<ModalShell Title="Story Entities" MaxWidth="960px" BodyClass="is-flush" OnClose="OnClose">
    <div class="entity-tabs">
        @foreach (var type in EntityTypes)
        {
            <SelectableButton @key="type.Key" Class="@($"entity-tab {(Type == type.Key ? "is-active" : "")}")" OnClick="@(_ => SelectType(type.Key))">
                <FaIcon Name="@type.Icon" />
                @type.Label
                <code>@CountFor(type.Key)</code>
            </SelectableButton>
        }
    </div>
    <EntityListEditor TItem="EntityEntry"
                      Items="Entries"
                      SelectedId="@SelectedId"
                      SelectedIdChanged="SetSelected"
                      GetId="entry => entry.Id"
                      Height="580px"
                      RailWidth="260px"
                      Class="entity-manager-layout"
                      MainClass="entity-editor-pane">
        <ListHeader>
            <span>@ActiveTypeLabel</span>
            <IconButton Icon="plus" Title="Add entity" OnClick="@(_ => AddEntity())" />
        </ListHeader>
        <ListItemTemplate Context="row">
            <SidebarListRow Title="@row.Item.Title"
                            Summary="@row.Item.Subtitle"
                            Active="@row.Active"
                            Class="entity-list-row"
                            OnClick="@row.Select">
                <LeadingContent>
                    <span class="entity-list-icon">
                        @if (Type == "characters")
                        {
                            <Avatar Name="@row.Item.Title" Size="34" />
                        }
                        else if (Type == "timeline")
                        {
                            <FaIcon Name="clock" />
                        }
                        else
                        {
                            <span class="img-placeholder tiny" style="--hue:@(Type == "locations" ? 210 : 200)"></span>
                        }
                        @if (row.Item.Active)
                        {
                            <span class="entity-active-dot @(Type == "locations" ? "is-location" : "")"></span>
                        }
                    </span>
                </LeadingContent>
                <TrailingContent>
                    @if (HasToggle)
                    {
                        <span class="entity-row-action" @onclick:stopPropagation="true">
                            <IconButton Icon="@(Type == "locations" ? "map-pin" : "eye")" Title="Toggle active" Active="@row.Item.Active" OnClick="@(_ => ToggleActive(row.Item.Id))" />
                        </span>
                    }
                </TrailingContent>
            </SidebarListRow>
        </ListItemTemplate>
        <ItemTemplate>
            @if (Type == "characters" && SelectedCharacter is not null)
            {
                <CharacterEditor Character="SelectedCharacter" ExistingCharacters="Characters" OnChanged="OnChanged" OnDelete="@(() => DeleteSelected())" />
            }
            else if (Type == "locations" && SelectedLocation is not null)
            {
                <LocationEditor Location="SelectedLocation" OnChanged="OnChanged" OnDelete="@(() => DeleteSelected())" />
            }
            else if (Type == "items" && SelectedItem is not null)
            {
                <ItemEditor Item="SelectedItem" OnChanged="OnChanged" OnDelete="@(() => DeleteSelected())" />
            }
            else if (Type == "timeline" && SelectedTimeline is not null)
            {
                <TimelineEditor Entry="SelectedTimeline" OnChanged="OnChanged" OnDelete="@(() => DeleteSelected())" />
            }
            else
            {
                <div class="empty-preview"><FaIcon Name="@ActiveIcon" /><span>Select an entity to edit, or add a new one</span><AppButton Variant="secondary" OnClick="@(_ => AddEntity())"><FaIcon Name="plus" />Add @ActiveSingular</AppButton></div>
            }
        </ItemTemplate>
        <EmptySelectionTemplate>
            <div class="empty-preview"><FaIcon Name="@ActiveIcon" /><span>Select an entity to edit, or add a new one</span><AppButton Variant="secondary" OnClick="@(_ => AddEntity())"><FaIcon Name="plus" />Add @ActiveSingular</AppButton></div>
        </EmptySelectionTemplate>
    </EntityListEditor>
</ModalShell>

@if (CharacterWizardOpen && SelectedCharacter is not null)
{
    <CharacterWizardModal Character="SelectedCharacter" ExistingCharacters="Characters" OnClose="@(() => CharacterWizardOpen = false)" OnChanged="OnChanged" />
}

@code {
    string Type = "characters";
    string? SelectedId;
    bool CharacterWizardOpen;
    sealed record EntityEntry(string Id, string Title, string Subtitle, bool Active);
    readonly (string Key, string Label, string Icon)[] EntityTypes =
    [
        ("characters", "Characters", "users"),
        ("locations", "Locations", "map-pin"),
        ("items", "Items", "box"),
        ("timeline", "Timeline", "clock")
    ];

    [Parameter] public string InitialType { get; set; } = "characters";
    [Parameter] public string? InitialId { get; set; }
    [Parameter] public List<RpCharacter> Characters { get; set; } = [];
    [Parameter] public List<RpLocation> Locations { get; set; } = [];
    [Parameter] public List<RpItem> Items { get; set; } = [];
    [Parameter] public List<RpTimelineEntry> Timeline { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    string ActiveTypeLabel => EntityTypes.First(type => type.Key == Type).Label;
    string ActiveIcon => EntityTypes.First(type => type.Key == Type).Icon;
    RpCharacter? SelectedCharacter => Characters.FirstOrDefault(character => character.Id == SelectedId);
    RpLocation? SelectedLocation => Locations.FirstOrDefault(location => location.Id == SelectedId);
    RpItem? SelectedItem => Items.FirstOrDefault(item => item.Id == SelectedId);
    RpTimelineEntry? SelectedTimeline => Timeline.FirstOrDefault(entry => entry.Id == SelectedId);

    bool HasToggle => Type is "characters" or "locations" or "items";
    string ActiveSingular => ActiveTypeLabel.TrimEnd('s');

    IEnumerable<EntityEntry> Entries => Type switch
    {
        "characters" => Characters.Select(character => new EntityEntry(character.Id, character.Name, character.Summary, character.InScene)),
        "locations" => Locations.Select(location => new EntityEntry(location.Id, location.Name, location.Summary, location.IsActive)),
        "items" => Items.Select(item => new EntityEntry(item.Id, item.Name, item.Summary, item.InScene)),
        _ => Timeline.Select(entry => new EntityEntry(entry.Id, entry.Title, entry.Date, false))
    };

    protected override void OnInitialized()
    {
        Type = InitialType;
        SelectedId = InitialId ?? Entries.FirstOrDefault()?.Id;
    }

    void SelectType(string type)
    {
        Type = type;
        SelectedId = Entries.FirstOrDefault()?.Id;
    }

    void SetSelected(string? id) => SelectedId = id;

    void AddEntity()
    {
        if (Type == "characters")
        {
            _ = CreateCharacter();
            return;
        }
        if (Type == "locations")
        {
            var location = new RpLocation { Id = $"l{Locations.Count + 1}", Name = "New Location", Summary = "New location summary." };
            Locations.Add(location);
            SelectedId = location.Id;
        }
        else if (Type == "items")
        {
            var item = new RpItem { Id = $"i{Items.Count + 1}", Name = "New Item", Summary = "New item summary." };
            Items.Add(item);
            SelectedId = item.Id;
        }
        else
        {
            var entry = new RpTimelineEntry { Id = $"t{Timeline.Count + 1}", Title = "New Event", Date = "today" };
            Timeline.Add(entry);
            SelectedId = entry.Id;
        }

        _ = OnChanged.InvokeAsync();
    }

    async Task CreateCharacter()
    {
        var character = new RpCharacter { Id = $"c{Characters.Count + 1}", Name = "New Character" };
        Characters.Insert(0, character);
        SelectedId = character.Id;
        CharacterWizardOpen = true;
        await OnChanged.InvokeAsync();
    }

    async Task ToggleActive(string id)
    {
        if (Type == "characters")
            Characters.First(character => character.Id == id).InScene = !Characters.First(character => character.Id == id).InScene;
        else if (Type == "locations")
        {
            foreach (var location in Locations)
                location.IsActive = location.Id == id;
        }
        else if (Type == "items")
            Items.First(item => item.Id == id).InScene = !Items.First(item => item.Id == id).InScene;

        await OnChanged.InvokeAsync();
    }

    int CountFor(string type) => type switch
    {
        "characters" => Characters.Count,
        "locations" => Locations.Count,
        "items" => Items.Count,
        _ => Timeline.Count
    };

    async Task DeleteSelected()
    {
        if (SelectedId is null)
            return;

        if (Type == "characters")
            Characters.RemoveAll(character => character.Id == SelectedId);
        else if (Type == "locations")
            Locations.RemoveAll(location => location.Id == SelectedId);
        else if (Type == "items")
            Items.RemoveAll(item => item.Id == SelectedId);
        else
            Timeline.RemoveAll(entry => entry.Id == SelectedId);

        SelectedId = Entries.FirstOrDefault()?.Id;
        await OnChanged.InvokeAsync();
    }
}
