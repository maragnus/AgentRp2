@if (Message.Type == "process")
{
    @if (ShowProcess)
    {
        <ProcessTrace Message="Message" />
    }
}
else if (Message.Type == "appearance")
{
    @if (ShowAppearance)
    {
        <div class="appearance-row">
            <FaIcon Name="eye" />
            <span style="flex:1">@Message.Summary</span>
            <Badge Tone="blue">@Message.CharacterCount chars</Badge>
        </div>
    }
}
else
{
    <article class="narrative-message">
        <div class="narrative-card">
            <div class="narrative-head">
                <div class="message-author">
                    @if (IsNarrator)
                    {
                        <span class="narrator-avatar"><FaIcon Name="book-open" /></span>
                    }
                    else
                    {
                        <Avatar Name="@Message.Author" Size="26" />
                    }
                    <span>@Message.Author</span>
                </div>
                <span style="margin-left:auto">@Message.Timestamp</span>
                <span class="mode-badge @ModeClass">@Message.Mode</span>
            </div>
            <p class="narrative-body @ProseClass">@Message.Body</p>
            <div class="narrative-actions">
                @if (!string.IsNullOrWhiteSpace(Message.Branch))
                {
                    <div class="branch-nav">
                        <IconButton Icon="chevron-left" Title="Previous branch" />
                        <code>@Message.Branch</code>
                        <IconButton Icon="chevron-right" Title="Next branch" />
                    </div>
                }
                else
                {
                    <div></div>
                }
                <div class="action-cluster">
                    <div class="dropdown-wrap">
                        <IconButton Icon="users" Title="Change author" Active="@AuthorOpen" OnClick="@(_ => AuthorOpen = !AuthorOpen)" />
                        @if (AuthorOpen)
                        {
                            <div class="popover message-popover">
                                <div class="popover-label">Change Author</div>
                                <SelectableButton Class="@($"select-row {(IsNarrator ? "is-disabled is-active" : "")}")" OnClick="@(_ => AuthorOpen = false)"><span class="mini-narrator large"><FaIcon Name="book-open" /></span><span>Narrator</span>@if (IsNarrator) { <FaIcon Name="check" /> }</SelectableButton>
                                @foreach (var character in Characters)
                                {
                                    var current = Message.Author == character.Name;
                                    <SelectableButton @key="character.Id" Class="@($"select-row {(current ? "is-disabled is-active" : "")}")" OnClick="@(_ => AuthorOpen = false)"><Avatar Name="@character.Name" Size="20" /><span>@character.Name</span>@if (current) { <FaIcon Name="check" /> }</SelectableButton>
                                }
                            </div>
                        }
                    </div>
                    <IconButton Icon="edit" Title="Edit message" />
                    <span class="v-divider"></span>
                    <div class="regen-group">
                        <IconButton Icon="refresh" Title="Regenerate from saved plan" />
                        <span></span>
                        <AppButton Variant="ghost" Size="icon" Title="Change turn shape & regenerate" OnClick="@(_ => ShapeOpen = !ShapeOpen)"><FaIcon Name="layers" /><FaIcon Name="chevron-down" /></AppButton>
                        <span></span>
                        <IconButton Icon="sliders" Title="Edit saved plan" OnClick="@(_ => EditPlan = true)" />
                        @if (ShapeOpen)
                        {
                            <div class="popover message-popover shape-popover">
                                <div class="popover-label">Turn Shape</div>
                                @foreach (var shape in TurnShapes)
                                {
                                    <SelectableButton @key="shape" Class="select-row" OnClick="@(_ => ShapeOpen = false)"><span>@shape</span></SelectableButton>
                                }
                            </div>
                        }
                    </div>
                    <span class="v-divider"></span>
                    <IconButton Icon="flag" Title="Create snapshot here" />
                    <IconButton Icon="copy" Title="Copy message" OnClick="@CopyMessage" />
                    <IconButton Icon="trash" Title="Delete message" OnClick="@(_ => ConfirmDelete = true)" />
                </div>
            </div>
        </div>
    </article>
}

@if (ConfirmDelete)
{
    <div class="modal-backdrop confirm-backdrop" @onclick="@(() => ConfirmDelete = false)">
        <section class="confirm-dialog" @onclick:stopPropagation="true">
            <div class="confirm-head">
                <span class="danger-mark"><FaIcon Name="trash" /></span>
                <strong>Delete this message?</strong>
            </div>
            <p>This removes this turn only. You can also delete this turn and @SubsequentCount later turns as a branch.</p>
            <div class="confirm-actions">
                <AppButton Variant="secondary" OnClick="@(_ => ConfirmDelete = false)">Cancel</AppButton>
                @if (SubsequentCount > 0)
                {
                    <AppButton Variant="danger" OnClick="DeleteBranch"><FaIcon Name="branch" /> Delete Branch</AppButton>
                }
                <AppButton Variant="rose" OnClick="DeleteSingle"><FaIcon Name="trash" /> Delete</AppButton>
            </div>
        </section>
    </div>
}

@if (EditPlan)
{
    <ModalShell Title="Edit Saved Plan" Subtitle="@($"{Message.Author} · {Message.Timestamp}")" Icon="sliders" MaxWidth="760px" BodyClass="is-flush" Class="edit-plan-modal" OnClose="@(() => EditPlan = false)">
        <ChildContent>
            <ModalTabGroup ActiveId="@ActivePlanTab" ActiveIdChanged="SetActivePlanTab" Height="560px" RailWidth="152px" Class="edit-plan-tabs">
                <ChildContent>
                    <ModalTab Id="appearance" Title="Appearance" Summary="@($"{Characters.Count} characters")" Dirty="@Appearances.Any(pair => !string.IsNullOrWhiteSpace(pair.Value))" />
                    <ModalTab Id="plan" Title="Plan" Summary="@PlanShape" Dirty="@IsPlanDirty()" />
                    <ModalTab Id="private" Title="Private Intent" Summary="@($"{Characters.Count} characters")" Dirty="@PrivateIntents.Any(pair => !string.IsNullOrWhiteSpace(pair.Value))" />
                </ChildContent>
                <RailFooter>
                    <div class="prompt-rail-note">
                        <div class="divider"></div>
                        <p>Saved plan fields are reused when regenerating this turn.</p>
                    </div>
                </RailFooter>
                <MainContent>
                    <section class="modal-editor-main edit-plan-main">
                        @if (ActivePlanTab == "appearance")
                        {
                            <header class="tuning-toolbar">
                                <strong>Characters</strong>
                                <span style="flex:1"></span>
                                <Badge Tone="blue">@Characters.Count</Badge>
                            </header>

                            <div class="edit-plan-fields">
                                @if (Characters.Count == 0)
                                {
                                    <Section Title="Characters" Class="edit-plan-section">
                                        <p class="empty-note">No characters are available for this turn.</p>
                                    </Section>
                                }
                                else
                                {
                                    @foreach (var character in Characters)
                                    {
                                        <Section @key="character.Id" Title="@character.Name" Class="edit-plan-section">
                                            <textarea class="field plan-field" rows="3" placeholder="@($"How does {character.Name} appear in this turn?")" value="@GetAppearance(character.Id)" @onchange="@((ChangeEventArgs args) => SetAppearance(character.Id, args.Value?.ToString() ?? ""))"></textarea>
                                        </Section>
                                    }
                                }
                            </div>
                        }
                        else if (ActivePlanTab == "plan")
                        {
                            <header class="tuning-toolbar">
                                <strong>Plan</strong>
                                <span style="flex:1"></span>
                                <Badge Tone="amber">@PlanShape</Badge>
                            </header>

                            <div class="edit-plan-fields">
                                <Section Title="Turn Length" Hint="Regeneration target" Class="edit-plan-section">
                                    <div class="turn-shape-chip-grid" role="group" aria-label="Turn Length">
                                        @foreach (var shape in TurnShapes)
                                        {
                                            <button @key="shape" type="button" class="turn-shape-chip @(PlanShape == shape ? "is-selected" : "")" @onclick="@(() => PlanShape = shape)">
                                                @shape
                                            </button>
                                        }
                                    </div>
                                </Section>

                                <Section Title="Scene Beat" Class="edit-plan-section">
                                    <FieldRow Label="Beat">
                                        <textarea class="field plan-field" rows="3" placeholder="What story beat does this turn serve?" @bind="Beat"></textarea>
                                    </FieldRow>
                                    <FieldRow Label="Change Introduced">
                                        <textarea class="field plan-field" rows="3" placeholder="What shifts as a result of this turn?" @bind="ChangeIntroduced"></textarea>
                                    </FieldRow>
                                </Section>

                                <Section Title="Character Aim" Class="edit-plan-section">
                                    <FieldRow Label="Intent">
                                        <textarea class="field plan-field" rows="3" placeholder="What does the character intend to do?" @bind="Intent"></textarea>
                                    </FieldRow>
                                    <FieldRow Label="Immediate Goal">
                                        <input class="field plan-field" placeholder="What does the character want right now?" @bind="ImmediateGoal" />
                                    </FieldRow>
                                    <FieldRow Label="Why Now">
                                        <textarea class="field plan-field" rows="3" placeholder="Why is the character acting at this moment?" @bind="WhyNow"></textarea>
                                    </FieldRow>
                                    <FieldRow Label="Guardrails">
                                        <textarea class="field plan-field" rows="3" placeholder="What should the AI avoid or preserve?" @bind="Guardrails"></textarea>
                                    </FieldRow>
                                </Section>
                            </div>
                        }
                        else
                        {
                            <header class="tuning-toolbar">
                                <strong>Private Intent</strong>
                                <span style="flex:1"></span>
                                <Badge Tone="violet">@Characters.Count</Badge>
                            </header>

                            <div class="edit-plan-fields">
                                @if (Characters.Count == 0)
                                {
                                    <Section Title="Characters" Class="edit-plan-section">
                                        <p class="empty-note">No characters are available for this turn.</p>
                                    </Section>
                                }
                                else
                                {
                                    @foreach (var character in Characters)
                                    {
                                        <Section @key="character.Id" Title="@character.Name" Class="edit-plan-section">
                                            <textarea class="field plan-field" rows="3" placeholder="@($"What private intention is {character.Name} carrying?")" value="@GetPrivateIntent(character.Id)" @onchange="@((ChangeEventArgs args) => SetPrivateIntent(character.Id, args.Value?.ToString() ?? ""))"></textarea>
                                        </Section>
                                    }
                                }
                            </div>
                        }
                        <footer class="prompt-footer">
                            <AppButton Variant="secondary" OnClick="@(_ => EditPlan = false)">Cancel</AppButton>
                            <AppButton Variant="primary" OnClick="@(_ => EditPlan = false)"><FaIcon Name="check" />Save Plan</AppButton>
                        </footer>
                    </section>
                </MainContent>
            </ModalTabGroup>
        </ChildContent>
    </ModalShell>
}

@code {
    bool ConfirmDelete;
    bool EditPlan;
    bool AuthorOpen;
    bool ShapeOpen;
    string ActivePlanTab = "appearance";
    string PlanShape = "Brief";
    string Beat = "Arrival and de-escalation attempt.";
    string Intent = "Move the scene forward while preserving character tension.";
    string ImmediateGoal = "Physical contact with both to claim her place in the room without choosing sides.";
    string WhyNow = "She has read the room instantly. Waiting would let the tension calcify.";
    string ChangeIntroduced = "The dynamic shifts from a two-person standoff to a three-way scene.";
    string Guardrails = "Keep the prose compact and grounded in observable action.";
    readonly Dictionary<string, string> Appearances = [];
    readonly Dictionary<string, string> PrivateIntents = [];
    readonly string[] TurnShapes = ["Compact", "Brief", "Extended", "Monologue", "Silent", "Silent Extended"];

    [Parameter] public RpMessage Message { get; set; } = new();
    [Parameter] public List<RpCharacter> Characters { get; set; } = [];
    [Parameter] public bool ShowAppearance { get; set; }
    [Parameter] public bool ShowProcess { get; set; }
    [Parameter] public int SubsequentCount { get; set; }
    [Parameter] public EventCallback<string> OnDeleteMessage { get; set; }
    [Parameter] public EventCallback<string> OnDeleteBranch { get; set; }
    [Inject] IJSRuntime JS { get; set; } = default!;

    bool IsNarrator => Message.Author == "Narrator";
    string ProseClass => IsNarrator ? "is-narrator" : "is-character";
    string ModeClass => Message.Mode switch
    {
        "Guided AI" => "is-guided",
        "Automatic AI" => "is-auto",
        _ => "is-manual"
    };

    async Task DeleteSingle()
    {
        ConfirmDelete = false;
        await OnDeleteMessage.InvokeAsync(Message.Id);
    }

    async Task DeleteBranch()
    {
        ConfirmDelete = false;
        await OnDeleteBranch.InvokeAsync(Message.Id);
    }

    void SetActivePlanTab(string? id) => ActivePlanTab = id ?? ActivePlanTab;

    bool IsPlanDirty() =>
        PlanShape != "Brief" ||
        Beat != "Arrival and de-escalation attempt." ||
        ChangeIntroduced != "The dynamic shifts from a two-person standoff to a three-way scene." ||
        Intent != "Move the scene forward while preserving character tension." ||
        ImmediateGoal != "Physical contact with both to claim her place in the room without choosing sides." ||
        WhyNow != "She has read the room instantly. Waiting would let the tension calcify." ||
        Guardrails != "Keep the prose compact and grounded in observable action.";

    string GetAppearance(string characterId) => Appearances.TryGetValue(characterId, out var appearance) ? appearance : "";

    void SetAppearance(string characterId, string appearance) => Appearances[characterId] = appearance;

    string GetPrivateIntent(string characterId) => PrivateIntents.TryGetValue(characterId, out var intent) ? intent : "";

    void SetPrivateIntent(string characterId, string intent) => PrivateIntents[characterId] = intent;

    async Task CopyMessage(MouseEventArgs args) => await JS.InvokeVoidAsync("navigator.clipboard.writeText", Message.Body);
}
