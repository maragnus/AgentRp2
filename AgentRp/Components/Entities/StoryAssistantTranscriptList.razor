@inject IJSRuntime JS

@foreach (var item in Session.Chat.StoryAssistant.Items)
{
    <div @key="item.Id" class="@ItemClass(item)">
        @if (item.Kind is StoryAssistantItemKind.UserMessage or StoryAssistantItemKind.AssistantMessage)
        {
            <div class="story-assistant-message-stack">
            @if (IsThinking(item) || item.Kind == StoryAssistantItemKind.UserMessage)
            {
                <div class="story-assistant-bubble @(IsThinking(item) ? "is-loading" : "")">
                    @if (IsThinking(item))
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>Loading...</span>
                    }
                    else
                    {
                        @item.Text
                    }
                </div>
            }
            else
            {
                <div class="story-assistant-bubble is-markdown">
                    <MarkdownContent Markdown="@item.Text" Class="story-assistant-markdown" />
                </div>
            }
            @if (ShowAssistantRecovery(item))
            {
                <div class="story-assistant-recovery-actions">
                    @if (item.Retry.CanRetry)
                    {
                        <BusyButton Variant="secondary" OnClick="@(() => Retry(item.Id))">
                            <FaIcon Name="rotate-right" /> Retry
                        </BusyButton>
                    }
                    @if (item.Diagnostics.HasDetails)
                    {
                        <AnchoredPopover Class="story-assistant-diagnostics-popover"
                                         AnchorClass="story-assistant-diagnostics-anchor"
                                         Placement="OverlayPlacement.BottomStart"
                                         CloseOnContentClick="false"
                                         DebugName="Story Assistant diagnostics">
                            <Trigger Context="popover">
                                <AppButton Icon="circle-info"
                                           TooltipText="Show diagnostics"
                                           AriaLabel="Show Story Assistant diagnostics"
                                           OnClick="@(_ => popover.Toggle())" />
                            </Trigger>
                            <Content Context="popover">
                                <div class="story-assistant-diagnostics">
                                    <div class="story-assistant-diagnostics-head">
                                        <strong>Diagnostics</strong>
                                        <AppButton Icon="x" TooltipText="Close" AriaLabel="Close diagnostics" OnClick="@(_ => popover.Close())" />
                                    </div>
                                    <dl>
                                        @foreach (var row in DiagnosticRows(item))
                                        {
                                            <div @key="row.Label">
                                                <dt>@row.Label</dt>
                                                <dd>@row.Value</dd>
                                            </div>
                                        }
                                    </dl>
                                    <pre>@DiagnosticDump(item)</pre>
                                    <div class="story-assistant-diagnostics-actions">
                                        <AppButton Variant="secondary" Icon="copy" Text="Copy" OnClick="@(_ => CopyDiagnostics(item))" />
                                    </div>
                                </div>
                            </Content>
                        </AnchoredPopover>
                    }
                </div>
            }
            </div>
        }
        else if (item.Kind == StoryAssistantItemKind.Question)
        {
            <div class="story-tool-card">
                <div class="story-tool-head">
                    <span><FaIcon Name="message-circle-question" /> @item.Question.Prompt</span>
                    <Badge Tone="@ToneFor(item.Status)">@StatusText(item.Status)</Badge>
                </div>
                @if (item.Status == StoryAssistantItemStatus.Pending)
                {
                    @if (item.Question.Choices.Count > 0)
                    {
                        <div class="story-question-choices @(item.Question.SelectionMode == StoryAssistantQuestionSelectionMode.Multiple ? "is-multi" : "")">
                            @foreach (var choice in item.Question.Choices)
                            {
                                if (item.Question.SelectionMode == StoryAssistantQuestionSelectionMode.Multiple)
                                {
                                    <SelectableButton @key="choice.Id"
                                                      Class="@($"story-question-choice {(IsChoiceSelected(item.Id, choice.Id) ? "is-selected" : "")}")"
                                                      OnClick="@(_ => ToggleChoice(item, choice.Id))">
                                        <span>
                                            <strong>@choice.Label</strong>
                                            @if (!string.IsNullOrWhiteSpace(choice.Description))
                                            {
                                                <small>@choice.Description</small>
                                            }
                                        </span>
                                        @if (IsChoiceSelected(item.Id, choice.Id))
                                        {
                                            <FaIcon Name="check" />
                                        }
                                    </SelectableButton>
                                }
                                else
                                {
                                    <BusyButton @key="choice.Id" Variant="secondary" OnClick="@(() => AnswerQuestion(item.Id, choice.Label))">
                                        @choice.Label
                                    </BusyButton>
                                }
                            }
                        </div>
                        @if (item.Question.SelectionMode == StoryAssistantQuestionSelectionMode.Multiple)
                        {
                            <div class="story-question-submit">
                                <span>@SelectionHint(item)</span>
                                <BusyButton Variant="primary" Disabled="@(!CanSubmitSelection(item))" OnClick="@(() => AnswerQuestion(item.Id, SelectedAnswer(item)))">Send</BusyButton>
                            </div>
                        }
                    }
                    @if (item.Question.AllowsFreeform || item.Question.Choices.Count == 0)
                    {
                        <div class="story-review-note">
                            <AppTextarea Rows="2"
                                         Value="@NoteFor(item.Id)"
                                         ValueChanged="value => SetNote(item.Id, value)"
                                         IsEmpty="@NoteIsEmpty(item.Id)"
                                         IsEmptyChanged="value => SetNoteEmpty(item.Id, value)"
                                         UpdateMode="TextUpdateMode.Empty"
                                         Placeholder="Your answer" />
                            <BusyButton Variant="primary" Disabled="@NoteIsEmpty(item.Id)" OnClick="@(() => AnswerQuestion(item.Id, NoteFor(item.Id)))">Send</BusyButton>
                        </div>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(item.Question.Answer))
                {
                    <p class="story-tool-result">@item.Question.Answer</p>
                }
            </div>
        }
        else
        {
            <div class="story-tool-card">
                <div class="story-tool-head">
                    <span><FaIcon Name="@IconFor(item)" /> @item.Title</span>
                    @if (ShowStatusBadge(item))
                    {
                        <Badge Tone="@ToneFor(item.Status)">@StatusText(item.Status)</Badge>
                    }
                </div>
                @if (item.Diffs.Count > 0 && ShowAfterOnlyDiffs(item))
                {
                    <details class="story-tool-details">
                        <summary>@item.Diffs.Count field@(item.Diffs.Count == 1 ? "" : "s")</summary>
                        <div class="story-created-list">
                            @foreach (var diff in item.Diffs)
                            {
                                <div @key="diff.Field" class="story-created-row">
                                    <strong>@diff.Label</strong>
                                    <span>@Display(diff.After)</span>
                                </div>
                            }
                        </div>
                    </details>
                }
                else if (item.Diffs.Count > 0)
                {
                    <details class="story-tool-details">
                        <summary>@item.Diffs.Count field@(item.Diffs.Count == 1 ? "" : "s")</summary>
                        <div class="story-diff-list">
                            @foreach (var diff in item.Diffs)
                            {
                                <div @key="diff.Field" class="story-diff-row">
                                    <strong>@diff.Label</strong>
                                    <span>@Display(diff.Before)</span>
                                    <FaIcon Name="arrow-right" />
                                    <span>@Display(diff.After)</span>
                                </div>
                            }
                        </div>
                    </details>
                }
                @if (item.Status == StoryAssistantItemStatus.NeedsReview)
                {
                    <div class="story-review-note">
                        <AppTextarea Rows="2"
                                     Value="@NoteFor(item.Id)"
                                     ValueChanged="value => SetNote(item.Id, value)"
                                     IsEmpty="@NoteIsEmpty(item.Id)"
                                     IsEmptyChanged="value => SetNoteEmpty(item.Id, value)"
                                     UpdateMode="TextUpdateMode.Empty"
                                     Placeholder="Optional guidance" />
                        <div class="story-review-actions">
                            <BusyButton Variant="primary" OnClick="@(() => Decide(item.Id, StoryAssistantDecisionKind.Accept))">Accept</BusyButton>
                            <BusyButton Variant="secondary" OnClick="@(() => Decide(item.Id, StoryAssistantDecisionKind.TryAgain))">Try Again</BusyButton>
                            <BusyButton Variant="danger" OnClick="@(() => Decide(item.Id, StoryAssistantDecisionKind.Reject))">Reject</BusyButton>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(item.DecisionReason))
                {
                    <p class="story-tool-result">@item.DecisionReason</p>
                }
            </div>
        }
    </div>
}
@if (ShowBusyPlaceholder)
{
    <div class="story-assistant-item is-assistant">
        <div class="story-assistant-bubble is-loading" role="status" aria-live="polite">
            <span class="spinner" aria-hidden="true"></span>
            <span>Loading...</span>
        </div>
    </div>
}

@code {
    readonly Dictionary<string, string> Notes = [];
    readonly Dictionary<string, bool> EmptyNotes = [];
    readonly Dictionary<string, HashSet<string>> SelectedChoices = [];

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public bool ShowBusyPlaceholder { get; set; }
    [Parameter] public int RenderVersion { get; set; }

    string NoteFor(string id) => Notes.GetValueOrDefault(id, "");

    bool NoteIsEmpty(string id) =>
        EmptyNotes.GetValueOrDefault(id, string.IsNullOrWhiteSpace(NoteFor(id)));

    void SetNote(string id, string value)
    {
        Notes[id] = value;
        EmptyNotes[id] = string.IsNullOrWhiteSpace(value);
    }

    void SetNoteEmpty(string id, bool isEmpty) => EmptyNotes[id] = isEmpty;

    bool IsChoiceSelected(string itemId, string choiceId) =>
        SelectedChoices.TryGetValue(itemId, out var selected) && selected.Contains(choiceId);

    void ToggleChoice(StoryAssistantTranscriptItem item, string choiceId)
    {
        if (!SelectedChoices.TryGetValue(item.Id, out var selected))
        {
            selected = new(StringComparer.Ordinal);
            SelectedChoices[item.Id] = selected;
        }

        if (!selected.Remove(choiceId))
        {
            if (selected.Count >= item.Question.MaxSelections)
                return;

            selected.Add(choiceId);
        }
    }

    async Task Decide(string id, StoryAssistantDecisionKind kind)
    {
        await Session.Chat.StoryAssistant.ResolveReviewAsync(id, kind, NoteFor(id));
        Notes.Remove(id);
        EmptyNotes.Remove(id);
    }

    async Task AnswerQuestion(string id, string answer)
    {
        await Session.Chat.StoryAssistant.ResolveQuestionAsync(id, answer);
        Notes.Remove(id);
        EmptyNotes.Remove(id);
        SelectedChoices.Remove(id);
    }

    Task Retry(string id) => Session.Chat.StoryAssistant.RetryAsync(id);

    async Task CopyDiagnostics(StoryAssistantTranscriptItem item) =>
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", DiagnosticDump(item));

    static string ItemClass(StoryAssistantTranscriptItem item) => item.Kind switch
    {
        StoryAssistantItemKind.UserMessage => "story-assistant-item is-user",
        StoryAssistantItemKind.AssistantMessage => "story-assistant-item is-assistant",
        _ => "story-assistant-item is-tool"
    };

    static bool IsThinking(StoryAssistantTranscriptItem item) =>
        item.Kind == StoryAssistantItemKind.AssistantMessage
        && item.Status == StoryAssistantItemStatus.Streaming
        && string.IsNullOrWhiteSpace(item.Text);

    static bool ShowAssistantRecovery(StoryAssistantTranscriptItem item) =>
        item.Kind == StoryAssistantItemKind.AssistantMessage
        && item.Status is StoryAssistantItemStatus.Failed or StoryAssistantItemStatus.Stopped
        && (item.Retry.CanRetry || item.Diagnostics.HasDetails);

    static bool ShowStatusBadge(StoryAssistantTranscriptItem item) => item.Status != StoryAssistantItemStatus.Read;

    static bool ShowAfterOnlyDiffs(StoryAssistantTranscriptItem item) =>
        item.Operation == StoryAssistantOperationKind.Create
        || item.Diffs.All(diff => string.IsNullOrWhiteSpace(diff.Before));

    static string IconFor(StoryAssistantTranscriptItem item) => item.EntityType switch
    {
        "character" => "user",
        "location" => "map-pin",
        "item" => "box",
        "timeline" => "clock",
        "relationship" => "users",
        _ => "wrench"
    };

    static string ToneFor(StoryAssistantItemStatus status) => status switch
    {
        StoryAssistantItemStatus.Accepted or StoryAssistantItemStatus.Applied or StoryAssistantItemStatus.Answered => "emerald",
        StoryAssistantItemStatus.Read => "blue",
        StoryAssistantItemStatus.NeedsReview or StoryAssistantItemStatus.RetryRequested or StoryAssistantItemStatus.Stopped => "amber",
        StoryAssistantItemStatus.Rejected or StoryAssistantItemStatus.Failed => "rose",
        _ => "blue"
    };

    static string StatusText(StoryAssistantItemStatus status) => status switch
    {
        StoryAssistantItemStatus.NeedsReview => "Review",
        StoryAssistantItemStatus.RetryRequested => "Try again",
        StoryAssistantItemStatus.Stopped => "Stopped",
        _ => status.ToString()
    };

    static string Display(string value) => string.IsNullOrWhiteSpace(value) ? "Not set" : value;

    bool CanSubmitSelection(StoryAssistantTranscriptItem item)
    {
        var count = SelectedChoiceLabels(item).Count;
        return count >= item.Question.MinSelections && count <= item.Question.MaxSelections;
    }

    string SelectedAnswer(StoryAssistantTranscriptItem item) =>
        string.Join(", ", SelectedChoiceLabels(item));

    IReadOnlyList<string> SelectedChoiceLabels(StoryAssistantTranscriptItem item)
    {
        if (!SelectedChoices.TryGetValue(item.Id, out var selected))
            return [];

        return item.Question.Choices
            .Where(choice => selected.Contains(choice.Id))
            .Select(choice => choice.Label)
            .ToList();
    }

    static string SelectionHint(StoryAssistantTranscriptItem item)
    {
        if (item.Question.MinSelections == item.Question.MaxSelections)
            return $"Pick {item.Question.MinSelections}.";
        if (item.Question.MinSelections == 0)
            return $"Pick up to {item.Question.MaxSelections}.";
        return $"Pick {item.Question.MinSelections}-{item.Question.MaxSelections}.";
    }

    static IReadOnlyList<DiagnosticRow> DiagnosticRows(StoryAssistantTranscriptItem item)
    {
        var diagnostics = item.Diagnostics;
        return
        [
            new("Outcome", Display(diagnostics.Outcome)),
            new("Reason", Display(diagnostics.Reason)),
            new("Provider", Display(JoinName(diagnostics.ProviderName, diagnostics.ProviderId))),
            new("Model", Display(JoinName(diagnostics.ModelName, diagnostics.ModelId))),
            new("Request", Display(diagnostics.RequestDisplay)),
            new("Response", Display(diagnostics.ResponseId)),
            new("Previous", Display(diagnostics.PreviousResponseId)),
            new("Last event", Display(diagnostics.LastStreamEvent)),
            new("Error", Display(diagnostics.Error))
        ];
    }

    static string DiagnosticDump(StoryAssistantTranscriptItem item)
    {
        var lines = DiagnosticRows(item)
            .Select(row => $"{row.Label}: {row.Value}")
            .ToList();
        lines.Add($"Item id: {item.Id}");
        lines.Add($"Item status: {item.Status}");
        lines.Add($"Created UTC: {item.CreatedUtc:O}");
        lines.Add($"Updated UTC: {item.UpdatedUtc:O}");
        lines.Add($"Retry display: {Display(item.Retry.DisplayMessage)}");
        lines.Add($"Retry available: {item.Retry.CanRetry}");
        return string.Join(Environment.NewLine, lines);
    }

    static string JoinName(string name, string id)
    {
        if (string.IsNullOrWhiteSpace(name))
            return id;
        if (string.IsNullOrWhiteSpace(id) || string.Equals(name, id, StringComparison.Ordinal))
            return name;
        return $"{name} ({id})";
    }

    sealed record DiagnosticRow(string Label, string Value);
}
