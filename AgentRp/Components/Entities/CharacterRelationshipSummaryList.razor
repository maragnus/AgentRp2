@if (Items.Count == 0)
{
    <span class="summary-empty">@EmptyText</span>
}
else
{
    <div class="character-relationships-summary">
        @foreach (var relationship in Items)
        {
            <article @key="relationship.Id" class="character-relationship-summary-row">
                <div class="character-relationship-summary-head">
                    <Avatar Name="@relationship.TargetName" Size="30" />
                    <div class="character-relationship-summary-title">
                        <strong>@relationship.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(relationship.Metadata))
                        {
                            <small>@relationship.Metadata</small>
                        }
                        <div class="character-relationship-summary-badges">
                            @BadgeList(relationship.RelationshipTypes, "amber")
                            @BadgeList(relationship.PrivateTensions, "violet")
                        </div>
                    </div>
                </div>
                <div class="character-relationship-summary-notes">
                    @if (!string.IsNullOrWhiteSpace(relationship.PublicDynamic))
                    {
                        <p>@relationship.PublicDynamic</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(relationship.HowSourceSeesTarget))
                    {
                        <dl>
                            <div>
                                <dt>@relationship.SourceName</dt>
                                <dd>@relationship.HowSourceSeesTarget</dd>
                            </div>
                        </dl>
                    }
                    @if (!string.IsNullOrWhiteSpace(relationship.HowTargetSeesSource))
                    {
                        <dl>
                            <div>
                                <dt>@relationship.TargetName</dt>
                                <dd>@relationship.HowTargetSeesSource</dd>
                            </div>
                        </dl>
                    }
                    @if (string.IsNullOrWhiteSpace(relationship.PublicDynamic)
                        && string.IsNullOrWhiteSpace(relationship.HowSourceSeesTarget)
                        && string.IsNullOrWhiteSpace(relationship.HowTargetSeesSource))
                    {
                        <span class="summary-empty">No details yet.</span>
                    }
                </div>
            </article>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<CharacterRelationshipSummaryItem> Items { get; set; } = [];
    [Parameter] public string EmptyText { get; set; } = "No relationships yet.";

    RenderFragment BadgeList(IReadOnlyCollection<string> values, string tone) => builder =>
    {
        var sequence = 0;
        foreach (var value in values)
        {
            builder.OpenComponent<Badge>(sequence++);
            builder.AddAttribute(sequence++, "Tone", tone);
            builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(child =>
            {
                child.AddContent(0, value);
            }));
            builder.CloseComponent();
        }
    };
}
