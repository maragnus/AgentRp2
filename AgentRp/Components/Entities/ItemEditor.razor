<div class="entity-form-editor">
    <Section Title="Identity" Class="entity-form-section">
        <FieldRow Label="Name"><AppInput Value="@Item.Name" ValueChanged="SetName" /></FieldRow>
        <FieldRow Label="Summary"><AppTextarea Rows="3" Value="@Item.Summary" ValueChanged="SetSummary" /></FieldRow>
    </Section>
    <Section Title="Object Details" Class="entity-form-section">
        <FieldRow Label="Description"><AppTextarea Rows="5" Value="@Item.Description" ValueChanged="SetDescription" /></FieldRow>
        <FieldRow Label="History"><AppTextarea Rows="4" Value="@Item.History" ValueChanged="SetHistory" /></FieldRow>
        <FieldRow Label="Properties"><AppTextarea Rows="4" Value="@Item.Properties" ValueChanged="SetProperties" /></FieldRow>
    </Section>
</div>

@code {
    [Parameter] public RpItem Item { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    Task Changed() => OnChanged.InvokeAsync();
    async Task SetName(string value) => await Update(() => Item.Name = value);
    async Task SetSummary(string value) => await Update(() => Item.Summary = value);
    async Task SetDescription(string value) => await Update(() => Item.Description = value);
    async Task SetHistory(string value) => await Update(() => Item.History = value);
    async Task SetProperties(string value) => await Update(() => Item.Properties = value);

    async Task Update(Action update)
    {
        update();
        await Changed();
    }
}
