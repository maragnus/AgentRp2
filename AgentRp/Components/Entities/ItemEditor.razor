<div class="entity-form-editor">
    <Section Title="Identity" Class="entity-form-section">
        <FieldRow Label="Name"><input class="field" @bind="Item.Name" @bind:after="Changed" /></FieldRow>
        <FieldRow Label="Summary"><textarea class="field" rows="3" @bind="Item.Summary" @bind:after="Changed"></textarea></FieldRow>
    </Section>
    <Section Title="Object Details" Class="entity-form-section">
        <FieldRow Label="Description"><textarea class="field" rows="5" @bind="Item.Description" @bind:after="Changed"></textarea></FieldRow>
        <FieldRow Label="History"><textarea class="field" rows="4" @bind="Item.History" @bind:after="Changed"></textarea></FieldRow>
        <FieldRow Label="Properties"><textarea class="field" rows="4" @bind="Item.Properties" @bind:after="Changed"></textarea></FieldRow>
    </Section>
</div>

@code {
    [Parameter] public RpItem Item { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    Task Changed() => OnChanged.InvokeAsync();
}
