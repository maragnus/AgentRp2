<FormStack>
    <FormSection Title="Identity" DirtyPaths="@IdentityPaths">
        <FieldRow Label="Name" DirtyPath="Name"><AppInput Value="@Item.Name" ValueChanged="SetName" DirtyPath="Name" /></FieldRow>
        <FieldRow Label="Summary" DirtyPath="Summary"><AppTextarea Rows="3" Value="@Item.Summary" ValueChanged="SetSummary" DirtyPath="Summary" /></FieldRow>
    </FormSection>
    <FormSection Title="Object Details" DirtyPaths="@DetailPaths">
        <FieldRow Label="Description" DirtyPath="Description"><AppTextarea Rows="5" Value="@Item.Description" ValueChanged="SetDescription" DirtyPath="Description" /></FieldRow>
        <FieldRow Label="History" DirtyPath="History"><AppTextarea Rows="4" Value="@Item.History" ValueChanged="SetHistory" DirtyPath="History" /></FieldRow>
        <FieldRow Label="Properties" DirtyPath="Properties"><AppTextarea Rows="4" Value="@Item.Properties" ValueChanged="SetProperties" DirtyPath="Properties" /></FieldRow>
    </FormSection>
</FormStack>

@code {
    static readonly string[] IdentityPaths = [nameof(RpItem.Name), nameof(RpItem.Summary)];
    static readonly string[] DetailPaths = [nameof(RpItem.Description), nameof(RpItem.History), nameof(RpItem.Properties)];

    [Parameter] public RpItem Item { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    Task Changed() => OnChanged.InvokeAsync();
    async Task SetName(string value) => await Update(() => Item.Name = value);
    async Task SetSummary(string value) => await Update(() => Item.Summary = value);
    async Task SetDescription(string value) => await Update(() => Item.Description = value);
    async Task SetHistory(string value) => await Update(() => Item.History = value);
    async Task SetProperties(string value) => await Update(() => Item.Properties = value);

    async Task Update(Action update)
    {
        update();
        await Changed();
    }
}
