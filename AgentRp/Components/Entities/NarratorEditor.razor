<div class="character-editor">
    <section class="character-summary-card">
        <div class="character-summary-top">
            <div>
                <SectionHeader Title="Summary" />
                <p>@SummaryText</p>
            </div>
        </div>

        <div class="character-summary-grid">
            <Section Title="Voice" Class="profile-block profile-block-wide">
                <dl class="summary-definition-list">
                    <div>
                        <dt>Preset</dt>
                        <dd>@NarratorProfileService.VoiceLabel(Profile.VoicePreset)</dd>
                    </div>
                    <div>
                        <dt>Guidance</dt>
                        <dd>@CustomGuidanceText</dd>
                    </div>
                </dl>
            </Section>
            <Section Title="Scene" Class="profile-block profile-block-wide">
                <dl class="summary-definition-list">
                    <div>
                        <dt>Setup</dt>
                        <dd>@LevelLabel(Profile.SetupDepth)</dd>
                    </div>
                    <div>
                        <dt>Visuals</dt>
                        <dd>@LevelLabel(Profile.VisualDetail)</dd>
                    </div>
                </dl>
            </Section>
            <Section Title="Motion" Class="profile-block profile-block-wide">
                <dl class="summary-definition-list">
                    <div>
                        <dt>Transitions</dt>
                        <dd>@LevelLabel(Profile.TransitionContext)</dd>
                    </div>
                    <div>
                        <dt>Foreshadowing</dt>
                        <dd>@LevelLabel(Profile.Foreshadowing)</dd>
                    </div>
                    <div>
                        <dt>Direction</dt>
                        <dd>@LevelLabel(Profile.DirectionStrength)</dd>
                    </div>
                </dl>
            </Section>
        </div>
    </section>
</div>

@code {
    [Parameter] public NarratorProfileState Profile { get; set; } = NarratorProfileState.CreateDefault();

    string SummaryText => NarratorProfileService.BuildPromptGuidance(Profile)
        .Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries)
        .FirstOrDefault(line => line.StartsWith("- Voice:", StringComparison.Ordinal))?
        .TrimStart('-', ' ')
        ?? "Narrator voice tuning is ready.";
    string CustomGuidanceText => string.IsNullOrWhiteSpace(Profile.CustomGuidance) ? "Not set" : Profile.CustomGuidance;

    static string LevelLabel(int value) => Math.Clamp(value, 0, 2) switch
    {
        0 => "Low",
        1 => "Balanced",
        _ => "High"
    };
}
