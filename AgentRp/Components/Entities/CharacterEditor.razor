<div class="entity-form-editor entity-profile-editor">
    <Section Title="Summary" Class="entity-profile-summary">
        <p>@SummaryText</p>
    </Section>

    <Section Title="Pronouns" Class="entity-profile-pronouns">
        <div class="pill-list">@BadgeList(Character.Pronouns, "blue")</div>
    </Section>

    <div class="entity-profile-grid">
        <Section Title="Scene Roles" Class="entity-profile-section">
            <div class="pill-list">@BadgeList(Character.SceneRoles, "blue")</div>
        </Section>
        <Section Title="Traits" Class="entity-profile-section">
            <div class="pill-list">@BadgeList(Character.Traits, "violet")</div>
        </Section>
        <Section Title="Soft Spots" Class="entity-profile-section">
            <div class="pill-list">@BadgeList(Character.SoftSpots, "emerald")</div>
        </Section>
        <Section Title="Inner Engine" Class="entity-profile-section entity-profile-section-wide">
            <dl class="summary-definition-list">
                @foreach (var row in CoreRows)
                {
                    <div @key="row.Label">
                        <dt>@row.Label</dt>
                        <dd>@DisplayLabel(row.Value)</dd>
                    </div>
                }
            </dl>
        </Section>
        <Section Title="Voice & Behavior" Class="entity-profile-section entity-profile-section-wide">
            <dl class="summary-definition-list">
                @foreach (var row in VoiceRows)
                {
                    <div @key="row.Label">
                        <dt>@row.Label</dt>
                        <dd>@DisplayLabel(row.Value)</dd>
                    </div>
                }
            </dl>
        </Section>
        <Section Title="Avoid Patterns" Class="entity-profile-section entity-profile-section-wide">
            <div class="pill-list">@BadgeList(Character.AvoidPatterns, "amber")</div>
        </Section>
    </div>
</div>

@code {
    [Parameter] public RpCharacter Character { get; set; } = new();

    string SummaryText => string.IsNullOrWhiteSpace(Character.Summary)
        ? "No summary yet. Open the editor to define the character concept."
        : Character.Summary;

    (string Label, string Value)[] CoreRows =>
    [
        ("Drive", Character.CoreDrive),
        ("Fear", Character.CoreFear),
        ("Mask", Character.SurfaceMask),
        ("Truth", Character.HiddenTruth)
    ];

    (string Label, string Value)[] VoiceRows =>
    [
        ("Sentence", Character.SentenceStyle),
        ("Honesty", Character.HonestyStyle),
        ("Leakage", Character.EmotionalLeakage),
        ("Action", Character.ActionFingerprint),
        ("Stress", Character.StressPattern)
    ];

    RenderFragment BadgeList(IReadOnlyCollection<string> values, string tone) => builder =>
    {
        if (values.Count == 0)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "summary-empty");
            builder.AddContent(2, "Not set");
            builder.CloseElement();
            return;
        }

        var sequence = 3;
        foreach (var value in values)
        {
            builder.OpenComponent<Badge>(sequence++);
            builder.AddAttribute(sequence++, "Tone", tone);
            builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(child =>
            {
                child.AddContent(0, DisplayLabel(value));
            }));
            builder.CloseComponent();
        }
    };

    static string DisplayLabel(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Not set";

        var spaced = value.Replace('-', ' ');
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(spaced);
    }
}
