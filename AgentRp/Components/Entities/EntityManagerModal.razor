@implements IDisposable

<StatefulForm Model="@Draft" Baseline="@Baseline" OnSave="SaveDraft" OnClose="OnClose" ContextChanged="SetEntityForm">
    <ChildContent Context="form">
<ModalShell Title="Story Entities" MaxWidth="960px" BodyClass="is-flush" OnClose="form.RequestCloseAsync">
    <ModalBodyTabs AriaLabel="Story entity sections">
        @foreach (var type in EntityTypes)
        {
            <ModalBodyTab @key="type.Key"
                          Icon="@type.Icon"
                          Label="@type.Label"
                          CountText="@CountFor(type.Key).ToString()"
                          Active="@(Type == type.Key)"
                          OnClick="@(_ => SelectType(type.Key))" />
        }
    </ModalBodyTabs>
    <EntityListEditor TItem="EntityEntry"
                      Items="Entries"
                      SelectedId="@SelectedId"
                      SelectedIdChanged="SetSelected"
                      GetId="entry => entry.Id"
                      Height="580px"
                      RailWidth="260px"
                      Class="entity-manager-layout"
                      MainClass="entity-editor-pane"
                      ItemBodyClass="modal-form-stack">
        <ListHeader>
            <span>@ActiveTypeLabel</span>
            <AppButton Icon="plus" TooltipText="Add entity" OnClick="@(_ => AddEntity())" />
        </ListHeader>
        <ListItemTemplate Context="row">
            <SidebarListRow Title="@row.Item.Title"
                            Summary="@row.Item.Subtitle"
                            Active="@row.Active"
                            Class="entity-list-row"
                            OnClick="@row.Select">
                <LeadingContent>
                    @if (Type == "timeline")
                    {
                        <CharacterAvatarStack Characters="TimelineAvatarItems(row.Item.Id)"
                                              Class="character-avatar-stack entity-list-avatar-stack"
                                              EmptyClass="entity-list-icon"
                                              EmptyIcon="clock"
                                              SummaryPrefix="Linked characters"
                                              EmptySummary="No linked characters" />
                    }
                    else
                    {
                        <span class="entity-list-icon">
                            @if (row.Item.IsNarrator)
                            {
                                <span class="narrator-avatar"><FaIcon Name="book-open" /></span>
                            }
                            else if (Type == "characters")
                            {
                                <EntityImage Name="@row.Item.Title" Image="@ImageFor(row.Item.ImageId)" EntityType="character" EntityId="@row.Item.Id" Size="34" />
                            }
                            else
                            {
                                <EntityImage Name="@row.Item.Title" Image="@ImageFor(row.Item.ImageId)" EntityType="@EntityTypeForCurrentTab" EntityId="@row.Item.Id" Size="34" />
                            }
                            @if (row.Item.Active)
                            {
                                <span class="entity-active-dot @(Type == "locations" ? "is-location" : "")"></span>
                            }
                        </span>
                    }
                </LeadingContent>
                <TrailingContent>
                    @if (HasToggle && !row.Item.IsNarrator)
                    {
                        <span class="entity-row-action" @onclick:stopPropagation="true">
                            <AppButton Icon="@(Type == "locations" ? "map-pin" : "eye")" TooltipText="Toggle active" Active="@row.Item.Active" OnClick="@(_ => ToggleActive(row.Item.Id))" />
                        </span>
                    }
                </TrailingContent>
            </SidebarListRow>
        </ListItemTemplate>
        <ItemHeaderTemplate Context="entry">
            @if (Type == "characters" && SelectedId == NarratorId)
            {
                <EntityHeader Name="Narrator" Subtitle="Story voice" ImageSize="40">
                    <Actions>
                        <EntityHeaderActionStack>
                            <TopActions>
                                <VoicePicker VoiceSelections="SelectedNarratorVoiceSelections"
                                             ActiveVoiceModel="ActiveVoiceModel"
                                             Compact
                                             OwnerName="Narrator"
                                             OnChanged="Changed" />
                            </TopActions>
                            <BottomActions>
                                <AppButton Variant="secondary" OnClick="@(_ => NarratorWizardOpen = true)"><FaIcon Name="sliders" /> Edit</AppButton>
                            </BottomActions>
                        </EntityHeaderActionStack>
                    </Actions>
                </EntityHeader>
            }
            else if (Type == "characters" && SelectedCharacter is not null)
            {
                <EntityHeader Name="@SelectedCharacter.Name" Subtitle="Guided profile" Image="@ImageFor(SelectedCharacter.ImageId)" EntityType="character" EntityId="@SelectedCharacter.Id" ImageSize="40" Editable OnImagePickerRequested="SelectSelectedEntityImage">
                    <Actions>
                        <EntityHeaderActionStack>
                            <TopActions>
                                <VoicePicker VoiceSelections="SelectedCharacter.VoiceSelections"
                                             ActiveVoiceModel="ActiveVoiceModel"
                                             Compact
                                             OwnerName="@SelectedCharacter.Name"
                                             OnChanged="Changed" />
                            </TopActions>
                            <BottomActions>
                                <AppButton Variant="secondary" OnClick="@(_ => CharacterWizardOpen = true)"><FaIcon Name="sliders" /> Edit</AppButton>
                                <AppButton Variant="danger" OnClick="@(_ => ConfirmDeleteOpen = true)"><FaIcon Name="trash" /> Delete</AppButton>
                            </BottomActions>
                        </EntityHeaderActionStack>
                    </Actions>
                </EntityHeader>
            }
            else if (Type == "locations" && SelectedLocation is not null)
            {
                <EntityHeader Name="@SelectedLocation.Name" Subtitle="Location profile" Image="@ImageFor(SelectedLocation.ImageId)" EntityType="location" EntityId="@SelectedLocation.Id" Editable OnImagePickerRequested="SelectSelectedEntityImage">
                    <Actions>
                        <AppButton Variant="danger" OnClick="@(_ => ConfirmDeleteOpen = true)"><FaIcon Name="trash" /> Delete</AppButton>
                    </Actions>
                </EntityHeader>
            }
            else if (Type == "items" && SelectedItem is not null)
            {
                <EntityHeader Name="@SelectedItem.Name" Subtitle="Item profile" Image="@ImageFor(SelectedItem.ImageId)" EntityType="item" EntityId="@SelectedItem.Id" Editable OnImagePickerRequested="SelectSelectedEntityImage">
                    <Actions>
                        <AppButton Variant="danger" OnClick="@(_ => ConfirmDeleteOpen = true)"><FaIcon Name="trash" /> Delete</AppButton>
                    </Actions>
                </EntityHeader>
            }
            else if (Type == "timeline" && SelectedTimeline is not null)
            {
                <EntityHeader Name="@SelectedTimeline.Title" Subtitle="Timeline entry" ImageSize="40">
                    <LeadingContent>
                        <CharacterAvatarStack Characters="TimelineAvatarItems(SelectedTimeline)"
                                              EmptyClass="sidebar-row-icon"
                                              EmptyIcon="clock"
                                              SummaryPrefix="Linked characters"
                                              EmptySummary="No linked characters" />
                    </LeadingContent>
                    <Actions>
                        <AppButton Variant="danger" OnClick="@(_ => ConfirmDeleteOpen = true)"><FaIcon Name="trash" /> Delete</AppButton>
                    </Actions>
                </EntityHeader>
            }
        </ItemHeaderTemplate>
        <ItemTemplate>
            @if (Type == "characters" && SelectedId == NarratorId)
            {
                <NarratorEditor Profile="@(SelectedNarrator ?? NarratorProfileState.CreateDefault())" />
            }
            else if (Type == "characters" && SelectedCharacter is not null)
            {
                <CharacterEditor Document="Session.ActiveChat.Current" Character="SelectedCharacter" Library="Session.Chat.CharacterTraitLibrary.State" />
            }
            else if (Type == "locations" && SelectedLocation is not null)
            {
                <StatefulFormScope PathPrefix="Location">
                    <LocationEditor Location="SelectedLocation"
                                    OnChanged="Changed" />
                </StatefulFormScope>
            }
            else if (Type == "items" && SelectedItem is not null)
            {
                <StatefulFormScope PathPrefix="Item">
                    <ItemEditor Item="SelectedItem"
                                OnChanged="Changed" />
                </StatefulFormScope>
            }
            else if (Type == "timeline" && SelectedTimeline is not null)
            {
                <StatefulFormScope PathPrefix="Timeline">
                    <TimelineEditor Entry="SelectedTimeline" OnChanged="Changed" />
                </StatefulFormScope>
            }
            else
            {
                <div class="empty-preview"><FaIcon Name="@ActiveIcon" /><span>Select an entity to edit, or add a new one</span><AppButton Variant="secondary" OnClick="@(_ => AddEntity())"><FaIcon Name="plus" />Add @ActiveSingular</AppButton></div>
            }
        </ItemTemplate>
        <ItemFooterTemplate>
            <span class="modal-action-spacer"></span>
            <AppButton Variant="secondary" Disabled="@(!form.HasChanges)" OnClick="@(_ => ResetDraft())">Cancel</AppButton>
            <BusyButton Variant="primary" Disabled="@(!form.CanSave)" OnClick="form.SaveAsync">Save</BusyButton>
        </ItemFooterTemplate>
        <EmptySelectionTemplate>
            <div class="empty-preview"><FaIcon Name="@ActiveIcon" /><span>Select an entity to edit, or add a new one</span><AppButton Variant="secondary" OnClick="@(_ => AddEntity())"><FaIcon Name="plus" />Add @ActiveSingular</AppButton></div>
        </EmptySelectionTemplate>
    </EntityListEditor>
</ModalShell>
    </ChildContent>
</StatefulForm>

@if (CharacterWizardOpen && SelectedCharacter is not null)
{
    <CharacterWizardModal Character="SelectedCharacter" ExistingCharacters="Characters" OnClose="@(() => CharacterWizardOpen = false)" OnChanged="Changed" />
}

@if (NarratorWizardOpen)
{
    <NarratorWizardModal Profile="@(SelectedNarrator ?? NarratorProfileState.CreateDefault())" OnClose="@(() => NarratorWizardOpen = false)" OnChanged="Changed" />
}

@if (ConfirmDeleteOpen && SelectedId is not null)
{
    <ConfirmDialog Title="@DeleteDialogTitle" Body="@DeleteDialogBody" OnCancel="@(() => ConfirmDeleteOpen = false)" OnConfirm="ConfirmDeleteSelected" />
}

@code {
    string Type = "characters";
    string? SelectedId;
    bool CharacterWizardOpen;
    bool NarratorWizardOpen;
    bool ConfirmDeleteOpen;
    EntityManagerDraftState Draft = EntityManagerDraftState.Empty();
    EntityManagerDraftState Baseline = EntityManagerDraftState.Empty();
    StatefulFormContext<EntityManagerDraftState>? EntityForm;
    const string NarratorId = EntityIds.Narrator;
    sealed record EntityEntry(string Id, string Title, string Subtitle, string ImageId, bool Active, bool IsNarrator = false);
    readonly (string Key, string Label, string Icon)[] EntityTypes =
    [
        ("characters", "Characters", "users"),
        ("locations", "Locations", "map-pin"),
        ("items", "Items", "box"),
        ("timeline", "Timeline", "clock")
    ];

    [Parameter] public string InitialType { get; set; } = "characters";
    [Parameter] public string? InitialId { get; set; }
    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback<(string Type, string Id)> OnSelectEntityImage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    string ActiveTypeLabel => EntityTypes.First(type => type.Key == Type).Label;
    string ActiveIcon => EntityTypes.First(type => type.Key == Type).Icon;
    List<RpCharacter> Characters => Session.Chat.Characters.Items;
    List<RpLocation> Locations => Session.Chat.Locations.Items;
    List<RpItem> Items => Session.Chat.Items.Items;
    List<RpTimelineEntry> Timeline => Session.Chat.Timeline.Items;
    List<GalleryImage> Images => Session.Chat.Images.Items;
    RpCharacter? SelectedCharacter => Draft.Character;
    RpLocation? SelectedLocation => Draft.Location;
    RpItem? SelectedItem => Draft.Item;
    RpTimelineEntry? SelectedTimeline => Draft.Timeline;
    NarratorProfileState? SelectedNarrator => Draft.Narrator;
    Dictionary<string, CharacterVoiceSelection> SelectedNarratorVoiceSelections => SelectedNarrator?.VoiceSelections ?? [];
    ActiveModelSelection? ActiveVoiceModel => Session.ModelSelection.Resolve(AiModelRole.Voice);

    bool HasToggle => Type is "characters" or "locations" or "items";
    string EntityTypeForCurrentTab => Type switch
    {
        "characters" => "character",
        "locations" => "location",
        "items" => "item",
        _ => ""
    };
    string ActiveSingular => ActiveTypeLabel.TrimEnd('s');
    IReadOnlyList<CharacterAvatarItem> TimelineAvatarItems(RpTimelineEntry entry) => entry.CharacterIds
        .Select(id => Characters.FirstOrDefault(character => string.Equals(character.Id, id, StringComparison.Ordinal)))
        .OfType<RpCharacter>()
        .Select(character => CharacterAvatarItem.From(character, ImageFor(character.ImageId)))
        .ToList();
    IReadOnlyList<CharacterAvatarItem> TimelineAvatarItems(string entryId) =>
        Timeline.FirstOrDefault(entry => string.Equals(entry.Id, entryId, StringComparison.Ordinal)) is { } entry
            ? TimelineAvatarItems(entry)
            : [];

    string DeleteDialogTitle => Type switch
    {
        "characters" => "Delete character?",
        "locations" => "Delete location?",
        "items" => "Delete item?",
        _ => "Delete timeline entry?"
    };
    string DeleteDialogBody => Type switch
    {
        "characters" when SelectedCharacter is not null => $"Remove {SelectedCharacter.Name} from the local prototype data.",
        "locations" when SelectedLocation is not null => $"Remove {SelectedLocation.Name}.",
        "items" when SelectedItem is not null => $"Remove {SelectedItem.Name}.",
        "timeline" when SelectedTimeline is not null => $"Remove {SelectedTimeline.Title}.",
        _ => "Remove the selected entry."
    };

    IEnumerable<EntityEntry> Entries => Type switch
    {
        "characters" => new[] { new EntityEntry(NarratorId, "Narrator", NarratorProfileService.VoiceLabel(Session.Chat.NarratorProfile.State.VoicePreset), "", false, true) }
            .Concat(Characters.Select(character => new EntityEntry(character.Id, character.Name, character.Summary, character.ImageId, character.InScene))),
        "locations" => Locations.Select(location => new EntityEntry(location.Id, location.Name, location.Summary, location.ImageId, location.IsActive)),
        "items" => Items.Select(item => new EntityEntry(item.Id, item.Name, item.Summary, item.ImageId, item.InScene)),
        "timeline" => Timeline.Select(entry => new EntityEntry(entry.Id, entry.Title, entry.Date, "", false)),
        _ => []
    };

    protected override void OnInitialized()
    {
        Session.Chat.Characters.Changed += OnStoreChanged;
        Session.Chat.Locations.Changed += OnStoreChanged;
        Session.Chat.Items.Changed += OnStoreChanged;
        Session.Chat.Timeline.Changed += OnStoreChanged;
        Session.Chat.Images.Changed += OnStoreChanged;
        Session.Chat.NarratorProfile.Changed += OnStoreChanged;
        Session.ModelSelection.Changed += OnStoreChanged;
        Session.Providers.Changed += OnStoreChanged;

        Type = InitialType;
        SelectDirect(InitialId ?? Entries.FirstOrDefault()?.Id);
    }

    Task OnStoreChanged()
    {
        if (EntityForm?.HasChanges != true)
            SelectDirect(SelectedId);

        return InvokeAsync(StateHasChanged);
    }

    Task SelectType(string type) => GuardSelectionAsync(() =>
    {
        Type = type;
        SelectDirect(Entries.FirstOrDefault()?.Id);
        return Task.CompletedTask;
    });

    Task SetSelected(string? id) => GuardSelectionAsync(() =>
    {
        SelectDirect(id);
        return Task.CompletedTask;
    });

    Task GuardSelectionAsync(Func<Task> action) => EntityForm?.GuardAsync(action) ?? action();

    void SetEntityForm(StatefulFormContext<EntityManagerDraftState> form) => EntityForm = form;

    void SelectDirect(string? id)
    {
        SelectedId = id ?? "";
        Draft = CreateDraft(Type, SelectedId);
        Baseline = Draft.Clone();
    }

    void ResetDraft() => SelectDirect(SelectedId);

    GalleryImage? ImageFor(string imageId) => Images.FirstOrDefault(image => image.Id == imageId);

    Task SelectEntityImage(string type, string id) => OnSelectEntityImage.InvokeAsync((type, id));

    Task SelectSelectedEntityImage(MouseEventArgs args) => SelectedId is null
        || SelectedId == NarratorId
        ? Task.CompletedTask
        : GuardSelectionAsync(() => SelectEntityImage(Type, SelectedId));

    Task AddEntity() => GuardSelectionAsync(AddEntityDirect);

    async Task AddEntityDirect()
    {
        if (Type == "characters")
        {
            await CreateCharacter();
            return;
        }
        if (Type == "locations")
        {
            var location = await Session.Chat.Locations.AddAsync();
            SelectDirect(location.Id);
        }
        else if (Type == "items")
        {
            var item = await Session.Chat.Items.AddAsync();
            SelectDirect(item.Id);
        }
        else
        {
            var entry = await Session.Chat.Timeline.AddAsync();
            SelectDirect(entry.Id);
        }
    }

    async Task CreateCharacter()
    {
        var character = await Session.Chat.Characters.AddAsync();
        SelectDirect(character.Id);
        CharacterWizardOpen = true;
    }

    Task ToggleActive(string id) => GuardSelectionAsync(() => ToggleActiveDirect(id));

    async Task ToggleActiveDirect(string id)
    {
        if (Type == "characters")
            await Session.Chat.Characters.ToggleInSceneAsync(id);
        else if (Type == "locations")
            await Session.Chat.Locations.SetActiveAsync(id);
        else if (Type == "items")
            await Session.Chat.Items.ToggleInSceneAsync(id);
    }

    int CountFor(string type) => type switch
    {
        "characters" => Characters.Count,
        "locations" => Locations.Count,
        "items" => Items.Count,
        "timeline" => Timeline.Count,
        _ => 0
    };

    async Task DeleteSelected()
    {
        if (SelectedId is null)
            return;

        if (Type == "characters")
            await Session.Chat.Characters.DeleteAsync(SelectedId);
        else if (Type == "locations")
            await Session.Chat.Locations.DeleteAsync(SelectedId);
        else if (Type == "items")
            await Session.Chat.Items.DeleteAsync(SelectedId);
        else
            await Session.Chat.Timeline.DeleteAsync(SelectedId);

        SelectDirect(Entries.FirstOrDefault()?.Id);
    }

    async Task ConfirmDeleteSelected()
    {
        ConfirmDeleteOpen = false;
        CharacterWizardOpen = false;
        NarratorWizardOpen = false;
        await GuardSelectionAsync(DeleteSelected);
    }

    Task Changed()
    {
        EntityForm?.NotifyChanged();
        return Task.CompletedTask;
    }

    async Task SaveDraft()
    {
        if (SelectedId == NarratorId && Draft.Narrator is not null && Session.ActiveChat.Current is not null)
        {
            Session.ActiveChat.Current.NarratorProfile = SessionCloner.Clone(Draft.Narrator);
            await Session.Chat.NarratorProfile.MarkChangedAsync();
            SelectDirect(SelectedId);
            return;
        }

        if (Type == "characters" && Draft.Character is not null)
        {
            ReplaceById(Characters, Draft.Character.Id, SessionCloner.Clone(Draft.Character));
            await Session.Chat.Characters.MarkChangedAsync(Draft.Character.Id);
        }
        else if (Type == "locations" && Draft.Location is not null)
        {
            ReplaceById(Locations, Draft.Location.Id, SessionCloner.Clone(Draft.Location));
            await Session.Chat.Locations.MarkChangedAsync(Draft.Location.Id);
        }
        else if (Type == "items" && Draft.Item is not null)
        {
            ReplaceById(Items, Draft.Item.Id, SessionCloner.Clone(Draft.Item));
            await Session.Chat.Items.MarkChangedAsync(Draft.Item.Id);
        }
        else if (Type == "timeline" && Draft.Timeline is not null)
        {
            ReplaceById(Timeline, Draft.Timeline.Id, SessionCloner.Clone(Draft.Timeline));
            await Session.Chat.Timeline.MarkChangedAsync(Draft.Timeline.Id);
        }

        SelectDirect(SelectedId);
    }

    EntityManagerDraftState CreateDraft(string type, string selectedId)
    {
        if (type == "characters" && selectedId == NarratorId)
            return EntityManagerDraftState.ForNarrator(Session.Chat.NarratorProfile.State);

        if (type == "characters" && Characters.FirstOrDefault(character => character.Id == selectedId) is { } character)
            return EntityManagerDraftState.ForCharacter(character);

        if (type == "locations" && Locations.FirstOrDefault(location => location.Id == selectedId) is { } location)
            return EntityManagerDraftState.ForLocation(location);

        if (type == "items" && Items.FirstOrDefault(item => item.Id == selectedId) is { } item)
            return EntityManagerDraftState.ForItem(item);

        if (type == "timeline" && Timeline.FirstOrDefault(entry => entry.Id == selectedId) is { } entry)
            return EntityManagerDraftState.ForTimeline(entry);

        return EntityManagerDraftState.Empty(type);
    }

    static void ReplaceById<TItem>(List<TItem> items, string id, TItem replacement)
        where TItem : class
    {
        var index = items.FindIndex(item => ItemId(item) == id);
        if (index >= 0)
            items[index] = replacement;
    }

    static string ItemId<TItem>(TItem item) => item switch
    {
        RpCharacter character => character.Id,
        RpLocation location => location.Id,
        RpItem storyItem => storyItem.Id,
        RpTimelineEntry entry => entry.Id,
        _ => ""
    };

    public void Dispose()
    {
        Session.Chat.Characters.Changed -= OnStoreChanged;
        Session.Chat.Locations.Changed -= OnStoreChanged;
        Session.Chat.Items.Changed -= OnStoreChanged;
        Session.Chat.Timeline.Changed -= OnStoreChanged;
        Session.Chat.Images.Changed -= OnStoreChanged;
        Session.Chat.NarratorProfile.Changed -= OnStoreChanged;
        Session.ModelSelection.Changed -= OnStoreChanged;
        Session.Providers.Changed -= OnStoreChanged;
    }
}
