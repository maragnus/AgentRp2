<CharacterRelationshipSummaryList Items="Relationships" />

@code {
    [Parameter] public RpChatDocument? Document { get; set; }
    [Parameter] public RpCharacter Character { get; set; } = new();

    string SourceName => string.IsNullOrWhiteSpace(Character.Name) ? "This character" : Character.Name;

    IReadOnlyList<CharacterRelationshipSummaryItem> Relationships
    {
        get
        {
            if (Document is null || string.IsNullOrWhiteSpace(Character.Id))
                return [];

            var characterNames = Document.Characters.ToDictionary(
                character => character.Id,
                character => string.IsNullOrWhiteSpace(character.Name) ? "Unnamed" : character.Name);

            return CharacterRelationshipGraph.ViewsForCharacter(Document, Character.Id, characterNames)
                .Where(relationship => !string.IsNullOrWhiteSpace(relationship.TargetCharacterName))
                .OrderBy(relationship => relationship.TargetCharacterName, StringComparer.CurrentCultureIgnoreCase)
                .Select(relationship => new CharacterRelationshipSummaryItem
                {
                    Id = relationship.Relationship.Id,
                    Title = relationship.TargetCharacterName,
                    SourceName = SourceName,
                    TargetName = relationship.TargetCharacterName,
                    RelationshipTypes = relationship.RelationshipTypes,
                    PrivateTensions = relationship.PrivateTensions,
                    PublicDynamic = relationship.PublicDynamic,
                    HowSourceSeesTarget = relationship.HowSourceSeesTarget,
                    HowTargetSeesSource = relationship.HowTargetSeesSource
                })
                .ToList();
        }
    }
}
