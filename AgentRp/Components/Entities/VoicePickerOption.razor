<PickerOptionButton Title="@DisplayName"
                    Selected="@Selected"
                    Disabled="@Selected"
                    TooltipText="@TooltipText"
                    AriaLabel="@TooltipText"
                    OnClick="Select">
    <DetailContent>
        @if (Tags.Count > 0)
        {
            <span class="popover-option-tags">
                @foreach (var tag in Tags)
                {
                    <span @key="@($"{Voice.Id}:{tag}")">@tag</span>
                }
            </span>
        }
    </DetailContent>
</PickerOptionButton>

@code {
    [Parameter] public AiProviderVoice Voice { get; set; } = new();
    [Parameter] public IReadOnlyList<string> Tags { get; set; } = [];
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<AiProviderVoice> OnSelected { get; set; }

    string DisplayName => AiProviderVoiceDisplayRules.DisplayVoice(Voice);
    string TooltipText => Selected ? $"{DisplayName} is selected" : $"Use {DisplayName}";

    Task Select() => OnSelected.InvokeAsync(Voice);
}
