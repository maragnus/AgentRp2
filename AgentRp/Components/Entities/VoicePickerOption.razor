<BusyButton Variant="ghost"
            Size="sm"
            Class="@CssClass"
            Disabled="@Selected"
            Title="@Title"
            AriaLabel="@Title"
            OnClick="Select">
    <strong>@DisplayName</strong>
    @if (Tags.Count > 0)
    {
        <span class="voice-picker-tag-cloud">
            @foreach (var tag in Tags)
            {
                <span @key="@($"{Voice.Id}:{tag}")">@tag</span>
            }
        </span>
    }
    @if (Selected)
    {
        <FaIcon Name="check" />
    }
</BusyButton>

@code {
    [Parameter] public AiProviderVoice Voice { get; set; } = new();
    [Parameter] public IReadOnlyList<string> Tags { get; set; } = [];
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<AiProviderVoice> OnSelected { get; set; }

    string DisplayName => AiProviderVoiceDisplayRules.DisplayVoice(Voice);
    string Title => Selected ? $"{DisplayName} is selected" : $"Use {DisplayName}";
    string CssClass => $"voice-picker-option-row {(Selected ? "is-selected" : "")}";

    Task Select() => OnSelected.InvokeAsync(Voice);
}
