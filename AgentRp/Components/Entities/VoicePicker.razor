@inject IElevenLabsVoiceCatalogService VoiceCatalogService

<div class="@CssClass" title="@Title">
    @if (Compact)
    {
        <div class="voice-picker-inline">
            <ActiveModelPicker Role="AiModelRole.Voice"
                               AnchorClass=""
                               PopoverClass="sidebar-model-popover voice-model-popover"
                               DebugName="@($"VoicePicker model picker for {OwnerName}")"
                               ModelSelections="ModelSelections"
                               ModelSelectionsChanged="ModelSelectionsChanged">
                <TriggerContent Context="modelPicker">
                    <AppButton Variant="secondary"
                               Size="sm"
                               Class="@ProviderButtonClass(modelPicker.IsOpen)"
                               TooltipText="@ModelPickerTitle"
                               OnClick="@(_ => modelPicker.Toggle())">
                        <span class="voice-picker-provider-glyph">
                            @if (modelPicker.ActiveModel is null)
                            {
                                <FaIcon Name="waveform-lines" />
                            }
                            else
                            {
                                <ProviderBadge Type="@modelPicker.ActiveModel.Provider.Type" Size="20" />
                            }
                        </span>
                        <FaIcon Name="chevron-down" />
                    </AppButton>
                </TriggerContent>
            </ActiveModelPicker>
            <VoicePickerMenu VoiceSelections="VoiceSelections"
                             ActiveVoiceModel="ActiveVoiceModel"
                             Voices="AvailableVoices"
                             Compact="Compact"
                             OwnerName="@OwnerName"
                             OnChanged="OnChanged"
                             OnBookmarkChanged="SetBookmarked" />
            @if (CanOpenCatalog)
            {
                <AppButton Variant="secondary"
                           Size="sm"
                           Class="voice-picker-catalog-button"
                           TooltipText="Open ElevenLabs voice catalog"
                           AriaLabel="Open ElevenLabs voice catalog"
                           OnClick="@(_ => VoiceCatalogOpen = true)">
                    <FaIcon Name="book-open" />
                </AppButton>
            }
            @if (SelectedVoice is not null && ActiveVoiceModel is not null)
            {
                <TtsSampleButton Provider="@ActiveVoiceModel.Provider"
                                 Model="@ActiveVoiceModel.Model"
                                 Voice="@SelectedVoice"
                                 PreviewUrl="@SelectedVoice.PreviewUrl" />
            }
        </div>
    }
    else
    {
        <div class="voice-picker-stack">
            <FieldRow Label="@ModelLabel">
                <VoicePickerMenu VoiceSelections="VoiceSelections"
                                 ActiveVoiceModel="ActiveVoiceModel"
                                 Voices="AvailableVoices"
                                 Compact="Compact"
                                 OwnerName="@OwnerName"
                                 OnChanged="OnChanged"
                                 OnBookmarkChanged="SetBookmarked" />
                @if (CanOpenCatalog)
                {
                    <AppButton Variant="secondary"
                               Size="sm"
                               Class="voice-picker-catalog-button"
                               OnClick="@(_ => VoiceCatalogOpen = true)">
                        <FaIcon Name="book-open" />Voice Catalog
                    </AppButton>
                }
            </FieldRow>
        </div>
    }
</div>

@if (VoiceCatalogOpen && ActiveVoiceModel is not null)
{
    <ElevenLabsVoiceCatalogModal Provider="@ActiveVoiceModel.Provider"
                                 PreviewModel="@ActiveVoiceModel.Model"
                                 OnChanged="ReloadBookmarkedVoices"
                                 OnClose="CloseCatalog" />
}

@code {
    List<AiProviderVoice> BookmarkedCatalogVoices = [];
    string LoadedCatalogKey = "";
    bool VoiceCatalogOpen;

    [Parameter] public Dictionary<string, CharacterVoiceSelection> VoiceSelections { get; set; } = [];
    [Parameter] public ActiveModelSelection? ActiveVoiceModel { get; set; }
    [Parameter] public ActiveModelSelectionsState? ModelSelections { get; set; }
    [Parameter] public EventCallback<ActiveModelSelectionsState> ModelSelectionsChanged { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string OwnerName { get; set; } = "entity";
    [Parameter] public EventCallback OnChanged { get; set; }

    string CssClass => $"voice-picker {(Compact ? "is-compact" : "")}";
    string ModelKey => ActiveVoiceModel?.Key ?? "";
    string SelectedVoiceId => !string.IsNullOrWhiteSpace(ModelKey)
        && VoiceSelections.TryGetValue(ModelKey, out var selection)
        ? selection.VoiceId
        : "";
    IReadOnlyList<AiProviderVoice> AvailableVoices => ActiveVoiceModel is null
        ? []
        : IsElevenLabs
            ? AiProviderVoiceMergeRules.MergeProviderAndCatalogVoices(ActiveVoiceModel.Model.Voices, BookmarkedCatalogVoices)
            : ActiveVoiceModel.Model.Voices;
    AiProviderVoice? SelectedVoice => AvailableVoices.FirstOrDefault(voice => voice.Id == SelectedVoiceId);
    string SelectedVoiceName => SelectedVoice is null ? "No voice" : AiProviderVoiceDisplayRules.DisplayVoice(SelectedVoice);
    bool IsElevenLabs => string.Equals(ActiveVoiceModel?.Provider.Type, "elevenlabs", StringComparison.OrdinalIgnoreCase);
    bool CanOpenCatalog => IsElevenLabs && ActiveVoiceModel is not null;
    string ModelPickerTitle => ActiveVoiceModel is null
        ? $"Choose active voice model for {OwnerName}."
        : $"Change active voice model for {OwnerName}. Current model is {ModelLabel}.";
    string ModelLabel => ActiveVoiceModel is null ? "No voice model" : DisplayModel(ActiveVoiceModel);
    string Title => ActiveVoiceModel is null
        ? $"No voice model selected for {OwnerName}."
        : $"Speech voice for {OwnerName} using {ModelLabel}.";

    string ProviderButtonClass(bool open) => string.Join(" ", new[]
    {
        "voice-picker-provider-button",
        open ? "is-open" : null
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    protected override async Task OnParametersSetAsync()
    {
        var key = IsElevenLabs ? ActiveVoiceModel?.Key ?? "" : "";
        if (key == LoadedCatalogKey)
            return;

        LoadedCatalogKey = key;
        BookmarkedCatalogVoices.Clear();
        if (!string.IsNullOrWhiteSpace(key))
            await ReloadBookmarkedVoices();
    }

    async Task ReloadBookmarkedVoices()
    {
        BookmarkedCatalogVoices = (await VoiceCatalogService.LoadBookmarkedVoicesAsync()).ToList();
    }

    async Task SetBookmarked((string VoiceId, bool Bookmarked) change)
    {
        await VoiceCatalogService.SetBookmarkedAsync(change.VoiceId, change.Bookmarked);
        await ReloadBookmarkedVoices();
    }

    async Task CloseCatalog()
    {
        VoiceCatalogOpen = false;
        await ReloadBookmarkedVoices();
    }

    static string DisplayModel(ActiveModelSelection selection)
    {
        var model = string.IsNullOrWhiteSpace(selection.Model.DisplayName) ? selection.Model.Id : selection.Model.DisplayName;
        return $"{selection.Provider.Name} · {model}";
    }
}
