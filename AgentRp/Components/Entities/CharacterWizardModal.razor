<StatefulForm Model="@DraftState" Baseline="@Baseline" OnSave="Save" OnClose="OnClose" ContextChanged="SetForm" RenderFormElement="false">
<ChildContent Context="form">
<ModalShell Title="@WizardTitle" Subtitle="Guided Profile" MaxWidth="960px" Height="680px" BodyClass="is-flush" OnClose="form.RequestCloseAsync">
    <ModalSplitLayout Height="100%" RailWidth="210px" RailClass="character-wizard-rail">
            <RailHeader>
                <div class="character-wizard-profile">
                    <Avatar Name="@(string.IsNullOrWhiteSpace(Draft.Name) ? "?" : Draft.Name)" Size="52" />
                    <span class="character-wizard-profile-name @(string.IsNullOrWhiteSpace(Draft.Name) ? "is-empty" : "")">
                        @(string.IsNullOrWhiteSpace(Draft.Name) ? "Unnamed" : Draft.Name)
                    </span>
                    @if (Draft.SceneRoles.Count > 0)
                    {
                        <div class="character-wizard-role-list">
                            @foreach (var roleId in Draft.SceneRoles)
                            {
                                var role = Find(SceneRoles, roleId);
                                if (role is not null)
                                {
                                    <span @key="role.Id" class="character-wizard-mini-role">@role.Label</span>
                                }
                        }
                    </div>
                }
                </div>
            </RailHeader>
            <RailContent>
                @for (var i = 0; i < Steps.Length; i++)
                {
                    var index = i;
                    var step = Steps[index];
                    var done = StepDone(index);
                    var accessible = index <= Step + 1 || done;
                    <SidebarTabRow @key="step.Id"
                                   Title="@step.Label"
                                   Summary="@step.Sub"
                                   Active="@(Step == index)"
                                   Done="@done"
                                   Dirty="@StepDirty(index)"
                                   Locked="@(!accessible)"
                                   Disabled="@(!accessible)"
                                   Class="character-wizard-step"
                                   OnClick="@(_ => GoToStep(index))">
                        <IndexContent>
                            @if (done && Step != index)
                            {
                                <FaIcon Name="check" />
                            }
                            else
                            {
                                @(index + 1)
                            }
                        </IndexContent>
                    </SidebarTabRow>
                }
            </RailContent>
            <RailFooter>
                <div class="character-wizard-progress">
                    <div>
                        <span>Completeness</span>
                        <span>@DoneCount/@Steps.Length</span>
                    </div>
                    <ProgressBar Value="@DoneCount" Max="@Steps.Length" Class="character-wizard-progress-track" />
                </div>
            </RailFooter>
            <MainContent>
                <ModalStackLayout BodyClass="character-wizard-step-content">
                    <Header>
                        <ModalPaneHeader Class="character-wizard-main-head">
                            <h3>@Steps[Step].Label</h3>
                            <p>@Steps[Step].Sub</p>
                        </ModalPaneHeader>
                    </Header>
                    <ChildContent>
                    @if (Step == 0)
                    {
                        <div class="character-wizard-step-stack">
                            <FormSection Title="Name" DirtyPath="@CharacterPath(nameof(RpCharacter.Name))">
                                <AppInput Class="character-wizard-name-input"
                                          Placeholder="Character name..."
                                          Value="@Draft.Name"
                                          ValueChanged="value => Draft.Name = value"
                                          DirtyPath="@CharacterPath(nameof(RpCharacter.Name))"
                                          UpdateMode="TextUpdateMode.Change" />
                            </FormSection>
                            <FormSection Title="Summary" Hint="— one sentence, optional" DirtyPath="@CharacterPath(nameof(RpCharacter.Summary))">
                                <AppTextarea Class="character-wizard-textarea"
                                             Rows="2"
                                             Placeholder="Who is this character in a sentence?"
                                             Value="@Draft.Summary"
                                             ValueChanged="value => Draft.Summary = value"
                                             DirtyPath="@CharacterPath(nameof(RpCharacter.Summary))"
                                             UpdateMode="TextUpdateMode.Change" />
                            </FormSection>
                            <Section Title="Pronouns" DirtyPath="@CharacterPath(nameof(RpCharacter.Pronouns))">
                                <div class="character-wizard-chip-list">
                                    @foreach (var pronoun in PronounOptions)
                                    {
                                        var selected = Draft.Pronouns.Contains(pronoun.Id);
                                        <SelectableButton @key="pronoun.Id" TooltipText="@pronoun.Hover" Class="@($"character-wizard-chip {(selected ? "is-selected" : "")}")" OnClick="@(_ => ToggleText(Draft.Pronouns, pronoun.Id))">
                                            @pronoun.Label
                                        </SelectableButton>
                                    }
                                </div>
                            </Section>
                            <Section Title="Scene Roles" Hint="— what function they serve" Count="Draft.SceneRoles.Count" MaxCount="CharacterProfileRules.MaxSceneRoles" DirtyPath="@CharacterPath(nameof(RpCharacter.SceneRoles))">
                                <div class="character-wizard-chip-list">
                                    @foreach (var role in SceneRoles)
                                    {
                                        var selected = Draft.SceneRoles.Contains(role.Id);
                                        <SelectableButton @key="role.Id" TooltipText="@role.Hover" Class="@($"character-wizard-chip {(selected ? "is-selected" : "")}")" Disabled="@(!selected && Draft.SceneRoles.Count >= CharacterProfileRules.MaxSceneRoles)" OnClick="@(_ => ToggleLimited(Draft.SceneRoles, role.Id, CharacterProfileRules.MaxSceneRoles))">
                                            @role.Label
                                        </SelectableButton>
                                    }
                                </div>
                            </Section>
                        </div>
                    }
                    else if (Step == 1)
                    {
                        <StatefulFormScope PathPrefix="@nameof(CharacterWizardDraftState.Character)">
                            <CharacterAppearanceEditor Character="Draft" Library="TraitLibrary" />
                        </StatefulFormScope>
                    }
                    else if (Step == 2)
                    {
                        <div class="character-wizard-personality-intro">
                            <p>Pick @CharacterProfileRules.RecommendedMinTraits to @CharacterProfileRules.MaxTraits total. Hover any trait for a description.</p>
                            <span class="character-wizard-count-pill @(Draft.Traits.Count >= CharacterProfileRules.RecommendedMinTraits ? "is-ready" : "")">@Draft.Traits.Count / @CharacterProfileRules.MaxTraits</span>
                        </div>
                        <div class="character-wizard-trait-section-list">
                            @foreach (var group in TraitCategories)
                            {
                                var selectedCount = group.Items.Count(item => Draft.Traits.Contains(item.Id));
                                <Section @key="group.Name" Title="@group.Name" Count="@selectedCount" Class="character-wizard-trait-group" DirtyPath="@CharacterPath(nameof(RpCharacter.Traits))">
                                    <div class="character-wizard-chip-list">
                                        @foreach (var trait in group.Items)
                                        {
                                            var selected = Draft.Traits.Contains(trait.Id);
                                            <SelectableButton @key="trait.Id" TooltipText="@trait.Hover" Class="@($"character-wizard-chip {(selected ? "is-selected" : "")}")" Disabled="@(!selected && Draft.Traits.Count >= CharacterProfileRules.MaxTraits)" OnClick="@(_ => ToggleLimited(Draft.Traits, trait.Id, CharacterProfileRules.MaxTraits))">
                                                @trait.Label
                                            </SelectableButton>
                                        }
                                    </div>
                                </Section>
                            }
                        </div>
                    }
                    else if (Step == 3)
                    {
                        <p class="character-wizard-help">Pick one for each. These four fields give the model emotional logic to draw from.</p>
                        <div class="character-wizard-step-stack is-roomy">
                            <CharacterOptionGrid Title="Core Drive" Hint="The engine behind every choice." Columns="3" Items="CoreDrives" Selected="@Draft.CoreDrive" DirtyPath="@CharacterPath(nameof(RpCharacter.CoreDrive))" OnSelect="@(id => SetSingle(nameof(Draft.CoreDrive), id))" />
                            <CharacterOptionGrid Title="Core Fear" Hint="What they most want to avoid." Columns="3" Items="CoreFears" Selected="@Draft.CoreFear" DirtyPath="@CharacterPath(nameof(RpCharacter.CoreFear))" OnSelect="@(id => SetSingle(nameof(Draft.CoreFear), id))" />
                            <CharacterOptionGrid Title="Surface Mask" Hint="How they present to the world." Columns="2" Items="SurfaceMasks" Selected="@Draft.SurfaceMask" DirtyPath="@CharacterPath(nameof(RpCharacter.SurfaceMask))" OnSelect="@(id => SetSingle(nameof(Draft.SurfaceMask), id))" />
                            <CharacterOptionGrid Title="Hidden Truth" Hint="What quietly drives them underneath." Columns="2" Items="HiddenTruths" Selected="@Draft.HiddenTruth" DirtyPath="@CharacterPath(nameof(RpCharacter.HiddenTruth))" OnSelect="@(id => SetSingle(nameof(Draft.HiddenTruth), id))" />
                        </div>
                    }
                    else if (Step == 4)
                    {
                        <p class="character-wizard-help">Pick one per category. Voice and behavior make characters feel distinct on the page.</p>
                        <div class="character-wizard-step-stack is-roomy">
                            <CharacterOptionGrid Title="Sentence Style" Hint="How they construct speech." Columns="2" Items="SentenceStyles" Selected="@Draft.SentenceStyle" DirtyPath="@CharacterPath(nameof(RpCharacter.SentenceStyle))" OnSelect="@(id => SetSingle(nameof(Draft.SentenceStyle), id))" />
                            <CharacterOptionGrid Title="Honesty Style" Hint="How direct vs. evasive they are." Columns="2" Items="HonestyStyles" Selected="@Draft.HonestyStyle" DirtyPath="@CharacterPath(nameof(RpCharacter.HonestyStyle))" OnSelect="@(id => SetSingle(nameof(Draft.HonestyStyle), id))" />
                            <CharacterOptionGrid Title="Emotional Leakage" Hint="How feelings escape their control." Columns="2" Items="EmotionalLeakages" Selected="@Draft.EmotionalLeakage" DirtyPath="@CharacterPath(nameof(RpCharacter.EmotionalLeakage))" OnSelect="@(id => SetSingle(nameof(Draft.EmotionalLeakage), id))" />
                            <CharacterOptionGrid Title="Action Fingerprint" Hint="Their physical signature in a scene." Columns="2" Items="ActionFingerprints" Selected="@Draft.ActionFingerprint" DirtyPath="@CharacterPath(nameof(RpCharacter.ActionFingerprint))" OnSelect="@(id => SetSingle(nameof(Draft.ActionFingerprint), id))" />
                            <CharacterOptionGrid Title="Stress Pattern" Hint="How behavior escalates under pressure." Columns="2" Items="StressPatterns" Selected="@Draft.StressPattern" DirtyPath="@CharacterPath(nameof(RpCharacter.StressPattern))" OnSelect="@(id => SetSingle(nameof(Draft.StressPattern), id))" />
                        </div>
                    }
                    else if (Step == 5)
                    {
                        <div class="character-wizard-step-stack is-roomy">
                            <CharacterOptionGrid Title="Soft Spots" Hint="— what makes them open up" Columns="2" Items="SoftSpots" MultiValues="Draft.SoftSpots" DirtyPath="@CharacterPath(nameof(RpCharacter.SoftSpots))" Max="CharacterProfileRules.MaxSoftSpots" OnToggle="@(id => ToggleLimited(Draft.SoftSpots, id, CharacterProfileRules.MaxSoftSpots))" />
                            <CharacterOptionGrid Title="Avoid Patterns" Hint="— what the model must not do" Columns="2" Items="AvoidPatterns" MultiValues="Draft.AvoidPatterns" DirtyPath="@CharacterPath(nameof(RpCharacter.AvoidPatterns))" Max="CharacterProfileRules.MaxAvoidPatterns" OnToggle="@(id => ToggleLimited(Draft.AvoidPatterns, id, CharacterProfileRules.MaxAvoidPatterns))" />
                        </div>
                    }
                    else
                    {
                        <CharacterRelationshipsEditor Character="Draft"
                                                      ExistingCharacters="ExistingCharacters"
                                                      Relationships="DraftState.Relationships"
                                                      BaselineRelationships="Baseline.Relationships"
                                                      Library="TraitLibrary"
                                                      OnChanged="NotifyFormChanged" />
                    }
                    </ChildContent>

                <Footer>
                    @if (Step > 0)
                    {
                        <AppButton Variant="secondary" Size="sm" OnClick="Back"><FaIcon Name="chevron-left" />Back</AppButton>
                    }
                    <span class="modal-action-spacer"></span>
                    @if (Step == Steps.Length - 1)
                    {
                        <BusyButton Variant="primary" Size="sm" Disabled="@string.IsNullOrWhiteSpace(Draft.Name)" OnClick="@(() => Complete(form))"><FaIcon Name="check" />Done</BusyButton>
                    }
                    else
                    {
                        <AppButton Variant="primary" Size="sm" Disabled="@(!CanNext)" OnClick="Next">Next<FaIcon Name="chevron-right" /></AppButton>
                        @if (IsComplete)
                        {
                            <BusyButton Variant="secondary" Size="sm" OnClick="@(() => Complete(form))"><FaIcon Name="check" />Done</BusyButton>
                        }
                    }
                </Footer>
                </ModalStackLayout>
            </MainContent>
        </ModalSplitLayout>
</ModalShell>
</ChildContent>
</StatefulForm>

@code {
    int Step;
    string LoadedCharacterId = "";
    CharacterWizardDraftState DraftState = new();
    CharacterWizardDraftState Baseline = new();
    StatefulFormContext<CharacterWizardDraftState>? Form;

    [Parameter] public RpCharacter Character { get; set; } = new();
    [Parameter] public List<RpCharacter> ExistingCharacters { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;

    RpCharacter Draft => DraftState.Character;
    string WizardTitle => string.IsNullOrWhiteSpace(Draft.Name) ? "New Character" : Draft.Name;
    CharacterTraitLibraryState TraitLibrary => Session.Chat.CharacterTraitLibrary.State;
    IReadOnlyList<CharacterOption> PronounOptions => CharacterProfileRules.PronounOptions;
    IReadOnlyList<CharacterOption> SceneRoles => TraitLibrary.SceneRoles;
    IReadOnlyList<CharacterTraitGroupState> TraitCategories => TraitLibrary.TraitCategories;
    IReadOnlyList<CharacterOption> CoreDrives => TraitLibrary.CoreDrives;
    IReadOnlyList<CharacterOption> CoreFears => TraitLibrary.CoreFears;
    IReadOnlyList<CharacterOption> SurfaceMasks => TraitLibrary.SurfaceMasks;
    IReadOnlyList<CharacterOption> HiddenTruths => TraitLibrary.HiddenTruths;
    IReadOnlyList<CharacterOption> SentenceStyles => TraitLibrary.SentenceStyles;
    IReadOnlyList<CharacterOption> HonestyStyles => TraitLibrary.HonestyStyles;
    IReadOnlyList<CharacterOption> EmotionalLeakages => TraitLibrary.EmotionalLeakages;
    IReadOnlyList<CharacterOption> ActionFingerprints => TraitLibrary.ActionFingerprints;
    IReadOnlyList<CharacterOption> StressPatterns => TraitLibrary.StressPatterns;
    IReadOnlyList<CharacterOption> SoftSpots => TraitLibrary.SoftSpots;
    IReadOnlyList<CharacterOption> AvoidPatterns => TraitLibrary.AvoidPatterns;

    static readonly WizardStep[] Steps =
    [
        new("concept", "Concept", "Name & pronouns"),
        new("appearance", "Appearance", "How they look"),
        new("personality", "Personality", "Baseline traits"),
        new("engine", "Inner Engine", "Drives & fears"),
        new("voice", "Voice", "How they speak"),
        new("limits", "Limits", "Soft spots & avoids"),
        new("relationships", "Relationships", "Who they know"),
    ];

    int DoneCount => Enumerable.Range(0, Steps.Length).Count(StepDone);
    bool CanNext => Step != 0 || !string.IsNullOrWhiteSpace(Draft.Name);
    bool IsComplete => DoneCount == Steps.Length;

    protected override void OnParametersSet()
    {
        if (LoadedCharacterId == Character.Id)
            return;

        LoadedCharacterId = Character.Id;
        var document = Session.ActiveChat.Current ?? new();
        DraftState = CharacterWizardDraftState.From(Character, document);
        Baseline = StatefulFormSnapshot.Clone(DraftState);
    }

    bool StepDone(int step) => step switch
    {
        0 => !string.IsNullOrWhiteSpace(Draft.Name),
        1 => CharacterAppearanceFormatter.HasStructuredAppearance(Draft.AppearanceProfile) || !string.IsNullOrWhiteSpace(Draft.Appearance),
        2 => Draft.Traits.Count >= 1,
        3 => !string.IsNullOrWhiteSpace(Draft.CoreDrive) || !string.IsNullOrWhiteSpace(Draft.CoreFear) || !string.IsNullOrWhiteSpace(Draft.SurfaceMask) || !string.IsNullOrWhiteSpace(Draft.HiddenTruth),
        4 => !string.IsNullOrWhiteSpace(Draft.SentenceStyle) || !string.IsNullOrWhiteSpace(Draft.StressPattern),
        5 => Draft.SoftSpots.Count > 0 || Draft.AvoidPatterns.Count > 0,
        _ => true
    };

    bool StepDirty(int step) => step switch
    {
        0 => Form?.IsAnyPathDirty(CharacterPath(nameof(RpCharacter.Name)), CharacterPath(nameof(RpCharacter.Summary)), CharacterPath(nameof(RpCharacter.Pronouns)), CharacterPath(nameof(RpCharacter.SceneRoles))) == true,
        1 => Form?.IsAnyPathDirty(CharacterPath(nameof(RpCharacter.Appearance)), CharacterPath(nameof(RpCharacter.AppearanceProfile))) == true,
        2 => Form?.IsPathDirty(CharacterPath(nameof(RpCharacter.Traits))) == true,
        3 => Form?.IsAnyPathDirty(CharacterPath(nameof(RpCharacter.CoreDrive)), CharacterPath(nameof(RpCharacter.CoreFear)), CharacterPath(nameof(RpCharacter.SurfaceMask)), CharacterPath(nameof(RpCharacter.HiddenTruth))) == true,
        4 => Form?.IsAnyPathDirty(CharacterPath(nameof(RpCharacter.SentenceStyle)), CharacterPath(nameof(RpCharacter.HonestyStyle)), CharacterPath(nameof(RpCharacter.EmotionalLeakage)), CharacterPath(nameof(RpCharacter.ActionFingerprint)), CharacterPath(nameof(RpCharacter.StressPattern))) == true,
        5 => Form?.IsAnyPathDirty(CharacterPath(nameof(RpCharacter.SoftSpots)), CharacterPath(nameof(RpCharacter.AvoidPatterns))) == true,
        _ => Form?.IsPathDirty(nameof(CharacterWizardDraftState.Relationships)) == true
    };

    void ToggleLimited(List<string> values, string value, int max)
    {
        if (values.Remove(value))
        {
            Form?.NotifyChanged();
            return;
        }

        if (values.Count < max)
            values.Add(value);

        Form?.NotifyChanged();
    }

    void ToggleText(List<string> values, string value)
    {
        if (!values.Remove(value))
            values.Add(value);

        Form?.NotifyChanged();
    }

    void SetSingle(string property, string value)
    {
        var current = property switch
        {
            nameof(Draft.CoreDrive) => Draft.CoreDrive,
            nameof(Draft.CoreFear) => Draft.CoreFear,
            nameof(Draft.SurfaceMask) => Draft.SurfaceMask,
            nameof(Draft.HiddenTruth) => Draft.HiddenTruth,
            nameof(Draft.SentenceStyle) => Draft.SentenceStyle,
            nameof(Draft.HonestyStyle) => Draft.HonestyStyle,
            nameof(Draft.EmotionalLeakage) => Draft.EmotionalLeakage,
            nameof(Draft.ActionFingerprint) => Draft.ActionFingerprint,
            nameof(Draft.StressPattern) => Draft.StressPattern,
            _ => ""
        };
        var next = current == value ? "" : value;

        switch (property)
        {
            case nameof(Draft.CoreDrive):
                Draft.CoreDrive = next;
                break;
            case nameof(Draft.CoreFear):
                Draft.CoreFear = next;
                break;
            case nameof(Draft.SurfaceMask):
                Draft.SurfaceMask = next;
                break;
            case nameof(Draft.HiddenTruth):
                Draft.HiddenTruth = next;
                break;
            case nameof(Draft.SentenceStyle):
                Draft.SentenceStyle = next;
                break;
            case nameof(Draft.HonestyStyle):
                Draft.HonestyStyle = next;
                break;
            case nameof(Draft.EmotionalLeakage):
                Draft.EmotionalLeakage = next;
                break;
            case nameof(Draft.ActionFingerprint):
                Draft.ActionFingerprint = next;
                break;
            case nameof(Draft.StressPattern):
                Draft.StressPattern = next;
                break;
        }

        Form?.NotifyChanged();
    }

    Task GoToStep(int step)
    {
        Step = step;
        return Task.CompletedTask;
    }

    Task Back()
    {
        if (Step > 0)
            Step--;

        return Task.CompletedTask;
    }

    Task Next()
    {
        if (Step < Steps.Length - 1)
            Step++;

        return Task.CompletedTask;
    }

    async Task Save()
    {
        if (Session.ActiveChat.Current is not { } document)
            return;

        DraftState.ApplyTo(Character, document);
        Baseline = StatefulFormSnapshot.Clone(DraftState);
        await OnChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    Task Complete(StatefulFormContext<CharacterWizardDraftState> form) =>
        form.HasChanges ? form.SaveAsync() : OnClose.InvokeAsync();

    void SetForm(StatefulFormContext<CharacterWizardDraftState> form) => Form = form;

    Task NotifyFormChanged()
    {
        Form?.NotifyChanged();
        return Task.CompletedTask;
    }

    static string CharacterPath(string property) => $"{nameof(CharacterWizardDraftState.Character)}.{property}";

    static CharacterOption? Find(IEnumerable<CharacterOption> items, string id) => items.FirstOrDefault(item => item.Id == id);

    public sealed record WizardStep(string Id, string Label, string Sub);
}
