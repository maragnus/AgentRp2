<ModalShell Title="@WizardTitle" Subtitle="Guided Profile" MaxWidth="960px" Height="680px" BodyClass="is-flush" OnClose="Close">
    <ModalSplitLayout Height="100%" RailWidth="210px" RailClass="character-wizard-rail">
            <RailHeader>
                <div class="character-wizard-profile">
                    <Avatar Name="@(string.IsNullOrWhiteSpace(Character.Name) ? "?" : Character.Name)" Size="52" />
                    <span class="character-wizard-profile-name @(string.IsNullOrWhiteSpace(Character.Name) ? "is-empty" : "")">
                        @(string.IsNullOrWhiteSpace(Character.Name) ? "Unnamed" : Character.Name)
                    </span>
                    @if (Character.SceneRoles.Count > 0)
                    {
                        <div class="character-wizard-role-list">
                            @foreach (var roleId in Character.SceneRoles)
                            {
                                var role = Find(SceneRoles, roleId);
                                if (role is not null)
                                {
                                    <span @key="role.Id" class="character-wizard-mini-role">@role.Label</span>
                                }
                        }
                    </div>
                }
                </div>
            </RailHeader>
            <RailContent>
                @for (var i = 0; i < Steps.Length; i++)
                {
                    var index = i;
                    var step = Steps[index];
                    var done = StepDone(index);
                    var accessible = index <= Step + 1 || done;
                    <SidebarTabRow @key="step.Id"
                                   Title="@step.Label"
                                   Summary="@step.Sub"
                                   Active="@(Step == index)"
                                   Done="@done"
                                   Locked="@(!accessible)"
                                   Disabled="@(!accessible)"
                                   Class="character-wizard-step"
                                   OnClick="@(_ => GoToStep(index))">
                        <IndexContent>
                            @if (done && Step != index)
                            {
                                <FaIcon Name="check" />
                            }
                            else
                            {
                                @(index + 1)
                            }
                        </IndexContent>
                    </SidebarTabRow>
                }
            </RailContent>
            <RailFooter>
                <div class="character-wizard-progress">
                    <div>
                        <span>Completeness</span>
                        <span>@DoneCount/@Steps.Length</span>
                    </div>
                    <ProgressBar Value="@DoneCount" Max="@Steps.Length" Class="character-wizard-progress-track" />
                </div>
            </RailFooter>
            <MainContent>
                <ModalStackLayout BodyClass="character-wizard-step-content">
                    <Header>
                        <ModalPaneHeader Class="character-wizard-main-head">
                            <h3>@Steps[Step].Label</h3>
                            <p>@Steps[Step].Sub</p>
                        </ModalPaneHeader>
                    </Header>
                    <ChildContent>
                    @if (Step == 0)
                    {
                        <div class="character-wizard-step-stack">
                            <Section Title="Name">
                                <input class="character-wizard-name-input" placeholder="Character name..." @bind="Character.Name" @bind:event="oninput" />
                            </Section>
                            <Section Title="Summary" Hint="— one sentence, optional">
                                <textarea class="character-wizard-textarea" rows="2" placeholder="Who is this character in a sentence?" @bind="Character.Summary" @bind:event="oninput"></textarea>
                            </Section>
                            <Section Title="Pronouns">
                                <div class="character-wizard-chip-list">
                                    @foreach (var pronoun in PronounOptions)
                                    {
                                        var selected = Character.Pronouns.Contains(pronoun.Id);
                                        <SelectableButton @key="pronoun.Id" TooltipText="@pronoun.Hover" Class="@($"character-wizard-chip {(selected ? "is-selected" : "")}")" OnClick="@(_ => ToggleText(Character.Pronouns, pronoun.Id))">
                                            @pronoun.Label
                                        </SelectableButton>
                                    }
                                </div>
                            </Section>
                            <Section Title="Scene Roles" Hint="— what function they serve" Count="Character.SceneRoles.Count" MaxCount="CharacterProfileRules.MaxSceneRoles">
                                <div class="character-wizard-chip-list">
                                    @foreach (var role in SceneRoles)
                                    {
                                        var selected = Character.SceneRoles.Contains(role.Id);
                                        <SelectableButton @key="role.Id" TooltipText="@role.Hover" Class="@($"character-wizard-chip {(selected ? "is-selected" : "")}")" Disabled="@(!selected && Character.SceneRoles.Count >= CharacterProfileRules.MaxSceneRoles)" OnClick="@(_ => ToggleLimited(Character.SceneRoles, role.Id, CharacterProfileRules.MaxSceneRoles))">
                                            @role.Label
                                        </SelectableButton>
                                    }
                                </div>
                            </Section>
                        </div>
                    }
                    else if (Step == 1)
                    {
                        <div class="character-wizard-personality-intro">
                            <p>Pick @CharacterProfileRules.RecommendedMinTraits to @CharacterProfileRules.MaxTraits total. Hover any trait for a description.</p>
                            <span class="character-wizard-count-pill @(Character.Traits.Count >= CharacterProfileRules.RecommendedMinTraits ? "is-ready" : "")">@Character.Traits.Count / @CharacterProfileRules.MaxTraits</span>
                        </div>
                        <div class="character-wizard-trait-section-list">
                            @foreach (var group in TraitCategories)
                            {
                                var selectedCount = group.Items.Count(item => Character.Traits.Contains(item.Id));
                                <Section @key="group.Name" Title="@group.Name" Count="@selectedCount" Class="character-wizard-trait-group">
                                    <div class="character-wizard-chip-list">
                                        @foreach (var trait in group.Items)
                                        {
                                            var selected = Character.Traits.Contains(trait.Id);
                                            <SelectableButton @key="trait.Id" TooltipText="@trait.Hover" Class="@($"character-wizard-chip {(selected ? "is-selected" : "")}")" Disabled="@(!selected && Character.Traits.Count >= CharacterProfileRules.MaxTraits)" OnClick="@(_ => ToggleLimited(Character.Traits, trait.Id, CharacterProfileRules.MaxTraits))">
                                                @trait.Label
                                            </SelectableButton>
                                        }
                                    </div>
                                </Section>
                            }
                        </div>
                    }
                    else if (Step == 2)
                    {
                        <p class="character-wizard-help">Pick one for each. These four fields give the model emotional logic to draw from.</p>
                        <div class="character-wizard-step-stack is-roomy">
                            <CharacterOptionGrid Title="Core Drive" Hint="The engine behind every choice." Columns="3" Items="CoreDrives" Selected="@Character.CoreDrive" OnSelect="@(id => SetSingle(nameof(Character.CoreDrive), id))" />
                            <CharacterOptionGrid Title="Core Fear" Hint="What they most want to avoid." Columns="3" Items="CoreFears" Selected="@Character.CoreFear" OnSelect="@(id => SetSingle(nameof(Character.CoreFear), id))" />
                            <CharacterOptionGrid Title="Surface Mask" Hint="How they present to the world." Columns="2" Items="SurfaceMasks" Selected="@Character.SurfaceMask" OnSelect="@(id => SetSingle(nameof(Character.SurfaceMask), id))" />
                            <CharacterOptionGrid Title="Hidden Truth" Hint="What quietly drives them underneath." Columns="2" Items="HiddenTruths" Selected="@Character.HiddenTruth" OnSelect="@(id => SetSingle(nameof(Character.HiddenTruth), id))" />
                        </div>
                    }
                    else if (Step == 3)
                    {
                        <p class="character-wizard-help">Pick one per category. Voice and behavior make characters feel distinct on the page.</p>
                        <div class="character-wizard-step-stack is-roomy">
                            <CharacterOptionGrid Title="Sentence Style" Hint="How they construct speech." Columns="2" Items="SentenceStyles" Selected="@Character.SentenceStyle" OnSelect="@(id => SetSingle(nameof(Character.SentenceStyle), id))" />
                            <CharacterOptionGrid Title="Honesty Style" Hint="How direct vs. evasive they are." Columns="2" Items="HonestyStyles" Selected="@Character.HonestyStyle" OnSelect="@(id => SetSingle(nameof(Character.HonestyStyle), id))" />
                            <CharacterOptionGrid Title="Emotional Leakage" Hint="How feelings escape their control." Columns="2" Items="EmotionalLeakages" Selected="@Character.EmotionalLeakage" OnSelect="@(id => SetSingle(nameof(Character.EmotionalLeakage), id))" />
                            <CharacterOptionGrid Title="Action Fingerprint" Hint="Their physical signature in a scene." Columns="2" Items="ActionFingerprints" Selected="@Character.ActionFingerprint" OnSelect="@(id => SetSingle(nameof(Character.ActionFingerprint), id))" />
                            <CharacterOptionGrid Title="Stress Pattern" Hint="How behavior escalates under pressure." Columns="2" Items="StressPatterns" Selected="@Character.StressPattern" OnSelect="@(id => SetSingle(nameof(Character.StressPattern), id))" />
                        </div>
                    }
                    else if (Step == 4)
                    {
                        <div class="character-wizard-step-stack is-roomy">
                            <CharacterOptionGrid Title="Soft Spots" Hint="— what makes them open up" Columns="2" Items="SoftSpots" MultiValues="Character.SoftSpots" Max="CharacterProfileRules.MaxSoftSpots" OnToggle="@(id => ToggleLimited(Character.SoftSpots, id, CharacterProfileRules.MaxSoftSpots))" />
                            <CharacterOptionGrid Title="Avoid Patterns" Hint="— what the model must not do" Columns="2" Items="AvoidPatterns" MultiValues="Character.AvoidPatterns" Max="CharacterProfileRules.MaxAvoidPatterns" OnToggle="@(id => ToggleLimited(Character.AvoidPatterns, id, CharacterProfileRules.MaxAvoidPatterns))" />
                        </div>
                    }
                    else
                    {
                        var others = ExistingCharacters.Where(c => c.Id != Character.Id).ToList();
                        @if (others.Count == 0)
                        {
                            <div class="character-wizard-empty">
                                <FaIcon Name="users" />
                                <span>No other characters yet.<br />Relationships can be added later from the character editor.</span>
                            </div>
                        }
                        else
                        {
                            <div class="character-wizard-relationships">
                                <p class="character-wizard-help">Toggle the characters this character knows, then define the dynamic from each direction.</p>
                                @foreach (var other in others)
                                {
                                    var rel = GetRelationship(other.Id);
                                    var known = rel is not null;
                                    var expanded = ExpandedRelationships.Contains(other.Id);
                                    <article @key="other.Id" class="character-relationship @(known ? "is-known" : "")">
                                        <SelectableButton Class="character-relationship-head" OnClick="@(_ => ToggleRelationshipRow(other.Id))">
                                            <span class="character-relationship-check @(known ? "is-selected" : "")" @onclick:stopPropagation="true" @onclick="() => ToggleRelationship(other.Id)">
                                                @if (known)
                                                {
                                                    <FaIcon Name="check" />
                                                }
                                            </span>
                                            <Avatar Name="@other.Name" Size="30" />
                                            <span class="character-relationship-copy">
                                                <strong>@other.Name</strong>
                                                @if (!string.IsNullOrWhiteSpace(other.Summary))
                                                {
                                                    <small>@other.Summary</small>
                                                }
                                            </span>
                                            @if (known)
                                            {
                                                <span class="character-relationship-meta">
                                                    @foreach (var bond in rel!.Bonds.Take(1))
                                                    {
                                                        <span @key="bond">@bond</span>
                                                    }
                                                    <FaIcon Name="@(expanded ? "chevron-up" : "chevron-down")" />
                                                </span>
                                            }
                                        </SelectableButton>
                                        @if (known && expanded)
                                        {
                                            <div class="character-relationship-detail">
                                                <Section Title="Bond Type">
                                                    <div class="character-wizard-chip-list">
                                                        @foreach (var bond in BondTypes)
                                                        {
                                                            var selected = rel!.Bonds.Contains(bond);
                                                            <SelectableButton @key="bond" Class="@($"character-wizard-mini-chip {(selected ? "is-selected" : "")}")" OnClick="@(_ => ToggleText(rel.Bonds, bond))">@bond</SelectableButton>
                                                        }
                                                    </div>
                                                </Section>
                                                <Section Title="Shared Dynamic">
                                                    <div class="character-wizard-chip-list">
                                                        @foreach (var dynamic in Dynamics)
                                                        {
                                                            var selected = rel!.Dynamics.Contains(dynamic);
                                                            <SelectableButton @key="dynamic" Class="@($"character-wizard-mini-chip {(selected ? "is-selected" : "")}")" OnClick="@(_ => ToggleText(rel.Dynamics, dynamic))">@dynamic</SelectableButton>
                                                        }
                                                    </div>
                                                </Section>
                                                <Section Title="@($"How {SelfName} sees {other.Name}")">
                                                    <textarea class="character-relationship-note" rows="1" placeholder="@($"How does {SelfName} perceive and treat {other.Name}?")" @bind="rel!.NoteAtoB" @bind:event="oninput"></textarea>
                                                </Section>
                                                <Section Title="@($"How {other.Name} sees {SelfName}")">
                                                    <textarea class="character-relationship-note" rows="1" placeholder="@($"How does {other.Name} perceive and treat {SelfName}?")" @bind="rel!.NoteBtoA" @bind:event="oninput"></textarea>
                                                </Section>
                                                <Section Title="External Perception">
                                                    <textarea class="character-relationship-note" rows="1" placeholder="How would others describe this relationship from the outside?" @bind="rel!.NoteExternal" @bind:event="oninput"></textarea>
                                                </Section>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    }
                    </ChildContent>

                <Footer>
                    @if (Step > 0)
                    {
                        <AppButton Variant="secondary" Size="sm" OnClick="Back"><FaIcon Name="chevron-left" />Back</AppButton>
                    }
                    <span class="modal-action-spacer"></span>
                    @if (Step == Steps.Length - 1)
                    {
                        <AppButton Variant="primary" Size="sm" Disabled="@string.IsNullOrWhiteSpace(Character.Name)" OnClick="Done"><FaIcon Name="check" />Done</AppButton>
                    }
                    else
                    {
                        <AppButton Variant="primary" Size="sm" Disabled="@(!CanNext)" OnClick="Next">Next<FaIcon Name="chevron-right" /></AppButton>
                        @if (IsComplete)
                        {
                            <AppButton Variant="secondary" Size="sm" OnClick="Done"><FaIcon Name="check" />Done</AppButton>
                        }
                    }
                </Footer>
                </ModalStackLayout>
            </MainContent>
        </ModalSplitLayout>
</ModalShell>

@code {
    int Step;
    HashSet<string> ExpandedRelationships { get; } = [];

    [Parameter] public RpCharacter Character { get; set; } = new();
    [Parameter] public List<RpCharacter> ExistingCharacters { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;

    string WizardTitle => string.IsNullOrWhiteSpace(Character.Name) ? "New Character" : Character.Name;
    CharacterTraitLibraryState TraitLibrary => Session.Chat.CharacterTraitLibrary.State;
    IReadOnlyList<CharacterOption> PronounOptions => CharacterProfileRules.PronounOptions;
    IReadOnlyList<CharacterOption> SceneRoles => TraitLibrary.SceneRoles;
    IReadOnlyList<CharacterTraitGroupState> TraitCategories => TraitLibrary.TraitCategories;
    IReadOnlyList<CharacterOption> CoreDrives => TraitLibrary.CoreDrives;
    IReadOnlyList<CharacterOption> CoreFears => TraitLibrary.CoreFears;
    IReadOnlyList<CharacterOption> SurfaceMasks => TraitLibrary.SurfaceMasks;
    IReadOnlyList<CharacterOption> HiddenTruths => TraitLibrary.HiddenTruths;
    IReadOnlyList<CharacterOption> SentenceStyles => TraitLibrary.SentenceStyles;
    IReadOnlyList<CharacterOption> HonestyStyles => TraitLibrary.HonestyStyles;
    IReadOnlyList<CharacterOption> EmotionalLeakages => TraitLibrary.EmotionalLeakages;
    IReadOnlyList<CharacterOption> ActionFingerprints => TraitLibrary.ActionFingerprints;
    IReadOnlyList<CharacterOption> StressPatterns => TraitLibrary.StressPatterns;
    IReadOnlyList<CharacterOption> SoftSpots => TraitLibrary.SoftSpots;
    IReadOnlyList<CharacterOption> AvoidPatterns => TraitLibrary.AvoidPatterns;
    IReadOnlyList<string> BondTypes => TraitLibrary.BondTypes;
    IReadOnlyList<string> Dynamics => TraitLibrary.Dynamics;

    static readonly WizardStep[] Steps =
    [
        new("concept", "Concept", "Name & pronouns"),
        new("personality", "Personality", "Baseline traits"),
        new("engine", "Inner Engine", "Drives & fears"),
        new("voice", "Voice", "How they speak"),
        new("limits", "Limits", "Soft spots & avoids"),
        new("relationships", "Relationships", "Who they know"),
    ];

    int DoneCount => Enumerable.Range(0, Steps.Length).Count(StepDone);
    bool CanNext => Step != 0 || !string.IsNullOrWhiteSpace(Character.Name);
    bool IsComplete => DoneCount == Steps.Length;
    string SelfName => string.IsNullOrWhiteSpace(Character.Name) ? "this character" : Character.Name;

    bool StepDone(int step) => step switch
    {
        0 => !string.IsNullOrWhiteSpace(Character.Name),
        1 => Character.Traits.Count >= 1,
        2 => !string.IsNullOrWhiteSpace(Character.CoreDrive) || !string.IsNullOrWhiteSpace(Character.CoreFear) || !string.IsNullOrWhiteSpace(Character.SurfaceMask) || !string.IsNullOrWhiteSpace(Character.HiddenTruth),
        3 => !string.IsNullOrWhiteSpace(Character.SentenceStyle) || !string.IsNullOrWhiteSpace(Character.StressPattern),
        4 => Character.SoftSpots.Count > 0 || Character.AvoidPatterns.Count > 0,
        _ => true
    };

    void ToggleLimited(List<string> values, string value, int max)
    {
        if (values.Remove(value))
            return;

        if (values.Count < max)
            values.Add(value);
    }

    static void ToggleText(List<string> values, string value)
    {
        if (!values.Remove(value))
            values.Add(value);
    }

    void SetSingle(string property, string value)
    {
        var current = property switch
        {
            nameof(Character.CoreDrive) => Character.CoreDrive,
            nameof(Character.CoreFear) => Character.CoreFear,
            nameof(Character.SurfaceMask) => Character.SurfaceMask,
            nameof(Character.HiddenTruth) => Character.HiddenTruth,
            nameof(Character.SentenceStyle) => Character.SentenceStyle,
            nameof(Character.HonestyStyle) => Character.HonestyStyle,
            nameof(Character.EmotionalLeakage) => Character.EmotionalLeakage,
            nameof(Character.ActionFingerprint) => Character.ActionFingerprint,
            nameof(Character.StressPattern) => Character.StressPattern,
            _ => ""
        };
        var next = current == value ? "" : value;

        switch (property)
        {
            case nameof(Character.CoreDrive):
                Character.CoreDrive = next;
                break;
            case nameof(Character.CoreFear):
                Character.CoreFear = next;
                break;
            case nameof(Character.SurfaceMask):
                Character.SurfaceMask = next;
                break;
            case nameof(Character.HiddenTruth):
                Character.HiddenTruth = next;
                break;
            case nameof(Character.SentenceStyle):
                Character.SentenceStyle = next;
                break;
            case nameof(Character.HonestyStyle):
                Character.HonestyStyle = next;
                break;
            case nameof(Character.EmotionalLeakage):
                Character.EmotionalLeakage = next;
                break;
            case nameof(Character.ActionFingerprint):
                Character.ActionFingerprint = next;
                break;
            case nameof(Character.StressPattern):
                Character.StressPattern = next;
                break;
        }
    }

    RpRelationship? GetRelationship(string characterId) => Character.ProfileRelationships.FirstOrDefault(r => r.CharacterId == characterId);

    void ToggleRelationship(string characterId)
    {
        var rel = GetRelationship(characterId);
        if (rel is not null)
        {
            Character.ProfileRelationships.Remove(rel);
            ExpandedRelationships.Remove(characterId);
            return;
        }

        Character.ProfileRelationships.Add(new() { CharacterId = characterId });
        ExpandedRelationships.Add(characterId);
    }

    void ToggleRelationshipRow(string characterId)
    {
        if (GetRelationship(characterId) is null)
        {
            ToggleRelationship(characterId);
            return;
        }

        if (!ExpandedRelationships.Remove(characterId))
            ExpandedRelationships.Add(characterId);
    }

    async Task GoToStep(int step)
    {
        Step = step;
        await OnChanged.InvokeAsync();
    }

    async Task Back()
    {
        if (Step > 0)
            Step--;

        await OnChanged.InvokeAsync();
    }

    async Task Next()
    {
        if (Step < Steps.Length - 1)
            Step++;

        await OnChanged.InvokeAsync();
    }

    async Task Done()
    {
        await OnChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    async Task Close()
    {
        await OnChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    static CharacterOption? Find(IEnumerable<CharacterOption> items, string id) => items.FirstOrDefault(item => item.Id == id);

    public sealed record WizardStep(string Id, string Label, string Sub);
}
