<div class="v2-backdrop" @onclick="Close">
    <section class="v2-modal" @onclick:stopPropagation="true">
        <header class="v2-header">
            <div class="v2-title-line">
                <span>@(string.IsNullOrWhiteSpace(Character.Name) ? "New Character" : Character.Name)</span>
                <span class="v2-version-badge">Guided Profile</span>
            </div>
            <div class="v2-header-actions">
                <IconButton Icon="x" Title="Close" OnClick="Close" />
            </div>
        </header>

        <ModalSplitLayout Height="100%" RailWidth="210px" Class="v2-body" RailClass="v2-rail" MainClass="v2-main">
            <RailHeader>
                <div class="v2-profile">
                    <Avatar Name="@(string.IsNullOrWhiteSpace(Character.Name) ? "?" : Character.Name)" Size="52" />
                    <span class="v2-profile-name @(string.IsNullOrWhiteSpace(Character.Name) ? "is-empty" : "")">
                        @(string.IsNullOrWhiteSpace(Character.Name) ? "Unnamed" : Character.Name)
                    </span>
                    @if (Character.SceneRoles.Count > 0)
                    {
                        <div class="v2-role-list">
                            @foreach (var roleId in Character.SceneRoles)
                            {
                                var role = Find(SceneRoles, roleId);
                                if (role is not null)
                                {
                                    <span @key="role.Id" class="v2-mini-role">@role.Label</span>
                                }
                        }
                    </div>
                }
                </div>
            </RailHeader>
            <RailContent>
                @for (var i = 0; i < Steps.Length; i++)
                {
                    var index = i;
                    var step = Steps[index];
                    var done = StepDone(index);
                    var accessible = index <= Step + 1 || done;
                    <SidebarTabRow @key="step.Id"
                                   Title="@step.Label"
                                   Summary="@step.Sub"
                                   Active="@(Step == index)"
                                   Done="@done"
                                   Locked="@(!accessible)"
                                   Disabled="@(!accessible)"
                                   Class="v2-step"
                                   OnClick="@(_ => GoToStep(index))">
                        <IndexContent>
                            @if (done && Step != index)
                            {
                                <FaIcon Name="check" />
                            }
                            else
                            {
                                @(index + 1)
                            }
                        </IndexContent>
                    </SidebarTabRow>
                }
            </RailContent>
            <RailFooter>
                <div class="v2-progress">
                    <div>
                        <span>Completeness</span>
                        <span>@DoneCount/@Steps.Length</span>
                    </div>
                    <div class="v2-progress-track">
                        <div class="v2-progress-fill" style="width:@ProgressPercent%"></div>
                    </div>
                </div>
            </RailFooter>
            <MainContent>
                <div class="v2-main-head">
                    <h3>@Steps[Step].Label</h3>
                    <p>@Steps[Step].Sub</p>
                </div>

                <div class="v2-content">
                    @if (Step == 0)
                    {
                        <div class="v2-step-stack">
                            <Section Title="Name">
                                <input class="v2-name-input" placeholder="Character name..." @bind="Character.Name" @bind:event="oninput" />
                            </Section>
                            <Section Title="Summary" Hint="— one sentence, optional">
                                <textarea class="v2-textarea" rows="2" placeholder="Who is this character in a sentence?" @bind="Character.Summary" @bind:event="oninput"></textarea>
                            </Section>
                            <Section Title="Scene Roles" Hint="— what function they serve" Count="Character.SceneRoles.Count" MaxCount="2">
                                <div class="v2-chip-list">
                                    @foreach (var role in SceneRoles)
                                    {
                                        var selected = Character.SceneRoles.Contains(role.Id);
                                        <SelectableButton @key="role.Id" Title="@role.Hover" Class="@($"v2-chip {(selected ? "is-selected" : "")}")" Disabled="@(!selected && Character.SceneRoles.Count >= 2)" OnClick="@(_ => ToggleLimited(Character.SceneRoles, role.Id, 2))">
                                            @role.Label
                                        </SelectableButton>
                                    }
                                </div>
                            </Section>
                        </div>
                    }
                    else if (Step == 1)
                    {
                        <div class="v2-personality-intro">
                            <p>Pick 3 to 6 total. Hover any trait for a description.</p>
                            <span class="v2-count-pill @(Character.Traits.Count >= 3 ? "is-ready" : "")">@Character.Traits.Count / 6</span>
                        </div>
                        <div class="v2-trait-section-list">
                            @foreach (var group in TraitCategories)
                            {
                                var selectedCount = group.Items.Count(item => Character.Traits.Contains(item.Id));
                                <Section @key="group.Name" Title="@group.Name" Count="@selectedCount" Class="v2-trait-group">
                                    <div class="v2-chip-list">
                                        @foreach (var trait in group.Items)
                                        {
                                            var selected = Character.Traits.Contains(trait.Id);
                                            <SelectableButton @key="trait.Id" Title="@trait.Hover" Class="@($"v2-chip {(selected ? "is-selected" : "")}")" Disabled="@(!selected && Character.Traits.Count >= 6)" OnClick="@(_ => ToggleLimited(Character.Traits, trait.Id, 6))">
                                                @trait.Label
                                            </SelectableButton>
                                        }
                                    </div>
                                </Section>
                            }
                        </div>
                    }
                    else if (Step == 2)
                    {
                        <p class="v2-help">Pick one for each. These four fields give the model emotional logic to draw from.</p>
                        <div class="v2-step-stack is-roomy">
                            <CharacterOptionGrid Title="Core Drive" Hint="The engine behind every choice." Columns="3" Items="CoreDrives" Selected="@Character.CoreDrive" OnSelect="@(id => SetSingle(nameof(Character.CoreDrive), id))" />
                            <CharacterOptionGrid Title="Core Fear" Hint="What they most want to avoid." Columns="3" Items="CoreFears" Selected="@Character.CoreFear" OnSelect="@(id => SetSingle(nameof(Character.CoreFear), id))" />
                            <CharacterOptionGrid Title="Surface Mask" Hint="How they present to the world." Columns="2" Items="SurfaceMasks" Selected="@Character.SurfaceMask" OnSelect="@(id => SetSingle(nameof(Character.SurfaceMask), id))" />
                            <CharacterOptionGrid Title="Hidden Truth" Hint="What quietly drives them underneath." Columns="2" Items="HiddenTruths" Selected="@Character.HiddenTruth" OnSelect="@(id => SetSingle(nameof(Character.HiddenTruth), id))" />
                        </div>
                    }
                    else if (Step == 3)
                    {
                        <p class="v2-help">Pick one per category. Voice and behavior make characters feel distinct on the page.</p>
                        <div class="v2-step-stack is-roomy">
                            <CharacterOptionGrid Title="Sentence Style" Hint="How they construct speech." Columns="2" Items="SentenceStyles" Selected="@Character.SentenceStyle" OnSelect="@(id => SetSingle(nameof(Character.SentenceStyle), id))" />
                            <CharacterOptionGrid Title="Honesty Style" Hint="How direct vs. evasive they are." Columns="2" Items="HonestyStyles" Selected="@Character.HonestyStyle" OnSelect="@(id => SetSingle(nameof(Character.HonestyStyle), id))" />
                            <CharacterOptionGrid Title="Emotional Leakage" Hint="How feelings escape their control." Columns="2" Items="EmotionalLeakages" Selected="@Character.EmotionalLeakage" OnSelect="@(id => SetSingle(nameof(Character.EmotionalLeakage), id))" />
                            <CharacterOptionGrid Title="Action Fingerprint" Hint="Their physical signature in a scene." Columns="2" Items="ActionFingerprints" Selected="@Character.ActionFingerprint" OnSelect="@(id => SetSingle(nameof(Character.ActionFingerprint), id))" />
                            <CharacterOptionGrid Title="Stress Pattern" Hint="How behavior escalates under pressure." Columns="2" Items="StressPatterns" Selected="@Character.StressPattern" OnSelect="@(id => SetSingle(nameof(Character.StressPattern), id))" />
                        </div>
                    }
                    else if (Step == 4)
                    {
                        <div class="v2-step-stack is-roomy">
                            <CharacterOptionGrid Title="Soft Spots" Hint="— what makes them open up" Columns="2" Items="SoftSpots" MultiValues="Character.SoftSpots" Max="3" OnToggle="@(id => ToggleLimited(Character.SoftSpots, id, 3))" />
                            <CharacterOptionGrid Title="Avoid Patterns" Hint="— what the model must not do" Columns="2" Items="AvoidPatterns" MultiValues="Character.AvoidPatterns" Max="5" OnToggle="@(id => ToggleLimited(Character.AvoidPatterns, id, 5))" />
                        </div>
                    }
                    else
                    {
                        var others = ExistingCharacters.Where(c => c.Id != Character.Id).ToList();
                        @if (others.Count == 0)
                        {
                            <div class="v2-empty">
                                <FaIcon Name="users" />
                                <span>No other characters yet.<br />Relationships can be added later from the character editor.</span>
                            </div>
                        }
                        else
                        {
                            <div class="v2-relationships">
                                <p class="v2-help">Toggle the characters this character knows, then define the dynamic from each direction.</p>
                                @foreach (var other in others)
                                {
                                    var rel = GetRelationship(other.Id);
                                    var known = rel is not null;
                                    var expanded = ExpandedRelationships.Contains(other.Id);
                                    <article @key="other.Id" class="v2-rel @(known ? "is-known" : "")">
                                        <SelectableButton Class="v2-rel-head" OnClick="@(_ => ToggleRelationshipRow(other.Id))">
                                            <span class="v2-rel-check @(known ? "is-selected" : "")" @onclick:stopPropagation="true" @onclick="() => ToggleRelationship(other.Id)">
                                                @if (known)
                                                {
                                                    <FaIcon Name="check" />
                                                }
                                            </span>
                                            <Avatar Name="@other.Name" Size="30" />
                                            <span class="v2-rel-copy">
                                                <strong>@other.Name</strong>
                                                @if (!string.IsNullOrWhiteSpace(other.Summary))
                                                {
                                                    <small>@other.Summary</small>
                                                }
                                            </span>
                                            @if (known)
                                            {
                                                <span class="v2-rel-meta">
                                                    @foreach (var bond in rel!.Bonds.Take(1))
                                                    {
                                                        <span @key="bond">@bond</span>
                                                    }
                                                    <FaIcon Name="@(expanded ? "chevron-up" : "chevron-down")" />
                                                </span>
                                            }
                                        </SelectableButton>
                                        @if (known && expanded)
                                        {
                                            <div class="v2-rel-detail">
                                                <Section Title="Bond Type">
                                                    <div class="v2-chip-list">
                                                        @foreach (var bond in BondTypes)
                                                        {
                                                            var selected = rel!.Bonds.Contains(bond);
                                                            <SelectableButton @key="bond" Class="@($"v2-mini-chip {(selected ? "is-selected" : "")}")" OnClick="@(_ => ToggleText(rel.Bonds, bond))">@bond</SelectableButton>
                                                        }
                                                    </div>
                                                </Section>
                                                <Section Title="Shared Dynamic">
                                                    <div class="v2-chip-list">
                                                        @foreach (var dynamic in Dynamics)
                                                        {
                                                            var selected = rel!.Dynamics.Contains(dynamic);
                                                            <SelectableButton @key="dynamic" Class="@($"v2-mini-chip {(selected ? "is-selected" : "")}")" OnClick="@(_ => ToggleText(rel.Dynamics, dynamic))">@dynamic</SelectableButton>
                                                        }
                                                    </div>
                                                </Section>
                                                <Section Title="@($"How {SelfName} sees {other.Name}")">
                                                    <textarea class="v2-rel-note" rows="1" placeholder="@($"How does {SelfName} perceive and treat {other.Name}?")" @bind="rel!.NoteAtoB" @bind:event="oninput"></textarea>
                                                </Section>
                                                <Section Title="@($"How {other.Name} sees {SelfName}")">
                                                    <textarea class="v2-rel-note" rows="1" placeholder="@($"How does {other.Name} perceive and treat {SelfName}?")" @bind="rel!.NoteBtoA" @bind:event="oninput"></textarea>
                                                </Section>
                                                <Section Title="External Perception">
                                                    <textarea class="v2-rel-note" rows="1" placeholder="How would others describe this relationship from the outside?" @bind="rel!.NoteExternal" @bind:event="oninput"></textarea>
                                                </Section>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    }
                </div>

                <footer class="v2-footer">
                    @if (Step > 0)
                    {
                        <AppButton Variant="secondary" Size="sm" OnClick="Back"><FaIcon Name="chevron-left" />Back</AppButton>
                    }
                    <span class="v2-footer-spacer"></span>
                    @if (Step == Steps.Length - 1)
                    {
                        <AppButton Variant="primary" Size="sm" Disabled="@string.IsNullOrWhiteSpace(Character.Name)" OnClick="Done"><FaIcon Name="check" />Done</AppButton>
                    }
                    else
                    {
                        <AppButton Variant="primary" Size="sm" Disabled="@(!CanNext)" OnClick="Next">Next<FaIcon Name="chevron-right" /></AppButton>
                        @if (IsComplete)
                        {
                            <AppButton Variant="secondary" Size="sm" OnClick="Done"><FaIcon Name="check" />Done</AppButton>
                        }
                    }
                </footer>
            </MainContent>
        </ModalSplitLayout>
    </section>
</div>

