<div class="entity-form-editor">
    <Section Title="Identity" Class="entity-form-section">
        <FieldRow Label="Name"><input class="field" @bind="Location.Name" @bind:after="Changed" /></FieldRow>
        <FieldRow Label="Summary"><textarea class="field" rows="3" @bind="Location.Summary" @bind:after="Changed"></textarea></FieldRow>
    </Section>
    <Section Title="Scene Texture" Class="entity-form-section">
        <FieldRow Label="Description"><textarea class="field" rows="5" @bind="Location.Description" @bind:after="Changed"></textarea></FieldRow>
        <FieldRow Label="Atmosphere"><textarea class="field" rows="4" @bind="Location.Atmosphere" @bind:after="Changed"></textarea></FieldRow>
        <FieldRow Label="Features"><textarea class="field" rows="4" @bind="Location.Features" @bind:after="Changed"></textarea></FieldRow>
    </Section>
</div>

@code {
    [Parameter] public RpLocation Location { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    Task Changed() => OnChanged.InvokeAsync();
}
