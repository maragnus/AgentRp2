<FormStack>
    <FormSection Title="Identity">
        <FieldRow Label="Name"><AppInput Value="@Location.Name" ValueChanged="SetName" /></FieldRow>
        <FieldRow Label="Summary"><AppTextarea Rows="3" Value="@Location.Summary" ValueChanged="SetSummary" /></FieldRow>
    </FormSection>
    <FormSection Title="Scene Texture">
        <FieldRow Label="Description"><AppTextarea Rows="5" Value="@Location.Description" ValueChanged="SetDescription" /></FieldRow>
        <FieldRow Label="Atmosphere"><AppTextarea Rows="4" Value="@Location.Atmosphere" ValueChanged="SetAtmosphere" /></FieldRow>
        <FieldRow Label="Features"><AppTextarea Rows="4" Value="@Location.Features" ValueChanged="SetFeatures" /></FieldRow>
    </FormSection>
</FormStack>

@code {
    [Parameter] public RpLocation Location { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    Task Changed() => OnChanged.InvokeAsync();
    async Task SetName(string value) => await Update(() => Location.Name = value);
    async Task SetSummary(string value) => await Update(() => Location.Summary = value);
    async Task SetDescription(string value) => await Update(() => Location.Description = value);
    async Task SetAtmosphere(string value) => await Update(() => Location.Atmosphere = value);
    async Task SetFeatures(string value) => await Update(() => Location.Features = value);

    async Task Update(Action update)
    {
        update();
        await Changed();
    }
}
