<FormStack>
    <FormSection Title="Identity" DirtyPaths="@IdentityPaths">
        <FieldRow Label="Name" DirtyPath="Name"><AppInput Value="@Location.Name" ValueChanged="SetName" DirtyPath="Name" /></FieldRow>
        <FieldRow Label="Summary" DirtyPath="Summary"><AppTextarea Rows="3" Value="@Location.Summary" ValueChanged="SetSummary" DirtyPath="Summary" /></FieldRow>
    </FormSection>
    <FormSection Title="Scene Texture" DirtyPaths="@TexturePaths">
        <FieldRow Label="Description" DirtyPath="Description"><AppTextarea Rows="5" Value="@Location.Description" ValueChanged="SetDescription" DirtyPath="Description" /></FieldRow>
        <FieldRow Label="Atmosphere" DirtyPath="Atmosphere"><AppTextarea Rows="4" Value="@Location.Atmosphere" ValueChanged="SetAtmosphere" DirtyPath="Atmosphere" /></FieldRow>
        <FieldRow Label="Features" DirtyPath="Features"><AppTextarea Rows="4" Value="@Location.Features" ValueChanged="SetFeatures" DirtyPath="Features" /></FieldRow>
    </FormSection>
</FormStack>

@code {
    static readonly string[] IdentityPaths = [nameof(RpLocation.Name), nameof(RpLocation.Summary)];
    static readonly string[] TexturePaths = [nameof(RpLocation.Description), nameof(RpLocation.Atmosphere), nameof(RpLocation.Features)];

    [Parameter] public RpLocation Location { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    Task Changed() => OnChanged.InvokeAsync();
    async Task SetName(string value) => await Update(() => Location.Name = value);
    async Task SetSummary(string value) => await Update(() => Location.Summary = value);
    async Task SetDescription(string value) => await Update(() => Location.Description = value);
    async Task SetAtmosphere(string value) => await Update(() => Location.Atmosphere = value);
    async Task SetFeatures(string value) => await Update(() => Location.Features = value);

    async Task Update(Action update)
    {
        update();
        await Changed();
    }
}
