@implements IDisposable
@inject ILogger<StoryAssistantModal> Logger

<ModalShell Title="Story Assistant" Icon="story-assistant" MaxWidth="1120px" BodyClass="is-flush" OnClose="OnClose">
    <ModalBodyTabs AriaLabel="Story Assistant views">
        <ModalBodyTab Icon="message-square"
                      Label="Chats"
                      Active="@(ActiveView == ChatsView)"
                      OnClick="@(_ => SetView(ChatsView))" />
        <ModalBodyTab Icon="database"
                      Label="Entities"
                      Active="@(ActiveView == EntitiesView)"
                      OnClick="@(_ => SetView(EntitiesView))" />
    </ModalBodyTabs>

    @if (ActiveView == ChatsView)
    {
        <ModalSplitLayout Height="100%" RailWidth="270px" Class="story-assistant-modal" RailClass="story-assistant-chat-rail">
            <RailHeader>
                <div class="story-assistant-chat-rail-head">
                    <strong>Chats</strong>
                    <AppButton Icon="plus" TooltipText="New chat" AriaLabel="New chat" OnClick="@(_ => Session.Chat.StoryAssistant.CreateChatAsync())" />
                </div>
            </RailHeader>
            <RailContent>
                @foreach (var chat in Chats)
                {
                    <SidebarListRow @key="chat.Id"
                                    Title="@chat.Title"
                                    Summary="@ChatSummary(chat)"
                                    Count="@PendingCountText(chat)"
                                    Active="@(chat.Id == ActiveChat.Id)"
                                    Class="story-assistant-chat-row"
                                    OnClick="@(_ => Session.Chat.StoryAssistant.SelectChatAsync(chat.Id))">
                        <LeadingContent>
                            <span class="sidebar-row-icon"><FaIcon Name="messages-square" /></span>
                        </LeadingContent>
                        <TrailingContent>
                            <span @onclick:stopPropagation="true">
                                <AppButton Icon="trash" TooltipText="Delete chat" AriaLabel="Delete chat" OnClick="@(_ => Session.Chat.StoryAssistant.DeleteChatAsync(chat.Id))" />
                            </span>
                        </TrailingContent>
                    </SidebarListRow>
                }
            </RailContent>
            <MainContent>
                <ModalStackLayout Class="story-assistant-workspace"
                                  HeaderClass="story-assistant-workspace-head"
                                  BodyClass="story-assistant-workspace-body"
                                  Header="@ChatWorkspaceHeader">
                    <ChildContent>
                        <StoryAssistantPanel ContextChips="ContextChips"
                                             OnRemoveContext="RemoveContext"
                                             OnClearContext="ClearContext" />
                    </ChildContent>
                </ModalStackLayout>
            </MainContent>
        </ModalSplitLayout>
    }
    else
    {
        <StoryAssistantEntityBrowser OnAttach="AttachContext" />
    }
</ModalShell>

@code {
    readonly List<StoryAssistantContextChip> ContextChips = [];
    const string ChatsView = "chats";
    const string EntitiesView = "entities";
    string ActiveView = ChatsView;
    string TitleDraft = "";

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    IReadOnlyList<StoryAssistantChat> Chats => Session.Chat.StoryAssistant.Chats.OrderByDescending(chat => chat.UpdatedUtc).ToList();
    StoryAssistantChat ActiveChat => Session.Chat.StoryAssistant.ActiveAssistantChat;

    RenderFragment ChatWorkspaceHeader => @<div class="story-assistant-workspace-title">
        <div class="story-assistant-title-edit">
            <AppInput Value="@TitleDraft" ValueChanged="RenameActiveChat" aria-label="Assistant chat title" />
        </div>
    </div>;

    protected override void OnInitialized()
    {
        TitleDraft = ActiveChat.Title;
        Session.Chat.StoryAssistant.Changed += OnStoreChanged;
    }

    Task OnStoreChanged() => InvokeAsync(() =>
    {
        TitleDraft = ActiveChat.Title;
        StateHasChanged();
    });

    async Task RenameActiveChat(string value)
    {
        TitleDraft = value;
        await Session.Chat.StoryAssistant.RenameChatAsync(ActiveChat.Id, TitleDraft);
    }

    Task AttachContext(StoryAssistantContextChip chip)
    {
        if (!ContextChips.Any(item => item.EntityType == chip.EntityType && item.EntityId == chip.EntityId))
            ContextChips.Add(chip);

        ActiveView = ChatsView;
        return InvokeAsync(StateHasChanged);
    }

    Task RemoveContext(StoryAssistantContextChip chip)
    {
        ContextChips.RemoveAll(item => item.EntityType == chip.EntityType && item.EntityId == chip.EntityId);
        return InvokeAsync(StateHasChanged);
    }

    Task ClearContext()
    {
        ContextChips.Clear();
        return InvokeAsync(StateHasChanged);
    }

    void SetView(string view) => ActiveView = view;

    static string ChatSummary(StoryAssistantChat chat)
    {
        var lastMessage = chat.Items
            .Where(item => item.Kind is StoryAssistantItemKind.UserMessage or StoryAssistantItemKind.AssistantMessage)
            .OrderByDescending(item => item.CreatedUtc)
            .FirstOrDefault();
        return lastMessage is null ? "No messages" : RelativeDateFormatter.FormatDate(lastMessage.CreatedUtc);
    }

    static string PendingCountText(StoryAssistantChat chat)
    {
        var count = chat.WorkItems.Count(item => item.Status == StoryAssistantWorkItemStatus.Pending);
        return count == 0 ? "" : count.ToString();
    }

    public void Dispose()
    {
        Session.Chat.StoryAssistant.Changed -= OnStoreChanged;
    }
}
