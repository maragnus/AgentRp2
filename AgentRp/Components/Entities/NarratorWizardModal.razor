<StatefulForm Model="@Draft" Baseline="@Baseline" OnSave="Save" OnClose="OnClose" ContextChanged="SetForm" RenderFormElement="false">
<ChildContent Context="form">
<ModalShell Title="Narrator" Subtitle="Story voice" MaxWidth="960px" Height="680px" BodyClass="is-flush" OnClose="form.RequestCloseAsync">
    <ModalSplitLayout Height="100%" RailWidth="210px" RailClass="character-wizard-rail">
        <RailHeader>
            <div class="character-wizard-profile">
                <span class="narrator-avatar"><FaIcon Name="book-open" /></span>
                <span class="character-wizard-profile-name">Narrator</span>
                <div class="character-wizard-role-list">
                    <span class="character-wizard-mini-role">@NarratorProfileService.VoiceLabel(Draft.VoicePreset)</span>
                </div>
            </div>
        </RailHeader>
        <RailContent>
            @for (var i = 0; i < Steps.Length; i++)
            {
                var index = i;
                var step = Steps[index];
                <SidebarTabRow @key="step.Id"
                               Title="@step.Label"
                               Summary="@step.Sub"
                               Active="@(Step == index)"
                               Done="@StepDone(index)"
                               Dirty="@StepDirty(index)"
                               Class="character-wizard-step"
                               OnClick="@(_ => GoToStep(index))">
                    <IndexContent>
                        @if (StepDone(index) && Step != index)
                        {
                            <FaIcon Name="check" />
                        }
                        else
                        {
                            @(index + 1)
                        }
                    </IndexContent>
                </SidebarTabRow>
            }
        </RailContent>
        <RailFooter>
            <div class="character-wizard-progress">
                <div>
                    <span>Completeness</span>
                    <span>@DoneCount/@Steps.Length</span>
                </div>
                <ProgressBar Value="@DoneCount" Max="@Steps.Length" Class="character-wizard-progress-track" />
            </div>
        </RailFooter>
        <MainContent>
            <ModalStackLayout BodyClass="character-wizard-step-content">
                <Header>
                    <ModalPaneHeader Class="character-wizard-main-head">
                        <h3>@Steps[Step].Label</h3>
                        <p>@Steps[Step].Sub</p>
                    </ModalPaneHeader>
                </Header>
                <ChildContent>
                    @if (Step == 0)
                    {
                        <div class="character-wizard-step-stack is-roomy">
                            <CharacterOptionGrid Title="Voice"
                                                 Columns="2"
                                                 Items="VoiceOptions"
                                                 Selected="@Draft.VoicePreset"
                                                 DirtyPath="@nameof(NarratorProfileState.VoicePreset)"
                                                 OnSelect="SetVoice" />
                            <FormSection Title="Custom Guidance" Hint="- optional" DirtyPath="@nameof(NarratorProfileState.CustomGuidance)">
                                <AppTextarea Class="character-wizard-textarea"
                                             Rows="4"
                                             Placeholder="Anything this narrator should consistently honor?"
                                             Value="@Draft.CustomGuidance"
                                             ValueChanged="value => Draft.CustomGuidance = value"
                                             DirtyPath="@nameof(NarratorProfileState.CustomGuidance)"
                                             UpdateMode="TextUpdateMode.Change" />
                            </FormSection>
                        </div>
                    }
                    else if (Step == 1)
                    {
                        <div class="character-wizard-step-stack is-roomy">
                            <NarratorProfileSliderSection Title="Scene Setup"
                                                          Hint="@NarratorProfileService.SetupDepthText(Draft.SetupDepth)"
                                                          Value="@Draft.SetupDepth"
                                                          ValueChanged="value => SetLevel(nameof(NarratorProfileState.SetupDepth), value)"
                                                          DirtyPath="@nameof(NarratorProfileState.SetupDepth)" />
                            <NarratorProfileSliderSection Title="Visual Detail"
                                                          Hint="@NarratorProfileService.VisualDetailText(Draft.VisualDetail)"
                                                          Value="@Draft.VisualDetail"
                                                          ValueChanged="value => SetLevel(nameof(NarratorProfileState.VisualDetail), value)"
                                                          DirtyPath="@nameof(NarratorProfileState.VisualDetail)" />
                        </div>
                    }
                    else
                    {
                        <div class="character-wizard-step-stack is-roomy">
                            <NarratorProfileSliderSection Title="Transition Context"
                                                          Hint="@NarratorProfileService.TransitionContextText(Draft.TransitionContext)"
                                                          Value="@Draft.TransitionContext"
                                                          ValueChanged="value => SetLevel(nameof(NarratorProfileState.TransitionContext), value)"
                                                          DirtyPath="@nameof(NarratorProfileState.TransitionContext)" />
                            <NarratorProfileSliderSection Title="Foreshadowing"
                                                          Hint="@NarratorProfileService.ForeshadowingText(Draft.Foreshadowing)"
                                                          Value="@Draft.Foreshadowing"
                                                          ValueChanged="value => SetLevel(nameof(NarratorProfileState.Foreshadowing), value)"
                                                          DirtyPath="@nameof(NarratorProfileState.Foreshadowing)" />
                            <NarratorProfileSliderSection Title="Story Direction"
                                                          Hint="@NarratorProfileService.DirectionText(Draft.DirectionStrength)"
                                                          Value="@Draft.DirectionStrength"
                                                          ValueChanged="value => SetLevel(nameof(NarratorProfileState.DirectionStrength), value)"
                                                          DirtyPath="@nameof(NarratorProfileState.DirectionStrength)" />
                        </div>
                    }
                </ChildContent>
                <Footer>
                    @if (Step > 0)
                    {
                        <AppButton Variant="secondary" Size="sm" OnClick="Back"><FaIcon Name="chevron-left" />Back</AppButton>
                    }
                    <span class="modal-action-spacer"></span>
                    @if (Step == Steps.Length - 1)
                    {
                        <BusyButton Variant="primary" Size="sm" OnClick="@(() => Complete(form))"><FaIcon Name="check" />Done</BusyButton>
                    }
                    else
                    {
                        <AppButton Variant="primary" Size="sm" OnClick="Next">Next<FaIcon Name="chevron-right" /></AppButton>
                        @if (IsComplete)
                        {
                            <BusyButton Variant="secondary" Size="sm" OnClick="@(() => Complete(form))"><FaIcon Name="check" />Done</BusyButton>
                        }
                    }
                </Footer>
            </ModalStackLayout>
        </MainContent>
    </ModalSplitLayout>
</ModalShell>
</ChildContent>
</StatefulForm>

@code {
    int Step;
    NarratorProfileState? LoadedProfile;
    NarratorProfileState Draft = NarratorProfileState.CreateDefault();
    NarratorProfileState Baseline = NarratorProfileState.CreateDefault();
    StatefulFormContext<NarratorProfileState>? Form;

    [Parameter] public NarratorProfileState Profile { get; set; } = NarratorProfileState.CreateDefault();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    static readonly WizardStep[] Steps =
    [
        new("voice", "Voice", "Style & custom guidance"),
        new("scene", "Scene", "Setup & visuals"),
        new("motion", "Motion", "Transitions & direction")
    ];

    static readonly IReadOnlyList<CharacterOption> VoiceOptions =
        NarratorProfileService.VoicePresets.Select(option => new CharacterOption(option.Id, option.Label, option.Description)).ToList();

    int DoneCount => Enumerable.Range(0, Steps.Length).Count(StepDone);
    bool IsComplete => DoneCount == Steps.Length;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(LoadedProfile, Profile))
            return;

        LoadedProfile = Profile;
        Draft = StatefulFormSnapshot.Clone(Profile);
        Baseline = StatefulFormSnapshot.Clone(Draft);
    }

    bool StepDone(int step) => step switch
    {
        0 => !string.IsNullOrWhiteSpace(Draft.VoicePreset),
        _ => true
    };

    bool StepDirty(int step) => step switch
    {
        0 => Form?.IsAnyPathDirty(nameof(NarratorProfileState.VoicePreset), nameof(NarratorProfileState.CustomGuidance)) == true,
        1 => Form?.IsAnyPathDirty(nameof(NarratorProfileState.SetupDepth), nameof(NarratorProfileState.VisualDetail)) == true,
        _ => Form?.IsAnyPathDirty(nameof(NarratorProfileState.TransitionContext), nameof(NarratorProfileState.Foreshadowing), nameof(NarratorProfileState.DirectionStrength)) == true
    };

    Task SetVoice(string id)
    {
        Draft.VoicePreset = id;
        Form?.NotifyChanged();
        return Task.CompletedTask;
    }

    void SetLevel(string property, int value)
    {
        var next = Math.Clamp(value, 0, 2);

        switch (property)
        {
            case nameof(NarratorProfileState.SetupDepth):
                Draft.SetupDepth = next;
                break;
            case nameof(NarratorProfileState.VisualDetail):
                Draft.VisualDetail = next;
                break;
            case nameof(NarratorProfileState.TransitionContext):
                Draft.TransitionContext = next;
                break;
            case nameof(NarratorProfileState.Foreshadowing):
                Draft.Foreshadowing = next;
                break;
            case nameof(NarratorProfileState.DirectionStrength):
                Draft.DirectionStrength = next;
                break;
        }
    }

    Task GoToStep(int step)
    {
        Step = step;
        return Task.CompletedTask;
    }

    Task Back()
    {
        if (Step > 0)
            Step--;

        return Task.CompletedTask;
    }

    Task Next()
    {
        if (Step < Steps.Length - 1)
            Step++;

        return Task.CompletedTask;
    }

    async Task Save()
    {
        CopyProfile(Draft, Profile);
        Baseline = StatefulFormSnapshot.Clone(Draft);
        await OnChanged.InvokeAsync();
    }

    async Task Complete(StatefulFormContext<NarratorProfileState> form)
    {
        if (form.HasChanges)
            await form.SaveAsync();

        await OnClose.InvokeAsync();
    }

    void SetForm(StatefulFormContext<NarratorProfileState> form) => Form = form;

    static void CopyProfile(NarratorProfileState source, NarratorProfileState target)
    {
        var snapshot = StatefulFormSnapshot.Clone(source);
        target.SchemaVersion = snapshot.SchemaVersion;
        target.VoicePreset = snapshot.VoicePreset;
        target.SetupDepth = snapshot.SetupDepth;
        target.VisualDetail = snapshot.VisualDetail;
        target.TransitionContext = snapshot.TransitionContext;
        target.Foreshadowing = snapshot.Foreshadowing;
        target.DirectionStrength = snapshot.DirectionStrength;
        target.CustomGuidance = snapshot.CustomGuidance;
        target.VoiceSelections = snapshot.VoiceSelections;
    }

    public sealed record WizardStep(string Id, string Label, string Sub);
}
