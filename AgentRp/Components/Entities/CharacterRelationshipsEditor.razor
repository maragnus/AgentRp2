@if (OtherCharacters.Count == 0)
{
    <div class="character-wizard-empty">
        <FaIcon Name="users" />
        <span>No other characters yet.<br />Relationships can be added later from the character editor.</span>
    </div>
}
else
{
    <div class="character-wizard-relationships">
        <p class="character-wizard-help">Toggle the characters this character knows, then define the dynamic from each direction.</p>
        @foreach (var other in OtherCharacters)
        {
            var rel = GetRelationship(other);
            var known = rel is not null;
            var expanded = ExpandedRelationships.Contains(other.Id);
            <article @key="other.Id" class="character-relationship @(known ? "is-known" : "") @(RelationshipDirty(other) ? "is-dirty" : "")">
                <SelectableButton Class="character-relationship-head" OnClick="@(_ => ToggleRelationshipRow(other))">
                    <span class="character-relationship-check @(known ? "is-selected" : "")" @onclick:stopPropagation="true" @onclick="() => ToggleRelationship(other)">
                        @if (known)
                        {
                            <FaIcon Name="check" />
                        }
                    </span>
                    <Avatar Name="@other.Name" Size="30" />
                    <span class="character-relationship-copy">
                        <strong>@other.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(other.Summary))
                        {
                            <small>@other.Summary</small>
                        }
                    </span>
                    @if (known)
                    {
                        <span class="character-relationship-meta">
                            @foreach (var bond in rel!.Bonds.Take(1))
                            {
                                <span @key="bond">@bond</span>
                            }
                            <FaIcon Name="@(expanded ? "chevron-up" : "chevron-down")" />
                        </span>
                    }
                </SelectableButton>
                @if (known && expanded)
                {
                    <CharacterRelationshipFieldsEditor SourceName="@SelfName"
                                                       TargetName="@other.Name"
                                                       RelationshipTypes="rel!.Bonds"
                                                       PrivateTensions="rel!.Dynamics"
                                                       BondTypes="BondTypes"
                                                       Dynamics="Dynamics"
                                                       HowSourceSeesTarget="@rel!.HowSourceSeesTarget"
                                                       HowSourceSeesTargetChanged="value => rel!.HowSourceSeesTarget = value"
                                                       HowTargetSeesSource="@rel!.HowTargetSeesSource"
                                                       HowTargetSeesSourceChanged="value => rel!.HowTargetSeesSource = value"
                                                       PublicDynamic="@rel!.PublicDynamic"
                                                       PublicDynamicChanged="value => rel!.PublicDynamic = value"
                                                       RelationshipTypesDirty="@RelationshipTypesDirty(rel!)"
                                                       PrivateTensionsDirty="@PrivateTensionsDirty(rel!)"
                                                       HowSourceSeesTargetDirty="@HowSourceSeesTargetDirty(rel!)"
                                                       HowTargetSeesSourceDirty="@HowTargetSeesSourceDirty(rel!)"
                                                       PublicDynamicDirty="@PublicDynamicDirty(rel!)"
                                                       OnChanged="Changed" />
                }
            </article>
        }
    </div>
}

@code {
    readonly HashSet<string> ExpandedRelationships = [];

    [Parameter] public RpCharacter Character { get; set; } = new();
    [Parameter] public List<RpCharacter> ExistingCharacters { get; set; } = [];
    [Parameter] public List<RpCharacterRelationship> Relationships { get; set; } = [];
    [Parameter] public IReadOnlyList<RpCharacterRelationship> BaselineRelationships { get; set; } = [];
    [Parameter] public CharacterTraitLibraryState Library { get; set; } = CharacterTraitLibraryState.CreateDefault();
    [Parameter] public EventCallback OnChanged { get; set; }

    IReadOnlyList<RpCharacter> OtherCharacters => ExistingCharacters.Where(character => character.Id != Character.Id).ToList();
    IReadOnlyList<string> BondTypes => Library.BondTypes;
    IReadOnlyList<string> Dynamics => Library.Dynamics;
    string SelfName => string.IsNullOrWhiteSpace(Character.Name) ? "this character" : Character.Name;

    CharacterRelationshipView? GetRelationship(RpCharacter other) =>
        CharacterRelationshipGraph.Find(Relationships, Character.Id, other.Id) is { } relationship
            ? CharacterRelationshipGraph.View(relationship, Character.Id, Character.Name, other.Id, other.Name)
            : null;

    CharacterRelationshipView? GetBaselineRelationship(CharacterRelationshipView relationship) =>
        BaselineRelationships.FirstOrDefault(item => string.Equals(item.Id, relationship.Relationship.Id, StringComparison.Ordinal)) is { } baseline
            ? CharacterRelationshipGraph.View(
                baseline,
                relationship.SourceCharacterId,
                relationship.SourceCharacterName,
                relationship.TargetCharacterId,
                relationship.TargetCharacterName)
            : null;

    async Task ToggleRelationship(RpCharacter other)
    {
        if (GetRelationship(other) is not null)
        {
            CharacterRelationshipGraph.Remove(Relationships, Character.Id, other.Id);
            ExpandedRelationships.Remove(other.Id);
            await Changed();
            return;
        }

        CharacterRelationshipGraph.GetOrCreate(Relationships, Character.Id, other.Id);
        ExpandedRelationships.Add(other.Id);
        await Changed();
    }

    async Task ToggleRelationshipRow(RpCharacter other)
    {
        if (GetRelationship(other) is null)
        {
            await ToggleRelationship(other);
            return;
        }

        if (!ExpandedRelationships.Remove(other.Id))
            ExpandedRelationships.Add(other.Id);
    }

    bool RelationshipDirty(RpCharacter other)
    {
        var id = CharacterRelationshipGraph.RelationshipIdFor(Character.Id, other.Id);
        return StatefulFormCollectionDirty.ItemDirty(Relationships, BaselineRelationships, id, relationship => relationship.Id);
    }

    bool RelationshipTypesDirty(CharacterRelationshipView relationship) =>
        StatefulFormCollectionDirty.ValueDirty(
            relationship.RelationshipTypes,
            GetBaselineRelationship(relationship)?.RelationshipTypes ?? []);

    bool PrivateTensionsDirty(CharacterRelationshipView relationship) =>
        StatefulFormCollectionDirty.ValueDirty(
            relationship.PrivateTensions,
            GetBaselineRelationship(relationship)?.PrivateTensions ?? []);

    bool HowSourceSeesTargetDirty(CharacterRelationshipView relationship) =>
        relationship.HowSourceSeesTarget != (GetBaselineRelationship(relationship)?.HowSourceSeesTarget ?? "");

    bool HowTargetSeesSourceDirty(CharacterRelationshipView relationship) =>
        relationship.HowTargetSeesSource != (GetBaselineRelationship(relationship)?.HowTargetSeesSource ?? "");

    bool PublicDynamicDirty(CharacterRelationshipView relationship) =>
        relationship.PublicDynamic != (GetBaselineRelationship(relationship)?.PublicDynamic ?? "");

    async Task Changed()
    {
        await OnChanged.InvokeAsync();
    }
}
