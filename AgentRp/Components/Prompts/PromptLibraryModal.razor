@inject IJSRuntime JS
@implements IDisposable

<ModalShell Title="Prompt Library" MaxWidth="860px" BodyClass="is-flush" OnClose="OnClose">
    <ModalTabGroup ActiveId="@Active" ActiveIdChanged="SwitchStep" Height="600px" RailWidth="156px">
        <ChildContent>
            @foreach (var step in Steps)
            {
                <ModalTab @key="step.Id" Id="@step.Id" Title="@step.Label" Dirty="@IsDirtyStep(step.Id)" />
            }
        </ChildContent>
        <RailFooter>
            <div class="prompt-rail-note">
                <div class="divider"></div>
                <p>Appearance · Selection shape prompts per step.</p>
                <p>Planning · Prose also include turn shape definitions.</p>
            </div>
        </RailFooter>
        <MainContent>
        <ModalStackLayout Class="modal-editor-main" BodyClass="modal-form-stack">
            <Header>
                <div class="prompt-stepbar">
                    <div>
                        <strong>@CurrentStep.Label</strong>
                        @if (CurrentStep.HasTurnShapes)
                        {
                            <Badge Tone="amber">Turn Shapes</Badge>
                        }
                    </div>
                    <SelectableButton Class="@($"placeholder-toggle {(ShowPlaceholders ? "is-active" : "")}")" OnClick="@(_ => ShowPlaceholders = !ShowPlaceholders)">
                        <code>{…}</code>
                        <span>Placeholders</span>
                        <FaIcon Name="@(ShowPlaceholders ? "chevron-up" : "chevron-down")" />
                    </SelectableButton>
                </div>

                @if (ShowPlaceholders)
                {
                    <div class="placeholder-panel">
                        <div class="pill-list">
                            @foreach (var placeholder in Placeholders[Active])
                            {
                                var copied = CopiedToken == placeholder.Token;
                                <SelectableButton @key="placeholder.Token" Class="@($"placeholder-token {(copied ? "is-copied" : "")}")" Title="@placeholder.Description" OnClick="@(_ => CopyToken(placeholder.Token))">
                                    <code>@placeholder.Token</code>
                                    <FaIcon Name="@(copied ? "check" : "copy")" />
                                </SelectableButton>
                            }
                        </div>
                        <div style="font-size:10.5px;color:var(--c-text3);margin-top:7px">Click any placeholder to copy it to your clipboard.</div>
                    </div>
                }
            </Header>
            <ChildContent>
                <PromptTextSection Label="System Prompt"
                                   Value="@PromptValues[Active].System"
                                   ValueChanged="@(value => SetSystem(value))"
                                   IsDirty="@(PromptValues[Active].System != DefaultPrompts[Active].System)"
                                   OnReset="@(() => ResetPrompt("system"))" />

                <PromptTextSection Label="User Prompt Template"
                                   Value="@PromptValues[Active].User"
                                   ValueChanged="@(value => SetUser(value))"
                                   IsDirty="@(PromptValues[Active].User != DefaultPrompts[Active].User)"
                                   OnReset="@(() => ResetPrompt("user"))" />

                @if (CurrentStep.HasTurnShapes)
                {
                    <Section Title="Turn Shapes">
                        <div class="turn-shape-list">
                            @foreach (var shape in TurnShapes[Active])
                            {
                                var dirty = shape.Value != DefaultTurnShapes[Active].First(def => def.Id == shape.Id).Value;
                                <div @key="shape.Id" class="turn-shape-row">
                                    <div>
                                        <code class="@(dirty ? "is-dirty" : "")">@shape.Label</code>
                                        <IconButton Icon="refresh" Title="Reset" Disabled="@(!dirty)" OnClick="@(_ => ResetTurnShape(shape.Id))" />
                                    </div>
                                    <textarea class="field mono" rows="2" value="@shape.Value" @onchange="@((ChangeEventArgs args) => UpdateTurnShape(shape.Id, args.Value?.ToString() ?? ""))"></textarea>
                                </div>
                            }
                        </div>
                    </Section>
                }
            </ChildContent>
            <Footer>
                <AppButton Variant="secondary" OnClick="@(_ => OnClose.InvokeAsync())">Cancel</AppButton>
                <AppButton Variant="primary" OnClick="Save"><FaIcon Name="check" />Save</AppButton>
            </Footer>
        </ModalStackLayout>
        </MainContent>
    </ModalTabGroup>
</ModalShell>

@code {
    sealed record PromptStep(string Id, string Label, bool HasTurnShapes);
    sealed record Placeholder(string Token, string Description);

    string Active = "appearance";
    bool ShowPlaceholders;
    string? CopiedToken;

    readonly PromptStep[] Steps =
    [
        new("appearance", "Appearance", false),
        new("selection", "Selection", true),
        new("planning", "Planning", true),
        new("prose", "Prose", true)
    ];

    Dictionary<string, PromptPairState> DefaultPrompts = new();
    Dictionary<string, List<ShapePromptState>> DefaultTurnShapes = new();
    Dictionary<string, Placeholder[]> Placeholders = new();

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    PromptStep CurrentStep => Steps.First(step => step.Id == Active);
    Dictionary<string, PromptPairState> PromptValues => Session.Chat.PromptLibrary.State.Prompts;
    Dictionary<string, List<ShapePromptState>> TurnShapes => Session.Chat.PromptLibrary.State.TurnShapes;

    protected override void OnInitialized()
    {
        Session.Chat.PromptLibrary.Changed += OnStoreChanged;
        DefaultPrompts = new()
        {
            ["appearance"] = new() { System = "You are a precise scene-state tracker for a collaborative fiction tool.", User = "Update observable positions, posture, expression, clothing, and proximity from {last_turn}." },
            ["selection"] = new() { System = "Choose the next responder from the active scene.", User = "Scene: {scene}\nCharacters: {characters}\nRecent turns: {transcript}" },
            ["planning"] = new() { System = "Produce a structured dramatic plan before prose.", User = "Character: {responder}\nTurn shape: {turn_shape}\nContext: {context}" },
            ["prose"] = new() { System = "Write polished contemporary roleplay prose.", User = "Write the next turn using {plan} and current appearance state." }
        };
        DefaultTurnShapes = new()
        {
            ["selection"] = Shapes("Compact", "Brief", "Extended"),
            ["planning"] = Shapes("Compact", "Brief", "Extended", "Monologue"),
            ["prose"] = Shapes("Compact", "Brief", "Extended", "Monologue", "Silent")
        };
        Placeholders = Steps.ToDictionary(
            step => step.Id,
            step => new[]
            {
                new Placeholder("{scene}", "Current scene and location"),
                new Placeholder("{characters}", "Active character summaries"),
                new Placeholder("{transcript}", "Recent chat transcript"),
                new Placeholder("{turn_shape}", "Selected turn shape"),
                new Placeholder("{appearance_state}", "Observable character state")
            });
    }

    Task OnStoreChanged() => InvokeAsync(StateHasChanged);

    static List<ShapePromptState> Shapes(params string[] labels) => labels.Select(label => new ShapePromptState { Id = label.ToLowerInvariant().Replace(" ", "-"), Label = label, Value = $"Use {label.ToLowerInvariant()} pacing and scope." }).ToList();

    void SwitchStep(string? id)
    {
        if (id is null)
            return;

        Active = id;
        ShowPlaceholders = false;
    }

    bool IsDirtyStep(string id)
    {
        var promptDirty = PromptValues[id].System != DefaultPrompts[id].System || PromptValues[id].User != DefaultPrompts[id].User;
        var shapeDirty = TurnShapes.ContainsKey(id) && TurnShapes[id].Any(shape => shape.Value != DefaultTurnShapes[id].First(def => def.Id == shape.Id).Value);
        return promptDirty || shapeDirty;
    }

    async Task SetSystem(string value)
    {
        PromptValues[Active].System = value;
        await Session.Chat.PromptLibrary.MarkChangedAsync();
    }

    async Task SetUser(string value)
    {
        PromptValues[Active].User = value;
        await Session.Chat.PromptLibrary.MarkChangedAsync();
    }

    async Task ResetPrompt(string field)
    {
        if (field == "system")
            PromptValues[Active].System = DefaultPrompts[Active].System;
        else
            PromptValues[Active].User = DefaultPrompts[Active].User;

        await Session.Chat.PromptLibrary.MarkChangedAsync();
    }

    async Task UpdateTurnShape(string id, string value)
    {
        TurnShapes[Active].First(shape => shape.Id == id).Value = value;
        await Session.Chat.PromptLibrary.MarkChangedAsync();
    }

    async Task ResetTurnShape(string id)
    {
        TurnShapes[Active].First(shape => shape.Id == id).Value = DefaultTurnShapes[Active].First(shape => shape.Id == id).Value;
        await Session.Chat.PromptLibrary.MarkChangedAsync();
    }

    async Task CopyToken(string token)
    {
        CopiedToken = token;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", token);
    }

    Task Save(MouseEventArgs args) => Session.Chat.PromptLibrary.MarkChangedAsync();

    public void Dispose()
    {
        Session.Chat.PromptLibrary.Changed -= OnStoreChanged;
    }
}
