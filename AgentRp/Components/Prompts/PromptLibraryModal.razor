@inject IJSRuntime JS
@implements IDisposable
@inject ILogger<PromptLibraryModal> Logger

<ModalShell Title="Prompt Library" MaxWidth="900px" BodyClass="is-flush" OnClose="OnClose">
    <ModalTabGroup ActiveId="@Active" ActiveIdChanged="SwitchStep" Height="600px" RailWidth="184px">
        <ChildContent>
            @foreach (var step in Steps)
            {
                <ModalTab @key="step.Id" Id="@step.Id" Title="@step.Label" Summary="@step.Group" Dirty="@IsDirtyStep(step.Id)" />
            }
        </ChildContent>
        <RailFooter>
            <div class="prompt-rail-note">
                <div class="divider"></div>
                <p>Generation prompts shape transcript output.</p>
                <p>Story Assistant prompts drive guided setup workflows.</p>
            </div>
        </RailFooter>
        <MainContent>
        <ModalStackLayout Class="modal-editor-main" BodyClass="modal-form-stack">
            <Header>
                <ModalPaneToolbar Class="prompt-stepbar">
                    <div>
                        <strong>@CurrentStep.Label</strong>
                        @if (CurrentStep.HasTurnShapes)
                        {
                            <Badge Tone="amber">Turn Shapes</Badge>
                        }
                    </div>
                    <span class="toolbar-spacer"></span>
                    <AppButton Variant="danger" Size="xs" Disabled="@(!IsDirty())" TooltipText="Reset all prompt pages" OnClick="@(_ => ConfirmResetAll = true)">
                        <FaIcon Name="refresh" />Reset All
                    </AppButton>
                    <SelectableButton Class="@($"placeholder-toggle {(ShowPlaceholders ? "is-active" : "")}")" OnClick="@(_ => ShowPlaceholders = !ShowPlaceholders)">
                        <code>{…}</code>
                        <span>Placeholders</span>
                        <FaIcon Name="@(ShowPlaceholders ? "chevron-up" : "chevron-down")" />
                    </SelectableButton>
                </ModalPaneToolbar>

                @if (ShowPlaceholders)
                {
                    <div class="placeholder-panel">
                        <div class="pill-list">
                            @foreach (var placeholder in PromptLibraryService.GetPlaceholders(Active))
                            {
                                var copied = CopiedToken == placeholder.Token;
                                <SelectableButton @key="placeholder.Token" Class="@($"placeholder-token {(copied ? "is-copied" : "")}")" TooltipText="@placeholder.Description" OnClick="@(_ => CopyToken(placeholder.Token))">
                                    <code>@placeholder.Token</code>
                                    <FaIcon Name="@(copied ? "check" : "copy")" />
                                </SelectableButton>
                            }
                        </div>
                        <InlineNote Class="placeholder-help">Click any placeholder to copy it to your clipboard.</InlineNote>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <InlineNote Tone="error">@ErrorMessage</InlineNote>
                }
            </Header>
            <ChildContent>
                <PromptTextSection Label="System Prompt"
                                   Value="@PromptValues[Active].System"
                                   ValueChanged="@(value => SetSystem(value))"
                                   IsDirty="@(PromptValues[Active].System != DefaultPrompts[Active].System)"
                                   OnReset="@(() => ResetPrompt("system"))" />

                <PromptTextSection Label="User Prompt Template"
                                   Value="@PromptValues[Active].User"
                                   ValueChanged="@(value => SetUser(value))"
                                   IsDirty="@(PromptValues[Active].User != DefaultPrompts[Active].User)"
                                   OnReset="@(() => ResetPrompt("user"))" />

                @if (CurrentStep.HasTurnShapes)
                {
                    <Section Title="Turn Shapes">
                        <div class="turn-shape-list">
                            @foreach (var shape in TurnShapes[Active])
                            {
                                var dirty = shape.Value != DefaultTurnShapes[Active].First(def => def.Id == shape.Id).Value;
                                <div @key="shape.Id" class="turn-shape-row">
                                    <div>
                                        <code class="@(dirty ? "is-dirty" : "")">@shape.Label</code>
                                        <AppButton Icon="refresh" TooltipText="Reset" Disabled="@(!dirty)" OnClick="@(_ => ResetTurnShape(shape.Id))" />
                                    </div>
                                    <AppTextarea Class="mono" Rows="2" Value="@shape.Value" ValueChanged="value => UpdateTurnShape(shape.Id, value)" />
                                </div>
                            }
                        </div>
                    </Section>
                }
            </ChildContent>
            <Footer>
                <AppButton Variant="secondary" OnClick="@(_ => OnClose.InvokeAsync())">Cancel</AppButton>
                <BusyButton Variant="primary" OnClick="Save"><FaIcon Name="check" />Save</BusyButton>
            </Footer>
        </ModalStackLayout>
        </MainContent>
    </ModalTabGroup>
</ModalShell>

@if (ConfirmResetAll)
{
    <ConfirmDialog Title="Reset all prompts?"
                   Body="This restores every system prompt, user prompt template, and turn shape on every Prompt Library page to defaults."
                   Icon="refresh"
                   ConfirmText="Reset All"
                   ConfirmVariant="rose"
                   OnCancel="@(() => ConfirmResetAll = false)"
                   OnConfirm="ResetAllPrompts" />
}

@code {
    string Active = PromptLibraryStageIds.SceneContinuity;
    bool ShowPlaceholders;
    bool ConfirmResetAll;
    string? CopiedToken;
    string? ErrorMessage;

    readonly IReadOnlyList<PromptLibraryStageDefinition> Steps = PromptLibraryService.GetStageDefinitions();
    readonly PromptLibraryState Defaults = PromptLibraryService.CreateDefaultState();

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    PromptLibraryStageDefinition CurrentStep => Steps.First(step => step.Id == Active);
    Dictionary<string, PromptPairState> PromptValues => Session.Chat.PromptLibrary.State.Prompts;
    Dictionary<string, List<ShapePromptState>> TurnShapes => Session.Chat.PromptLibrary.State.TurnShapes;
    Dictionary<string, PromptPairState> DefaultPrompts => Defaults.Prompts;
    Dictionary<string, List<ShapePromptState>> DefaultTurnShapes => Defaults.TurnShapes;

    protected override void OnInitialized()
    {
        Session.Chat.PromptLibrary.Changed += OnStoreChanged;
    }

    Task OnStoreChanged() => InvokeAsync(StateHasChanged);

    void SwitchStep(string? id)
    {
        if (id is null)
            return;

        Active = id;
        ShowPlaceholders = false;
        ErrorMessage = null;
    }

    bool IsDirtyStep(string id)
    {
        var promptDirty = PromptValues[id].System != DefaultPrompts[id].System || PromptValues[id].User != DefaultPrompts[id].User;
        var shapeDirty = TurnShapes.ContainsKey(id) && TurnShapes[id].Any(shape => shape.Value != DefaultTurnShapes[id].First(def => def.Id == shape.Id).Value);
        return promptDirty || shapeDirty;
    }

    bool IsDirty() => Steps.Any(step => IsDirtyStep(step.Id));

    async Task SetSystem(string value)
    {
        PromptValues[Active].System = value;
        await SaveChangesAsync();
    }

    async Task SetUser(string value)
    {
        PromptValues[Active].User = value;
        await SaveChangesAsync();
    }

    async Task ResetPrompt(string field)
    {
        if (field == "system")
            PromptValues[Active].System = DefaultPrompts[Active].System;
        else
            PromptValues[Active].User = DefaultPrompts[Active].User;

        await SaveChangesAsync();
    }

    async Task UpdateTurnShape(string id, string value)
    {
        TurnShapes[Active].First(shape => shape.Id == id).Value = value;
        await SaveChangesAsync();
    }

    async Task ResetTurnShape(string id)
    {
        TurnShapes[Active].First(shape => shape.Id == id).Value = DefaultTurnShapes[Active].First(shape => shape.Id == id).Value;
        await SaveChangesAsync();
    }

    async Task ResetAllPrompts()
    {
        ConfirmResetAll = false;
        ErrorMessage = null;
        try
        {
            await Session.Chat.PromptLibrary.ResetAllAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Resetting the prompt library failed.",
                "Resetting prompt library failed for chat {ChatId}.",
                Session.Chats.Active?.ChatId);
        }
    }

    async Task CopyToken(string token)
    {
        CopiedToken = token;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", token);
    }

    Task Save() => SaveChangesAsync();

    async Task SaveChangesAsync()
    {
        ErrorMessage = null;
        try
        {
            await Session.Chat.PromptLibrary.MarkChangedAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Saving the prompt library failed.",
                "Saving prompt library failed for chat {ChatId}.",
                Session.Chats.Active?.ChatId);
        }
    }

    public void Dispose()
    {
        Session.Chat.PromptLibrary.Changed -= OnStoreChanged;
    }
}
