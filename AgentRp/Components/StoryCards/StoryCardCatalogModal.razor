@namespace AgentRp.Components.StoryCards
@inject IStoryCardCatalogService Catalog
@inject IAppSettingsService AppSettings
@inject ILogger<StoryCardCatalogModal> Logger

<ModalShell Title="Card Library" Icon="cards" MaxWidth="1080px" Height="720px" BodyClass="is-flush" OnClose="OnClose">
    <ModalStackLayout BodyClass="story-card-catalog-body">
        <Header>
            <ModalPaneToolbar Class="story-card-catalog-toolbar">
                <div class="segmented">
                    <AppButton Size="sm" Active="@(View == MyCardsView)" OnClick="@(_ => SetView(MyCardsView))">
                        <FaIcon Name="user" />My Cards
                    </AppButton>
                    <AppButton Size="sm" Active="@(View == FavoritesView)" OnClick="@(_ => SetView(FavoritesView))">
                        <FaIcon Name="star" />Favorites
                    </AppButton>
                    <AppButton Size="sm" Active="@(View == AllCardsView)" OnClick="@(_ => SetView(AllCardsView))">
                        <FaIcon Name="cards" />All Cards
                    </AppButton>
                </div>
                <SearchField Value="@Search" ValueChanged="SetSearch" Placeholder="Search cards..." />
                <span class="toolbar-spacer"></span>
                <AppButton Icon="plus" TooltipText="New story card" OnClick="@(_ => NewTemplate())" />
            </ModalPaneToolbar>
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="modal-error">@ErrorMessage</div>
            }
        </Header>
        <ChildContent>
            @if (Templates.Count == 0)
            {
                <EmptyState Icon="cards" Title="No story cards" Message="Create a card template to reuse it across stories." />
            }
            else if (FilteredTemplates.Count == 0)
            {
                <EmptyState Icon="cards" Title="@EmptyTitle" Message="@EmptyMessage" />
            }
            else
            {
                <div class="story-card-catalog-grid">
                    @foreach (var template in FilteredTemplates)
                    {
                        <StoryCardView @key="template.Id"
                                       Model="@StoryCardViewModel.FromTemplate(template)"
                                       OnSelect="@(() => OpenDetails(template.Id))">
                            <ActionContent>
                                <AppButton Icon="star" Active="@FavoriteTemplateIds.Contains(template.Id)" TooltipText="@FavoriteTooltip(template)" StopPropagation OnClick="@(_ => ToggleFavorite(template.Id))" />
                                <AppButton Icon="eye" TooltipText="View" StopPropagation OnClick="@(_ => OpenDetails(template.Id))" />
                                @if (CanEdit(template))
                                {
                                    <AppButton Icon="edit" TooltipText="Edit" StopPropagation OnClick="@(_ => EditTemplate(template))" />
                                }
                                <BusyButton Variant="ghost" TooltipText="Remix" StopPropagation OnClick="@(() => Remix(template.Id))"><FaIcon Name="copy" /></BusyButton>
                            </ActionContent>
                        </StoryCardView>
                    }
                </div>
            }
        </ChildContent>
    </ModalStackLayout>
</ModalShell>

@if (!string.IsNullOrWhiteSpace(DetailsTemplateId))
{
    <StoryCardDetailsModal @key="DetailsKey"
                           TemplateId="@DetailsTemplateId"
                           OnClose="@CloseDetails"
                           OnAddToCurrentStory="OnAddToCurrentStory"
                           OnEditTemplate="EditTemplateFromDetails"
                           OnRemixTemplate="Remix"
                           OnRefreshStats="RefreshStats" />
}

@if (EditorTemplate is not null)
{
    <StoryCardEditorModal Template="EditorTemplate"
                          OnTemplateSaved="TemplateSaved"
                          OnTemplateArchived="TemplateArchived"
                          OnClose="CloseEditor" />
}

@code {
    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback<string> OnAddToCurrentStory { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    const string MyCardsView = "mine";
    const string FavoritesView = "favorites";
    const string AllCardsView = "all";

    List<StoryCardTemplate> Templates = [];
    HashSet<string> FavoriteTemplateIds = new(StringComparer.Ordinal);
    string View = MyCardsView;
    string Search = "";
    string DetailsTemplateId = "";
    int DetailsVersion;
    StoryCardTemplate? EditorTemplate;
    string ErrorMessage = "";
    string DetailsKey => $"{DetailsTemplateId}:{DetailsVersion}";
    IReadOnlyList<StoryCardTemplate> FilteredTemplates => Templates
        .Where(MatchesView)
        .Where(MatchesSearch)
        .ToList();
    string EmptyTitle => View == FavoritesView ? "No favorite cards" : "No cards found";
    string EmptyMessage => View == FavoritesView
        ? "Use the star on a card to keep it here."
        : "Adjust search or switch catalog views.";

    protected override async Task OnInitializedAsync()
    {
        await LoadPreferencesAsync();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        ErrorMessage = "";
        try
        {
            Templates = (await Catalog.LoadCatalogAsync(Session.CurrentUser)).ToList();
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Loading story cards failed.",
                "Loading story card catalog failed.");
        }
    }

    async Task LoadPreferencesAsync()
    {
        var preferences = await AppSettings.GetAsync(
            StoryCardCatalogPreferencesState.SettingsKey(Session.CurrentUser.Id),
            StoryCardCatalogPreferencesState.Default);
        FavoriteTemplateIds = preferences.FavoriteTemplateIds.ToHashSet(StringComparer.Ordinal);
    }

    Task SetView(string value)
    {
        View = value;
        return Task.CompletedTask;
    }

    Task SetSearch(string value)
    {
        Search = value;
        return Task.CompletedTask;
    }

    async Task ToggleFavorite(string templateId)
    {
        if (!FavoriteTemplateIds.Remove(templateId))
            FavoriteTemplateIds.Add(templateId);

        await AppSettings.SaveAsync(
            StoryCardCatalogPreferencesState.SettingsKey(Session.CurrentUser.Id),
            new StoryCardCatalogPreferencesState(FavoriteTemplateIds.OrderBy(id => id, StringComparer.Ordinal).ToList()));
    }

    void NewTemplate()
    {
        EditorTemplate = new()
        {
            Title = "New Story Card",
            OwnerUserId = Session.CurrentUser.Id,
            OwnerDisplayName = Session.CurrentUser.DisplayName,
            Phases =
            [
                new() { Id = $"phase-{Guid.NewGuid():N}", Title = "Opening Phase", SortOrder = 0, IsEnding = true }
            ]
        };
    }

    Task OpenDetails(string templateId)
    {
        DetailsTemplateId = templateId;
        return Task.CompletedTask;
    }

    Task CloseDetails()
    {
        DetailsTemplateId = "";
        return Task.CompletedTask;
    }

    Task EditTemplateFromDetails(StoryCardTemplate template)
    {
        DetailsTemplateId = "";
        EditTemplate(template);
        return Task.CompletedTask;
    }

    void EditTemplate(StoryCardTemplate template)
    {
        EditorTemplate = SessionCloner.Clone(template);
    }

    async Task Remix(string templateId)
    {
        ErrorMessage = "";
        try
        {
            var remix = await Catalog.RemixAsync(Session.CurrentUser, templateId);
            await LoadAsync();
            DetailsTemplateId = remix.Id;
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Remixing story card failed.",
                "Remixing story card template {TemplateId} failed.",
                templateId);
        }
    }

    async Task RefreshStats(string templateId)
    {
        ErrorMessage = "";
        try
        {
            var refreshed = await Catalog.RefreshStatsAsync(Session.CurrentUser, templateId);
            await LoadAsync();
            DetailsTemplateId = refreshed.Id;
            DetailsVersion++;
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Refreshing story card stats failed.",
                "Refreshing story card template {TemplateId} stats failed.",
                templateId);
        }
    }

    async Task TemplateSaved(StoryCardTemplate template)
    {
        await LoadAsync();
        DetailsTemplateId = template.Id;
    }

    async Task TemplateArchived(string templateId)
    {
        await LoadAsync();
        if (DetailsTemplateId == templateId)
            DetailsTemplateId = "";
    }

    Task CloseEditor()
    {
        EditorTemplate = null;
        return Task.CompletedTask;
    }

    bool CanEdit(StoryCardTemplate template) =>
        Session.CurrentUser.IsAdmin || template.OwnerUserId == Session.CurrentUser.Id;

    bool MatchesView(StoryCardTemplate template) => View switch
    {
        FavoritesView => FavoriteTemplateIds.Contains(template.Id),
        AllCardsView => true,
        _ => template.OwnerUserId == Session.CurrentUser.Id
    };

    bool MatchesSearch(StoryCardTemplate template)
    {
        if (string.IsNullOrWhiteSpace(Search))
            return true;

        return Contains(template.Title, Search)
            || Contains(template.Summary, Search)
            || Contains(template.OwnerDisplayName, Search);
    }

    string FavoriteTooltip(StoryCardTemplate template) =>
        FavoriteTemplateIds.Contains(template.Id) ? $"Remove {template.Title} from favorites" : $"Add {template.Title} to favorites";

    static bool Contains(string value, string search) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);
}
