@namespace AgentRp.Components.StoryCards
@implements IDisposable
@inject ILogger<StoryCardsStoryTab> Logger

<div class="story-card-story-tab">
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="modal-error">@ErrorMessage</div>
    }

    <Section Title="Story Cards" Count="@Cards.Count">
        <RightContent>
            <AppButton Icon="plus" TooltipText="Add story card" OnClick="@(_ => CatalogOpen = true)" />
        </RightContent>
        <ChildContent>
            @if (Cards.Count == 0)
            {
                <EmptyState Icon="cards" Title="No story cards" Message="Add a card when the story needs a reusable arc, role, item, or location structure." />
            }
            else
            {
                <div class="story-card-catalog-grid is-compact">
                    @foreach (var card in Cards)
                    {
                        <StoryCardView @key="card.Id"
                                       Model="@StoryCardViewModel.FromInstance(card, CurrentTurnNumber)"
                                       OnSelect="@(() => OpenDetails(card.Id))">
                            <ActionContent>
                                <AppButton Icon="eye" TooltipText="View" StopPropagation OnClick="@(_ => OpenDetails(card.Id))" />
                                @if (CanInspect)
                                {
                                    <AppButton Icon="edit" TooltipText="Edit" StopPropagation OnClick="@(_ => OpenEditor(card))" />
                                }
                            </ActionContent>
                        </StoryCardView>
                    }
                </div>
            }
        </ChildContent>
    </Section>
</div>

@if (CatalogOpen)
{
    <StoryCardCatalogModal OnAddToCurrentStory="Inject" OnClose="CloseCatalog" />
}

@if (DetailsInstance is not null)
{
    <StoryCardDetailsModal Instance="DetailsInstance"
                           CurrentTurnNumber="@CurrentTurnNumber"
                           CanInspectInstance="@CanInspect"
                           OnClose="CloseDetails"
                           OnEditInstance="EditInstanceFromDetails"
                           OnSetInstanceStatus="SetStatus" />
}

@if (EditorInstance is not null)
{
    <StoryCardEditorModal Instance="EditorInstance"
                          IncludeAssignments="true"
                          OnInstanceSaved="InstanceSaved"
                          OnClose="CloseEditor" />
}

@code {
    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;

    string DetailsInstanceId = "";
    StoryCardInstance? EditorInstance;
    string ErrorMessage = "";
    bool CatalogOpen;
    List<StoryCardInstance> Cards => Session.Chat.StoryCards.Items;
    bool CanInspect => Session.Chat.StoryCards.CanInspectInternals();
    int CurrentTurnNumber => Session.Chats.Active?.LastGeneratedTurnNumber ?? Session.ActiveChat.Current?.Chat.LastGeneratedTurnNumber ?? 0;
    StoryCardInstance? DetailsInstance => Cards.FirstOrDefault(card => card.Id == DetailsInstanceId);

    protected override void OnInitialized()
    {
        Session.Chat.StoryCards.Changed += OnStoreChanged;
    }

    Task OnStoreChanged() => InvokeAsync(StateHasChanged);

    Task OpenDetails(string id)
    {
        DetailsInstanceId = id;
        return Task.CompletedTask;
    }

    Task CloseDetails()
    {
        DetailsInstanceId = "";
        return Task.CompletedTask;
    }

    Task CloseCatalog()
    {
        CatalogOpen = false;
        return Task.CompletedTask;
    }

    async Task Inject(string templateId)
    {
        ErrorMessage = "";
        try
        {
            var instance = await Session.Chat.StoryCards.InjectAsync(templateId);
            CatalogOpen = false;
            DetailsInstanceId = instance.Id;
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Adding the story card failed.",
                "Injecting story card template {TemplateId} failed for chat {ChatId}.",
                templateId,
                Session.Chats.Active?.ChatId);
        }
    }

    Task EditInstanceFromDetails(StoryCardInstance instance)
    {
        DetailsInstanceId = "";
        OpenEditor(instance);
        return Task.CompletedTask;
    }

    void OpenEditor(StoryCardInstance instance)
    {
        EditorInstance = SessionCloner.Clone(instance);
    }

    async Task SetStatus(StoryCardStatus status)
    {
        if (DetailsInstance is null)
            return;

        ErrorMessage = "";
        try
        {
            await Session.Chat.StoryCards.SetStatusAsync(DetailsInstance.Id, status);
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Updating story card status failed.",
                "Updating story card {StoryCardInstanceId} status failed.",
                DetailsInstance.Id);
        }
    }

    Task InstanceSaved(StoryCardInstance instance)
    {
        DetailsInstanceId = instance.Id;
        return Task.CompletedTask;
    }

    Task CloseEditor()
    {
        EditorInstance = null;
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Session.Chat.StoryCards.Changed -= OnStoreChanged;
    }
}
