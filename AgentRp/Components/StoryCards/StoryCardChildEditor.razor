@namespace AgentRp.Components.StoryCards

<FormSection Title="@ChildTitle(Child.Title, Child.FallbackTitle)" Class="story-card-child-section" Dirty="@ChildDirty">
    <FieldRow Label="Title" Dirty="@TitleDirty">
        <AppInput Value="@Child.Title" ValueChanged="SetTitle" Disabled="@(!Editable)" Dirty="@TitleDirty" />
    </FieldRow>
    @if (Child.HasAssignment)
    {
        <FieldRow Label="Assigned">
            <span class="story-card-assignment">@Child.AssignmentText</span>
        </FieldRow>
    }
    <FieldRow Label="Selection" Dirty="@SelectionDirty">
        <AppTextarea Rows="4" Value="@Child.SelectionInstructions" ValueChanged="SetSelection" Disabled="@(!Editable)" Dirty="@SelectionDirty" />
    </FieldRow>
    <FieldRow Label="Creation" Dirty="@CreationDirty">
        <AppTextarea Rows="4" Value="@Child.CreationInstructions" ValueChanged="SetCreation" Disabled="@(!Editable)" Dirty="@CreationDirty" />
    </FieldRow>
    <FieldRow Label="Ongoing Context" Dirty="@OngoingDirty">
        <AppTextarea Rows="4" Value="@Child.OngoingContext" ValueChanged="SetOngoing" Disabled="@(!Editable)" Dirty="@OngoingDirty" />
    </FieldRow>
    @if (Child.IncludePrivate)
    {
        <FieldRow Label="Private Context" Dirty="@PrivateDirty">
            <AppTextarea Rows="4" Value="@Child.PrivateContext" ValueChanged="SetPrivate" Disabled="@(!Editable)" Dirty="@PrivateDirty" />
        </FieldRow>
    }
</FormSection>

@code {
    [Parameter] public StoryCardChildEditorRow Child { get; set; } = default!;
    [Parameter] public StoryCardChildEditorRow? BaselineChild { get; set; }
    [Parameter] public bool Editable { get; set; }
    [CascadingParameter] public IStatefulFormContext? StatefulForm { get; set; }

    Task SetTitle(string value)
    {
        Child.Title = value;
        StatefulForm?.NotifyChanged();
        return Task.CompletedTask;
    }

    Task SetSelection(string value)
    {
        Child.SelectionInstructions = value;
        StatefulForm?.NotifyChanged();
        return Task.CompletedTask;
    }

    Task SetCreation(string value)
    {
        Child.CreationInstructions = value;
        StatefulForm?.NotifyChanged();
        return Task.CompletedTask;
    }

    Task SetOngoing(string value)
    {
        Child.OngoingContext = value;
        StatefulForm?.NotifyChanged();
        return Task.CompletedTask;
    }

    Task SetPrivate(string value)
    {
        Child.PrivateContext = value;
        StatefulForm?.NotifyChanged();
        return Task.CompletedTask;
    }

    static string ChildTitle(string title, string fallback) => string.IsNullOrWhiteSpace(title) ? fallback : title;

    bool ChildDirty =>
        BaselineChild is null || TitleDirty || SelectionDirty || CreationDirty || OngoingDirty || PrivateDirty;

    bool TitleDirty => BaselineChild is null || Child.Title != BaselineChild.Title;
    bool SelectionDirty => BaselineChild is null || Child.SelectionInstructions != BaselineChild.SelectionInstructions;
    bool CreationDirty => BaselineChild is null || Child.CreationInstructions != BaselineChild.CreationInstructions;
    bool OngoingDirty => BaselineChild is null || Child.OngoingContext != BaselineChild.OngoingContext;
    bool PrivateDirty => Child.IncludePrivate && (BaselineChild is null || Child.PrivateContext != BaselineChild.PrivateContext);
}
