@inject IAiProviderConnectionService ProviderConnectionService
@inject ILogger<ProviderConnectionEditor> Logger

<StatefulForm Model="@Draft" Baseline="@Baseline" OnSave="Save" OnClose="Noop" CanSave="@(() => Validation.IsValid)" ContextChanged="SetFormContext" DisableNavigationGuard>
    <ChildContent Context="form">
        <FormSection Title="Connection" Class="provider-section" Dirty="@form.HasChanges">
            <AppField Label="Display Name" DirtyPath="@nameof(Draft.Name)">
                <AppInput Value="@Draft.Name" ValueChanged="SetName" ValueExpression="@(() => Draft.Name)" DirtyPath="@nameof(Draft.Name)" UpdateMode="TextUpdateMode.Change" />
            </AppField>
            <AppField Label="@Meta.KeyLabel" Hint="Stored locally, never sent to our servers." DirtyPath="@nameof(Draft.ApiKey)">
                <LabelAction>
                    @if (!string.IsNullOrWhiteSpace(Meta.KeyLink))
                    {
                        <a href="@Meta.KeyLink" target="_blank" rel="noopener noreferrer">Get your key -></a>
                    }
                </LabelAction>
                <ChildContent><KeyInput Value="@Draft.ApiKey" ValueChanged="SetApiKey" ValueExpression="@(() => Draft.ApiKey)" DirtyPath="@nameof(Draft.ApiKey)" /></ChildContent>
            </AppField>
            @if (Provider.Type is "grok" or "claude")
            {
                <AppField Label="Admin / Management Key" Hint="Used only for provider usage, billing, or management widgets." DirtyPath="@nameof(Draft.ManagementApiKey)">
                    <ChildContent><KeyInput Value="@Draft.ManagementApiKey" ValueChanged="SetManagementApiKey" ValueExpression="@(() => Draft.ManagementApiKey)" DirtyPath="@nameof(Draft.ManagementApiKey)" /></ChildContent>
                </AppField>
            }
            @if (Meta.NeedsEndpoint)
            {
                <AppField Label="Endpoint URL" DirtyPath="@nameof(Draft.Endpoint)">
                    <LabelAction><span class="field-status-pill @(Meta.EndpointRequired ? "is-required" : "")">@(Meta.EndpointRequired ? "Required" : "Optional")</span></LabelAction>
                    <ChildContent><AppInput Value="@Draft.Endpoint" ValueChanged="SetEndpoint" ValueExpression="@(() => Draft.Endpoint)" DirtyPath="@nameof(Draft.Endpoint)" Placeholder="https://..." UpdateMode="TextUpdateMode.Change" /></ChildContent>
                </AppField>
            }
            @if (Provider.Type is "openai" or "claude")
            {
                <AppField Label="Project" DirtyPath="@nameof(Draft.ProjectId)">
                    <ChildContent><AppInput Value="@Draft.ProjectId" ValueChanged="SetProjectId" ValueExpression="@(() => Draft.ProjectId)" DirtyPath="@nameof(Draft.ProjectId)" UpdateMode="TextUpdateMode.Change" /></ChildContent>
                </AppField>
                <AppField Label="Account" DirtyPath="@nameof(Draft.AccountId)">
                    <ChildContent><AppInput Value="@Draft.AccountId" ValueChanged="SetAccountId" ValueExpression="@(() => Draft.AccountId)" DirtyPath="@nameof(Draft.AccountId)" UpdateMode="TextUpdateMode.Change" /></ChildContent>
                </AppField>
            }
            @if (Provider.Type == "grok")
            {
                <AppField Label="Team" DirtyPath="@nameof(Draft.TeamId)">
                    <ChildContent><AppInput Value="@Draft.TeamId" ValueChanged="SetTeamId" ValueExpression="@(() => Draft.TeamId)" DirtyPath="@nameof(Draft.TeamId)" UpdateMode="TextUpdateMode.Change" /></ChildContent>
                </AppField>
            }

            @if (!Validation.IsValid && form.HasChanges)
            {
                <div class="modal-error">@Validation.Message</div>
            }
            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <span class="provider-connected"><FaIcon Name="check" />@StatusMessage</span>
            }
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="modal-error">@ErrorMessage</div>
            }

            <div class="provider-section-actions">
                <BusyButton Variant="primary" Size="sm" Disabled="@(!form.CanSave)" OnClick="form.SaveAsync">
                    <FaIcon Name="check" />Save
                </BusyButton>
                <BusyButton Variant="secondary" Size="sm" Disabled="@(!Validation.IsValid)" OnClick="Test">
                    <FaIcon Name="zap" />Test connection
                </BusyButton>
            </div>
        </FormSection>
    </ChildContent>
</StatefulForm>

@code {
    ProviderConnectionDraft Draft = new();
    ProviderConnectionDraft Baseline = new();
    string? DraftProviderId;
    string ErrorMessage = "";
    string StatusMessage = "";

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public AiProvider Provider { get; set; } = new();
    [Parameter] public AiProviderMeta Meta { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public Action<IStatefulFormContext>? FormContextChanged { get; set; }

    ProviderConnectionValidation Validation => ProviderConnectionValidation.Validate(Meta, Draft);
    protected override void OnParametersSet()
    {
        if (DraftProviderId == Provider.Id)
            return;

        Draft = ProviderConnectionDraft.FromProvider(Provider);
        Baseline = ProviderConnectionDraft.FromProvider(Provider);
        DraftProviderId = Provider.Id;
        ErrorMessage = "";
        StatusMessage = "";
    }

    async Task Save()
    {
        ErrorMessage = "";
        StatusMessage = "";
        if (!Validation.IsValid)
            return;

        try
        {
            Draft.ApplyTo(Provider);
            await Session.Providers.MarkChangedAsync();
            Draft = ProviderConnectionDraft.FromProvider(Provider);
            Baseline = ProviderConnectionDraft.FromProvider(Provider);
            StatusMessage = "Saved";
            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                $"Saving {Provider.Name} connection failed.",
                "Saving provider connection {ProviderId} failed.",
                Provider.Id);
        }
    }

    async Task Test()
    {
        ErrorMessage = "";
        StatusMessage = "";
        if (!Validation.IsValid)
            return;

        try
        {
            await ProviderConnectionService.TestProviderAsync(Draft.CloneProvider(Provider));
            StatusMessage = "Connected";
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                $"Testing {Draft.Name} failed.",
                "Testing provider connection {ProviderId} failed.",
                Provider.Id);
        }
    }

    void SetName(string value) => UpdateDraft(() => Draft.Name = value);
    Task SetApiKey(string value)
    {
        UpdateDraft(() => Draft.ApiKey = value);
        return Task.CompletedTask;
    }

    Task SetManagementApiKey(string value)
    {
        UpdateDraft(() => Draft.ManagementApiKey = value);
        return Task.CompletedTask;
    }

    void SetEndpoint(string value) => UpdateDraft(() => Draft.Endpoint = value);
    void SetAccountId(string value) => UpdateDraft(() => Draft.AccountId = value);
    void SetProjectId(string value) => UpdateDraft(() => Draft.ProjectId = value);
    void SetTeamId(string value) => UpdateDraft(() => Draft.TeamId = value);
    static Task Noop() => Task.CompletedTask;

    void SetFormContext(StatefulFormContext<ProviderConnectionDraft> form) => FormContextChanged?.Invoke(form);

    void UpdateDraft(Action update)
    {
        update();
        ErrorMessage = "";
        StatusMessage = "";
    }
}
