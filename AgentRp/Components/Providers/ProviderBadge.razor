<span class="@CssClass">@Glyph</span>

@code {
    [Parameter] public string Type { get; set; } = "compatible";
    [Parameter] public int Size { get; set; } = 28;
    string CssClass => $"provider-badge provider-{Type} provider-badge-{SizeClass}";
    string SizeClass => Size switch
    {
        <= 28 => "sm",
        <= 32 => "md",
        _ => "lg"
    };

    string Glyph => Type switch
    {
        "grok" => "⚡",
        "claude" => "✦",
        "huggingface" => "🤗",
        "openai" => "⬡",
        _ => "⬡"
    };
}
