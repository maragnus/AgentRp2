@if (ShowHeader)
{
    <SectionHeader Title="@Title" Count="@SelectedCount" MaxCount="@Models.Count" />
}

<div class="provider-model-toolbar">
    <div class="provider-model-summary">
        <span>@ReadyCount ready</span>
        @if (NeedsSetupCount > 0)
        {
            <span>@NeedsSetupCount need setup</span>
        }
    </div>
    <div class="provider-model-actions">
        @if (CanToggleNeedsSetup)
        {
            <span class="provider-model-filter">
                <span>Show setup</span>
                <ToggleSwitch Value="@ShowNeedsSetup" ValueChanged="SetShowNeedsSetup" TooltipText="Show models needing setup" />
            </span>
        }
        <AppButton Variant="secondary"
                   Size="xs"
                   Disabled="@(!HasSelectedModels)"
                   TooltipText="Clear selected models"
                   OnClick="@(_ => ClearModels())">
            <FaIcon Name="x" />Clear
        </AppButton>
    </div>
</div>

@if (Models.Count > 0 && VisibleModelsList.Count == 0)
{
    <div class="providers-empty-state is-compact">
        <FaIcon Name="layers" />
        <strong>No configured models visible</strong>
        <span>Show setup models to configure the rest.</span>
    </div>
}
else
{
    <SelectableList Class="provider-model-list">
        @foreach (var model in VisibleModelsList)
        {
            <ProviderModelRow @key="model.Id" ProviderType="@ProviderType" Model="model" OnChanged="OnChanged" OnSetup="OnSetup" />
        }
    </SelectableList>
}

@code {
    [Parameter] public IReadOnlyList<AiProviderModel> Models { get; set; } = [];
    [Parameter] public string ProviderType { get; set; } = "";
    [Parameter] public string Title { get; set; } = "Models";
    [Parameter] public bool ShowHeader { get; set; }
    [Parameter] public bool ShowNeedsSetup { get; set; }
    [Parameter] public EventCallback<bool> ShowNeedsSetupChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<AiProviderModel> OnSetup { get; set; }

    int ReadyCount => ProviderModelListRules.ReadyCount(Models);
    int NeedsSetupCount => ProviderModelListRules.NeedsSetupCount(Models);
    int SelectedCount => Models.Count(ProviderModelListRules.IsSelectedForAnyRole);
    bool HasSelectedModels => SelectedCount > 0;
    bool CanToggleNeedsSetup => ReadyCount > 0 && NeedsSetupCount > 0;
    IReadOnlyList<AiProviderModel> VisibleModelsList => ProviderModelListRules.VisibleModels(Models, ShowNeedsSetup).ToList();

    async Task SetShowNeedsSetup(bool value)
    {
        ShowNeedsSetup = value;
        await ShowNeedsSetupChanged.InvokeAsync(value);
    }

    async Task ClearModels()
    {
        foreach (var model in Models)
            ProviderModelListRules.ClearSelectedRoles(model);

        await OnChanged.InvokeAsync();
    }
}
