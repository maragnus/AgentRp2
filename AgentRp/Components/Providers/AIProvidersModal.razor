@implements IDisposable
@inject IAiProviderConnectionService ProviderConnectionService
@inject IModelCapabilityCatalog CapabilityCatalog
@inject IAiProviderWidgetService ProviderWidgetService

<ModalShell Title="AI Providers" MaxWidth="900px" BodyClass="is-flush" OnClose="OnClose">
    <ModalSplitLayout RailWidth="230px">
        <RailHeader>
            <span>Providers</span>
            <IconButton Icon="plus" Title="Add provider" Class="providers-add-button" OnClick="@(_ => StartAdd())" />
        </RailHeader>
        <RailContent>
                @foreach (var provider in Providers)
                {
                    var selected = provider.Id == SelectedId && OnboardStep == 0;
                    var counts = Counts(provider);
                    <SidebarListRow @key="provider.Id"
                                    Title="@provider.Name"
                                    Summary="@($"{counts.TextCount}t · {counts.ImageCount}i")"
                                    Count="@((counts.TextCount + counts.ImageCount).ToString())"
                                    Active="@selected"
                                    Class="provider-row"
                                    OnClick="@(_ => Select(provider.Id))">
                        <LeadingContent><ProviderBadge Type="@provider.Type" Size="28" /></LeadingContent>
                    </SidebarListRow>
                }
                @if (Providers.Count == 0)
                {
                    <div class="providers-empty">No providers yet.<br />Click + to add one.</div>
                }
        </RailContent>
        <RailFooter>
            <AppButton Variant="outline" Size="xs" Class="providers-footer-button"><FaIcon Name="upload" />Export</AppButton>
            <AppButton Variant="outline" Size="xs" Class="providers-footer-button"><FaIcon Name="download" />Import</AppButton>
        </RailFooter>
        <MainContent>
            @if (OnboardStep == 1)
            {
                <ModalStackLayout BodyClass="modal-form-stack">
                    <Header>
                        <SectionHeader Title="Connect a provider" Hint="Choose the platform you want to use for AI generation." />
                    </Header>
                    <ChildContent>
                        <div class="provider-pick-grid">
                            @foreach (var meta in ProviderTypes)
                            {
                                <SelectableButton @key="meta.Id" Class="provider-pick" OnClick="@(_ => PickProviderType(meta.Id))">
                                    <ProviderBadge Type="@meta.Id" Size="32" />
                                    <span>
                                        <strong>@meta.Name</strong>
                                        <small>@meta.Description</small>
                                    </span>
                                </SelectableButton>
                            }
                        </div>
                    </ChildContent>
                    <Footer>
                        <StepPips Current="0" />
                        <span class="modal-action-spacer"></span>
                        <AppButton Variant="secondary" Size="sm" OnClick="@(_ => CancelOnboarding())">Cancel</AppButton>
                    </Footer>
                </ModalStackLayout>
            }
            else if (OnboardStep == 2 && OnboardMeta is not null)
            {
                <ModalStackLayout BodyClass="modal-form-stack">
                    <Header>
                        <SectionHeader Title="@($"Configure {OnboardMeta.Name}")" Hint="Enter your credentials to connect this provider.">
                            <RightContent><ProviderBadge Type="@OnboardMeta.Id" Size="28" /></RightContent>
                        </SectionHeader>
                    </Header>
                    <ChildContent>
                        @if (!string.IsNullOrWhiteSpace(ProviderError))
                        {
                            <div class="modal-error">@ProviderError</div>
                        }
                        @if (OnboardMeta.NeedsEndpoint)
                        {
                            <AppField Label="Endpoint URL" Hint="@EndpointHint">
                                <LabelAction><span class="field-status-pill @(OnboardMeta.EndpointRequired ? "is-required" : "")">@(OnboardMeta.EndpointRequired ? "Required" : "Optional")</span></LabelAction>
                                <ChildContent><input class="field" value="@OnboardEndpoint" placeholder="https://your-endpoint.example.com/v1" @oninput="args => OnboardEndpoint = args.Value?.ToString() ?? string.Empty" /></ChildContent>
                            </AppField>
                        }
                        <AppField Label="@OnboardMeta.KeyLabel" Hint="Stored locally only, never sent to our servers.">
                            <LabelAction>
                                <span class="field-status-pill @(OnboardMeta.ApiKeyRequired ? "is-required" : "")">@(OnboardMeta.ApiKeyRequired ? "Required" : "Optional")</span>
                                @if (!string.IsNullOrWhiteSpace(OnboardMeta.KeyLink))
                                {
                                    <a href="@OnboardMeta.KeyLink" target="_blank" rel="noopener noreferrer">Get your key -></a>
                                }
                            </LabelAction>
                            <ChildContent><KeyInput @bind-Value="OnboardApiKey" /></ChildContent>
                        </AppField>
                    </ChildContent>
                    <Footer>
                        <StepPips Current="1" />
                        <span class="modal-action-spacer"></span>
                        <span class="modal-action-group">
                            <AppButton Variant="secondary" Size="sm" OnClick="@(_ => BackToPick())">Back</AppButton>
                            <BusyButton Variant="primary" Size="sm" Disabled="@(!CanFetchModels)" OnClick="FetchModels">
                                Fetch models <FaIcon Name="chevron-right" />
                            </BusyButton>
                        </span>
                    </Footer>
                </ModalStackLayout>
            }
            else if (OnboardStep == 3 && OnboardMeta is not null)
            {
                <ModalStackLayout BodyClass="modal-form-stack">
                    <Header>
                        <SectionHeader Title="@(OnboardModels.Count == 0 ? "No models discovered" : "Choose your models")"
                                       Hint="@(OnboardModels.Count == 0 ? "You can configure models manually later." : $"{OnboardModels.Count} models found. Enable the ones you want.")" />
                    </Header>
                    <ChildContent>
                        @if (!string.IsNullOrWhiteSpace(ProviderError))
                        {
                            <div class="modal-error">@ProviderError</div>
                        }
                        @if (OnboardModels.Count == 0)
                        {
                            <div class="providers-empty-state">
                                <FaIcon Name="layers" />
                                <strong>No models returned from this endpoint.</strong>
                                <span>You can add models manually after connecting.</span>
                            </div>
                        }
                        else
                        {
                            <ProviderModelList Models="OnboardModels"
                                               ShowHeader="true"
                                               ShowNeedsSetup="@ShowModelsNeedingSetup"
                                               ShowNeedsSetupChanged="value => ShowModelsNeedingSetup = value"
                                               OnChanged="OnOnboardModelChanged"
                                               OnSetup="model => OpenSetup(BuildOnboardProvider(), model)" />
                        }
                    </ChildContent>
                    <Footer>
                        <StepPips Current="2" />
                        <span class="modal-action-spacer"></span>
                        <span class="modal-action-group">
                            <AppButton Variant="secondary" Size="sm" OnClick="@(_ => OnboardStep = 2)">Back</AppButton>
                            <AppButton Variant="primary" Size="sm" OnClick="@(_ => FinishOnboarding())"><FaIcon Name="check" />Add provider</AppButton>
                        </span>
                    </Footer>
                </ModalStackLayout>
            }
            else if (Selected is not null)
            {
                var meta = MetaFor(Selected.Type);
                var counts = Counts(Selected);
                <ModalStackLayout BodyClass="provider-detail-content">
                    <Header>
                        <ModalPaneHeader Class="provider-detail-head">
                            <div class="provider-title-lockup">
                                <ProviderBadge Type="@Selected.Type" Size="40" />
                                <span>
                                    <strong>@Selected.Name</strong>
                                    <small>@counts.TextCount text · @counts.ImageCount image · @Selected.Models.Count total</small>
                                </span>
                            </div>
                            <div class="provider-enabled-wrap">
                                <span>@(Selected.Enabled ? "Enabled" : "Disabled")</span>
                                <ToggleSwitch Value="Selected.Enabled" ValueChanged="value => SetProviderEnabled(Selected, value)" Title="Toggle provider enabled" />
                            </div>
                        </ModalPaneHeader>

                        <ModalPaneActionBar Class="provider-action-bar">
                            <AppButton Variant="primary" Size="sm" OnClick="SaveSelectedClick"><FaIcon Name="check" />Save</AppButton>
                            <BusyButton Variant="secondary" Size="sm" OnClick="TestProvider"><FaIcon Name="zap" />Test connection</BusyButton>
                            <BusyButton Variant="secondary" Size="sm" OnClick="RefreshModels"><FaIcon Name="refresh" />Refresh models</BusyButton>
                            <BusyButton Variant="secondary" Size="sm" OnClick="RefreshWidget"><FaIcon Name="chart-line" />Refresh widget</BusyButton>
                            @if (TestOk is true)
                            {
                                <span class="provider-connected"><FaIcon Name="check" />Connected</span>
                            }
                            <span class="modal-action-spacer"></span>
                            <AppButton Variant="danger" Size="sm" OnClick="@(_ => ConfirmDelete = true)"><FaIcon Name="trash" />Delete</AppButton>
                        </ModalPaneActionBar>
                    </Header>
                    <ChildContent>
                        @if (!string.IsNullOrWhiteSpace(ProviderError))
                        {
                            <div class="modal-error">@ProviderError</div>
                        }
                        <Section Title="Connection" Class="provider-section">
                            <AppField Label="Display Name">
                                <input class="field" value="@Selected.Name" @oninput="args => Selected.Name = args.Value?.ToString() ?? string.Empty" />
                            </AppField>
                            <AppField Label="@meta.KeyLabel" Hint="Stored locally, never sent to our servers.">
                                <LabelAction>
                                    @if (!string.IsNullOrWhiteSpace(meta.KeyLink))
                                    {
                                        <a href="@meta.KeyLink" target="_blank" rel="noopener noreferrer">Get your key -></a>
                                    }
                                </LabelAction>
                                <ChildContent><KeyInput @bind-Value="Selected.ApiKey" /></ChildContent>
                            </AppField>
                            @if (Selected.Type is "grok" or "claude")
                            {
                                <AppField Label="Admin / Management Key" Hint="Used only for provider usage, billing, or management widgets.">
                                    <ChildContent><KeyInput @bind-Value="Selected.ManagementApiKey" /></ChildContent>
                                </AppField>
                            }
                            @if (meta.NeedsEndpoint)
                            {
                                <AppField Label="Endpoint URL">
                                    <LabelAction><span class="field-status-pill @(meta.EndpointRequired ? "is-required" : "")">@(meta.EndpointRequired ? "Required" : "Optional")</span></LabelAction>
                                    <ChildContent><input class="field" value="@Selected.Endpoint" placeholder="https://..." @oninput="args => Selected.Endpoint = args.Value?.ToString() ?? string.Empty" /></ChildContent>
                                </AppField>
                            }
                            @if (Selected.Type is "openai" or "claude")
                            {
                                <AppField Label="Project">
                                    <ChildContent><input class="field" value="@Selected.ProjectId" @oninput="args => Selected.ProjectId = args.Value?.ToString() ?? string.Empty" /></ChildContent>
                                </AppField>
                                <AppField Label="Account">
                                    <ChildContent><input class="field" value="@Selected.AccountId" @oninput="args => Selected.AccountId = args.Value?.ToString() ?? string.Empty" /></ChildContent>
                                </AppField>
                            }
                            @if (Selected.Type == "grok")
                            {
                                <AppField Label="Team">
                                    <ChildContent><input class="field" value="@Selected.TeamId" @oninput="args => Selected.TeamId = args.Value?.ToString() ?? string.Empty" /></ChildContent>
                                </AppField>
                            }
                        </Section>

                        <Section Title="Provider Widget" Hint="@ProviderWidgetHint(Selected)" Class="provider-section">
                            <ChildContent>
                                @if (!string.IsNullOrWhiteSpace(Selected.LastMetricsError))
                                {
                                    <div class="modal-error">@Selected.LastMetricsError</div>
                                }
                                @if (Selected.Metrics.Count == 0)
                                {
                                    <div class="providers-empty-state is-compact">
                                        <FaIcon Name="chart-line" />
                                        <strong>No widget details loaded</strong>
                                        <span>Refresh the widget to load provider-specific status.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="provider-metric-grid">
                                        @foreach (var metric in Selected.Metrics)
                                        {
                                            <div @key="metric.Id" class="provider-metric-card" title="@metric.Detail">
                                                <small>@metric.Label</small>
                                                <strong>@metric.Value</strong>
                                                @if (!string.IsNullOrWhiteSpace(metric.Detail))
                                                {
                                                    <span>@metric.Detail</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (Selected.Type == "huggingface")
                                {
                                    <div class="provider-endpoint-stack">
                                        @foreach (var model in Selected.Models.Where(model => !string.IsNullOrWhiteSpace(model.Endpoint)))
                                        {
                                            <HuggingFaceEndpointWidget @key="model.Id" Provider="@Selected" Model="@model" />
                                        }
                                    </div>
                                }
                            </ChildContent>
                        </Section>

                        <Section Title="Models" Hint="Enable models for Chat, Image Gen, or both." Class="provider-section">
                            <ChildContent>
                                <ProviderModelList Models="Selected.Models"
                                                   ShowNeedsSetup="@ShowModelsNeedingSetup"
                                                   ShowNeedsSetupChanged="value => ShowModelsNeedingSetup = value"
                                                   OnChanged="SaveSelected"
                                                   OnSetup="model => OpenSetup(Selected, model)" />
                            </ChildContent>
                        </Section>
                    </ChildContent>
                </ModalStackLayout>
            }
            else
            {
                <div class="providers-empty-state">
                    <FaIcon Name="zap" />
                    <strong>No provider selected</strong>
                    <span>Select a provider or add a new one.</span>
                    <AppButton Variant="primary" Size="sm" OnClick="@(_ => StartAdd())"><FaIcon Name="plus" />Add provider</AppButton>
                </div>
            }
        </MainContent>
    </ModalSplitLayout>
</ModalShell>

@if (ConfirmDelete && Selected is not null)
{
    <ConfirmDialog Title="@($"Delete \"{Selected.Name}\" provider?")"
                   Body="This provider and all its configured models will be removed."
                   OnCancel="@(() => ConfirmDelete = false)"
                   OnConfirm="DeleteProvider" />
}

@if (SetupModel is not null)
{
    <ModalShell Title="Set Up Model" Subtitle="@SetupModel.Id" Icon="wrench" MaxWidth="620px" Height="" OnClose="CloseSetup">
        <ChildContent>
            <Section Title="Roles" Hint="Choose how AgentRp can use this model.">
                <div class="setup-grid">
                    <label class="setup-toggle-row">
                        <span><strong>Chat</strong><small>Text input and text output</small></span>
                        <ToggleSwitch Value="@SetupChat" ValueChanged="value => SetupChat = value" Title="Toggle chat capability" />
                    </label>
                    <label class="setup-toggle-row">
                        <span><strong>Image Gen</strong><small>Text prompt to image output</small></span>
                        <ToggleSwitch Value="@SetupImage" ValueChanged="value => SetupImage = value" Title="Toggle image generation capability" />
                    </label>
                    <label class="setup-toggle-row">
                        <span><strong>Vision</strong><small>Accepts image input</small></span>
                        <ToggleSwitch Value="@SetupVision" ValueChanged="value => SetupVision = value" Title="Toggle vision capability" />
                    </label>
                    <label class="setup-toggle-row">
                        <span><strong>Structured</strong><small>Reliable JSON/schema output</small></span>
                        <ToggleSwitch Value="@SetupStructured" ValueChanged="value => SetupStructured = value" Title="Toggle structured output capability" />
                    </label>
                    <label class="setup-toggle-row">
                        <span><strong>Streaming</strong><small>Can stream text responses</small></span>
                        <ToggleSwitch Value="@SetupStreaming" ValueChanged="value => SetupStreaming = value" Title="Toggle streaming capability" />
                    </label>
                    <label class="setup-toggle-row">
                        <span><strong>Tools</strong><small>Can call tools/functions</small></span>
                        <ToggleSwitch Value="@SetupTools" ValueChanged="value => SetupTools = value" Title="Toggle tool capability" />
                    </label>
                </div>
            </Section>

            <Section Title="Tuning Support">
                <div class="setup-tuning-grid">
                    <FieldRow Label="Temperature"><AppSelect Value="@SetupTemperature" ValueChanged="value => SetupTemperature = value">@TuningOptions()</AppSelect></FieldRow>
                    <FieldRow Label="Top P"><AppSelect Value="@SetupTopP" ValueChanged="value => SetupTopP = value">@TuningOptions()</AppSelect></FieldRow>
                    <FieldRow Label="Max Tokens"><AppSelect Value="@SetupMaxTokens" ValueChanged="value => SetupMaxTokens = value">@TuningOptions()</AppSelect></FieldRow>
                    <FieldRow Label="Seed"><AppSelect Value="@SetupSeed" ValueChanged="value => SetupSeed = value">@TuningOptions()</AppSelect></FieldRow>
                    <FieldRow Label="Frequency Penalty"><AppSelect Value="@SetupFrequencyPenalty" ValueChanged="value => SetupFrequencyPenalty = value">@TuningOptions()</AppSelect></FieldRow>
                    <FieldRow Label="Presence Penalty"><AppSelect Value="@SetupPresencePenalty" ValueChanged="value => SetupPresencePenalty = value">@TuningOptions()</AppSelect></FieldRow>
                    <FieldRow Label="Stop Sequences"><AppSelect Value="@SetupStopSequences" ValueChanged="value => SetupStopSequences = value">@TuningOptions()</AppSelect></FieldRow>
                </div>
            </Section>
        </ChildContent>

        <Footer>
            <AppButton Variant="secondary" OnClick="@(_ => CloseSetup())">Cancel</AppButton>
            <AppButton Variant="primary" OnClick="@(_ => SaveSetup())"><FaIcon Name="check" />Save Setup</AppButton>
        </Footer>
    </ModalShell>
}

@code {
    string? SelectedId;
    int OnboardStep;
    string? OnboardType;
    string OnboardApiKey = "";
    string OnboardEndpoint = "";
    bool? TestOk;
    bool ConfirmDelete;
    bool ShowModelsNeedingSetup;
    AiProvider? SetupProvider;
    AiProviderModel? SetupModel;
    bool SetupChat;
    bool SetupImage;
    bool SetupVision;
    bool SetupStructured;
    bool SetupStreaming;
    bool SetupTools;
    string SetupTemperature = nameof(TuningSupport.Unsupported);
    string SetupTopP = nameof(TuningSupport.Unsupported);
    string SetupMaxTokens = nameof(TuningSupport.Unsupported);
    string SetupSeed = nameof(TuningSupport.Unsupported);
    string SetupFrequencyPenalty = nameof(TuningSupport.Unsupported);
    string SetupPresencePenalty = nameof(TuningSupport.Unsupported);
    string SetupStopSequences = nameof(TuningSupport.Unsupported);
    string ProviderError = "";
    List<AiProviderModel> OnboardModels = [];
    readonly IReadOnlyList<AiProviderMeta> ProviderTypes = SeedData.ProviderMetadata();

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    IReadOnlyList<AiProvider> Providers => Session.Providers.Items;
    AiProvider? Selected => Providers.FirstOrDefault(provider => provider.Id == SelectedId);
    AiProviderMeta? OnboardMeta => OnboardType is null ? null : MetaFor(OnboardType);
    bool CanFetchModels => OnboardMeta is not null
        && (!OnboardMeta.ApiKeyRequired || !string.IsNullOrWhiteSpace(OnboardApiKey))
        && (!OnboardMeta.EndpointRequired || !string.IsNullOrWhiteSpace(OnboardEndpoint));
    string? EndpointHint => OnboardType switch
    {
        "openai" => "Uses the default OpenAI /v1 base URL.",
        "grok" => "Uses the default xAI /v1 base URL.",
        "claude" => "Uses the default Anthropic /v1 base URL.",
        "huggingface" => "Discovers managed endpoints from your Hugging Face account.",
        "compatible" => "Works with any Responses/Open Responses-compatible API. Point to the /v1 base URL.",
        _ => null
    };

    protected override void OnInitialized()
    {
        Session.Providers.Changed += OnProvidersChanged;
        SelectedId = Providers.FirstOrDefault()?.Id;
    }

    Task OnProvidersChanged() => InvokeAsync(StateHasChanged);

    AiProviderMeta MetaFor(string type) => ProviderTypes.FirstOrDefault(provider => provider.Id == type) ?? ProviderTypes.Last();
    (int TextCount, int ImageCount) Counts(AiProvider provider)
    {
        CapabilityCatalog.ApplyResolvedCapabilities(provider);
        var enabled = provider.Models.Where(model => model.Enabled).ToList();
        return (
            enabled.Count(AiProviderModelSelectionRules.IsSelectedForChat),
            enabled.Count(AiProviderModelSelectionRules.IsSelectedForImage));
    }

    void Select(string id)
    {
        SelectedId = id;
        OnboardStep = 0;
        TestOk = null;
        ProviderError = "";
    }

    void StartAdd()
    {
        SelectedId = null;
        OnboardStep = 1;
        OnboardType = null;
        OnboardApiKey = "";
        OnboardEndpoint = "";
        OnboardModels = [];
        ProviderError = "";
    }

    void CancelOnboarding()
    {
        OnboardStep = 0;
        SelectedId = Providers.FirstOrDefault()?.Id;
    }

    void PickProviderType(string type)
    {
        OnboardType = type;
        OnboardApiKey = "";
        OnboardEndpoint = "";
        OnboardStep = 2;
        ProviderError = "";
    }

    void BackToPick()
    {
        OnboardType = null;
        OnboardStep = 1;
    }

    async Task FetchModels()
    {
        if (OnboardMeta is null)
            return;

        ProviderError = "";
        try
        {
            OnboardModels = ProviderModelListRules.SortModels((await ProviderConnectionService.DiscoverModelsAsync(BuildOnboardProvider())).Select(CloneDisabled)).ToList();
            OnboardStep = 3;
        }
        catch (Exception exception)
        {
            ProviderError = UserFacingErrorMessageBuilder.Build($"Fetching models from {OnboardMeta.Name} failed.", exception);
        }
    }

    async Task FinishOnboarding()
    {
        if (OnboardMeta is null)
            return;

        var provider = new AiProvider
        {
            Id = $"ap{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
            Type = OnboardMeta.Id,
            Name = OnboardMeta.Name,
            Enabled = true,
            ApiKey = OnboardApiKey,
            Endpoint = OnboardMeta.NeedsEndpoint ? OnboardEndpoint : "",
            Models = ProviderModelListRules.SortModels(OnboardModels.Select(Clone)).ToList()
        };
        if (!HasActiveTextModel())
        {
            var active = provider.Models.FirstOrDefault(AiProviderModelSelectionRules.IsSelectedForChat);
            if (active is not null)
                active.ActiveText = true;
        }

        await Session.Providers.AddAsync(provider);
        SelectedId = provider.Id;
        OnboardStep = 0;
    }

    Task OnOnboardModelChanged() => InvokeAsync(StateHasChanged);

    async Task TestProvider()
    {
        TestOk = null;
        ProviderError = "";
        if (Selected is null)
            return;

        try
        {
            await ProviderConnectionService.TestProviderAsync(Selected);
            TestOk = true;
        }
        catch (Exception exception)
        {
            TestOk = false;
            ProviderError = UserFacingErrorMessageBuilder.Build($"Testing {Selected.Name} failed.", exception);
        }
    }

    async Task RefreshModels()
    {
        if (Selected is null)
            return;

        ProviderError = "";
        try
        {
            var discovered = await ProviderConnectionService.DiscoverModelsAsync(Selected);
            MergeModels(Selected, discovered);
            Selected.Models = ProviderModelListRules.SortModels(Selected.Models).ToList();
            await Session.Providers.MarkChangedAsync();
        }
        catch (Exception exception)
        {
            ProviderError = UserFacingErrorMessageBuilder.Build($"Refreshing models for {Selected.Name} failed.", exception);
        }
    }

    async Task RefreshWidget()
    {
        if (Selected is null)
            return;

        ProviderError = "";
        try
        {
            Selected.Metrics = (await ProviderWidgetService.RefreshMetricsAsync(Selected)).ToList();
            Selected.LastMetricsRefreshUtc = DateTime.UtcNow;
            Selected.LastMetricsError = "";
            await Session.Providers.MarkChangedAsync();
        }
        catch (Exception exception)
        {
            Selected.LastMetricsError = UserFacingErrorMessageBuilder.Build($"Refreshing widget details for {Selected.Name} failed.", exception);
            ProviderError = Selected.LastMetricsError;
            await Session.Providers.MarkChangedAsync();
        }
    }

    async Task DeleteProvider()
    {
        ConfirmDelete = false;
        if (SelectedId is null)
            return;

        await Session.Providers.DeleteAsync(SelectedId);
        SelectedId = Providers.FirstOrDefault()?.Id;
    }

    async Task SetProviderEnabled(AiProvider provider, bool enabled)
    {
        provider.Enabled = enabled;
        await Session.Providers.MarkChangedAsync();
    }

    Task SaveSelectedClick(MouseEventArgs args) => Session.Providers.MarkChangedAsync();

    Task SaveSelected() => Session.Providers.MarkChangedAsync();

    AiProvider BuildOnboardProvider() => new()
    {
        Id = "draft",
        Type = OnboardMeta?.Id ?? "",
        Name = OnboardMeta?.Name ?? "Provider",
        Enabled = true,
        ApiKey = OnboardApiKey,
        Endpoint = OnboardMeta?.NeedsEndpoint == true ? OnboardEndpoint : "",
        Models = []
    };

    static void MergeModels(AiProvider provider, IReadOnlyList<AiProviderModel> discovered)
    {
        var existing = provider.Models.ToDictionary(model => model.Id, StringComparer.Ordinal);
        foreach (var model in discovered)
        {
            if (existing.TryGetValue(model.Id, out var current))
            {
                current.Capabilities = model.Capabilities;
                current.DisplayName = string.IsNullOrWhiteSpace(model.DisplayName) ? current.DisplayName : model.DisplayName;
                current.Endpoint = string.IsNullOrWhiteSpace(model.Endpoint) ? current.Endpoint : model.Endpoint;
                current.Repository = string.IsNullOrWhiteSpace(model.Repository) ? current.Repository : model.Repository;
                current.CreatedUnix = model.CreatedUnix ?? current.CreatedUnix;
                AiProviderModelSelectionRules.SynchronizeEnabled(current);
            }
            else
            {
                provider.Models.Add(CloneDisabled(model));
            }
        }
    }

    void OpenSetup(AiProvider provider, AiProviderModel model)
    {
        SetupProvider = Providers.FirstOrDefault(item => item.Id == provider.Id) ?? provider;
        SetupModel = model;
        SetupChat = model.Capabilities.CanGenerateText;
        SetupImage = model.Capabilities.CanGenerateImage;
        SetupVision = model.Capabilities.ImageInput;
        SetupStructured = model.Capabilities.StructuredOutput;
        SetupStreaming = model.Capabilities.Streaming;
        SetupTools = model.Capabilities.Tools;
        SetupTemperature = model.Capabilities.Temperature.ToString();
        SetupTopP = model.Capabilities.TopP.ToString();
        SetupMaxTokens = model.Capabilities.MaxTokens.ToString();
        SetupSeed = model.Capabilities.Seed.ToString();
        SetupFrequencyPenalty = model.Capabilities.FrequencyPenalty.ToString();
        SetupPresencePenalty = model.Capabilities.PresencePenalty.ToString();
        SetupStopSequences = model.Capabilities.StopSequences.ToString();
    }

    void CloseSetup()
    {
        SetupProvider = null;
        SetupModel = null;
    }

    async Task SaveSetup()
    {
        if (SetupProvider is null || SetupModel is null)
            return;

        var capabilities = new ModelGenerationCapabilities
        {
            TextInput = SetupChat || SetupImage || SetupVision,
            TextOutput = SetupChat,
            ImageInput = SetupVision,
            ImageOutput = SetupImage,
            Streaming = SetupStreaming,
            StructuredOutput = SetupStructured,
            Tools = SetupTools,
            Temperature = ParseSupport(SetupTemperature),
            TopP = ParseSupport(SetupTopP),
            MaxTokens = ParseSupport(SetupMaxTokens),
            Seed = ParseSupport(SetupSeed),
            FrequencyPenalty = ParseSupport(SetupFrequencyPenalty),
            PresencePenalty = ParseSupport(SetupPresencePenalty),
            StopSequences = ParseSupport(SetupStopSequences),
            Source = "user"
        };

        CapabilityCatalog.SaveUserCapabilities(SetupProvider.Type, SetupModel.Id, capabilities);
        SetupModel.Capabilities = CapabilityCatalog.Resolve(SetupProvider, SetupModel);
        AiProviderModelSelectionRules.SelectAvailableRoles(SetupModel);
        if (Providers.Any(provider => provider.Id == SetupProvider.Id))
            await Session.Providers.MarkChangedAsync();

        CloseSetup();
    }

    static TuningSupport ParseSupport(string value) =>
        Enum.TryParse<TuningSupport>(value, out var parsed) ? parsed : TuningSupport.Unsupported;

    bool HasActiveTextModel() =>
        Providers.Any(provider => provider.Enabled && provider.Models.Any(model => model.ActiveText && AiProviderModelSelectionRules.IsSelectedForChat(model)));

    static string ProviderWidgetHint(AiProvider provider) => provider.Type switch
    {
        "openai" => "Shows connection, model inventory, and usage guidance.",
        "grok" => "Shows xAI billing status when a team id is configured.",
        "claude" => "Shows Anthropic usage status when an admin key is configured.",
        "huggingface" => "Shows managed endpoint runtime and controls.",
        _ => "Shows provider-specific connection details."
    };

    static RenderFragment TuningOptions() => builder =>
    {
        builder.OpenElement(0, "option");
        builder.AddAttribute(1, "value", nameof(TuningSupport.Unsupported));
        builder.AddContent(2, "Unsupported");
        builder.CloseElement();
        builder.OpenElement(3, "option");
        builder.AddAttribute(4, "value", nameof(TuningSupport.DefaultOnly));
        builder.AddContent(5, "Default only");
        builder.CloseElement();
        builder.OpenElement(6, "option");
        builder.AddAttribute(7, "value", nameof(TuningSupport.Supported));
        builder.AddContent(8, "Supported");
        builder.CloseElement();
    };

    static AiProviderModel Clone(AiProviderModel model) => new()
    {
        Id = model.Id,
        DisplayName = model.DisplayName,
        Endpoint = model.Endpoint,
        Repository = model.Repository,
        CreatedUnix = model.CreatedUnix,
        Enabled = model.Enabled,
        Text = model.Text,
        Image = model.Image,
        ActiveText = model.ActiveText,
        Capabilities = model.Capabilities
    };

    static AiProviderModel CloneDisabled(AiProviderModel model) => new()
    {
        Id = model.Id,
        DisplayName = model.DisplayName,
        Endpoint = model.Endpoint,
        Repository = model.Repository,
        CreatedUnix = model.CreatedUnix,
        Text = false,
        Image = false,
        Capabilities = model.Capabilities
    };

    public void Dispose()
    {
        Session.Providers.Changed -= OnProvidersChanged;
    }
}
