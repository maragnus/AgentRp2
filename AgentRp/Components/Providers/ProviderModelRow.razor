<SelectableRow Class="provider-model"
               Selected="@AnyEnabled"
               Disabled="@(!HasAnyRole || ProviderManagedVoiceEndpoint)"
               Limited="@(!HasAnyRole)"
               SelectionTitle="@RowTitle"
               OnToggle="@(_ => ToggleModel())">
    <ChildContent>
        <span class="provider-model-title">
            <strong title="@Model.Id">@DisplayName</strong>
            @if (ShowModelId)
            {
                <small title="@Model.Id">@Model.Id</small>
            }
        </span>
    </ChildContent>
    <Actions>
        @if (CanChat)
        {
            <CapabilityPill Tone="text"
                            Active="@ChatActive"
                            Title="@ChatTitle"
                            OnClick="@(_ => ToggleChat())">Chat</CapabilityPill>
        }
        @if (CanImage)
        {
            <CapabilityPill Tone="image"
                            Active="@ImageActive"
                            Title="@ImageTitle"
                            OnClick="@(_ => ToggleImage())">Image Gen</CapabilityPill>
        }
        @if (CanVoice)
        {
            @if (ProviderManagedVoiceEndpoint)
            {
                <span class="cap cap-passive is-voice" title="@VoiceTitle">Voice</span>
            }
            else
            {
                <CapabilityPill Tone="voice"
                                Active="@VoiceActive"
                                Title="@VoiceTitle"
                                OnClick="@(_ => ToggleVoice())">Voice</CapabilityPill>
            }
            @if (VoiceActive)
            {
                <span class="cap cap-passive" title="@VoiceCountTitle">@Model.Voices.Count voices</span>
            }
        }
        @if (Model.Capabilities.ImageInput)
        {
            <span class="cap cap-passive cap-vision" title="@VisionTitle">Vision</span>
        }
        @if (NeedsSetup)
        {
            <AppButton Variant="secondary" Size="xs" Class="model-setup-button" Title="@NeedsSetupTitle" OnClick="@(_ => OnSetup.InvokeAsync(Model))">
                <FaIcon Name="wrench" />Set up
            </AppButton>
        }
    </Actions>
</SelectableRow>

@code {
    [Parameter] public string ProviderType { get; set; } = "";
    [Parameter] public AiProviderModel Model { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<AiProviderModel> OnSetup { get; set; }

    bool CanChat => AiProviderModelSelectionRules.HasChatRole(Model);
    bool CanImage => AiProviderModelSelectionRules.HasImageRole(Model);
    bool CanVoice => AiProviderModelSelectionRules.HasVoiceRole(Model);
    bool HasAnyRole => AiProviderModelSelectionRules.HasAnyRole(Model);
    bool ChatActive => AiProviderModelSelectionRules.IsSelectedForChat(Model);
    bool ImageActive => AiProviderModelSelectionRules.IsSelectedForImage(Model);
    bool VoiceActive => AiProviderModelSelectionRules.IsSelectedForVoice(Model);
    bool AnyEnabled => AiProviderModelSelectionRules.IsSelectedForAnyRole(Model);
    bool NeedsSetup => !HasAnyRole;
    bool ProviderManagedVoiceEndpoint => AiProviderModelIdentityRules.IsProviderManagedVoiceEndpoint(ProviderType, Model.Id);
    string DisplayName => string.IsNullOrWhiteSpace(Model.DisplayName) ? Model.Id : Model.DisplayName;
    bool ShowModelId => !string.Equals(DisplayName.Trim(), Model.Id.Trim(), StringComparison.OrdinalIgnoreCase);
    string RowTitle => ProviderManagedVoiceEndpoint
        ? "xAI text-to-speech is available automatically when an API key is configured."
        : AnyEnabled ? $"Clear selected roles for {Model.Id}" : $"Choose available roles for {Model.Id}";
    string ChatTitle => CanChat
        ? $"Enable this model for chat."
        : "Chat is not available for this model.";
    string ImageTitle => CanImage
        ? "Enable this model for image generation through Responses image output."
        : "Image generation is not available for this model.";
    string VoiceTitle => ProviderManagedVoiceEndpoint
        ? "xAI text-to-speech uses the provider endpoint and does not require model selection."
        : CanVoice
        ? "Enable this model for text-to-speech voice selection."
        : "Voice generation is not available for this model.";
    string VoiceCountTitle => Model.LastVoiceRefreshUtc is null
        ? "Voices have not been refreshed for this model."
        : $"Voices refreshed {Model.LastVoiceRefreshUtc:g}.";
    string VisionTitle => "This model can accept image input.";
    string NeedsSetupTitle => "No supported app role is known for this model. Set up model capabilities to enable it.";

    async Task ToggleModel()
    {
        if (ProviderManagedVoiceEndpoint)
            return;

        if (AnyEnabled)
            AiProviderModelSelectionRules.ClearSelectedRoles(Model);
        else
            AiProviderModelSelectionRules.SelectAvailableRoles(Model);

        await OnChanged.InvokeAsync();
    }

    async Task ToggleChat()
    {
        if (!CanChat)
            return;

        AiProviderModelSelectionRules.SetChatSelected(Model, !ChatActive);

        await OnChanged.InvokeAsync();
    }

    async Task ToggleImage()
    {
        if (!CanImage)
            return;

        AiProviderModelSelectionRules.SetImageSelected(Model, !ImageActive);

        await OnChanged.InvokeAsync();
    }

    async Task ToggleVoice()
    {
        if (!CanVoice || ProviderManagedVoiceEndpoint)
            return;

        AiProviderModelSelectionRules.SetVoiceSelected(Model, !VoiceActive);

        await OnChanged.InvokeAsync();
    }
}
