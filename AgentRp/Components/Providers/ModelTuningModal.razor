@inject IJSRuntime JS
@implements IDisposable

<ModalShell Title="Model Tuning" MaxWidth="780px" BodyClass="is-flush" OnClose="OnClose">
    <ModalTabGroup ActiveId="@Active" ActiveIdChanged="SetActive" Height="540px" RailWidth="156px">
        <ChildContent>
            @foreach (var step in Steps)
            {
                <ModalTab @key="step.Id" Id="@step.Id" Title="@step.Label" Dirty="@IsDirtyStep(step.Id)" />
            }
        </ChildContent>
        <RailFooter>
            <div class="prompt-rail-note">
                <div class="divider"></div>
                <p>Lower temperature is steadier. Leave fields blank to use model defaults.</p>
            </div>
        </RailFooter>
        <MainContent>
        <ModalStackLayout Class="modal-editor-main" BodyClass="modal-form-stack">
            <Header>
                <div class="tuning-toolbar">
                    <strong>@CurrentStep.Label</strong>
                    <span style="flex:1"></span>
                    <AppButton Variant="secondary" Size="xs" OnClick="ImportSettings"><FaIcon Name="download" />Import</AppButton>
                    <AppButton Variant="secondary" Size="xs" OnClick="ExportSettings"><FaIcon Name="upload" />Export</AppButton>
                    <div class="dropdown-wrap">
                        <AppButton Variant="@(CopyOpen ? "outline" : "secondary")" Size="xs" OnClick="@(_ => CopyOpen = !CopyOpen)">
                            <FaIcon Name="copy" />Copy To <FaIcon Name="@(CopyOpen ? "chevron-up" : "chevron-down")" />
                        </AppButton>
                        @if (CopyOpen)
                        {
                            <div class="popover copy-popover">
                                <div class="popover-label">Copy settings to</div>
                                @foreach (var step in Steps.Where(step => step.Id != Active))
                                {
                                    <SelectableButton @key="step.Id" Class="select-row" OnClick="@(_ => CopyTo(step.Id))">@step.Label</SelectableButton>
                                }
                                <div class="divider"></div>
                                <SelectableButton Class="select-row is-accent" OnClick="@(_ => CopyToAll())">All phases</SelectableButton>
                            </div>
                        }
                    </div>
                    @if (IsDirty())
                    {
                        <AppButton Size="xs" OnClick="@(_ => Reset())"><FaIcon Name="refresh" />Reset</AppButton>
                    }
                </div>
            </Header>

            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(CopiedToast))
                {
                    <div class="floating-toast"><FaIcon Name="check" />@CopiedToast</div>
                }

                <Section Title="Sampling" Class="tuning-section">
                    <FieldRow Label="Temperature">
                        <LabelAction><code>@Current.Temperature.ToString("0.00")</code></LabelAction>
                        <ChildContent>
                            <div class="tuning-slider" style="--pct:@(Current.Temperature / 2 * 100)%">
                                <span></span>
                                <input type="range" min="0" max="2" step="0.01" @bind="Current.Temperature" @bind:event="oninput" />
                                <i></i>
                            </div>
                            <div class="slider-scale"><span>0 · steadier</span><span>2 · wilder</span></div>
                        </ChildContent>
                    </FieldRow>
                    <div class="tuning-grid">
                        <NumberSetting Label="Top P" Value="@Current.TopP" ValueChanged="value => Current.TopP = value" />
                        <NumberSetting Label="Seed" Value="@Current.Seed" ValueChanged="value => Current.Seed = value" />
                    </div>
                </Section>

                <Section Title="Limits & Penalties" Class="tuning-section">
                    <div class="tuning-grid">
                        <NumberSetting Label="Max Output Tokens" Value="@Current.MaxTokens" ValueChanged="value => Current.MaxTokens = value" />
                        <NumberSetting Label="Frequency Penalty" Value="@Current.FrequencyPenalty" ValueChanged="value => Current.FrequencyPenalty = value" />
                        <NumberSetting Label="Presence Penalty" Value="@Current.PresencePenalty" ValueChanged="value => Current.PresencePenalty = value" />
                    </div>
                </Section>

                <Section Title="Stop Conditions" Class="tuning-section">
                    <FieldRow Label="Stop Sequences" Hint="Enter one stop sequence per line.">
                        <textarea class="field mono" rows="3" @bind="Current.StopSequences" placeholder="One stop sequence per line…"></textarea>
                    </FieldRow>
                </Section>
            </ChildContent>

            <Footer>
                <AppButton Variant="secondary" OnClick="@(_ => OnClose.InvokeAsync())">Cancel</AppButton>
                <AppButton Variant="primary" OnClick="Save"><FaIcon Name="check" />Save</AppButton>
            </Footer>
        </ModalStackLayout>
        </MainContent>
    </ModalTabGroup>
</ModalShell>

@code {
    sealed record StepDef(string Id, string Label);
    string Active = "appearance";
    bool CopyOpen;
    string? CopiedToast;

    readonly StepDef[] Steps =
    [
        new("appearance", "Appearance"),
        new("selection", "Selection"),
        new("planning", "Planning"),
        new("prose", "Prose")
    ];

    Dictionary<string, ModelTuningStepState> Defaults = new();

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    StepDef CurrentStep => Steps.First(step => step.Id == Active);
    Dictionary<string, ModelTuningStepState> Values => Session.Chat.ModelTuning.State.Values;
    ModelTuningStepState Current => Values[Active];

    protected override void OnInitialized()
    {
        Session.Chat.ModelTuning.Changed += OnStoreChanged;
        Defaults = new()
        {
            ["appearance"] = new() { Temperature = .4 },
            ["selection"] = new() { Temperature = .2 },
            ["planning"] = new() { Temperature = .4 },
            ["prose"] = new() { Temperature = .7 }
        };
    }

    Task OnStoreChanged() => InvokeAsync(StateHasChanged);

    static ModelTuningStepState Clone(ModelTuningStepState value) => new()
    {
        Temperature = value.Temperature,
        TopP = value.TopP,
        MaxTokens = value.MaxTokens,
        Seed = value.Seed,
        FrequencyPenalty = value.FrequencyPenalty,
        PresencePenalty = value.PresencePenalty,
        StopSequences = value.StopSequences
    };

    bool IsDirty() => IsDirtyStep(Active);
    void SetActive(string? id) => Active = id ?? Active;

    bool IsDirtyStep(string id)
    {
        var current = Values[id];
        var def = Defaults[id];
        return current.Temperature != def.Temperature ||
               current.TopP != def.TopP ||
               current.MaxTokens != def.MaxTokens ||
               current.Seed != def.Seed ||
               current.FrequencyPenalty != def.FrequencyPenalty ||
               current.PresencePenalty != def.PresencePenalty ||
               current.StopSequences != def.StopSequences;
    }

    async Task Reset()
    {
        Values[Active] = Clone(Defaults[Active]);
        await Session.Chat.ModelTuning.MarkChangedAsync();
    }

    void CopyTo(string targetId)
    {
        Values[targetId] = Clone(Current);
        CopiedToast = $"Copied to {Steps.First(step => step.Id == targetId).Label}";
        CopyOpen = false;
        _ = Session.Chat.ModelTuning.MarkChangedAsync();
    }

    void CopyToAll()
    {
        foreach (var step in Steps.Where(step => step.Id != Active))
            Values[step.Id] = Clone(Current);

        CopiedToast = "Copied to all phases";
        CopyOpen = false;
        _ = Session.Chat.ModelTuning.MarkChangedAsync();
    }

    async Task ExportSettings()
    {
        var content = System.Text.Json.JsonSerializer.Serialize(Current, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("agentRp.downloadText", $"model-tuning-{Active}.json", content, "application/json;charset=utf-8");
    }

    async Task ImportSettings()
    {
        var imported = await JS.InvokeAsync<string>("agentRp.importText", ".json");
        if (string.IsNullOrWhiteSpace(imported))
            return;

        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<ModelTuningStepState>(imported);
            if (parsed is not null)
            {
                Values[Active] = parsed;
                await Session.Chat.ModelTuning.MarkChangedAsync();
            }
        }
        catch
        {
            CopiedToast = "Import failed";
        }
    }

    Task Save(MouseEventArgs args) => Session.Chat.ModelTuning.MarkChangedAsync();

    public void Dispose()
    {
        Session.Chat.ModelTuning.Changed -= OnStoreChanged;
    }
}
