@inject IJSRuntime JS
@implements IDisposable

<StatefulForm Model="@Draft"
              Baseline="@Baseline"
              OnSave="Save"
              OnClose="OnClose"
              ContextChanged="SetTuningForm">
    <ChildContent Context="form">
<ModalShell Title="Model Tuning" MaxWidth="780px" BodyClass="is-flush" OnClose="form.RequestCloseAsync">
    <ModalTabGroup ActiveId="@Active" ActiveIdChanged="SetActive" Height="540px" RailWidth="156px">
        <ChildContent>
            @foreach (var step in Steps)
            {
                <ModalTab @key="step.Id" Id="@step.Id" Title="@step.Label" DirtyPath="@StepPath(step.Id)" />
            }
        </ChildContent>
        <RailFooter>
            <div class="prompt-rail-note">
                <p>Leave controls blank to use model defaults. Some tuning knobs are model-specific.</p>
            </div>
        </RailFooter>
        <MainContent>
        <ModalStackLayout Class="modal-editor-main" BodyClass="modal-form-stack">
            <Header>
                <ModalPaneToolbar Class="tuning-toolbar">
                    <strong>@CurrentStep.Label</strong>
                    <span class="toolbar-spacer"></span>
                    <AppButton Variant="secondary" Size="xs" OnClick="ImportSettings"><FaIcon Name="download" />Import</AppButton>
                    <AppButton Variant="secondary" Size="xs" OnClick="ExportSettings"><FaIcon Name="upload" />Export</AppButton>
                    <AnchoredPopover Placement="OverlayPlacement.BottomEnd" Class="copy-popover">
                        <Trigger Context="copy">
                            <AppButton Variant="@(copy.IsOpen ? "outline" : "secondary")" Size="xs" OnClick="@(_ => copy.Toggle())">
                                <FaIcon Name="copy" />Copy To <FaIcon Name="@(copy.IsOpen ? "chevron-up" : "chevron-down")" />
                            </AppButton>
                        </Trigger>
                        <Content>
                            <div class="popover-label">Copy settings to</div>
                            @foreach (var step in Steps.Where(step => step.Id != Active))
                            {
                                <SelectableButton @key="step.Id" Class="select-row" OnClick="@(_ => CopyTo(step.Id))">@step.Label</SelectableButton>
                            }
                            <div class="divider"></div>
                            <SelectableButton Class="select-row is-accent" OnClick="@(_ => CopyToAll())">All phases</SelectableButton>
                        </Content>
                    </AnchoredPopover>
                    @if (IsDirty())
                    {
                        <AppButton Size="xs" OnClick="@(_ => Reset())"><FaIcon Name="refresh" />Reset</AppButton>
                    }
                </ModalPaneToolbar>
            </Header>

            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(CopiedToast))
                {
                    <div class="floating-toast"><FaIcon Name="check" />@CopiedToast</div>
                }

                <div class="tuning-capability-card">
                    @if (ActiveTextModel is null)
                    {
                        <strong>No active text model selected</strong>
                        <p>These settings stay attached to the story. Capability filtering kicks in as soon as a text model is enabled.</p>
                    }
                    else
                    {
                        <div class="tuning-capability-meta">
                            <strong>@ActiveTextModel.Model.Id</strong>
                            <span class="field-status-pill">@ActiveTextModel.Provider.Name</span>
                            @if (ActiveCapabilities.SupportsReasoningEffort)
                            {
                                <span class="field-status-pill">Reasoning-aware</span>
                            }
                            @if (ActiveCapabilities.SupportsVerbosity)
                            {
                                <span class="field-status-pill">Verbosity-aware</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ActiveCapabilities.Guidance))
                        {
                            <p>@ActiveCapabilities.Guidance</p>
                        }
                    }
                </div>

                <StatefulFormScope PathPrefix="@StepPath(Active)">
                <FormSection Title="Sampling" Class="tuning-section" DirtyPaths="@SamplingPaths">
                    <FieldRow Label="Temperature" DirtyPath="@nameof(Current.Temperature)">
                        <LabelAction>
                            @if (Current.Temperature is double temperature)
                            {
                                <code>@temperature.ToString("0.00")</code>
                            }
                            else
                            {
                                <span class="field-status-pill">Model default</span>
                            }
                        </LabelAction>
                        <ChildContent>
                            <div class="tuning-inline-actions">
                                <AppButton Variant="ghost" Size="xs" Active="@(!Current.Temperature.HasValue)" OnClick="@(_ => ClearTemperature())">Model default</AppButton>
                                <AppButton Variant="ghost" Size="xs" Active="@Current.Temperature.HasValue" Disabled="@(!CanCustomizeTemperature)" OnClick="@(_ => EnableTemperature())">Custom</AppButton>
                            </div>
                            @if (Current.Temperature.HasValue && CanCustomizeTemperature)
                            {
                                <RangeSlider Value="@TemperatureSliderValue"
                                             ValueChanged="SetTemperature"
                                             DirtyPath="@nameof(Current.Temperature)"
                                             Min="0"
                                             Max="2"
                                             Step="0.01"
                                             StartLabel="0 · steadier"
                                             EndLabel="2 · wilder" />
                            }
                            @if (!string.IsNullOrWhiteSpace(TemperatureSupportNote))
                            {
                                <div class="tuning-inline-note">@TemperatureSupportNote</div>
                            }
                        </ChildContent>
                    </FieldRow>
                    <div class="tuning-grid">
                        <NumberSetting Label="Top P" Value="@Current.TopP" Disabled="@(ActiveCapabilities.TopP != TuningSupport.Supported)" DirtyPath="@nameof(Current.TopP)" ValueChanged="SetTopP" />
                        <NumberSetting Label="Seed" Value="@Current.Seed" Disabled="@(ActiveCapabilities.Seed != TuningSupport.Supported)" DirtyPath="@nameof(Current.Seed)" ValueChanged="SetSeed" />
                    </div>
                </FormSection>

                <FormSection Title="Limits & Penalties" Class="tuning-section" DirtyPaths="@LimitPaths">
                    <div class="tuning-grid">
                        <NumberSetting Label="Max Output Tokens" Value="@Current.MaxTokens" Disabled="@(ActiveCapabilities.MaxTokens != TuningSupport.Supported)" DirtyPath="@nameof(Current.MaxTokens)" ValueChanged="SetMaxTokens" />
                        <NumberSetting Label="Frequency Penalty" Value="@Current.FrequencyPenalty" Disabled="@(ActiveCapabilities.FrequencyPenalty != TuningSupport.Supported)" DirtyPath="@nameof(Current.FrequencyPenalty)" ValueChanged="SetFrequencyPenalty" />
                        <NumberSetting Label="Presence Penalty" Value="@Current.PresencePenalty" Disabled="@(ActiveCapabilities.PresencePenalty != TuningSupport.Supported)" DirtyPath="@nameof(Current.PresencePenalty)" ValueChanged="SetPresencePenalty" />
                    </div>
                </FormSection>

                <FormSection Title="Stop Conditions" Class="tuning-section" DirtyPath="@nameof(Current.StopSequences)">
                    <FieldRow Label="Stop Sequences" Hint="Enter one stop sequence per line." DirtyPath="@nameof(Current.StopSequences)">
                        <AppTextarea Class="mono" Rows="3" Value="@Current.StopSequences" ValueChanged="SetStopSequences" DirtyPath="@nameof(Current.StopSequences)" Disabled="@(ActiveCapabilities.StopSequences != TuningSupport.Supported)" Placeholder="One stop sequence per line..." />
                    </FieldRow>
                </FormSection>
                </StatefulFormScope>
            </ChildContent>

            <Footer>
                <AppButton Variant="secondary" OnClick="@(_ => form.RequestCloseAsync())">Cancel</AppButton>
                <BusyButton Variant="primary" Disabled="@(!form.CanSave)" OnClick="form.SaveAsync">Save</BusyButton>
            </Footer>
        </ModalStackLayout>
        </MainContent>
    </ModalTabGroup>
</ModalShell>
    </ChildContent>
</StatefulForm>

@code {
    sealed record StepDef(string Id, string Label);
    string Active = PromptLibraryStageIds.SceneContinuity;
    string? CopiedToast;

    readonly StepDef[] Steps =
    [
        new("snapshot", "Snapshot"),
        new(PromptLibraryStageIds.SceneContinuity, "Scene Continuity"),
        new("selection", "Selection"),
        new("planning", "Planning"),
        new("prose", "Prose")
    ];

    Dictionary<string, ModelTuningStepState> Defaults = new();
    ModelTuningState Draft = ModelTuningState.CreateDefault();
    ModelTuningState Baseline = ModelTuningState.CreateDefault();
    StatefulFormContext<ModelTuningState>? TuningForm;
    static readonly string[] SamplingPaths = [nameof(ModelTuningStepState.Temperature), nameof(ModelTuningStepState.TopP), nameof(ModelTuningStepState.Seed)];
    static readonly string[] LimitPaths = [nameof(ModelTuningStepState.MaxTokens), nameof(ModelTuningStepState.FrequencyPenalty), nameof(ModelTuningStepState.PresencePenalty)];

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    StepDef CurrentStep => Steps.First(step => step.Id == Active);
    Dictionary<string, ModelTuningStepState> Values => Draft.Values;
    ModelTuningStepState Current => Values[Active];
    ActiveModelSelection? ActiveTextModel => ResolveActiveTextModel();
    ModelGenerationCapabilities ActiveCapabilities => ActiveTextModel?.Capabilities ?? ModelGenerationCapabilities.Fallback;
    bool CanCustomizeTemperature => ActiveCapabilities.Temperature == TuningSupport.Supported;
    double TemperatureSliderValue => Current.Temperature ?? 1d;
    string? TemperatureSupportNote => ActiveCapabilities.Temperature switch
    {
        TuningSupport.Supported when Current.Temperature is null => "Temperature stays off until you switch to a custom value.",
        TuningSupport.DefaultOnly when Current.Temperature.HasValue => "This model only accepts its default temperature. Any saved custom value will be ignored until you clear it.",
        TuningSupport.DefaultOnly => "This model only accepts its default temperature.",
        TuningSupport.Unsupported when Current.Temperature.HasValue => "This model does not support temperature. Any saved value will be ignored until you clear it.",
        TuningSupport.Unsupported => "This model does not support temperature.",
        _ => null
    };

    protected override void OnInitialized()
    {
        Draft = SessionCloner.Clone(Session.ModelTuning.State);
        Baseline = SessionCloner.Clone(Draft);
        Session.ModelTuning.Changed += OnStoreChanged;
        Session.ModelSelection.Changed += OnStoreChanged;
        Session.Providers.Changed += OnStoreChanged;
        Defaults = ModelTuningState.CreateDefault().Values.ToDictionary(pair => pair.Key, pair => Clone(pair.Value), StringComparer.Ordinal);
    }

    ActiveModelSelection? ResolveActiveTextModel() => Session.ModelSelection.Resolve(AiModelRole.Chat);

    Task OnStoreChanged()
    {
        if (TuningForm?.HasChanges == true)
            return InvokeAsync(StateHasChanged);

        Draft = SessionCloner.Clone(Session.ModelTuning.State);
        Baseline = SessionCloner.Clone(Draft);
        return InvokeAsync(StateHasChanged);
    }

    static ModelTuningStepState Clone(ModelTuningStepState value) => new()
    {
        Temperature = value.Temperature,
        TopP = value.TopP,
        MaxTokens = value.MaxTokens,
        Seed = value.Seed,
        FrequencyPenalty = value.FrequencyPenalty,
        PresencePenalty = value.PresencePenalty,
        StopSequences = value.StopSequences
    };

    void SetTuningForm(StatefulFormContext<ModelTuningState> form) => TuningForm = form;

    bool IsDirty() => IsFactoryDefaultDirtyStep(Active);
    void SetActive(string? id) => Active = id ?? Active;

    static string StepPath(string id) => $"{nameof(ModelTuningState.Values)}.{id}";

    bool IsFactoryDefaultDirtyStep(string id)
    {
        var current = Values[id];
        var def = Defaults[id];
        return !Equivalent(current, def);
    }

    void EnableTemperature()
    {
        if (!CanCustomizeTemperature)
            return;

        Current.Temperature ??= 1d;
        Touch();
    }

    void ClearTemperature()
    {
        Current.Temperature = null;
        Touch();
    }

    void SetTemperature(double value)
    {
        Current.Temperature = value;
        Touch();
    }

    void SetTopP(string value)
    {
        Current.TopP = value;
        Touch();
    }

    void SetSeed(string value)
    {
        Current.Seed = value;
        Touch();
    }

    void SetMaxTokens(string value)
    {
        Current.MaxTokens = value;
        Touch();
    }

    void SetFrequencyPenalty(string value)
    {
        Current.FrequencyPenalty = value;
        Touch();
    }

    void SetPresencePenalty(string value)
    {
        Current.PresencePenalty = value;
        Touch();
    }

    void SetStopSequences(string value)
    {
        Current.StopSequences = value;
        Touch();
    }

    void Reset()
    {
        Values[Active] = Clone(Defaults[Active]);
        Touch();
    }

    void CopyTo(string targetId)
    {
        Values[targetId] = Clone(Current);
        CopiedToast = $"Copied to {Steps.First(step => step.Id == targetId).Label}";
        Touch();
    }

    void CopyToAll()
    {
        foreach (var step in Steps.Where(step => step.Id != Active))
            Values[step.Id] = Clone(Current);

        CopiedToast = "Copied to all phases";
        Touch();
    }

    async Task ExportSettings()
    {
        var content = System.Text.Json.JsonSerializer.Serialize(Current, AppJsonSerializerOptions.IndentedWeb);
        await JS.InvokeVoidAsync("agentRp.downloadText", $"model-tuning-{Active}.json", content, "application/json;charset=utf-8");
    }

    async Task ImportSettings()
    {
        var imported = await JS.InvokeAsync<string>("agentRp.importText", ".json");
        if (string.IsNullOrWhiteSpace(imported))
            return;

        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<ModelTuningStepState>(imported, AppJsonSerializerOptions.Web);
            if (parsed is not null)
            {
                Values[Active] = parsed;
                Touch();
            }
        }
        catch
        {
            CopiedToast = "Import failed";
        }
    }

    async Task Save()
    {
        await Session.ModelTuning.SaveAsync(Draft);
        Baseline = SessionCloner.Clone(Draft);
    }

    void Touch() => TuningForm?.NotifyChanged();

    static bool Equivalent(ModelTuningStepState current, ModelTuningStepState baseline) =>
        current.Temperature == baseline.Temperature &&
        current.TopP == baseline.TopP &&
        current.MaxTokens == baseline.MaxTokens &&
        current.Seed == baseline.Seed &&
        current.FrequencyPenalty == baseline.FrequencyPenalty &&
        current.PresencePenalty == baseline.PresencePenalty &&
        current.StopSequences == baseline.StopSequences;

    public void Dispose()
    {
        Session.ModelTuning.Changed -= OnStoreChanged;
        Session.ModelSelection.Changed -= OnStoreChanged;
        Session.Providers.Changed -= OnStoreChanged;
    }
}
