@inject IJSRuntime JS
@inject IModelCapabilityCatalog CapabilityCatalog
@implements IDisposable

<ModalShell Title="Model Tuning" MaxWidth="780px" BodyClass="is-flush" OnClose="OnClose">
    <ModalTabGroup ActiveId="@Active" ActiveIdChanged="SetActive" Height="540px" RailWidth="156px">
        <ChildContent>
            @foreach (var step in Steps)
            {
                <ModalTab @key="step.Id" Id="@step.Id" Title="@step.Label" Dirty="@IsDirtyStep(step.Id)" />
            }
        </ChildContent>
        <RailFooter>
            <div class="prompt-rail-note">
                <div class="divider"></div>
                <p>Leave controls blank to use model defaults. Some tuning knobs are model-specific.</p>
            </div>
        </RailFooter>
        <MainContent>
        <ModalStackLayout Class="modal-editor-main" BodyClass="modal-form-stack">
            <Header>
                <ModalPaneToolbar Class="tuning-toolbar">
                    <strong>@CurrentStep.Label</strong>
                    <span class="toolbar-spacer"></span>
                    <AppButton Variant="secondary" Size="xs" OnClick="ImportSettings"><FaIcon Name="download" />Import</AppButton>
                    <AppButton Variant="secondary" Size="xs" OnClick="ExportSettings"><FaIcon Name="upload" />Export</AppButton>
                    <AnchoredPopover Placement="OverlayPlacement.BottomEnd" Class="copy-popover">
                        <Trigger Context="copy">
                            <AppButton Variant="@(copy.IsOpen ? "outline" : "secondary")" Size="xs" OnClick="@(_ => copy.Toggle())">
                                <FaIcon Name="copy" />Copy To <FaIcon Name="@(copy.IsOpen ? "chevron-up" : "chevron-down")" />
                            </AppButton>
                        </Trigger>
                        <Content>
                            <div class="popover-label">Copy settings to</div>
                            @foreach (var step in Steps.Where(step => step.Id != Active))
                            {
                                <SelectableButton @key="step.Id" Class="select-row" OnClick="@(_ => CopyTo(step.Id))">@step.Label</SelectableButton>
                            }
                            <div class="divider"></div>
                            <SelectableButton Class="select-row is-accent" OnClick="@(_ => CopyToAll())">All phases</SelectableButton>
                        </Content>
                    </AnchoredPopover>
                    @if (IsDirty())
                    {
                        <AppButton Size="xs" OnClick="@(_ => Reset())"><FaIcon Name="refresh" />Reset</AppButton>
                    }
                </ModalPaneToolbar>
            </Header>

            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(CopiedToast))
                {
                    <div class="floating-toast"><FaIcon Name="check" />@CopiedToast</div>
                }

                <div class="tuning-capability-card">
                    @if (ActiveTextModel is null)
                    {
                        <strong>No active text model selected</strong>
                        <p>These settings stay attached to the chat. Capability filtering kicks in as soon as a text model is enabled.</p>
                    }
                    else
                    {
                        <div class="tuning-capability-meta">
                            <strong>@ActiveTextModel.Model.Id</strong>
                            <span class="field-status-pill">@ActiveTextModel.Provider.Name</span>
                            @if (ActiveCapabilities.SupportsReasoningEffort)
                            {
                                <span class="field-status-pill">Reasoning-aware</span>
                            }
                            @if (ActiveCapabilities.SupportsVerbosity)
                            {
                                <span class="field-status-pill">Verbosity-aware</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ActiveCapabilities.Guidance))
                        {
                            <p>@ActiveCapabilities.Guidance</p>
                        }
                    }
                </div>

                <Section Title="Sampling" Class="tuning-section">
                    <FieldRow Label="Temperature">
                        <LabelAction>
                            @if (Current.Temperature is double temperature)
                            {
                                <code>@temperature.ToString("0.00")</code>
                            }
                            else
                            {
                                <span class="field-status-pill">Model default</span>
                            }
                        </LabelAction>
                        <ChildContent>
                            <div class="tuning-inline-actions">
                                <AppButton Variant="ghost" Size="xs" Active="@(!Current.Temperature.HasValue)" OnClick="@(_ => ClearTemperature())">Model default</AppButton>
                                <AppButton Variant="ghost" Size="xs" Active="@Current.Temperature.HasValue" Disabled="@(!CanCustomizeTemperature)" OnClick="@(_ => EnableTemperature())">Custom</AppButton>
                            </div>
                            @if (Current.Temperature.HasValue && CanCustomizeTemperature)
                            {
                                <RangeSlider Value="@TemperatureSliderValue"
                                             ValueChanged="SetTemperature"
                                             Min="0"
                                             Max="2"
                                             Step="0.01"
                                             StartLabel="0 · steadier"
                                             EndLabel="2 · wilder" />
                            }
                            @if (!string.IsNullOrWhiteSpace(TemperatureSupportNote))
                            {
                                <div class="tuning-inline-note">@TemperatureSupportNote</div>
                            }
                        </ChildContent>
                    </FieldRow>
                    <div class="tuning-grid">
                        <NumberSetting Label="Top P" Value="@Current.TopP" Disabled="@(ActiveCapabilities.TopP != TuningSupport.Supported)" ValueChanged="value => Current.TopP = value" />
                        <NumberSetting Label="Seed" Value="@Current.Seed" Disabled="@(ActiveCapabilities.Seed != TuningSupport.Supported)" ValueChanged="value => Current.Seed = value" />
                    </div>
                </Section>

                <Section Title="Limits & Penalties" Class="tuning-section">
                    <div class="tuning-grid">
                        <NumberSetting Label="Max Output Tokens" Value="@Current.MaxTokens" Disabled="@(ActiveCapabilities.MaxTokens != TuningSupport.Supported)" ValueChanged="value => Current.MaxTokens = value" />
                        <NumberSetting Label="Frequency Penalty" Value="@Current.FrequencyPenalty" Disabled="@(ActiveCapabilities.FrequencyPenalty != TuningSupport.Supported)" ValueChanged="value => Current.FrequencyPenalty = value" />
                        <NumberSetting Label="Presence Penalty" Value="@Current.PresencePenalty" Disabled="@(ActiveCapabilities.PresencePenalty != TuningSupport.Supported)" ValueChanged="value => Current.PresencePenalty = value" />
                    </div>
                </Section>

                <Section Title="Stop Conditions" Class="tuning-section">
                    <FieldRow Label="Stop Sequences" Hint="Enter one stop sequence per line.">
                        <textarea class="field mono" rows="3" @bind="Current.StopSequences" disabled="@(ActiveCapabilities.StopSequences != TuningSupport.Supported)" placeholder="One stop sequence per line…"></textarea>
                    </FieldRow>
                </Section>
            </ChildContent>

            <Footer>
                <AppButton Variant="secondary" OnClick="@(_ => OnClose.InvokeAsync())">Cancel</AppButton>
                <AppButton Variant="primary" OnClick="Save"><FaIcon Name="check" />Save</AppButton>
            </Footer>
        </ModalStackLayout>
        </MainContent>
    </ModalTabGroup>
</ModalShell>

@code {
    sealed record StepDef(string Id, string Label);
    string Active = "appearance";
    string? CopiedToast;

    readonly StepDef[] Steps =
    [
        new("snapshot", "Snapshot"),
        new("appearance", "Appearance"),
        new("selection", "Selection"),
        new("planning", "Planning"),
        new("prose", "Prose")
    ];

    Dictionary<string, ModelTuningStepState> Defaults = new();

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    StepDef CurrentStep => Steps.First(step => step.Id == Active);
    Dictionary<string, ModelTuningStepState> Values => Session.Chat.ModelTuning.State.Values;
    ModelTuningStepState Current => Values[Active];
    ActiveModelSelection? ActiveTextModel => ResolveActiveTextModel();
    ModelGenerationCapabilities ActiveCapabilities => ActiveTextModel?.Capabilities ?? ModelGenerationCapabilities.Fallback;
    bool CanCustomizeTemperature => ActiveCapabilities.Temperature == TuningSupport.Supported;
    double TemperatureSliderValue => Current.Temperature ?? 1d;
    string? TemperatureSupportNote => ActiveCapabilities.Temperature switch
    {
        TuningSupport.Supported when Current.Temperature is null => "Temperature stays off until you switch to a custom value.",
        TuningSupport.DefaultOnly when Current.Temperature.HasValue => "This model only accepts its default temperature. Any saved custom value will be ignored until you clear it.",
        TuningSupport.DefaultOnly => "This model only accepts its default temperature.",
        TuningSupport.Unsupported when Current.Temperature.HasValue => "This model does not support temperature. Any saved value will be ignored until you clear it.",
        TuningSupport.Unsupported => "This model does not support temperature.",
        _ => null
    };

    protected override void OnInitialized()
    {
        Session.Chat.ModelTuning.Changed += OnStoreChanged;
        Session.Chat.ModelSelection.Changed += OnStoreChanged;
        Session.Providers.Changed += OnStoreChanged;
        Defaults = ModelTuningState.CreateDefault().Values.ToDictionary(pair => pair.Key, pair => Clone(pair.Value), StringComparer.Ordinal);
    }

    ActiveModelSelection? ResolveActiveTextModel()
    {
        foreach (var provider in Session.Providers.Items)
            CapabilityCatalog.ApplyResolvedCapabilities(provider);

        return Session.Chat.ModelSelection.Resolve(AiModelRole.Chat);
    }

    Task OnStoreChanged() => InvokeAsync(StateHasChanged);

    static ModelTuningStepState Clone(ModelTuningStepState value) => new()
    {
        Temperature = value.Temperature,
        TopP = value.TopP,
        MaxTokens = value.MaxTokens,
        Seed = value.Seed,
        FrequencyPenalty = value.FrequencyPenalty,
        PresencePenalty = value.PresencePenalty,
        StopSequences = value.StopSequences
    };

    bool IsDirty() => IsDirtyStep(Active);
    void SetActive(string? id) => Active = id ?? Active;

    bool IsDirtyStep(string id)
    {
        var current = Values[id];
        var def = Defaults[id];
        return current.Temperature != def.Temperature ||
               current.TopP != def.TopP ||
               current.MaxTokens != def.MaxTokens ||
               current.Seed != def.Seed ||
               current.FrequencyPenalty != def.FrequencyPenalty ||
               current.PresencePenalty != def.PresencePenalty ||
               current.StopSequences != def.StopSequences;
    }

    void EnableTemperature()
    {
        if (!CanCustomizeTemperature)
            return;

        Current.Temperature ??= 1d;
    }

    void ClearTemperature() => Current.Temperature = null;

    void SetTemperature(double value) => Current.Temperature = value;

    async Task Reset()
    {
        Values[Active] = Clone(Defaults[Active]);
        await Session.Chat.ModelTuning.MarkChangedAsync();
    }

    void CopyTo(string targetId)
    {
        Values[targetId] = Clone(Current);
        CopiedToast = $"Copied to {Steps.First(step => step.Id == targetId).Label}";
        _ = Session.Chat.ModelTuning.MarkChangedAsync();
    }

    void CopyToAll()
    {
        foreach (var step in Steps.Where(step => step.Id != Active))
            Values[step.Id] = Clone(Current);

        CopiedToast = "Copied to all phases";
        _ = Session.Chat.ModelTuning.MarkChangedAsync();
    }

    async Task ExportSettings()
    {
        var content = System.Text.Json.JsonSerializer.Serialize(Current, AppJsonSerializerOptions.IndentedWeb);
        await JS.InvokeVoidAsync("agentRp.downloadText", $"model-tuning-{Active}.json", content, "application/json;charset=utf-8");
    }

    async Task ImportSettings()
    {
        var imported = await JS.InvokeAsync<string>("agentRp.importText", ".json");
        if (string.IsNullOrWhiteSpace(imported))
            return;

        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<ModelTuningStepState>(imported, AppJsonSerializerOptions.Web);
            if (parsed is not null)
            {
                Values[Active] = parsed;
                await Session.Chat.ModelTuning.MarkChangedAsync();
            }
        }
        catch
        {
            CopiedToast = "Import failed";
        }
    }

    Task Save(MouseEventArgs args) => Session.Chat.ModelTuning.MarkChangedAsync();

    public void Dispose()
    {
        Session.Chat.ModelTuning.Changed -= OnStoreChanged;
        Session.Chat.ModelSelection.Changed -= OnStoreChanged;
        Session.Providers.Changed -= OnStoreChanged;
    }
}
