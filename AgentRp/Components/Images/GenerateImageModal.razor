<ModalShell Title="Generate Image" MaxWidth="1000px" OnClose="RequestClose">
    <div class="generate-layout">
        <aside class="generate-settings">
            <Section Title="Settings" Class="generate-block">
                <FieldRow Label="Image Model">
                    <select class="select" @bind="Model">
                        <option>gpt-image-1.5 (OpenAI)</option>
                        <option>DALL·E 3 (OpenAI)</option>
                        <option>FLUX 1.1 Pro (Black Forest)</option>
                        <option>Stable Diffusion 3.5 (Stability)</option>
                    </select>
                </FieldRow>
                <div style="display:flex;gap:8px">
                    <FieldRow Label="Size"><select class="select" @bind="Size"><option>Landscape</option><option>Portrait</option><option>Square</option></select></FieldRow>
                    <FieldRow Label="Quality"><select class="select" @bind="Quality"><option>Auto</option><option>High</option><option>Medium</option></select></FieldRow>
                    <FieldRow Label="Refs"><select class="select" @bind="Refs"><option>Low</option><option>Medium</option><option>High</option></select></FieldRow>
                </div>
                <FieldRow Label="Prompt" Hint="Entity context from checked entities will be woven into the prompt automatically.">
                    <textarea class="field generate-prompt" rows="2" @bind="Prompt" placeholder="Describe the scene you want to generate…"></textarea>
                </FieldRow>
            </Section>

            <Section Title="Entity Context" Class="generate-block">
                @if (!string.IsNullOrWhiteSpace(TargetEntityName))
                {
                    <div class="model-card generate-target-card"><strong>@TargetEntityName</strong></div>
                }
                <TiledSelectList TItem="RpCharacter"
                                 Items="Characters"
                                 SelectedIds="SelectedCharacters"
                                 GetId="@(character => character.Id)"
                                 Title="@(character => character.Name)"
                                 Layout="TiledSelectLayout.Vertical"
                                 Columns="3"
                                 OnToggle="Toggle">
                    <ItemTemplate Context="character">
                        <span class="tiled-select-media">
                            <Avatar Name="@character.Name" Size="22" />
                        </span>
                        <strong class="tiled-select-label">@character.Name</strong>
                    </ItemTemplate>
                </TiledSelectList>
            </Section>

            <Section Title="Reference Images" Class="generate-block">
                <TiledSelectList TItem="GalleryImage"
                                 Items="Images"
                                 SelectedIds="SelectedRefs"
                                 GetId="@(image => image.Id)"
                                 Title="@(image => image.Name)"
                                 Layout="TiledSelectLayout.Horizontal"
                                 OnToggle="ToggleRef">
                    <ItemTemplate Context="image">
                        <span class="tiled-select-media img-placeholder" style="--hue:@image.Hue">@ShortLabel(image.Name)</span>
                        <strong class="tiled-select-label">@image.Name</strong>
                    </ItemTemplate>
                </TiledSelectList>
            </Section>
        </aside>

        <Section Title="Generated Image" Class="generate-preview" BodyClass="generate-preview-body">
            <div class="generated-frame">
                @if (Generating)
                {
                    <div class="empty-preview"><span class="spinner"></span><span>Generating…</span></div>
                }
                else if (SelectedGenerated is not null)
                {
                    <div class="img-placeholder" style="height:100%;--hue:@SelectedGeneratedHue">@SelectedGeneratedTitle</div>
                }
                else
                {
                    <div class="empty-preview"><FaIcon Name="image" /><span>Preview</span></div>
                }
            </div>
            <TiledSelectList TItem="GeneratedImageOption"
                             Items="Generated"
                             SelectedIds="SelectedGeneratedIds"
                             GetId="@(option => option.Id)"
                             Title="@(option => option.Title)"
                             Layout="TiledSelectLayout.Horizontal"
                             OnToggle="SelectGenerated">
                <EmptyContent>Generate to add options</EmptyContent>
                <ItemTemplate Context="option">
                    <span class="tiled-select-media img-placeholder" style="--hue:@option.Hue">@ShortLabel(option.Title)</span>
                    <strong class="tiled-select-label">@option.Title</strong>
                </ItemTemplate>
                <BadgeTemplate Context="option">
                    @if (option.IsSaved)
                    {
                        <span class="tiled-select-badge is-saved" title="Saved to gallery"><FaIcon Name="save" /></span>
                    }
                </BadgeTemplate>
            </TiledSelectList>
        </Section>
    </div>
    <div class="modal-local-footer">
        <span style="flex:1"></span>
        <AppButton Variant="primary" Disabled="@(!CanGenerate || Generating)" OnClick="Generate"><FaIcon Name="sparkle" />@GenerateButtonText</AppButton>
        @if (SelectedGenerated is not null)
        {
            <AppButton Variant="blue" Disabled="@SelectedGenerated.IsSaved" OnClick="Save"><FaIcon Name="download" />@SaveButtonText</AppButton>
        }
        <AppButton Variant="secondary" OnClick="@(_ => RequestClose())">Done</AppButton>
    </div>
</ModalShell>

@if (ConfirmDiscard)
{
    <ConfirmDialog Title="Discard unsaved images?"
                   Body="Any generated images that have not been saved to the gallery will be discarded."
                   Icon="x"
                   ConfirmText="Discard"
                   ConfirmVariant="rose"
                   OnCancel="@(() => ConfirmDiscard = false)"
                   OnConfirm="CloseWithoutSaving" />
}

@code {
    bool Generating;
    bool ConfirmDiscard;
    string Prompt = "";
    string Model = "gpt-image-1.5 (OpenAI)";
    string Size = "Landscape";
    string Quality = "Auto";
    string Refs = "Low";
    string? SelectedGeneratedId;
    HashSet<string> SelectedCharacters = ["c3"];
    HashSet<string> SelectedRefs = ["g1", "g2"];
    List<GeneratedImageOption> Generated = [];

    [Parameter] public List<RpCharacter> Characters { get; set; } = [];
    [Parameter] public List<GalleryImage> Images { get; set; } = [];
    [Parameter] public string? TargetEntityName { get; set; }
    [Parameter] public string? TargetEntityType { get; set; }
    [Parameter] public bool AutoUseSavedImage { get; set; }
    [Parameter] public EventCallback<GalleryImage> OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    GeneratedImageOption? SelectedGenerated => Generated.FirstOrDefault(image => image.Id == SelectedGeneratedId);
    ISet<string> SelectedGeneratedIds => SelectedGeneratedId is null ? new HashSet<string>() : new HashSet<string> { SelectedGeneratedId };
    int SelectedGeneratedHue => SelectedGenerated?.Hue ?? 200;
    string SelectedGeneratedTitle => SelectedGenerated?.Title ?? "Generated scene";
    bool HasPrompt => !string.IsNullOrWhiteSpace(Prompt);
    bool HasEntityContext => SelectedCharacters.Count > 0 || !string.IsNullOrWhiteSpace(TargetEntityName);
    bool CanGenerate => HasPrompt || HasEntityContext;
    bool HasUnsavedGeneratedImages => Generated.Any(image => !image.IsSaved);
    string GenerateButtonText => Generating ? "Generating…" : Generated.Count > 0 ? "Generate More" : "Generate";
    string SaveButtonText => SelectedGenerated?.IsSaved == true ? "Saved to Gallery" : AutoUseSavedImage ? "Use Generated" : "Save to Gallery";

    void Toggle(string id)
    {
        if (!SelectedCharacters.Add(id))
            SelectedCharacters.Remove(id);
    }

    void ToggleRef(string id)
    {
        if (!SelectedRefs.Add(id))
            SelectedRefs.Remove(id);
    }

    static string ShortLabel(string value) => value.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? value;

    async Task Generate()
    {
        if (!CanGenerate)
            return;

        Generating = true;
        await Task.Delay(1800);
        var title = HasPrompt
            ? Prompt.Length > 28 ? Prompt[..28] : Prompt
            : EntityContextTitle();
        var option = new GeneratedImageOption
        {
            Id = $"generated-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}-{Generated.Count + 1}",
            Title = title,
            Hue = 200 + Generated.Count * 20
        };
        Generated.Insert(0, option);
        SelectedGeneratedId = option.Id;
        Generating = false;
    }

    string EntityContextTitle()
    {
        if (!string.IsNullOrWhiteSpace(TargetEntityName))
            return TargetEntityName;

        return Characters.FirstOrDefault(character => SelectedCharacters.Contains(character.Id))?.Name ?? "Entity context";
    }

    void SelectGenerated(string id) => SelectedGeneratedId = id;

    async Task Save(MouseEventArgs args)
    {
        var selected = SelectedGenerated;
        if (selected is null || selected.IsSaved)
            return;

        var image = new GalleryImage
        {
            Id = NextGalleryImageId(),
            Name = selected.Title,
            Entity = string.IsNullOrWhiteSpace(TargetEntityName) ? "Generated" : TargetEntityName,
            EntityType = GalleryEntityType,
            Date = "today",
            Hue = selected.Hue
        };
        Images.Insert(0, image);
        selected.SavedImageId = image.Id;
        await OnSaved.InvokeAsync(image);
    }

    async Task RequestClose()
    {
        if (HasUnsavedGeneratedImages)
        {
            ConfirmDiscard = true;
            await Task.CompletedTask;
            return;
        }

        await OnClose.InvokeAsync();
    }

    async Task CloseWithoutSaving()
    {
        ConfirmDiscard = false;
        await OnClose.InvokeAsync();
    }

    string NextGalleryImageId()
    {
        var index = Images
            .Select(image => image.Id)
            .Where(id => id.Length > 1 && id[0] == 'g' && int.TryParse(id[1..], out _))
            .Select(id => int.Parse(id[1..]))
            .DefaultIfEmpty(0)
            .Max() + 1;

        return $"g{index}";
    }

    string GalleryEntityType => TargetEntityType switch
    {
        "characters" => "character",
        "locations" => "location",
        "items" => "item",
        _ => "scene"
    };

    public sealed class GeneratedImageOption
    {
        public string Id { get; init; } = "";
        public string Title { get; init; } = "";
        public int Hue { get; init; }
        public string? SavedImageId { get; set; }
        public bool IsSaved => !string.IsNullOrWhiteSpace(SavedImageId);
    }
}
