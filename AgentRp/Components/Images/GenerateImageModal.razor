@implements IDisposable
@inject IImageGenerationService ImageGenerationService
@inject ILogger<GenerateImageModal> Logger

<ModalShell Title="Generate Image" MaxWidth="1000px" BodyClass="is-flush" OnClose="RequestClose">
    <ChildContent>
        <ModalSplitLayout RailWidth="400px" Class="generate-layout" RailClass="generate-settings">
            <RailContent>
                <FormSection Title="Settings" Class="generate-block">
                    <FieldRow Label="Image Model">
                        <AppSelect Value="@ModelKey" ValueChanged="SetModel">
                            @foreach (var model in ImageModels)
                            {
                                <option @key="model.Key" value="@model.Key">@model.Label</option>
                            }
                        </AppSelect>
                    </FieldRow>
                    @if (ImageModels.Count == 0)
                    {
                        <div class="modal-error">Enable an image-capable model in AI Providers before generating images.</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="modal-error">@ErrorMessage</div>
                    }
                    <div class="field-row-grid cols-3">
                        <FieldRow Label="Size">
                            <AppSelect Value="@Size" ValueChanged="value => Size = value">
                                <option value="@StoryImagePromptBuilder.LandscapeSize">Landscape</option>
                                <option value="@StoryImagePromptBuilder.PortraitSize">Portrait</option>
                                <option value="@StoryImagePromptBuilder.SquareSize">Square</option>
                                <option value="auto">Auto</option>
                            </AppSelect>
                        </FieldRow>
                        <FieldRow Label="Quality">
                            <AppSelect Value="@Quality" ValueChanged="value => Quality = value">
                                <option value="auto">Auto</option>
                                <option value="high">High</option>
                                <option value="medium">Medium</option>
                                <option value="low">Low</option>
                            </AppSelect>
                        </FieldRow>
                        <FieldRow Label="Reference Detail">
                            <AppSelect Value="@ReferenceDetail" ValueChanged="value => ReferenceDetail = value">
                                <option value="auto">Auto</option>
                                <option value="high">High</option>
                                <option value="low">Low</option>
                            </AppSelect>
                        </FieldRow>
                    </div>
                    <FieldRow Label="Art Style">
                        <AppSelect Value="@ArtStyleKey" ValueChanged="value => ArtStyleKey = value">
                            @foreach (var style in ArtStyleOptions)
                            {
                                <option @key="style.Key" value="@style.Key">@style.Label</option>
                            }
                        </AppSelect>
                    </FieldRow>
                    <FieldRow Label="Prompt" Hint="Entity context from checked entities will be woven into the prompt automatically.">
                        <AppTextarea Class="generate-prompt" Rows="2" @bind-Value="Prompt" Placeholder="Describe the scene you want to generate..." />
                    </FieldRow>
                    @if (!string.IsNullOrWhiteSpace(LastFinalPrompt) || !string.IsNullOrWhiteSpace(LastRationale))
                    {
                        <div class="generate-review">
                            <ImagePromptBlock Title="Prompt Sent to Image Model" Text="@LastFinalPrompt" />
                            <ImagePromptBlock Title="Rationale" Text="@LastRationale" />
                        </div>
                    }
                </FormSection>

                <Section Title="Entity Context" Class="generate-block">
                    @if (TargetEntity is not null)
                    {
                        <div class="model-card generate-target-card">
                            <EntityImage Name="@TargetEntity.Name" Image="@TargetEntity.Image" EntityType="@TargetEntity.EntityType" EntityId="@TargetEntity.EntityId" Size="28" />
                            <strong>@TargetEntity.Name</strong>
                            <small>@TargetEntity.EntityType</small>
                        </div>
                    }
                    <ImageEntityContextPicker Entities="EntityOptions"
                                              SelectedIds="SelectedEntities"
                                              OnToggle="ToggleEntity" />
                </Section>

                <Section Title="Reference Images" Class="generate-block">
                    <div class="generate-reference-toolbar">
                        <ToggleSwitch Value="@ShowAllReferences" ValueChanged="value => ShowAllReferences = value" />
                        <span>Show all</span>
                    </div>
                    <ImageReferencePicker Images="FilteredReferences"
                                          SelectedIds="SelectedRefs"
                                          OnToggle="ToggleRef" />
                </Section>
            </RailContent>

            <MainContent>
                <Section Title="Generated Image" Class="generate-preview" BodyClass="generate-preview-body">
                    <GeneratedImagePreview Generating="@Generating"
                                           ImageUrl="@CurrentPreviewUrl"
                                           ImageAlt="@CurrentPreviewAlt"
                                           CanOpenDetails="@CanOpenSelectedDetails"
                                           OnOpenDetails="OpenSelectedDetails" />
                    <GeneratedImageStrip Generated="Generated"
                                         SelectedIds="SelectedGeneratedIds"
                                         OnToggle="SelectGenerated" />
                </Section>
            </MainContent>
        </ModalSplitLayout>
    </ChildContent>
    <Footer>
        <span class="modal-action-spacer"></span>
        <BusyButton Variant="primary" Disabled="@(!CanGenerate || Generating)" OnClick="Generate"><FaIcon Name="sparkle" />@GenerateButtonText</BusyButton>
        @if (SelectedGenerated is not null)
        {
            <BusyButton Variant="blue" Disabled="@SelectedGenerated.IsSaved" OnClick="Save"><FaIcon Name="download" />@SaveButtonText</BusyButton>
        }
        <AppButton Variant="secondary" OnClick="@(_ => RequestClose())">Done</AppButton>
    </Footer>
</ModalShell>

@if (!string.IsNullOrWhiteSpace(DetailImageId))
{
    <ImageDetailsModal ImageId="@DetailImageId" OnClose="@(() => DetailImageId = null)" />
}

@if (ConfirmDiscard)
{
    <ConfirmDialog Title="Discard unsaved images?"
                   Body="Any generated images that have not been saved to the gallery will be discarded."
                   Icon="x"
                   ConfirmText="Discard"
                   ConfirmVariant="rose"
                   OnCancel="@(() => ConfirmDiscard = false)"
                   OnConfirm="CloseWithoutSaving" />
}

@code {
    bool Generating;
    bool ConfirmDiscard;
    bool ShowAllReferences;
    string Prompt = "";
    string ModelKey = "";
    string ArtStyleKey = "none";
    string Size = StoryImagePromptBuilder.SquareSize;
    string Quality = "auto";
    string ReferenceDetail = "low";
    string ErrorMessage = "";
    string PreviewImageDataUrl = "";
    string LastFinalPrompt = "";
    string LastRationale = "";
    string? DetailImageId;
    string? SelectedGeneratedId;
    CancellationTokenSource? GenerationCancellation;
    HashSet<string> SelectedEntities = [];
    HashSet<string> SelectedRefs = [];
    List<GeneratedImageOption> Generated = [];

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public string? TargetEntityId { get; set; }
    [Parameter] public string? TargetEntityName { get; set; }
    [Parameter] public string? TargetEntityType { get; set; }
    [Parameter] public bool AutoUseSavedImage { get; set; }
    [Parameter] public EventCallback<GalleryImage> OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    List<GalleryImage> Images => Session.Chat.Images.Items;
    IReadOnlyList<ImageArtStyleOption> ArtStyleOptions => ImageGenerationService.GetArtStyleOptions();
    IReadOnlyList<ImageModelOption> ImageModels => ImageGenerationService.GetEnabledImageModels(Session.Providers.Items, Session.ModelSelection.State);
    IReadOnlyList<ImageEntityOption> EntityOptions => BuildEntityOptions();
    ImageEntityOption? TargetEntity => EntityOptions.FirstOrDefault(entity => entity.EntityType == NormalizedTargetEntityType && entity.EntityId == TargetEntityId);
    GeneratedImageOption? SelectedGenerated => Generated.FirstOrDefault(image => image.Id == SelectedGeneratedId);
    ISet<string> SelectedGeneratedIds => SelectedGeneratedId is null ? new HashSet<string>() : new HashSet<string> { SelectedGeneratedId };
    IReadOnlyList<GalleryImage> FilteredReferences => ShowAllReferences ? Images : Images.Where(ShouldShowReference).ToList();
    bool HasPrompt => !string.IsNullOrWhiteSpace(Prompt);
    bool HasEntityContext => SelectedEntities.Count > 0 || !string.IsNullOrWhiteSpace(TargetEntityName);
    bool CanGenerate => !string.IsNullOrWhiteSpace(ModelKey) && (HasPrompt || HasEntityContext);
    bool HasUnsavedGeneratedImages => Generated.Any(image => !image.IsSaved);
    string GenerateButtonText => Generating ? "Generating..." : Generated.Count > 0 ? "Generate More" : "Generate";
    string SaveButtonText => SelectedGenerated?.IsSaved == true ? "Saved to Gallery" : AutoUseSavedImage ? "Use Generated" : "Save to Gallery";
    string CurrentPreviewUrl => Generating && !string.IsNullOrWhiteSpace(PreviewImageDataUrl) ? PreviewImageDataUrl : SelectedGenerated?.Image.Url ?? "";
    string CurrentPreviewAlt => SelectedGenerated?.Image.Name ?? "Generated image preview";
    bool CanOpenSelectedDetails => !Generating && SelectedGenerated is not null;
    string NormalizedTargetEntityType => StoryImagePromptBuilder.NormalizeEntityType(TargetEntityType);

    protected override async Task OnInitializedAsync()
    {
        Session.Chat.Characters.Changed += OnStoreChanged;
        Session.Chat.Locations.Changed += OnStoreChanged;
        Session.Chat.Items.Changed += OnStoreChanged;
        Session.Chat.Images.Changed += OnStoreChanged;
        Session.ModelSelection.Changed += OnStoreChanged;
        Session.Providers.Changed += OnStoreChanged;
        await LoadDefaultsAsync();
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(ModelKey) || ImageModels.All(model => model.Key != ModelKey))
            ModelKey = ImageModels.FirstOrDefault()?.Key ?? "";
    }

    async Task LoadDefaultsAsync()
    {
        var settings = await ImageGenerationService.GetSettingsAsync(Session.Providers.Items, Session.ModelSelection.State);
        ModelKey = settings.ModelKey;
        ArtStyleKey = settings.ArtStyleKey;
        Quality = settings.Quality;
        ReferenceDetail = settings.ReferenceDetail;
        Size = string.IsNullOrWhiteSpace(NormalizedTargetEntityType)
            ? settings.Size
            : StoryImagePromptBuilder.BuildReferenceSize(TargetEntityType);

        if (!string.IsNullOrWhiteSpace(TargetEntityName))
            Prompt = StoryImagePromptBuilder.BuildReferencePrompt(TargetEntityType, TargetEntityName);

        PreselectTargetEntity();
    }

    Task OnStoreChanged() => InvokeAsync(StateHasChanged);

    async Task SetModel(string modelKey)
    {
        ModelKey = modelKey;
        var selected = ImageModels.FirstOrDefault(model => model.Key == ModelKey);
        if (selected is not null)
            await Session.ModelSelection.SetActiveModelAsync(AiModelRole.Image, selected.ProviderId, selected.ModelId);
    }

    void ToggleEntity(string key)
    {
        if (!SelectedEntities.Add(key))
            SelectedEntities.Remove(key);
    }

    void ToggleRef(string id)
    {
        if (!SelectedRefs.Add(id))
            SelectedRefs.Remove(id);
    }

    async Task Generate()
    {
        if (!CanGenerate)
            return;

        Generating = true;
        ErrorMessage = "";
        PreviewImageDataUrl = "";
        LastFinalPrompt = "";
        LastRationale = "";
        GenerationCancellation?.Cancel();
        GenerationCancellation?.Dispose();
        var generationCancellation = new CancellationTokenSource();
        GenerationCancellation = generationCancellation;
        try
        {
            await ImageGenerationService.SaveSettingsAsync(new(ModelKey, Size, Quality, ReferenceDetail, ArtStyleKey), generationCancellation.Token);
            var document = Session.ActiveChat.Current ?? throw new InvalidOperationException("Generating an image failed because no story is open.");
            await foreach (var update in ImageGenerationService.GenerateStreamingAsync(
                document,
                Session.Providers.Items,
                Session.ModelSelection.State,
                new GenerateImageRequest(
                    ModelKey,
                    Prompt,
                    ArtStyleKey,
                    Size,
                    Quality,
                    ReferenceDetail,
                    BuildSelectedEntitySelections(),
                    SelectedRefs.ToList(),
                    TargetEntityName,
                    TargetEntityType,
                    TargetEntityId),
                generationCancellation.Token))
            {
                if (!string.IsNullOrWhiteSpace(update.PreviewImageDataUrl))
                {
                    PreviewImageDataUrl = update.PreviewImageDataUrl;
                    await InvokeAsync(StateHasChanged);
                }

                if (update.Result is not null)
                {
                    LastFinalPrompt = update.Result.FinalPrompt;
                    LastRationale = update.Result.Rationale;
                    var option = new GeneratedImageOption
                    {
                        Id = update.Result.Image.Id,
                        Image = update.Result.Image,
                        ProviderName = update.Result.ProviderName,
                        ModelId = update.Result.ModelId,
                        FinalPrompt = update.Result.FinalPrompt,
                        Rationale = update.Result.Rationale
                    };
                    Generated.Insert(0, option);
                    SelectedGeneratedId = option.Id;
                    PreviewImageDataUrl = "";
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Generating an image failed.",
                "Generating an image failed for chat {ChatId} using model key {ModelKey}.",
                Session.Chats.Active?.ChatId,
                ModelKey);
        }
        finally
        {
            Generating = false;
            if (ReferenceEquals(GenerationCancellation, generationCancellation))
            {
                GenerationCancellation.Dispose();
                GenerationCancellation = null;
            }
        }
    }

    void SelectGenerated(string id) => SelectedGeneratedId = id;

    void OpenSelectedDetails()
    {
        if (SelectedGenerated is not null)
            DetailImageId = SelectedGenerated.Id;
    }

    async Task Save()
    {
        var selected = SelectedGenerated;
        if (selected is null || selected.IsSaved)
            return;

        var image = selected.Image;
        await Session.Chat.Images.AddAsync(image);
        selected.SavedImageId = image.Id;
        await OnSaved.InvokeAsync(image);
    }

    async Task RequestClose()
    {
        CancelGeneration();
        if (HasUnsavedGeneratedImages)
        {
            ConfirmDiscard = true;
            await Task.CompletedTask;
            return;
        }

        await OnClose.InvokeAsync();
    }

    async Task CloseWithoutSaving()
    {
        CancelGeneration();
        ConfirmDiscard = false;
        await OnClose.InvokeAsync();
    }

    IReadOnlyList<ImageEntityOption> BuildEntityOptions() =>
        Session.Chat.Characters.Items.Select(character => BuildEntity("character", character.Id, character.Name, character.ImageId))
            .Concat(Session.Chat.Locations.Items.Select(location => BuildEntity("location", location.Id, location.Name, location.ImageId)))
            .Concat(Session.Chat.Items.Items.Select(item => BuildEntity("item", item.Id, item.Name, item.ImageId)))
            .ToList();

    ImageEntityOption BuildEntity(string entityType, string entityId, string name, string imageId) =>
        new(BuildEntityKey(entityType, entityId), entityType, entityId, name, imageId, ImageFor(imageId));

    List<StoryImageEntitySelection> BuildSelectedEntitySelections()
    {
        var selections = EntityOptions
            .Where(entity => SelectedEntities.Contains(entity.Key))
            .Select(entity => entity.ToSelection())
            .ToList();
        if (!string.IsNullOrWhiteSpace(NormalizedTargetEntityType)
            && !string.IsNullOrWhiteSpace(TargetEntityId)
            && selections.All(entity => entity.EntityType != NormalizedTargetEntityType || entity.EntityId != TargetEntityId))
        {
            selections.Add(new(NormalizedTargetEntityType, TargetEntityId));
        }

        return selections;
    }

    void PreselectTargetEntity()
    {
        if (string.IsNullOrWhiteSpace(NormalizedTargetEntityType) || string.IsNullOrWhiteSpace(TargetEntityId))
            return;

        SelectedEntities.Add(BuildEntityKey(NormalizedTargetEntityType, TargetEntityId));
    }

    bool ShouldShowReference(GalleryImage image)
    {
        if (SelectedRefs.Contains(image.Id))
            return true;

        var selected = EntityOptions.Where(entity => SelectedEntities.Contains(entity.Key)).ToList();
        if (selected.Count == 0)
            return false;

        return selected.Any(entity =>
            image.Id == entity.ImageId
            || (string.Equals(image.EntityType, entity.EntityType, StringComparison.OrdinalIgnoreCase)
                && string.Equals(image.Entity, entity.Name, StringComparison.OrdinalIgnoreCase)));
    }

    GalleryImage? ImageFor(string imageId) => Images.FirstOrDefault(image => image.Id == imageId);

    static string BuildEntityKey(string entityType, string entityId) => $"{entityType}:{entityId}";

    public void Dispose()
    {
        CancelGeneration();
        Session.Chat.Characters.Changed -= OnStoreChanged;
        Session.Chat.Locations.Changed -= OnStoreChanged;
        Session.Chat.Items.Changed -= OnStoreChanged;
        Session.Chat.Images.Changed -= OnStoreChanged;
        Session.ModelSelection.Changed -= OnStoreChanged;
        Session.Providers.Changed -= OnStoreChanged;
    }

    void CancelGeneration()
    {
        GenerationCancellation?.Cancel();
    }
}
