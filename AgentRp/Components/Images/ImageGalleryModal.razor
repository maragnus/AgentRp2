<ModalShell Title="@Title" MaxWidth="860px" OnClose="OnClose">
    <div class="modal-filter-bar">
        <div style="position:relative;flex:1;max-width:240px">
            <FaIcon Name="search" />
            <input class="field search-field" placeholder="Search images…" @bind="Search" @bind:event="oninput" />
        </div>
        <div class="segmented">
            @foreach (var type in Types)
            {
                <AppButton @key="type" Size="sm" Active="@(Filter == type)" OnClick="@(_ => Filter = type)">@type</AppButton>
            }
        </div>
    </div>
    <TiledSelectList TItem="GalleryImage"
                     Items="Filtered"
                     SelectedIds="SelectedIds"
                     GetId="@(image => image.Id)"
                     Title="@(image => image.Name)"
                     Layout="TiledSelectLayout.Vertical"
                     MinTileWidth="150px"
                     Class="is-gallery"
                     ReadOnly="@(Mode == ImageGalleryMode.View)"
                     OnToggle="Pick">
        <LeadingContent>
            <button type="button" class="tiled-select-card is-readonly tiled-gallery-generate" @onclick="Generate">
                <span class="tiled-select-media tiled-gallery-media">
                    <FaIcon Name="sparkle" />
                    <span>Generate new image</span>
                </span>
                <span class="tiled-select-caption">
                    <strong class="tiled-select-label">Generate Image</strong>
                    <small>New gallery image</small>
                </span>
            </button>
        </LeadingContent>
        <ItemTemplate Context="image">
            <span class="tiled-select-media tiled-gallery-media img-placeholder" style="--hue:@image.Hue">@image.Name</span>
            <span class="tiled-select-caption">
                <strong class="tiled-select-label">@image.Name</strong>
                <small>@image.EntityType · @image.Date</small>
            </span>
        </ItemTemplate>
        <ActionTemplate Context="image">
            <span class="tiled-select-actions">
                <IconButton Icon="eye" Title="View image" StopPropagation OnClick="@(_ => View(image))" />
                <IconButton Icon="trash" Variant="danger" Title="Delete image" StopPropagation OnClick="@(_ => Delete(image))" />
            </span>
        </ActionTemplate>
    </TiledSelectList>
    <div class="modal-local-footer">
        <span>@Filtered.Count images@(Selected is null ? "" : " · 1 selected")</span>
        <div style="display:flex;gap:8px">
            @if (Mode == ImageGalleryMode.Select && Selected is not null)
            {
                <AppButton Variant="primary" OnClick="UseSelected">Use Selected</AppButton>
            }
            <AppButton Variant="secondary" OnClick="@(_ => OnClose.InvokeAsync())">Close</AppButton>
        </div>
    </div>
</ModalShell>

@code {
    string Search = "";
    string Filter = "all";
    GalleryImage? Selected;
    readonly string[] Types = ["all", "character", "location", "item"];

    [Parameter] public ImageGalleryMode Mode { get; set; } = ImageGalleryMode.View;
    [Parameter] public string? SelectedImageId { get; set; }
    [Parameter] public List<GalleryImage> Images { get; set; } = [];
    [Parameter] public EventCallback OnGenerate { get; set; }
    [Parameter] public EventCallback<GalleryImage> OnUseSelected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    string Title => Mode == ImageGalleryMode.Select ? "Select Image" : "Image Gallery";
    ISet<string> SelectedIds => Selected is null ? new HashSet<string>() : new HashSet<string> { Selected.Id };

    List<GalleryImage> Filtered => Images
        .Where(image => Filter == "all" || image.EntityType == Filter)
        .Where(image => string.IsNullOrWhiteSpace(Search) || image.Name.Contains(Search, StringComparison.OrdinalIgnoreCase) || image.Entity.Contains(Search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override void OnParametersSet()
    {
        if (Mode == ImageGalleryMode.Select)
            Selected = Images.FirstOrDefault(image => image.Id == SelectedImageId);
        else
            Selected = null;
    }

    void Pick(string id)
    {
        if (Mode == ImageGalleryMode.Select)
            Selected = Images.FirstOrDefault(image => image.Id == id);
    }

    Task Generate(MouseEventArgs args) => OnGenerate.InvokeAsync();

    static void View(GalleryImage image)
    {
    }

    void Delete(GalleryImage image) => Images.Remove(image);

    Task UseSelected(MouseEventArgs args) => Selected is null
        ? Task.CompletedTask
        : OnUseSelected.InvokeAsync(Selected);
}
