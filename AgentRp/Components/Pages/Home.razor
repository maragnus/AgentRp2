@page "/"

<PageTitle>AgentRp</PageTitle>

<div class="app-shell">
    <Sidebar Characters="Characters"
             Locations="Locations"
             Chats="Chats"
             ActiveChat="ActiveChat"
             SpeakingAs="SpeakingAs"
             OnChatSelected="SelectChat"
             OnSpeakAs="SetSpeakingAs"
             OnToggleScene="ToggleScene"
             OnSwitchLocation="SwitchLocation"
             OnOpenModal="OpenModal"
             OnOpenEntities="OpenEntities" />

    <ChatArea Chat="ActiveChat"
              Messages="Messages"
              Characters="Characters"
              SpeakingAs="SpeakingAs"
              OnSpeakAs="SetSpeakingAs"
              OnPost="PostMessage"
              OnDeleteMessage="DeleteMessage"
              OnDeleteBranch="DeleteBranch" />

    @switch (Modal)
    {
        case "entities":
            <EntityManagerModal InitialType="@EntityType"
                                InitialId="@EntityId"
                                Characters="Characters"
                                Locations="Locations"
                                Items="Items"
                                Timeline="Timeline"
                                Images="Images"
                                OnSelectEntityImage="OpenEntityImagePicker"
                                OnClose="CloseModal"
                                OnChanged="Refresh" />
            break;
        case "gallery":
            <ImageGalleryModal Mode="ImageGalleryMode.View" Images="Images" OnGenerate="OpenGalleryGenerator" OnClose="CloseModal" />
            break;
        case "imageSelect":
            <ImageGalleryModal Mode="ImageGalleryMode.Select"
                               Images="Images"
                               SelectedImageId="@SelectedEntityImageId"
                               OnGenerate="OpenSelectionGenerator"
                               OnUseSelected="UseSelectedEntityImage"
                               OnClose="ReturnToEntities" />
            break;
        case "generate":
            <GenerateImageModal Characters="Characters"
                                Images="Images"
                                TargetEntityName="@PendingEntityName"
                                TargetEntityType="@PendingEntityType"
                                AutoUseSavedImage="@(PendingEntityId is not null)"
                                OnSaved="UseGeneratedEntityImage"
                                OnClose="CloseGenerator" />
            break;
        case "aiProviders":
            <AIProvidersModal Providers="Providers" OnClose="CloseModal" />
            break;
        case "promptLibrary":
            <PromptLibraryModal OnClose="CloseModal" />
            break;
        case "modelTuning":
            <ModelTuningModal OnClose="CloseModal" />
            break;
        case "export":
            <ExportModal Characters="Characters" Locations="Locations" Items="Items" Timeline="Timeline" Chats="Chats" ActiveChat="ActiveChat" OnClose="CloseModal" />
            break;
    }
</div>

@code {
    List<RpCharacter> Characters = SeedData.Characters();
    List<RpLocation> Locations = SeedData.Locations();
    List<RpItem> Items = SeedData.Items();
    List<RpTimelineEntry> Timeline = SeedData.Timeline();
    List<RpChat> Chats = SeedData.Chats();
    List<RpMessage> Messages = SeedData.Messages();
    List<GalleryImage> Images = SeedData.GalleryImages();
    List<AiProvider> Providers = SeedData.Providers();
    RpChat ActiveChat = SeedData.Chats()[0];
    RpCharacter? SpeakingAs;
    string? Modal;
    string EntityType = "characters";
    string? EntityId;
    string? PendingEntityType;
    string? PendingEntityId;

    void SelectChat(RpChat chat) => ActiveChat = chat;
    void SetSpeakingAs(RpCharacter? character) => SpeakingAs = character;

    void ToggleScene(string id)
    {
        var character = Characters.First(c => c.Id == id);
        character.InScene = !character.InScene;
    }

    void SwitchLocation(string id)
    {
        foreach (var location in Locations)
            location.IsActive = location.Id == id;
    }

    void OpenModal(string name)
    {
        if (name is "gallery" or "generate")
            ClearPendingEntityImage();

        Modal = name;
    }

    void OpenEntities((string Type, string? Id) value)
    {
        EntityType = value.Type;
        EntityId = value.Id;
        Modal = "entities";
    }

    void CloseModal()
    {
        Modal = null;
        ClearPendingEntityImage();
    }
    void Refresh() => StateHasChanged();

    string? SelectedEntityImageId => PendingEntityType switch
    {
        "characters" => Characters.FirstOrDefault(character => character.Id == PendingEntityId)?.ImageId,
        "locations" => Locations.FirstOrDefault(location => location.Id == PendingEntityId)?.ImageId,
        "items" => Items.FirstOrDefault(item => item.Id == PendingEntityId)?.ImageId,
        _ => null
    };

    string? PendingEntityName => PendingEntityType switch
    {
        "characters" => Characters.FirstOrDefault(character => character.Id == PendingEntityId)?.Name,
        "locations" => Locations.FirstOrDefault(location => location.Id == PendingEntityId)?.Name,
        "items" => Items.FirstOrDefault(item => item.Id == PendingEntityId)?.Name,
        _ => null
    };

    Task OpenEntityImagePicker((string Type, string Id) value)
    {
        PendingEntityType = value.Type;
        PendingEntityId = value.Id;
        EntityType = value.Type;
        EntityId = value.Id;
        Modal = "imageSelect";
        return Task.CompletedTask;
    }

    void OpenGalleryGenerator()
    {
        ClearPendingEntityImage();
        Modal = "generate";
    }

    void OpenSelectionGenerator() => Modal = "generate";

    void ReturnToEntities() => Modal = "entities";

    void CloseGenerator()
    {
        Modal = PendingEntityId is null ? null : "imageSelect";
    }

    async Task UseSelectedEntityImage(GalleryImage image)
    {
        ApplyPendingEntityImage(image.Id);
        Modal = "entities";
        await Task.CompletedTask;
    }

    async Task UseGeneratedEntityImage(GalleryImage image)
    {
        if (PendingEntityId is not null)
        {
            ApplyPendingEntityImage(image.Id);
            Modal = "entities";
        }

        await Task.CompletedTask;
    }

    void ApplyPendingEntityImage(string imageId)
    {
        if (PendingEntityType == "characters")
            Characters.First(character => character.Id == PendingEntityId).ImageId = imageId;
        else if (PendingEntityType == "locations")
            Locations.First(location => location.Id == PendingEntityId).ImageId = imageId;
        else if (PendingEntityType == "items")
            Items.First(item => item.Id == PendingEntityId).ImageId = imageId;
    }

    void ClearPendingEntityImage()
    {
        PendingEntityType = null;
        PendingEntityId = null;
    }

    void PostMessage((string Text, RpCharacter? Speaker, string Mode) post)
    {
        if (string.IsNullOrWhiteSpace(post.Text))
            return;

        Messages.Add(new RpMessage
        {
            Id = $"msg-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
            Type = "narrative",
            Author = post.Speaker?.Name ?? "Narrator",
            Mode = post.Mode == "guided" ? "Guided AI" : post.Mode == "automatic" ? "Automatic AI" : "Manual",
            Timestamp = "just now",
            Body = post.Text
        });
    }

    void DeleteMessage(string id) => Messages.RemoveAll(message => message.Id == id);

    void DeleteBranch(string id)
    {
        var index = Messages.FindIndex(message => message.Id == id);
        if (index >= 0)
            Messages.RemoveRange(index, Messages.Count - index);
    }
}
