@page "/"
@inject OverlayService Overlays

<PageTitle>AgentRp</PageTitle>

@if (Session.IsInitialized)
{
    <div class="app-shell">
        <Sidebar OnOpenModal="OpenModal" OnOpenEntities="OpenEntities" />

        <ChatArea OnOpenEntities="OpenEntities" OnNewStory="OpenNewStory" />

        @switch (Modal)
        {
            case "entities":
                <EntityManagerModal InitialType="@EntityType"
                                    InitialId="@EntityId"
                                    OnSelectEntityImage="OpenEntityImagePicker"
                                    OnClose="CloseModal" />
                break;
            case "newStory":
                <NewStoryModal OnClose="CloseModal" OnOpenAssistant="OpenStoryAssistant" />
                break;
            case "gallery":
                <ImageGalleryModal Mode="ImageGalleryMode.View" OnGenerate="OpenGalleryGenerator" OnClose="CloseModal" />
                break;
            case "imageSelect":
                <ImageGalleryModal Mode="ImageGalleryMode.Select"
                                   SelectedImageId="@SelectedEntityImageId"
                                   OnGenerate="OpenSelectionGenerator"
                                   OnUseSelected="UseSelectedEntityImage"
                                   OnClose="ReturnToEntities" />
                break;
            case "generate":
                <GenerateImageModal TargetEntityId="@PendingEntityId"
                                    TargetEntityName="@PendingEntityName"
                                    TargetEntityType="@PendingEntityType"
                                    AutoUseSavedImage="@(PendingEntityId is not null)"
                                    OnSaved="UseGeneratedEntityImage"
                                    OnClose="CloseGenerator" />
                break;
            case "aiProviders":
                <AIProvidersModal OnClose="CloseModal" />
                break;
            case "promptLibrary":
                <PromptLibraryModal OnClose="CloseModal" />
                break;
            case "storyAssistant":
                <StoryAssistantModal OnClose="CloseModal" />
                break;
            case "chatDirection":
                <ChatDirectionModal OnClose="CloseModal" />
                break;
            case "modelTuning":
                <ModelTuningModal OnClose="CloseModal" />
                break;
            case "export":
                <ExportModal Characters="Session.Chat.Characters.Items"
                             Locations="Session.Chat.Locations.Items"
                             Items="Session.Chat.Items.Items"
                             Timeline="Session.Chat.Timeline.Items"
                             Chats="Session.Chats.Items.ToList()"
                             ActiveChat="@(Session.Chats.Active ?? new())"
                             OnClose="CloseModal" />
                break;
        }

        @if (CropImage is not null)
        {
            <ImageCropModal Image="CropImage"
                            OnSaved="HandleCropSavedAsync"
                            OnClose="CloseCropAsync" />
        }
    </div>
}

@code {
    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;

    string? Modal;
    string EntityType = "characters";
    string? EntityId;
    string? PendingEntityType;
    string? PendingEntityId;
    GalleryImage? CropImage;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
    }

    async Task OpenModal(string name)
    {
        await Overlays.CloseAllAsync($"Opening modal '{name}'");
        if (name is "gallery" or "generate")
            ClearPendingEntityImage();

        Modal = name;
    }

    Task OpenNewStory() => OpenModal("newStory");

    async Task OpenEntities((string Type, string? Id) value)
    {
        await Overlays.CloseAllAsync($"Opening story entities '{value.Type}'");
        EntityType = value.Type;
        EntityId = value.Id;
        Modal = "entities";
    }

    async Task OpenStoryAssistant()
    {
        await Overlays.CloseAllAsync("Opening Story Assistant");
        Modal = "storyAssistant";
    }

    async Task CloseModal()
    {
        await Overlays.CloseAllAsync("Closing modal");
        Modal = null;
        ClearPendingEntityImage();
    }

    string? SelectedEntityImageId => PendingEntityType switch
    {
        "characters" => Session.Chat.Characters.Items.FirstOrDefault(character => character.Id == PendingEntityId)?.ImageId,
        "locations" => Session.Chat.Locations.Items.FirstOrDefault(location => location.Id == PendingEntityId)?.ImageId,
        "items" => Session.Chat.Items.Items.FirstOrDefault(item => item.Id == PendingEntityId)?.ImageId,
        _ => null
    };

    string? PendingEntityName => PendingEntityType switch
    {
        "characters" => Session.Chat.Characters.Items.FirstOrDefault(character => character.Id == PendingEntityId)?.Name,
        "locations" => Session.Chat.Locations.Items.FirstOrDefault(location => location.Id == PendingEntityId)?.Name,
        "items" => Session.Chat.Items.Items.FirstOrDefault(item => item.Id == PendingEntityId)?.Name,
        _ => null
    };

    async Task OpenEntityImagePicker((string Type, string Id) value)
    {
        await Overlays.CloseAllAsync("Opening entity image picker");
        PendingEntityType = value.Type;
        PendingEntityId = value.Id;
        EntityType = value.Type;
        EntityId = value.Id;
        Modal = "imageSelect";
    }

    async Task OpenGalleryGenerator()
    {
        await Overlays.CloseAllAsync("Opening gallery generator");
        ClearPendingEntityImage();
        Modal = "generate";
    }

    async Task OpenSelectionGenerator()
    {
        await Overlays.CloseAllAsync("Opening selection generator");
        Modal = "generate";
    }

    async Task ReturnToEntities()
    {
        await Overlays.CloseAllAsync("Returning to story entities");
        Modal = "entities";
    }

    async Task CloseGenerator()
    {
        await Overlays.CloseAllAsync("Closing image generator");
        Modal = PendingEntityId is null ? null : "imageSelect";
    }

    async Task UseSelectedEntityImage(GalleryImage image)
    {
        await ApplyPendingEntityImage(image.Id);
        CropImage = image;
        Modal = "entities";
    }

    async Task UseGeneratedEntityImage(GalleryImage image)
    {
        if (PendingEntityId is not null)
        {
            await ApplyPendingEntityImage(image.Id);
            CropImage = image;
            Modal = "entities";
        }
    }

    async Task HandleCropSavedAsync(ImageCropSavedResult result)
    {
        await Session.Chat.Images.SetCropAsync(result.ImageId, result.Crop);
        CropImage = null;
    }

    Task CloseCropAsync()
    {
        CropImage = null;
        return Task.CompletedTask;
    }

    Task ApplyPendingEntityImage(string imageId) => PendingEntityType switch
    {
        "characters" => Session.Chat.Characters.SetImageAsync(PendingEntityId!, imageId),
        "locations" => Session.Chat.Locations.SetImageAsync(PendingEntityId!, imageId),
        "items" => Session.Chat.Items.SetImageAsync(PendingEntityId!, imageId),
        _ => Task.CompletedTask
    };

    void ClearPendingEntityImage()
    {
        PendingEntityType = null;
        PendingEntityId = null;
    }
}
