@using AgentRp.Models
@using AgentRp.Services

@if (Entries.Count == 0)
{
    <div class="providers-empty-state is-compact">
        <FaIcon Name="clock" />
        <strong>No timeline items</strong>
        <span>The snapshot can still be saved with only a summary.</span>
    </div>
}
else
{
    <div class="snapshot-timeline-list">
        @for (var index = 0; index < Entries.Count; index++)
        {
            var entry = Entries[index];
            <FormSection @key="entry.Id" Title="@EntryTitle(entry, index)" Hint="@EntryHint(entry)" Class="snapshot-review-section snapshot-timeline-entry" Dirty="@EntryDirty(entry)">
                <RightContent>
                    <AppButton Icon="trash" TooltipText="Remove timeline item" OnClick="@(_ => Remove(entry.Id))" />
                </RightContent>
                <ChildContent>
                    <div class="snapshot-timeline-grid">
                        <FieldRow Label="When" Dirty="@TurnNumberDirty(entry)">
                            <AppInput Value="@FormatWhen(entry)" ValueChanged="value => UpdateTurnNumber(entry, value)" Dirty="@TurnNumberDirty(entry)" Placeholder="Turn 52" />
                        </FieldRow>
                        <FieldRow Label="Title" Dirty="@TitleDirty(entry)">
                            <AppInput Value="@entry.Title" ValueChanged="value => Update(updated => entry.Title = updated, value)" Dirty="@TitleDirty(entry)" Placeholder="Timeline title" UpdateMode="TextUpdateMode.Change" />
                        </FieldRow>
                    </div>
                    <FieldRow Label="Description" Dirty="@DescriptionDirty(entry)">
                        <AppTextarea Rows="3" Value="@entry.Description" ValueChanged="value => Update(updated => entry.Description = updated, value)" Dirty="@DescriptionDirty(entry)" />
                    </FieldRow>
                </ChildContent>
            </FormSection>
        }
    </div>
}

@code {
    [Parameter] public List<SnapshotDraftTimelineEntryEditor> Entries { get; set; } = [];
    [Parameter] public IReadOnlyList<SnapshotDraftTimelineEntryEditor> BaselineEntries { get; set; } = [];
    [Parameter] public EventCallback OnChanged { get; set; }

    async Task Remove(string id)
    {
        Entries.RemoveAll(entry => entry.Id == id);
        await OnChanged.InvokeAsync();
    }

    async Task UpdateTurnNumber(SnapshotDraftTimelineEntryEditor entry, string value)
    {
        entry.TurnNumber = ParseTurnNumber(value);
        await OnChanged.InvokeAsync();
    }

    async Task Update(Action<string> setValue, string value)
    {
        setValue(value);
        await OnChanged.InvokeAsync();
    }

    static string EntryTitle(SnapshotDraftTimelineEntryEditor entry, int index) =>
        string.IsNullOrWhiteSpace(entry.Title) ? $"Item {index + 1}" : entry.Title;

    static string EntryHint(SnapshotDraftTimelineEntryEditor entry) =>
        entry.TurnNumber <= 0 ? "Turn" : FormatWhen(entry);

    static string FormatWhen(SnapshotDraftTimelineEntryEditor entry) =>
        entry.TurnNumber <= 0 ? "" : TranscriptTurnNumbering.Format(entry.TurnNumber);

    static int ParseTurnNumber(string? value)
    {
        var text = value?.Trim() ?? "";
        if (text.StartsWith("turn", StringComparison.OrdinalIgnoreCase))
            text = text[4..].Trim();

        return int.TryParse(text, out var turnNumber) ? Math.Max(0, turnNumber) : 0;
    }

    SnapshotDraftTimelineEntryEditor? BaselineFor(SnapshotDraftTimelineEntryEditor entry) =>
        BaselineEntries.FirstOrDefault(item => string.Equals(item.Id, entry.Id, StringComparison.Ordinal));

    bool EntryDirty(SnapshotDraftTimelineEntryEditor entry) =>
        StatefulFormCollectionDirty.ItemDirty(Entries, BaselineEntries, entry.Id, item => item.Id);

    bool TurnNumberDirty(SnapshotDraftTimelineEntryEditor entry) =>
        BaselineFor(entry) is not { } baseline || entry.TurnNumber != baseline.TurnNumber;

    bool TitleDirty(SnapshotDraftTimelineEntryEditor entry) =>
        BaselineFor(entry) is not { } baseline || entry.Title != baseline.Title;

    bool DescriptionDirty(SnapshotDraftTimelineEntryEditor entry) =>
        BaselineFor(entry) is not { } baseline || entry.Description != baseline.Description;
}
