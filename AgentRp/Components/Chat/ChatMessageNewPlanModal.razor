@using AgentRp.Services

<ModalShell Title="New Plan" Subtitle="@Subtitle" Icon="sparkle" MaxWidth="680px" CloseDisabled="@TranscriptBusy" OnClose="Close">
    <ChildContent>
        <FormSection Title="Guidance" Hint="Creates a new branch from this message.">
            <AppTextarea Rows="8"
                         Value="@GuidanceDraft"
                         ValueChanged="SetGuidance"
                         Placeholder="Guide the revised turn." />
        </FormSection>
        <Section Title="Turn Shape">
            <TurnShapePicker SelectedShape="@TurnShapeDraft"
                             Disabled="@TranscriptBusy"
                             Placement="OverlayPlacement.BottomStart"
                             ShapeSelected="SetTurnShape" />
        </Section>
    </ChildContent>
    <Footer>
        <AppButton Variant="secondary" Disabled="@TranscriptBusy" OnClick="@(_ => Close())">Cancel</AppButton>
        <BusyButton Variant="primary" Disabled="@TranscriptBusy" OnClick="Submit">
            <FaIcon Name="sparkle" />New Plan
        </BusyButton>
    </Footer>
</ModalShell>

@code {
    string GuidanceDraft = "";
    string TurnShapeDraft = TurnShapePickerOptions.Auto;
    string LoadedInitialGuidance = "";
    string LoadedInitialTurnShape = "";

    [Parameter] public string InitialGuidance { get; set; } = "";
    [Parameter] public string InitialTurnShape { get; set; } = TurnShapePickerOptions.Auto;
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public bool TranscriptBusy { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ChatMessageNewPlanSubmission> OnSubmit { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.Equals(LoadedInitialGuidance, InitialGuidance, StringComparison.Ordinal))
        {
            LoadedInitialGuidance = InitialGuidance;
            GuidanceDraft = InitialGuidance;
        }

        var normalizedTurnShape = TurnShapePickerOptions.Normalize(InitialTurnShape);
        if (string.Equals(LoadedInitialTurnShape, normalizedTurnShape, StringComparison.Ordinal))
            return;

        LoadedInitialTurnShape = normalizedTurnShape;
        TurnShapeDraft = normalizedTurnShape;
    }

    void SetGuidance(string value) => GuidanceDraft = value;

    void SetTurnShape(string value) => TurnShapeDraft = TurnShapePickerOptions.Normalize(value);

    async Task Close()
    {
        if (TranscriptBusy)
            return;

        await OnClose.InvokeAsync();
    }

    async Task Submit()
    {
        await OnSubmit.InvokeAsync(new(
            GuidanceDraft.Trim(),
            TurnShapePickerOptions.Normalize(TurnShapeDraft)));
    }
}
