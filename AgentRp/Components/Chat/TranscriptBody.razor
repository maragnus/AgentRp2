@inject IMarkdownRenderer MarkdownRenderer

<div class="@CssClass">@((MarkupString)MarkdownRenderer.Render(Body))</div>

@code {
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public string? Class { get; set; }

    string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "app-markdown"
        : $"app-markdown {Class}";
}
