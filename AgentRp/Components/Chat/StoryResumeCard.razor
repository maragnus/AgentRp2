<button class="@CssClass"
        title="@Title"
        @onclick="OnClick">
    <span class="story-resume-visuals" aria-label="@AvatarSummary">
        @if (Story?.ActiveLocation is { } location)
        {
            <StoryAvatar Name="@location.Name"
                         ImageUrl="@location.Avatar?.Url"
                         Crop="@CropFor(location.Avatar)"
                         Class="story-resume-location-avatar" />
        }
        else
        {
            <span class="story-resume-location-avatar story-resume-empty-avatar">
                <FaIcon Name="map-pin" />
            </span>
        }
        <StoryPreviewAvatarStack Characters="VisibleCharacters"
                                 Class="story-resume-character-stack"
                                 AvatarClass="story-resume-character-avatar" />
    </span>
    <span class="story-resume-copy">
        <strong>@Story?.Title</strong>
        <small>@Subtitle</small>
    </span>
    <span class="story-resume-trailing">
        <FaIcon Name="chevron-right" />
    </span>
</button>

@code {
    [Parameter] public StoryPreview? Story { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    IReadOnlyList<StoryPreviewCharacter> VisibleCharacters => Story?.SceneCharacters.Take(3).ToList() ?? [];
    string CssClass => "story-resume-card";
    string Title => Story is null ? "" : $"Continue {Story.Title}";
    string TurnText => Story?.LastGeneratedTurnNumber > 0
        ? $"Turn {Story.LastGeneratedTurnNumber}"
        : Story?.VisibleTurnCount > 0 ? $"{Story.VisibleTurnCount} turns" : "No turns";
    string Subtitle => string.Join(" / ", new[]
    {
        Story?.ActiveLocation?.Name,
        TurnText,
        Story?.Updated
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    string AvatarSummary => Story is null || VisibleCharacters.Count == 0
        ? "No characters in scene"
        : $"In scene: {string.Join(", ", VisibleCharacters.Select(character => character.Name))}";

    static ImageAvatarCropView CropFor(StoryPreviewAvatar? avatar) =>
        avatar is null
            ? ImageAvatarCropView.Default
            : ImageAvatarCropView.Normalize(avatar.FocusXPercent, avatar.FocusYPercent, avatar.ZoomPercent);
}
