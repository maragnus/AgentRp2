@using AgentRp.Services

<article class="narrative-message">
    @if (ShowProcess && Message.Trace is not null)
    {
        <ProcessTrace Trace="Message.Trace" />
    }

    <div class="narrative-card">
        <div class="narrative-head">
            <EntityMention EntityType="@AuthorMentionType"
                           EntityId="@AuthorMentionId"
                           Name="@DisplayAuthorName"
                           Size="26"
                           Class="message-author transcript-speaker"
                           OnOpenEntities="OnOpenEntities" />
            <span class="message-date">@RelativeDateFormatter.FormatDate(Message.CreatedUtc)</span>
            <span class="mode-badge @ModeClass">@ModeLabel</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message.Body))
        {
            <TranscriptBody Body="@Message.Body" Class="@($"narrative-body {ProseClass}")" />
        }

        @if (ShowAppearance && Message.AppearanceByCharacterId.Count > 0)
        {
            <StatusRow Icon="eye" Class="appearance-row">
                <ChildContent>@AppearanceSummary</ChildContent>
                <BadgeContent><Badge Tone="blue">@Message.AppearanceByCharacterId.Count chars</Badge></BadgeContent>
            </StatusRow>
        }

        @if (!string.IsNullOrWhiteSpace(FailureMessage))
        {
            <StatusRow Icon="warning" Tone="danger" Class="appearance-row">@FailureMessage</StatusRow>
        }

        <div class="narrative-actions">
            @if (SiblingCount > 1)
            {
                <div class="branch-nav">
                    <AppButton Icon="chevron-left" TooltipText="Previous branch" Disabled="@(TranscriptBusy || !CanSelectPreviousSibling)" OnClick="@(_ => SelectPreviousSibling())" />
                    <code>@BranchLabel</code>
                    <AppButton Icon="chevron-right" TooltipText="Next branch" Disabled="@(TranscriptBusy || !CanSelectNextSibling)" OnClick="@(_ => SelectNextSibling())" />
                </div>
            }
            else
            {
                <div></div>
            }

            <div class="action-cluster">
                <MessageSpeechButton Message="Message"
                                     Disabled="@TranscriptBusy"
                                     OnOpenEntities="OnOpenEntities" />
                <AnchoredPopover Placement="OverlayPlacement.TopCenter" Class="message-popover">
                    <Trigger Context="author">
                        <AppButton Icon="users" TooltipText="Change author" Active="@author.IsOpen" Disabled="@TranscriptBusy" OnClick="@(_ => author.Toggle())" />
                    </Trigger>
                    <Content>
                        <div class="popover-label">Change Author</div>
                        <SelectableButton Class="@($"select-row {(IsNarrator ? "is-disabled is-active" : "")}")" Disabled="@TranscriptBusy" OnClick="@(_ => RecastTurn(null))"><EntityMention EntityType="@EntityTypes.Narrator" EntityId="@EntityIds.Narrator" Name="Narrator" Size="20" />@if (IsNarrator) { <FaIcon Name="check" /> }</SelectableButton>
                        @foreach (var character in Characters)
                        {
                            var current = Message.AuthorCharacterId == character.Id;
                            <SelectableButton @key="character.Id" Class="@($"select-row {(current ? "is-disabled is-active" : "")}")" Disabled="@TranscriptBusy" OnClick="@(_ => RecastTurn(character))"><EntityMention EntityType="@EntityTypes.Character" EntityId="@character.Id" Name="@character.Name" Size="20" />@if (current) { <FaIcon Name="check" /> }</SelectableButton>
                        }
                    </Content>
                </AnchoredPopover>
                <AppButton Icon="edit" TooltipText="Edit message" Disabled="@TranscriptBusy" OnClick="@(_ => OpenEditBody())" />
                <span class="v-divider"></span>
                <div class="regen-group">
                    <AppButton Icon="sparkle" TooltipText="Edit guidance and create branch" Disabled="@TranscriptBusy" OnClick="@(_ => OpenNewPlan())" />
                    <span class="regen-divider" aria-hidden="true"></span>
                    <AppButton Icon="refresh" TooltipText="Regenerate from saved plan" Disabled="@TranscriptBusy" OnClick="@(_ => Regenerate())" />
                    <span class="regen-divider" aria-hidden="true"></span>
                    <AnchoredPopover Placement="OverlayPlacement.TopCenter" Class="message-popover shape-popover">
                        <Trigger Context="shapeMenu">
                            <AppButton Variant="ghost" Size="sm" Icon="layers" TrailingIcon="chevron-down" Active="@shapeMenu.IsOpen" Disabled="@TranscriptBusy" TooltipText="Change turn shape & regenerate" OnClick="@(_ => shapeMenu.Toggle())" />
                        </Trigger>
                        <Content>
                            <div class="popover-label">Turn Shape</div>
                            <TurnShapeOptionList SelectedShape="@SelectedTurnShape" Disabled="@TranscriptBusy" ShapeSelected="PickShapeAndRegenerate" />
                        </Content>
                    </AnchoredPopover>
                    <span class="regen-divider" aria-hidden="true"></span>
                    <AppButton Icon="sliders" TooltipText="Edit saved plan" Disabled="@TranscriptBusy" OnClick="@(_ => OpenPlanEditor())" />
                </div>
                <span class="v-divider"></span>
                @if (CanUseStructuredFeatures && CanCreateSnapshot)
                {
                    <AppButton Icon="scissors" TooltipText="Create snapshot here" Disabled="@TranscriptBusy" OnClick="@(_ => CreateSnapshot())" />
                }
                <AppButton Icon="copy" TooltipText="Copy message" OnClick="@CopyMessage" />
                <AppButton Icon="trash" TooltipText="Delete message" Disabled="@TranscriptBusy" OnClick="@(_ => ConfirmDelete = true)" />
            </div>
        </div>
    </div>
</article>

@if (ConfirmDelete)
{
    <ConfirmDialog Title="Delete this message?"
                   Body="@($"This removes this turn only. You can also delete this turn and {SubsequentCount} later turns as a branch.")"
                   OnCancel="@(() => ConfirmDelete = false)">
        <Actions>
            <AppButton Variant="secondary" OnClick="@(_ => ConfirmDelete = false)">Cancel</AppButton>
            @if (SubsequentCount > 0)
            {
                <AppButton Variant="danger" Disabled="@TranscriptBusy" OnClick="DeleteBranch"><FaIcon Name="branch" /> Delete Branch</AppButton>
            }
            <AppButton Variant="rose" Disabled="@TranscriptBusy" OnClick="DeleteSingle"><FaIcon Name="trash" /> Delete</AppButton>
        </Actions>
    </ConfirmDialog>
}

@if (EditPlan)
{
    <ChatMessageEditPlanModal Message="Message"
                              Characters="Characters"
                              TranscriptBusy="@TranscriptBusy"
                              OnClose="@ClosePlanEditor" />
}

@if (NewPlan)
{
    <ChatMessageNewPlanModal InitialGuidance="@Message.Guidance"
                             InitialTurnShape="@NewPlanInitialTurnShape"
                             Subtitle="@($"{DisplayAuthorName} · {RelativeDateFormatter.FormatDate(Message.CreatedUtc)}")"
                             TranscriptBusy="@TranscriptBusy"
                             OnClose="@CloseNewPlan"
                             OnSubmit="@SubmitNewPlan" />
}

@if (EditBody)
{
    <ModalShell Title="Edit Message" Subtitle="@($"{DisplayAuthorName} · {RelativeDateFormatter.FormatDate(Message.CreatedUtc)}")" Icon="edit" MaxWidth="760px" OnClose="@(() => EditBody = false)">
        <ChildContent>
            <FormSection Title="Body">
                <AppTextarea Class="plan-field" Rows="8" @bind-Value="BodyDraft" />
            </FormSection>
        </ChildContent>
        <Footer>
            <AppButton Variant="secondary" OnClick="@(_ => EditBody = false)">Cancel</AppButton>
            <AppButton Variant="primary" Disabled="@TranscriptBusy" OnClick="@(_ => SaveBody())"><FaIcon Name="check" />Save Edit</AppButton>
        </Footer>
    </ModalShell>
}

@code {
    bool ConfirmDelete;
    bool EditPlan;
    bool NewPlan;
    bool EditBody;
    string SelectedTurnShape = "";
    string BodyDraft = "";

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public RpTranscriptTurn Message { get; set; } = new();
    [Parameter] public List<RpCharacter> Characters { get; set; } = [];
    [Parameter] public bool ShowAppearance { get; set; }
    [Parameter] public bool ShowProcess { get; set; }
    [Parameter] public bool TranscriptBusy { get; set; }
    [Parameter] public int SubsequentCount { get; set; }
    [Parameter] public bool CanCreateSnapshot { get; set; } = true;
    [Parameter] public EventCallback<(string Type, string? Id)> OnOpenEntities { get; set; }
    [Parameter] public EventCallback<string> OnCreateSnapshot { get; set; }
    [Inject] IJSRuntime JS { get; set; } = default!;

    bool IsNarrator => string.IsNullOrWhiteSpace(Message.AuthorCharacterId);
    RpCharacter? AuthorCharacter => IsNarrator ? null : Characters.FirstOrDefault(character => character.Id == Message.AuthorCharacterId);
    string DisplayAuthorName => AuthorCharacter?.Name ?? Message.AuthorName;
    string AuthorMentionType => IsNarrator ? EntityTypes.Narrator : EntityTypes.Character;
    string AuthorMentionId => IsNarrator ? EntityIds.Narrator : Message.AuthorCharacterId;
    string ProseClass => IsNarrator ? "is-narrator" : "is-character";
    string ModeClass => Message.Mode switch
    {
        "guided" => "is-guided",
        "automatic" => "is-auto",
        "regenerated" => "is-guided",
        "replanned" => "is-guided",
        "edited" => "is-manual",
        _ => "is-manual"
    };

    string ModeLabel => Message.Mode switch
    {
        "guided" => "Guided AI",
        "automatic" => "Automatic AI",
        "regenerated" => "Regenerated",
        "replanned" => "New Plan",
        "edited" => "Edited",
        _ => "Manual"
    };

    bool CanUseStructuredFeatures => ResolveActiveTextModel()?.Capabilities.CanGenerateStructuredText == true;
    IReadOnlyList<RpTranscriptTurn> Siblings => Session.Chat.Transcript.SiblingsFor(Message.Id);
    int SiblingIndex => Math.Max(0, Siblings.ToList().FindIndex(turn => turn.Id == Message.Id));
    int SiblingCount => Siblings.Count;
    bool CanSelectPreviousSibling => SiblingIndex > 0;
    bool CanSelectNextSibling => SiblingIndex >= 0 && SiblingIndex < SiblingCount - 1;
    string BranchLabel => $"{SiblingIndex + 1}/{SiblingCount}";
    string AppearanceSummary => string.Join("; ", Characters
        .Where(character => Message.AppearanceByCharacterId.ContainsKey(character.Id))
        .Select(character => $"{character.Name} {Message.AppearanceByCharacterId[character.Id]}"));
    string FailureMessage => Message.Trace?.Status == "failed" && Message.Trace?.Data.TryGetPropertyValue("error", out var errorNode) == true
        ? errorNode?.GetValue<string>() ?? ""
        : "";
    string NewPlanInitialTurnShape => string.IsNullOrWhiteSpace(Message.Plan.TurnShape)
        ? TurnShapePickerOptions.Auto
        : TurnShapePickerOptions.Normalize(Message.Plan.TurnShape);

    protected override void OnParametersSet()
    {
        SelectedTurnShape = TurnShapePickerOptions.NormalizeExplicit(Message.Plan.TurnShape);
    }

    async Task DeleteSingle()
    {
        ConfirmDelete = false;
        await Session.Chat.Transcript.DeleteTurnAsync(Message.Id);
    }

    async Task DeleteBranch()
    {
        ConfirmDelete = false;
        await Session.Chat.Transcript.DeleteBranchAsync(Message.Id);
    }

    async Task SelectPreviousSibling()
    {
        if (CanSelectPreviousSibling)
            await Session.Chat.Transcript.SelectSiblingAsync(Siblings[SiblingIndex - 1].Id);
    }

    async Task SelectNextSibling()
    {
        if (CanSelectNextSibling)
            await Session.Chat.Transcript.SelectSiblingAsync(Siblings[SiblingIndex + 1].Id);
    }

    async Task CopyMessage(MouseEventArgs args) => await JS.InvokeVoidAsync("navigator.clipboard.writeText", Message.Body);

    async Task CreateSnapshot() => await OnCreateSnapshot.InvokeAsync(Message.Id);

    async Task PickShapeAndRegenerate(string shape)
    {
        SelectedTurnShape = TurnShapePickerOptions.NormalizeExplicit(shape);
        await Regenerate(SelectedTurnShape);
    }

    async Task Regenerate(string? requestedShape = null)
    {
        var actor = Characters.FirstOrDefault(character => character.Id == Message.ActorCharacterId);
        var turnShape = string.IsNullOrWhiteSpace(requestedShape) ? "" : TurnShapePickerOptions.NormalizeExplicit(requestedShape);
        if (!string.IsNullOrWhiteSpace(turnShape))
            SelectedTurnShape = turnShape;

        await Session.Chat.Transcript.RegenerateAsync(Message.Id, Message.Guidance, actor, turnShape);
    }

    void OpenNewPlan()
    {
        NewPlan = true;
    }

    Task CloseNewPlan()
    {
        NewPlan = false;
        return Task.CompletedTask;
    }

    async Task SubmitNewPlan(ChatMessageNewPlanSubmission submission)
    {
        var actor = Characters.FirstOrDefault(character => character.Id == Message.ActorCharacterId);
        NewPlan = false;
        await Session.Chat.Transcript.ReplanAsync(
            Message.Id,
            submission.Guidance,
            actor,
            TurnShapePickerOptions.Normalize(submission.TurnShape));
    }

    async Task OpenPlanEditor()
    {
        EditPlan = true;
        await Task.CompletedTask;
    }

    Task ClosePlanEditor()
    {
        EditPlan = false;
        return Task.CompletedTask;
    }

    void OpenEditBody()
    {
        BodyDraft = Message.Body;
        EditBody = true;
    }

    async Task SaveBody()
    {
        EditBody = false;
        await Session.Chat.Transcript.EditTurnAsync(Message.Id, BodyDraft, Message.Plan, Message.AppearanceByCharacterId, Message.PrivateIntentByCharacterId);
    }

    async Task RecastTurn(RpCharacter? character)
    {
        await Session.Chat.Transcript.RecastTurnAsync(Message.Id, character);
    }

    ActiveModelSelection? ResolveActiveTextModel() => Session.ModelSelection.Resolve(AiModelRole.Reasoning);

}
