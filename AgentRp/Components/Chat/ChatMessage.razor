@using AgentRp.Services
@implements IDisposable
@inject IServiceProvider Services
@inject IEntityNotifier EntityNotifier

<article class="narrative-message">
    @if (ShowProcess && Message.Trace is not null)
    {
        <ProcessTrace Trace="Message.Trace" />
    }

    <div class="narrative-card">
        <div class="narrative-head">
            <div class="message-author transcript-speaker">
                @if (IsNarrator)
                {
                    <span class="narrator-avatar"><FaIcon Name="book-open" /></span>
                }
                else
                {
                    <EntityImage EntityType="character" EntityId="@Message.AuthorCharacterId" Name="@DisplayAuthorName" Image="@ImageFor(AuthorCharacter?.ImageId ?? "")" Size="26" />
                }
                <span>@DisplayAuthorName</span>
            </div>
            <span class="message-date">@RelativeDateFormatter.FormatDate(Message.CreatedUtc)</span>
            <span class="mode-badge @ModeClass">@ModeLabel</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message.Body))
        {
            <TranscriptBody Body="@Message.Body" Class="@($"narrative-body {ProseClass}")" />
        }

        @if (ShowAppearance && Message.AppearanceByCharacterId.Count > 0)
        {
            <StatusRow Icon="eye" Class="appearance-row">
                <ChildContent>@AppearanceSummary</ChildContent>
                <BadgeContent><Badge Tone="blue">@Message.AppearanceByCharacterId.Count chars</Badge></BadgeContent>
            </StatusRow>
        }

        @if (!string.IsNullOrWhiteSpace(FailureMessage))
        {
            <StatusRow Icon="warning" Tone="danger" Class="appearance-row">@FailureMessage</StatusRow>
        }

        <div class="narrative-actions">
            @if (SiblingCount > 1)
            {
                <div class="branch-nav">
                    <AppButton Icon="chevron-left" TooltipText="Previous branch" Disabled="@(TranscriptBusy || !CanSelectPreviousSibling)" OnClick="@(_ => SelectPreviousSibling())" />
                    <code>@BranchLabel</code>
                    <AppButton Icon="chevron-right" TooltipText="Next branch" Disabled="@(TranscriptBusy || !CanSelectNextSibling)" OnClick="@(_ => SelectNextSibling())" />
                </div>
            }
            else
            {
                <div></div>
            }

            <div class="action-cluster">
                <MessageSpeechButton Message="Message"
                                     Disabled="@TranscriptBusy"
                                     OnOpenEntities="OnOpenEntities" />
                <AnchoredPopover Placement="OverlayPlacement.TopCenter" Class="message-popover">
                    <Trigger Context="author">
                        <AppButton Icon="users" TooltipText="Change author" Active="@author.IsOpen" Disabled="@TranscriptBusy" OnClick="@(_ => author.Toggle())" />
                    </Trigger>
                    <Content>
                        <div class="popover-label">Change Author</div>
                        <SelectableButton Class="@($"select-row {(IsNarrator ? "is-disabled is-active" : "")}")" Disabled="@TranscriptBusy" OnClick="@(_ => RecastTurn(null))"><span class="mini-narrator large"><FaIcon Name="book-open" /></span><span>Narrator</span>@if (IsNarrator) { <FaIcon Name="check" /> }</SelectableButton>
                        @foreach (var character in Characters)
                        {
                            var current = Message.AuthorCharacterId == character.Id;
                            <SelectableButton @key="character.Id" Class="@($"select-row {(current ? "is-disabled is-active" : "")}")" Disabled="@TranscriptBusy" OnClick="@(_ => RecastTurn(character))"><EntityImage EntityType="character" EntityId="@character.Id" Name="@character.Name" Image="@ImageFor(character.ImageId)" Size="20" /><span>@character.Name</span>@if (current) { <FaIcon Name="check" /> }</SelectableButton>
                        }
                    </Content>
                </AnchoredPopover>
                <AppButton Icon="edit" TooltipText="Edit message" Disabled="@TranscriptBusy" OnClick="@(_ => OpenEditBody())" />
                <span class="v-divider"></span>
                <div class="regen-group">
                    <AppButton Icon="sparkle" TooltipText="Edit guidance and create branch" Disabled="@TranscriptBusy" OnClick="@(_ => OpenNewPlan())" />
                    <span class="regen-divider" aria-hidden="true"></span>
                    <AppButton Icon="refresh" TooltipText="Regenerate from saved plan" Disabled="@TranscriptBusy" OnClick="@(_ => Regenerate())" />
                    <span class="regen-divider" aria-hidden="true"></span>
                    <AnchoredPopover Placement="OverlayPlacement.TopCenter" Class="message-popover shape-popover">
                        <Trigger Context="shapeMenu">
                            <AppButton Variant="ghost" Size="sm" Icon="layers" TrailingIcon="chevron-down" Active="@shapeMenu.IsOpen" Disabled="@TranscriptBusy" TooltipText="Change turn shape & regenerate" OnClick="@(_ => shapeMenu.Toggle())" />
                        </Trigger>
                        <Content>
                            <div class="popover-label">Turn Shape</div>
                            <TurnShapeOptionList SelectedShape="@SelectedTurnShape" Disabled="@TranscriptBusy" ShapeSelected="PickShapeAndRegenerate" />
                        </Content>
                    </AnchoredPopover>
                    <span class="regen-divider" aria-hidden="true"></span>
                    <AppButton Icon="sliders" TooltipText="Edit saved plan" Disabled="@TranscriptBusy" OnClick="@(_ => OpenPlanEditor())" />
                </div>
                <span class="v-divider"></span>
                @if (CanUseStructuredFeatures)
                {
                    <AppButton Icon="scissors" TooltipText="Create snapshot here" Disabled="@TranscriptBusy" OnClick="@(_ => CreateSnapshot())" />
                }
                <AppButton Icon="copy" TooltipText="Copy message" OnClick="@CopyMessage" />
                <AppButton Icon="trash" TooltipText="Delete message" Disabled="@TranscriptBusy" OnClick="@(_ => ConfirmDelete = true)" />
            </div>
        </div>
    </div>
</article>

@if (ConfirmDelete)
{
    <ConfirmDialog Title="Delete this message?"
                   Body="@($"This removes this turn only. You can also delete this turn and {SubsequentCount} later turns as a branch.")"
                   OnCancel="@(() => ConfirmDelete = false)">
        <Actions>
            <AppButton Variant="secondary" OnClick="@(_ => ConfirmDelete = false)">Cancel</AppButton>
            @if (SubsequentCount > 0)
            {
                <AppButton Variant="danger" Disabled="@TranscriptBusy" OnClick="DeleteBranch"><FaIcon Name="branch" /> Delete Branch</AppButton>
            }
            <AppButton Variant="rose" Disabled="@TranscriptBusy" OnClick="DeleteSingle"><FaIcon Name="trash" /> Delete</AppButton>
        </Actions>
    </ConfirmDialog>
}

@if (EditPlan)
{
    <ModalShell Title="Edit Saved Plan" Subtitle="@($"{DisplayAuthorName} · {RelativeDateFormatter.FormatDate(Message.CreatedUtc)}")" Icon="sliders" MaxWidth="760px" BodyClass="is-flush" Class="edit-plan-modal" OnClose="@(() => EditPlan = false)">
        <ChildContent>
            <ModalTabGroup ActiveId="@ActivePlanTab" ActiveIdChanged="SetActivePlanTab" Height="560px" RailWidth="152px" Class="edit-plan-tabs">
                <ChildContent>
                    <ModalTab Id="appearance" Title="Appearance" Dirty="@Appearances.Any(pair => !string.IsNullOrWhiteSpace(pair.Value))" />
                    <ModalTab Id="plan" Title="Plan" Dirty="@IsPlanDirty()" />
                    <ModalTab Id="private" Title="Private Intent" Dirty="@IsActivePrivateIntentSet" />
                    <ModalTab Id="speech" Title="Speech" />
                </ChildContent>
                <RailFooter>
                    <div class="prompt-rail-note">
                        <div class="divider"></div>
                        <p>Saved plan fields are reused when regenerating this turn.</p>
                    </div>
                </RailFooter>
                <MainContent>
                    <ModalStackLayout Class="modal-editor-main edit-plan-main" BodyClass="modal-form-stack edit-plan-fields">
                        <Header>
                            @if (ActivePlanTab == "appearance")
                            {
                                <ModalPaneToolbar Class="tuning-toolbar">
                                    <strong>Characters</strong>
                                </ModalPaneToolbar>
                            }
                            else if (ActivePlanTab == "plan")
                            {
                                <ModalPaneToolbar Class="tuning-toolbar">
                                    <strong>Plan</strong>
                                </ModalPaneToolbar>
                            }
                            else
                            {
                                <ModalPaneToolbar Class="tuning-toolbar">
                                    <strong>@(ActivePlanTab == "speech" ? "TTS Input" : "Private Intent")</strong>
                                </ModalPaneToolbar>
                            }
                        </Header>
                        <ChildContent>
                            @if (ActivePlanTab == "appearance")
                            {
                                @foreach (var character in Characters)
                                {
                                    <Section @key="character.Id" Title="@character.Name" Class="edit-plan-section">
                                        <textarea class="field plan-field" rows="3" placeholder="@($"How does {character.Name} appear in this turn?")" value="@GetAppearance(character.Id)" @onchange="@((ChangeEventArgs args) => SetAppearance(character.Id, args.Value?.ToString() ?? ""))"></textarea>
                                    </Section>
                                }
                            }
                            else if (ActivePlanTab == "plan")
                            {
                                <Section Title="Turn Shape" Hint="Regeneration target" Class="edit-plan-section">
                                    <div class="turn-shape-chip-grid" role="group" aria-label="Turn Shape">
                                        @foreach (var shape in TurnShapePickerOptions.Explicit)
                                        {
                                            <button @key="shape" type="button" class="turn-shape-chip @(PlanShape == shape ? "is-selected" : "")" @onclick="@(() => PlanShape = shape)">
                                                @shape
                                            </button>
                                        }
                                    </div>
                                </Section>

                                <Section Title="Scene Beat" Class="edit-plan-section">
                                    <FieldRow Label="Beat">
                                        <textarea class="field plan-field" rows="@PlanTextareaRows" placeholder="What story beat does this turn serve?" @bind="Beat"></textarea>
                                    </FieldRow>
                                    <FieldRow Label="Change Introduced">
                                        <textarea class="field plan-field" rows="@PlanTextareaRows" placeholder="What shifts as a result of this turn?" @bind="ChangeIntroduced"></textarea>
                                    </FieldRow>
                                </Section>

                                <Section Title="Character Aim" Class="edit-plan-section">
                                    <FieldRow Label="Intent">
                                        <textarea class="field plan-field" rows="@PlanTextareaRows" placeholder="What does the character intend to do?" @bind="Intent"></textarea>
                                    </FieldRow>
                                    <FieldRow Label="Immediate Goal">
                                        <input class="field plan-field" placeholder="What does the character want right now?" @bind="ImmediateGoal" />
                                    </FieldRow>
                                    <FieldRow Label="Why Now">
                                        <textarea class="field plan-field" rows="@PlanTextareaRows" placeholder="Why is the character acting at this moment?" @bind="WhyNow"></textarea>
                                    </FieldRow>
                                    <FieldRow Label="Guardrails">
                                        <textarea class="field plan-field" rows="@PlanTextareaRows" placeholder="What should the AI avoid or preserve?" @bind="Guardrails"></textarea>
                                    </FieldRow>
                                </Section>
                            }
                            else if (ActivePlanTab == "private")
                            {
                                var activeCharacter = ActivePrivateIntentCharacter;
                                if (activeCharacter is null)
                                {
                                    <p class="empty-note">Narrator turns do not have a private character intent.</p>
                                }
                                else
                                {
                                    <Section @key="activeCharacter.Id" Title="@activeCharacter.Name" Class="edit-plan-section">
                                        <textarea class="field plan-field" rows="3" placeholder="@($"What private intention is {activeCharacter.Name} carrying?")" value="@GetPrivateIntent(activeCharacter.Id)" @onchange="@((ChangeEventArgs args) => SetPrivateIntent(activeCharacter.Id, args.Value?.ToString() ?? ""))"></textarea>
                                    </Section>
                                }
                            }
                            else
                            {
                                <Section Title="TTS Input" Hint="@SpeechInputHint" Class="edit-plan-section">
                                    @if (SpeechInputLoading)
                                    {
                                        <StatusRow Icon="spinner">Loading speech input...</StatusRow>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(SpeechInputError))
                                    {
                                        <StatusRow Icon="warning" Tone="danger">@SpeechInputError</StatusRow>
                                    }
                                    else if (SpeechInputSnapshot is null || SpeechInputSnapshot.Inputs.Count == 0)
                                    {
                                        <p class="empty-note">Generate read-aloud to capture the TTS input for this message.</p>
                                    }
                                    else if (SpeechInputSnapshot.Inputs.Count == 1)
                                    {
                                        <textarea class="field plan-field speech-input-field" rows="8" readonly value="@SpeechInputSnapshot.Inputs[0].Text"></textarea>
                                    }
                                    else
                                    {
                                        <div class="speech-input-list">
                                            @for (var i = 0; i < SpeechInputSnapshot.Inputs.Count; i++)
                                            {
                                                var input = SpeechInputSnapshot.Inputs[i];
                                                <FieldRow @key="SpeechInputKey(input, i)" Label="@SpeechInputLabel(input, i)">
                                                    <textarea class="field plan-field speech-input-field" rows="4" readonly value="@input.Text"></textarea>
                                                </FieldRow>
                                            }
                                        </div>
                                    }
                                </Section>
                            }
                        </ChildContent>
                        <Footer>
                            <AppButton Variant="secondary" OnClick="@(_ => EditPlan = false)">Cancel</AppButton>
                            <AppButton Variant="primary" Disabled="@TranscriptBusy" OnClick="@(_ => SavePlan())"><FaIcon Name="check" />Save Plan</AppButton>
                        </Footer>
                    </ModalStackLayout>
                </MainContent>
            </ModalTabGroup>
        </ChildContent>
    </ModalShell>
}

@if (NewPlan)
{
    <ChatMessageNewPlanModal InitialGuidance="@Message.Guidance"
                             Subtitle="@($"{DisplayAuthorName} Â· {RelativeDateFormatter.FormatDate(Message.CreatedUtc)}")"
                             TranscriptBusy="@TranscriptBusy"
                             OnClose="@CloseNewPlan"
                             OnSubmit="@SubmitNewPlan" />
}

@if (EditBody)
{
    <ModalShell Title="Edit Message" Subtitle="@($"{DisplayAuthorName} · {RelativeDateFormatter.FormatDate(Message.CreatedUtc)}")" Icon="edit" MaxWidth="760px" OnClose="@(() => EditBody = false)">
        <ChildContent>
            <Section Title="Body">
                <textarea class="field plan-field" rows="8" @bind="BodyDraft"></textarea>
            </Section>
        </ChildContent>
        <Footer>
            <AppButton Variant="secondary" OnClick="@(_ => EditBody = false)">Cancel</AppButton>
            <AppButton Variant="primary" Disabled="@TranscriptBusy" OnClick="@(_ => SaveBody())"><FaIcon Name="check" />Save Edit</AppButton>
        </Footer>
    </ModalShell>
}

@code {
    bool ConfirmDelete;
    bool EditPlan;
    bool NewPlan;
    bool EditBody;
    bool SpeechInputLoading;
    string ActivePlanTab = "plan";
    string SelectedTurnShape = "";
    string BodyDraft = "";
    string PlanShape = TurnShapePickerOptions.Default;
    string Beat = "";
    string Intent = "";
    string ImmediateGoal = "";
    string WhyNow = "";
    string ChangeIntroduced = "";
    string Guardrails = "";
    string SpeechInputError = "";
    MessageSpeechInputSnapshot? SpeechInputSnapshot;
    Dictionary<string, string> Appearances = [];
    Dictionary<string, string> PrivateIntents = [];
    const int PlanTextareaRows = 1;

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public RpTranscriptTurn Message { get; set; } = new();
    [Parameter] public List<RpCharacter> Characters { get; set; } = [];
    [Parameter] public bool ShowAppearance { get; set; }
    [Parameter] public bool ShowProcess { get; set; }
    [Parameter] public bool TranscriptBusy { get; set; }
    [Parameter] public int SubsequentCount { get; set; }
    [Parameter] public EventCallback<(string Type, string? Id)> OnOpenEntities { get; set; }
    [Parameter] public EventCallback<string> OnCreateSnapshot { get; set; }
    [Inject] IJSRuntime JS { get; set; } = default!;

    IMessageSpeechService? SpeechService => Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions.GetService<IMessageSpeechService>(Services);
    bool IsNarrator => string.IsNullOrWhiteSpace(Message.AuthorCharacterId);
    RpCharacter? AuthorCharacter => IsNarrator ? null : Characters.FirstOrDefault(character => character.Id == Message.AuthorCharacterId);
    string DisplayAuthorName => AuthorCharacter?.Name ?? Message.AuthorName;
    string ProseClass => IsNarrator ? "is-narrator" : "is-character";
    string ModeClass => Message.Mode switch
    {
        "guided" => "is-guided",
        "automatic" => "is-auto",
        "regenerated" => "is-guided",
        "replanned" => "is-guided",
        "edited" => "is-manual",
        _ => "is-manual"
    };

    string ModeLabel => Message.Mode switch
    {
        "guided" => "Guided AI",
        "automatic" => "Automatic AI",
        "regenerated" => "Regenerated",
        "replanned" => "New Plan",
        "edited" => "Edited",
        _ => "Manual"
    };

    bool CanUseStructuredFeatures => ResolveActiveTextModel()?.Capabilities.CanGenerateStructuredText == true;
    IReadOnlyList<RpTranscriptTurn> Siblings => Session.Chat.Transcript.SiblingsFor(Message.Id);
    int SiblingIndex => Math.Max(0, Siblings.ToList().FindIndex(turn => turn.Id == Message.Id));
    int SiblingCount => Siblings.Count;
    bool CanSelectPreviousSibling => SiblingIndex > 0;
    bool CanSelectNextSibling => SiblingIndex >= 0 && SiblingIndex < SiblingCount - 1;
    string BranchLabel => $"{SiblingIndex + 1}/{SiblingCount}";
    string AppearanceSummary => string.Join("; ", Characters
        .Where(character => Message.AppearanceByCharacterId.ContainsKey(character.Id))
        .Select(character => $"{character.Name} {Message.AppearanceByCharacterId[character.Id]}"));
    string FailureMessage => Message.Trace?.Status == "failed" && Message.Trace?.Data.TryGetPropertyValue("error", out var errorNode) == true
        ? errorNode?.GetValue<string>() ?? ""
        : "";
    string SpeechInputHint => SpeechInputSnapshot is null
        ? "Captured after read-aloud generation"
        : $"{SpeechInputSnapshot.ProviderName} · {SpeechInputSnapshot.ModelId} · {SpeechInputSnapshot.Status}";

    RpCharacter? ActivePrivateIntentCharacter => ResolveActivePrivateIntentCharacter();
    bool IsActivePrivateIntentSet => ActivePrivateIntentCharacter is not null && !string.IsNullOrWhiteSpace(GetPrivateIntent(ActivePrivateIntentCharacter.Id));

    protected override void OnParametersSet()
    {
        SelectedTurnShape = TurnShapePickerOptions.NormalizeExplicit(Message.Plan.TurnShape);
    }

    protected override void OnInitialized()
    {
        EntityNotifier.Changed += OnEntityChanged;
    }

    Task OnEntityChanged(EntityChangeNotification notification)
    {
        if (IsNarrator
            || !string.Equals(notification.EntityType, EntityTypes.Character, StringComparison.Ordinal)
            || !string.Equals(notification.EntityId, Message.AuthorCharacterId, StringComparison.Ordinal)
            || notification.ChangeKind is not EntityChangeKinds.Profile and not EntityChangeKinds.Deleted)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(StateHasChanged);
    }

    async Task DeleteSingle()
    {
        ConfirmDelete = false;
        await Session.Chat.Transcript.DeleteTurnAsync(Message.Id);
    }

    async Task DeleteBranch()
    {
        ConfirmDelete = false;
        await Session.Chat.Transcript.DeleteBranchAsync(Message.Id);
    }

    async Task SelectPreviousSibling()
    {
        if (CanSelectPreviousSibling)
            await Session.Chat.Transcript.SelectSiblingAsync(Siblings[SiblingIndex - 1].Id);
    }

    async Task SelectNextSibling()
    {
        if (CanSelectNextSibling)
            await Session.Chat.Transcript.SelectSiblingAsync(Siblings[SiblingIndex + 1].Id);
    }

    void SetActivePlanTab(string? id) => ActivePlanTab = id ?? ActivePlanTab;

    bool IsPlanDirty() =>
        PlanShape != TurnShapePickerOptions.NormalizeExplicit(Message.Plan.TurnShape) ||
        Beat != Message.Plan.Beat ||
        ChangeIntroduced != Message.Plan.ChangeIntroduced ||
        Intent != Message.Plan.Intent ||
        ImmediateGoal != Message.Plan.ImmediateGoal ||
        WhyNow != Message.Plan.WhyNow ||
        Guardrails != Message.Plan.Guardrails;

    string GetAppearance(string characterId) => Appearances.TryGetValue(characterId, out var appearance) ? appearance : "";
    void SetAppearance(string characterId, string appearance) => Appearances[characterId] = appearance;
    string GetPrivateIntent(string characterId) => PrivateIntents.TryGetValue(characterId, out var intent) ? intent : "";
    void SetPrivateIntent(string characterId, string intent) => PrivateIntents[characterId] = intent;

    async Task CopyMessage(MouseEventArgs args) => await JS.InvokeVoidAsync("navigator.clipboard.writeText", Message.Body);

    async Task CreateSnapshot() => await OnCreateSnapshot.InvokeAsync(Message.Id);

    async Task PickShapeAndRegenerate(string shape)
    {
        SelectedTurnShape = TurnShapePickerOptions.NormalizeExplicit(shape);
        await Regenerate(SelectedTurnShape);
    }

    async Task Regenerate(string? requestedShape = null)
    {
        var actor = Characters.FirstOrDefault(character => character.Id == Message.ActorCharacterId);
        var turnShape = string.IsNullOrWhiteSpace(requestedShape) ? "" : TurnShapePickerOptions.NormalizeExplicit(requestedShape);
        if (!string.IsNullOrWhiteSpace(turnShape))
            SelectedTurnShape = turnShape;

        await Session.Chat.Transcript.RegenerateAsync(Message.Id, Message.Guidance, actor, turnShape);
    }

    void OpenNewPlan()
    {
        NewPlan = true;
    }

    Task CloseNewPlan()
    {
        NewPlan = false;
        return Task.CompletedTask;
    }

    async Task SubmitNewPlan(string guidance)
    {
        var actor = Characters.FirstOrDefault(character => character.Id == Message.ActorCharacterId);
        NewPlan = false;
        await Session.Chat.Transcript.ReplanAsync(
            Message.Id,
            guidance,
            actor,
            TurnShapePickerOptions.NormalizeExplicit(Message.Plan.TurnShape));
    }

    async Task OpenPlanEditor()
    {
        PlanShape = TurnShapePickerOptions.NormalizeExplicit(Message.Plan.TurnShape);
        Beat = Message.Plan.Beat;
        Intent = Message.Plan.Intent;
        ImmediateGoal = Message.Plan.ImmediateGoal;
        WhyNow = Message.Plan.WhyNow;
        ChangeIntroduced = Message.Plan.ChangeIntroduced;
        Guardrails = Message.Plan.Guardrails;
        Appearances = Message.AppearanceByCharacterId.ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal);
        PrivateIntents = Message.PrivateIntentByCharacterId.ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal);
        ActivePlanTab = "plan";
        EditPlan = true;
        await LoadSpeechInputSnapshot();
    }

    void OpenEditBody()
    {
        BodyDraft = Message.Body;
        EditBody = true;
    }

    async Task SaveBody()
    {
        EditBody = false;
        await Session.Chat.Transcript.EditTurnAsync(Message.Id, BodyDraft, Message.Plan, Message.AppearanceByCharacterId, Message.PrivateIntentByCharacterId);
    }

    async Task SavePlan()
    {
        var plan = new RpTurnPlan
        {
            TurnShape = TurnShapePickerOptions.NormalizeExplicit(PlanShape),
            Beat = Beat,
            Intent = Intent,
            ImmediateGoal = ImmediateGoal,
            WhyNow = WhyNow,
            ChangeIntroduced = ChangeIntroduced,
            Guardrails = Guardrails
        };
        await Session.Chat.Transcript.SavePlanAsync(Message.Id, plan, Appearances, PrivateIntents);
        EditPlan = false;
    }

    async Task RecastTurn(RpCharacter? character)
    {
        await Session.Chat.Transcript.RecastTurnAsync(Message.Id, character);
    }

    async Task LoadSpeechInputSnapshot()
    {
        SpeechInputSnapshot = null;
        SpeechInputError = "";
        if (SpeechService is null || string.IsNullOrWhiteSpace(Message.Speech.VoiceMessageId))
            return;

        SpeechInputLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            SpeechInputSnapshot = await SpeechService.LoadInputSnapshotAsync(Message);
        }
        catch (Exception exception)
        {
            SpeechInputError = UserFacingErrorMessageBuilder.Build("Loading TTS input failed.", exception);
        }
        finally
        {
            SpeechInputLoading = false;
        }
    }

    static string SpeechInputLabel(SpeechGenerationInput input, int index) =>
        string.IsNullOrWhiteSpace(input.VoiceId)
            ? $"Input {index + 1}"
            : $"Input {index + 1} · {input.VoiceId}";

    static string SpeechInputKey(SpeechGenerationInput input, int index) =>
        $"{index}:{input.VoiceId}:{input.Text.Length}";

    RpCharacter? ResolveActivePrivateIntentCharacter()
    {
        if (string.IsNullOrWhiteSpace(Message.ActorCharacterId))
            return null;

        return Characters.FirstOrDefault(character => character.Id == Message.ActorCharacterId)
            ?? new()
            {
                Id = Message.ActorCharacterId,
                Name = string.IsNullOrWhiteSpace(Message.ActorName) ? "Active character" : Message.ActorName
            };
    }

    ActiveModelSelection? ResolveActiveTextModel() => Session.ModelSelection.Resolve(AiModelRole.Reasoning);

    GalleryImage? ImageFor(string imageId) => Session.Chat.Images.Items.FirstOrDefault(image => image.Id == imageId);

    public void Dispose()
    {
        EntityNotifier.Changed -= OnEntityChanged;
    }
}
