@using AgentRp.Services

<div class="process-row">
    <StatusRow Icon="zap" Class="process-summary" OnClick="@(_ => Open = !Open)">
        <ChildContent>@Trace.Summary</ChildContent>
        <BadgeContent>
            @if (!string.IsNullOrWhiteSpace(StatusText))
            {
                <span class="@StatusClass">@StatusText</span>
            }
        </BadgeContent>
        <TrailingContent><FaIcon Name="@(Open ? "chevron-up" : "chevron-down")" /></TrailingContent>
    </StatusRow>
    @if (Open)
    {
        <div class="process-steps">
            @foreach (var step in Trace.Steps)
            {
                <div @key="step.Id" class="process-step">
                    <div class="process-step-head" @onclick="() => Toggle(step.Id)">
                        <FaIcon Name="@IconFor(step.Id)" />
                        <strong class="process-step-title">@step.Label</strong>
                        <code>@step.InputTokens.ToString("N0") in</code>
                        <code>@step.OutputTokens.ToString("N0") out</code>
                        <code>@RelativeDateFormatter.FormatDuration(step.DurationSeconds)</code>
                        <FaIcon Name="@(OpenSteps.Contains(step.Id) ? "chevron-up" : "chevron-down")" />
                    </div>
                    @if (OpenSteps.Contains(step.Id))
                    {
                        <div class="process-detail">
                            <div class="prompt-block"><label>System Prompt</label><pre>@step.SystemPrompt</pre></div>
                            <div class="prompt-block"><label>User Prompt</label><pre>@step.UserPrompt</pre></div>
                            @if (!string.IsNullOrWhiteSpace(step.StructuredOutputJson))
                            {
                                <div class="prompt-block"><label>Structured Output</label><pre>@step.StructuredOutputJson</pre></div>
                            }
                            <div class="prompt-block"><label>Output</label><pre>@step.RawOutput</pre></div>
                            @if (!string.IsNullOrWhiteSpace(step.Error))
                            {
                                <div class="prompt-block"><label>Error</label><pre>@step.Error</pre></div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    bool Open;
    HashSet<string> OpenSteps = [];

    [Parameter] public RpTurnTrace Trace { get; set; } = new();

    string StatusText => Trace.Status switch
    {
        "completed" => $"Completed · {RelativeDateFormatter.FormatDuration(Trace.DurationSeconds)}",
        "failed" => $"Failed · {RelativeDateFormatter.FormatDuration(Trace.DurationSeconds)}",
        _ => ""
    };

    string StatusClass => Trace.Status == "failed" ? "status-text-danger" : "status-text-success";

    void Toggle(string id)
    {
        if (!OpenSteps.Add(id))
            OpenSteps.Remove(id);
    }

    static string IconFor(string id) => id switch
    {
        "appearance" => "eye",
        "selection" => "users",
        "planning" => "sliders",
        "prose" => "edit",
        "snapshot" => "flag",
        _ => "zap"
    };
}
