@implements IDisposable
@inject ILogger<ChatDirectionModal> Logger

<StatefulForm Model="@Draft" Baseline="@Baseline" OnSave="Save" OnClose="OnClose" ContextChanged="SetDirectionForm" RenderFormElement="false">
<ChildContent Context="form">
<ModalShell Title="Direction" Icon="book-open" MaxWidth="900px" BodyClass="is-flush" OnClose="form.RequestCloseAsync">
    <ModalTabGroup ActiveId="@ActiveTab" ActiveIdChanged="SetActiveTab" Height="620px" RailWidth="164px" Class="chat-direction-tabs">
        <RailHeader>
            <div class="chat-direction-rail-header">
                <label for="chat-direction-title">Story Title</label>
                <AppInput id="chat-direction-title" Class="chat-direction-title-field" Value="@Draft.Title" ValueChanged="SetDraftTitle" DirtyPath="@nameof(ChatDirectionEditorState.Title)" />
            </div>
        </RailHeader>
        <ChildContent>
            <ModalTab Id="mood" Title="Mood" Summary="@MoodSummary" DirtyPaths="@MoodPaths">
                <LeadingContent><FaIcon Name="sparkle" /></LeadingContent>
            </ModalTab>
            <ModalTab Id="shape" Title="Shape" Summary="@ShapeSummary" DirtyPaths="@ShapePaths">
                <LeadingContent><FaIcon Name="branch" /></LeadingContent>
            </ModalTab>
            <ModalTab Id="limits" Title="Limits" Summary="@LimitsSummary" DirtyPaths="@LimitPaths">
                <LeadingContent><FaIcon Name="warning" /></LeadingContent>
            </ModalTab>
            <ModalTab Id="world" Title="World" Summary="@WorldSummary" DirtyPaths="@WorldPaths">
                <LeadingContent><FaIcon Name="map-pin" /></LeadingContent>
            </ModalTab>
            <ModalTab Id="cards" Title="Cards" Summary="@CardsSummary">
                <LeadingContent><FaIcon Name="cards" /></LeadingContent>
                <TrailingContent><Badge Tone="blue">@Session.Chat.StoryCards.Items.Count</Badge></TrailingContent>
            </ModalTab>
        </ChildContent>
        <RailFooter>
            <div class="prompt-rail-note">
                <p>Direction is attached to this story and rendered into planning, selection, scene continuity, and prose prompts.</p>
            </div>
        </RailFooter>
        <MainContent>
            <ModalStackLayout Class="modal-editor-main" BodyClass="modal-form-stack chat-direction-tab-body">
                <Header>
                    <ModalPaneToolbar Class="tuning-toolbar">
                        <strong>@ActiveTabTitle</strong>
                        <span class="toolbar-spacer"></span>
                        <Badge Tone="@ActiveBadgeTone">@ActiveTabSummary</Badge>
                    </ModalPaneToolbar>
                </Header>
                <ChildContent>
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="modal-error">@ErrorMessage</div>
                    }

                    @if (ActiveTab == "mood")
                    {
                        <OptionGrid Title="Genres" Hint="@($"Pick up to {ChatDirectionService.MaxGenres}")" Columns="2" Items="@Library.Genres" MultiValues="@Direction.Genres" Max="@ChatDirectionService.MaxGenres" DirtyPath="@DirectionPath(nameof(ChatDirectionState.Genres))" OnToggle="@(id => ToggleLimited(Direction.Genres, id, ChatDirectionService.MaxGenres))" />
                        <OptionGrid Title="Tone" Hint="@($"Pick up to {ChatDirectionService.MaxTones}")" Columns="2" Items="@Library.Tones" MultiValues="@Direction.Tones" Max="@ChatDirectionService.MaxTones" DirtyPath="@DirectionPath(nameof(ChatDirectionState.Tones))" OnToggle="@(id => ToggleLimited(Direction.Tones, id, ChatDirectionService.MaxTones))" />
                        <OptionGrid Title="Themes" Hint="@($"Pick up to {ChatDirectionService.MaxThemes}")" Columns="2" Items="@Library.Themes" MultiValues="@Direction.Themes" Max="@ChatDirectionService.MaxThemes" DirtyPath="@DirectionPath(nameof(ChatDirectionState.Themes))" OnToggle="@(id => ToggleLimited(Direction.Themes, id, ChatDirectionService.MaxThemes))" />
                    }
                    else if (ActiveTab == "shape")
                    {
                        <OptionGrid Title="Pacing" Hint="@($"Pick up to {ChatDirectionService.MaxPacing}")" Columns="2" Items="@Library.Pacing" MultiValues="@Direction.Pacing" Max="@ChatDirectionService.MaxPacing" DirtyPath="@DirectionPath(nameof(ChatDirectionState.Pacing))" OnToggle="@(id => ToggleLimited(Direction.Pacing, id, ChatDirectionService.MaxPacing))" />
                        <OptionGrid Title="Focus" Hint="@($"Pick up to {ChatDirectionService.MaxStoryFocus}")" Columns="2" Items="@Library.StoryFocus" MultiValues="@Direction.StoryFocus" Max="@ChatDirectionService.MaxStoryFocus" DirtyPath="@DirectionPath(nameof(ChatDirectionState.StoryFocus))" OnToggle="@(id => ToggleLimited(Direction.StoryFocus, id, ChatDirectionService.MaxStoryFocus))" />
                    }
                    else if (ActiveTab == "limits")
                    {
                        <ContentIntensityControl Label="Explicit Content" Value="@Direction.ExplicitContent" ValueChanged="@(value => Direction.ExplicitContent = value)" DirtyPath="@DirectionPath(nameof(ChatDirectionState.ExplicitContent))" />
                        <ContentIntensityControl Label="Violent Content" Value="@Direction.ViolentContent" ValueChanged="@(value => Direction.ViolentContent = value)" DirtyPath="@DirectionPath(nameof(ChatDirectionState.ViolentContent))" />
                        <OptionGrid Title="Boundaries" Hint="@($"Pick up to {ChatDirectionService.MaxBoundaries}")" Columns="2" Items="@Library.Boundaries" MultiValues="@Direction.Boundaries" Max="@ChatDirectionService.MaxBoundaries" DirtyPath="@DirectionPath(nameof(ChatDirectionState.Boundaries))" OnToggle="@(id => ToggleLimited(Direction.Boundaries, id, ChatDirectionService.MaxBoundaries))" />
                    }
                    else if (ActiveTab == "world")
                    {
                        <div class="field-stack">
                            <FieldRow Label="Setting" DirtyPath="@DirectionPath(nameof(ChatDirectionState.Setting))">
                                <AppTextarea Rows="5" Value="@Direction.Setting" ValueChanged="value => Direction.Setting = value" DirtyPath="@DirectionPath(nameof(ChatDirectionState.Setting))" Placeholder="Where this story lives, socially and physically." />
                            </FieldRow>
                            <FieldRow Label="Premise" DirtyPath="@DirectionPath(nameof(ChatDirectionState.Premise))">
                                <AppTextarea Rows="5" Value="@Direction.Premise" ValueChanged="value => Direction.Premise = value" DirtyPath="@DirectionPath(nameof(ChatDirectionState.Premise))" Placeholder="The current story promise or direction." />
                            </FieldRow>
                            <FieldRow Label="Custom Guidance" DirtyPath="@DirectionPath(nameof(ChatDirectionState.CustomGuidance))">
                                <AppTextarea Rows="5" Value="@Direction.CustomGuidance" ValueChanged="value => Direction.CustomGuidance = value" DirtyPath="@DirectionPath(nameof(ChatDirectionState.CustomGuidance))" Placeholder="Any extra direction this story should consistently honor." />
                            </FieldRow>
                        </div>
                    }
                    else
                    {
                        <StoryCardsStoryTab />
                    }
                </ChildContent>
                <Footer>
                    <AppButton Variant="secondary" OnClick="@(_ => form.RequestCloseAsync())">Cancel</AppButton>
                    <BusyButton Disabled="@(!form.CanSave)" OnClick="form.SaveAsync"><FaIcon Name="check" />Save</BusyButton>
                </Footer>
            </ModalStackLayout>
        </MainContent>
    </ModalTabGroup>
</ModalShell>
</ChildContent>
</StatefulForm>

@code {
    ChatDirectionEditorState Draft = ChatDirectionEditorState.From("", ChatDirectionState.CreateDefault());
    ChatDirectionEditorState Baseline = ChatDirectionEditorState.From("", ChatDirectionState.CreateDefault());
    StatefulFormContext<ChatDirectionEditorState>? DirectionForm;
    ChatDirectionLibrary Library => ChatDirectionService.Library;
    string ErrorMessage = "";
    string ActiveTab = "mood";
    ChatDirectionState Direction => Draft.Direction;
    static readonly string[] MoodPaths = [DirectionPath(nameof(ChatDirectionState.Genres)), DirectionPath(nameof(ChatDirectionState.Tones)), DirectionPath(nameof(ChatDirectionState.Themes))];
    static readonly string[] ShapePaths = [DirectionPath(nameof(ChatDirectionState.Pacing)), DirectionPath(nameof(ChatDirectionState.StoryFocus))];
    static readonly string[] LimitPaths = [DirectionPath(nameof(ChatDirectionState.Boundaries)), DirectionPath(nameof(ChatDirectionState.ExplicitContent)), DirectionPath(nameof(ChatDirectionState.ViolentContent))];
    static readonly string[] WorldPaths =
    [
        nameof(ChatDirectionEditorState.Title),
        DirectionPath(nameof(ChatDirectionState.Setting)),
        DirectionPath(nameof(ChatDirectionState.Premise)),
        DirectionPath(nameof(ChatDirectionState.CustomGuidance))
    ];

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    string MoodSummary => CountSummary(Direction.Genres.Count + Direction.Tones.Count + Direction.Themes.Count);
    string ShapeSummary => CountSummary(Direction.Pacing.Count + Direction.StoryFocus.Count);
    string LimitsSummary => $"{ChatDirectionService.FormatIntensityLabel(Direction.ExplicitContent)} / {ChatDirectionService.FormatIntensityLabel(Direction.ViolentContent)}";
    string WorldSummary => CountSummary(HasText(Direction.Setting), HasText(Direction.Premise), HasText(Direction.CustomGuidance));
    string ActiveTabTitle => ActiveTab switch
    {
        "shape" => "Story Shape",
        "limits" => "Limits",
        "world" => "World",
        "cards" => "Story Cards",
        _ => "Mood"
    };
    string ActiveTabSummary => ActiveTab switch
    {
        "shape" => ShapeSummary,
        "limits" => LimitsSummary,
        "world" => WorldSummary,
        "cards" => CardsSummary,
        _ => MoodSummary
    };
    string ActiveBadgeTone => ActiveTab switch
    {
        "shape" => "blue",
        "limits" => "rose",
        "world" => "emerald",
        "cards" => "blue",
        _ => "violet"
    };
    string CardsSummary => Session.Chat.StoryCards.Items.Count == 1 ? "1 card" : $"{Session.Chat.StoryCards.Items.Count} cards";

    protected override void OnInitialized()
    {
        LoadDraft();
        Session.Chat.ChatDirection.Changed += OnStoreChanged;
    }

    Task OnStoreChanged()
    {
        if (DirectionForm?.HasChanges != true)
            LoadDraft();

        return InvokeAsync(StateHasChanged);
    }

    void LoadDraft()
    {
        Baseline = ChatDirectionEditorState.From(Session.Chats.Active?.Title ?? "", Session.Chat.ChatDirection.State);
        Draft = StatefulFormSnapshot.Clone(Baseline);
    }

    void SetActiveTab(string? id) => ActiveTab = id ?? ActiveTab;

    async Task Save()
    {
        ErrorMessage = "";
        try
        {
            Session.Chat.ChatDirection.SetTitle(Draft.Title);
            CopyInto(Session.Chat.ChatDirection.State, Direction);
            await Session.Chat.ChatDirection.MarkChangedAsync();
            await Session.Chats.RefreshAsync();
            LoadDraft();
            await Close();
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Saving story direction failed.",
                "Saving story direction failed for chat {ChatId}.",
                Session.Chats.Active?.ChatId);
        }
    }

    Task Close() => OnClose.InvokeAsync();

    void SetDirectionForm(StatefulFormContext<ChatDirectionEditorState> form)
    {
        DirectionForm = form;
    }

    void SetDraftTitle(string value) => Draft.Title = value;

    static Task ToggleLimited(List<string> values, string value, int max)
    {
        if (!values.Remove(value) && values.Count < max)
            values.Add(value);

        return Task.CompletedTask;
    }

    static bool HasText(string value) => !string.IsNullOrWhiteSpace(value);

    static string CountSummary(int count) => count == 1 ? "1 choice" : $"{count} choices";

    static string CountSummary(params bool[] values)
    {
        var count = values.Count(value => value);
        return count == 1 ? "1 field" : $"{count} fields";
    }

    static string DirectionPath(string property) => $"{nameof(ChatDirectionEditorState.Direction)}.{property}";

    static void CopyInto(ChatDirectionState target, ChatDirectionState source)
    {
        var normalized = ChatDirectionService.NormalizeState(source);
        target.SchemaVersion = normalized.SchemaVersion;
        target.Genres = normalized.Genres;
        target.Tones = normalized.Tones;
        target.Themes = normalized.Themes;
        target.Pacing = normalized.Pacing;
        target.StoryFocus = normalized.StoryFocus;
        target.Boundaries = normalized.Boundaries;
        target.ExplicitContent = normalized.ExplicitContent;
        target.ViolentContent = normalized.ViolentContent;
        target.Setting = normalized.Setting;
        target.Premise = normalized.Premise;
        target.CustomGuidance = normalized.CustomGuidance;
    }

    public void Dispose()
    {
        Session.Chat.ChatDirection.Changed -= OnStoreChanged;
    }
}
