@implements IDisposable
@inject ILogger<ChatDirectionModal> Logger

<StatefulForm Model="@Draft" Baseline="@Saved" OnSave="Save" OnClose="OnClose" ContextChanged="SetDirectionForm" RenderFormElement="false">
<ChildContent Context="form">
<ModalShell Title="Direction" Icon="book-open" MaxWidth="900px" BodyClass="is-flush" OnClose="form.RequestCloseAsync">
    <ModalTabGroup ActiveId="@ActiveTab" ActiveIdChanged="SetActiveTab" Height="620px" RailWidth="164px" Class="chat-direction-tabs">
        <RailHeader>
            <div class="chat-direction-rail-header">
                <label for="chat-direction-title">Story Title</label>
                <AppInput id="chat-direction-title" Class="chat-direction-title-field" Value="@DraftTitle" ValueChanged="SetDraftTitle" Dirty="@(DraftTitle != SavedTitle)" />
            </div>
        </RailHeader>
        <ChildContent>
            <ModalTab Id="mood" Title="Mood" Summary="@MoodSummary" DirtyPaths="@MoodPaths">
                <LeadingContent><FaIcon Name="sparkle" /></LeadingContent>
            </ModalTab>
            <ModalTab Id="shape" Title="Shape" Summary="@ShapeSummary" DirtyPaths="@ShapePaths">
                <LeadingContent><FaIcon Name="branch" /></LeadingContent>
            </ModalTab>
            <ModalTab Id="limits" Title="Limits" Summary="@LimitsSummary" DirtyPaths="@LimitPaths">
                <LeadingContent><FaIcon Name="warning" /></LeadingContent>
            </ModalTab>
            <ModalTab Id="world" Title="World" Summary="@WorldSummary" Dirty="@IsWorldDirty()">
                <LeadingContent><FaIcon Name="map-pin" /></LeadingContent>
            </ModalTab>
            <ModalTab Id="cards" Title="Cards" Summary="@CardsSummary">
                <LeadingContent><FaIcon Name="cards" /></LeadingContent>
                <TrailingContent><Badge Tone="blue">@Session.Chat.StoryCards.Items.Count</Badge></TrailingContent>
            </ModalTab>
        </ChildContent>
        <RailFooter>
            <div class="prompt-rail-note">
                <p>Direction is attached to this story and rendered into planning, selection, scene continuity, and prose prompts.</p>
            </div>
        </RailFooter>
        <MainContent>
            <ModalStackLayout Class="modal-editor-main" BodyClass="modal-form-stack chat-direction-tab-body">
                <Header>
                    <ModalPaneToolbar Class="tuning-toolbar">
                        <strong>@ActiveTabTitle</strong>
                        <span class="toolbar-spacer"></span>
                        <Badge Tone="@ActiveBadgeTone">@ActiveTabSummary</Badge>
                    </ModalPaneToolbar>
                </Header>
                <ChildContent>
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="modal-error">@ErrorMessage</div>
                    }

                    @if (ActiveTab == "mood")
                    {
                        <OptionGrid Title="Genres" Hint="@($"Pick up to {ChatDirectionService.MaxGenres}")" Columns="2" Items="@Library.Genres" MultiValues="@Draft.Genres" Max="@ChatDirectionService.MaxGenres" DirtyPath="@nameof(Draft.Genres)" OnToggle="@(id => ToggleLimited(Draft.Genres, id, ChatDirectionService.MaxGenres))" />
                        <OptionGrid Title="Tone" Hint="@($"Pick up to {ChatDirectionService.MaxTones}")" Columns="2" Items="@Library.Tones" MultiValues="@Draft.Tones" Max="@ChatDirectionService.MaxTones" DirtyPath="@nameof(Draft.Tones)" OnToggle="@(id => ToggleLimited(Draft.Tones, id, ChatDirectionService.MaxTones))" />
                        <OptionGrid Title="Themes" Hint="@($"Pick up to {ChatDirectionService.MaxThemes}")" Columns="2" Items="@Library.Themes" MultiValues="@Draft.Themes" Max="@ChatDirectionService.MaxThemes" DirtyPath="@nameof(Draft.Themes)" OnToggle="@(id => ToggleLimited(Draft.Themes, id, ChatDirectionService.MaxThemes))" />
                    }
                    else if (ActiveTab == "shape")
                    {
                        <OptionGrid Title="Pacing" Hint="@($"Pick up to {ChatDirectionService.MaxPacing}")" Columns="2" Items="@Library.Pacing" MultiValues="@Draft.Pacing" Max="@ChatDirectionService.MaxPacing" DirtyPath="@nameof(Draft.Pacing)" OnToggle="@(id => ToggleLimited(Draft.Pacing, id, ChatDirectionService.MaxPacing))" />
                        <OptionGrid Title="Focus" Hint="@($"Pick up to {ChatDirectionService.MaxStoryFocus}")" Columns="2" Items="@Library.StoryFocus" MultiValues="@Draft.StoryFocus" Max="@ChatDirectionService.MaxStoryFocus" DirtyPath="@nameof(Draft.StoryFocus)" OnToggle="@(id => ToggleLimited(Draft.StoryFocus, id, ChatDirectionService.MaxStoryFocus))" />
                    }
                    else if (ActiveTab == "limits")
                    {
                        <ContentIntensityControl Label="Explicit Content" Value="@Draft.ExplicitContent" ValueChanged="@(value => Draft.ExplicitContent = value)" DirtyPath="@nameof(Draft.ExplicitContent)" />
                        <ContentIntensityControl Label="Violent Content" Value="@Draft.ViolentContent" ValueChanged="@(value => Draft.ViolentContent = value)" DirtyPath="@nameof(Draft.ViolentContent)" />
                        <OptionGrid Title="Boundaries" Hint="@($"Pick up to {ChatDirectionService.MaxBoundaries}")" Columns="2" Items="@Library.Boundaries" MultiValues="@Draft.Boundaries" Max="@ChatDirectionService.MaxBoundaries" DirtyPath="@nameof(Draft.Boundaries)" OnToggle="@(id => ToggleLimited(Draft.Boundaries, id, ChatDirectionService.MaxBoundaries))" />
                    }
                    else if (ActiveTab == "world")
                    {
                        <div class="field-stack">
                            <FieldRow Label="Setting" DirtyPath="@nameof(Draft.Setting)">
                                <AppTextarea Rows="5" Value="@Draft.Setting" ValueChanged="value => Draft.Setting = value" DirtyPath="@nameof(Draft.Setting)" Placeholder="Where this story lives, socially and physically." />
                            </FieldRow>
                            <FieldRow Label="Premise" DirtyPath="@nameof(Draft.Premise)">
                                <AppTextarea Rows="5" Value="@Draft.Premise" ValueChanged="value => Draft.Premise = value" DirtyPath="@nameof(Draft.Premise)" Placeholder="The current story promise or direction." />
                            </FieldRow>
                            <FieldRow Label="Custom Guidance" DirtyPath="@nameof(Draft.CustomGuidance)">
                                <AppTextarea Rows="5" Value="@Draft.CustomGuidance" ValueChanged="value => Draft.CustomGuidance = value" DirtyPath="@nameof(Draft.CustomGuidance)" Placeholder="Any extra direction this story should consistently honor." />
                            </FieldRow>
                        </div>
                    }
                    else
                    {
                        <StoryCardsStoryTab />
                    }
                </ChildContent>
                <Footer>
                    <AppButton Variant="secondary" OnClick="@(_ => form.RequestCloseAsync())">Cancel</AppButton>
                    <BusyButton Disabled="@(!form.CanSave)" OnClick="form.SaveAsync"><FaIcon Name="check" />Save</BusyButton>
                </Footer>
            </ModalStackLayout>
        </MainContent>
    </ModalTabGroup>
</ModalShell>
</ChildContent>
</StatefulForm>

@code {
    ChatDirectionState Draft = ChatDirectionState.CreateDefault();
    ChatDirectionState Saved = ChatDirectionState.CreateDefault();
    StatefulFormContext<ChatDirectionState>? DirectionForm;
    ChatDirectionLibrary Library => ChatDirectionService.Library;
    string ErrorMessage = "";
    string ActiveTab = "mood";
    string DraftTitle = "";
    string SavedTitle = "";
    static readonly string[] MoodPaths = [nameof(ChatDirectionState.Genres), nameof(ChatDirectionState.Tones), nameof(ChatDirectionState.Themes)];
    static readonly string[] ShapePaths = [nameof(ChatDirectionState.Pacing), nameof(ChatDirectionState.StoryFocus)];
    static readonly string[] LimitPaths = [nameof(ChatDirectionState.Boundaries), nameof(ChatDirectionState.ExplicitContent), nameof(ChatDirectionState.ViolentContent)];

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    string MoodSummary => CountSummary(Draft.Genres.Count + Draft.Tones.Count + Draft.Themes.Count);
    string ShapeSummary => CountSummary(Draft.Pacing.Count + Draft.StoryFocus.Count);
    string LimitsSummary => $"{ChatDirectionService.FormatIntensityLabel(Draft.ExplicitContent)} / {ChatDirectionService.FormatIntensityLabel(Draft.ViolentContent)}";
    string WorldSummary => CountSummary(HasText(Draft.Setting), HasText(Draft.Premise), HasText(Draft.CustomGuidance));
    string ActiveTabTitle => ActiveTab switch
    {
        "shape" => "Story Shape",
        "limits" => "Limits",
        "world" => "World",
        "cards" => "Story Cards",
        _ => "Mood"
    };
    string ActiveTabSummary => ActiveTab switch
    {
        "shape" => ShapeSummary,
        "limits" => LimitsSummary,
        "world" => WorldSummary,
        "cards" => CardsSummary,
        _ => MoodSummary
    };
    string ActiveBadgeTone => ActiveTab switch
    {
        "shape" => "blue",
        "limits" => "rose",
        "world" => "emerald",
        "cards" => "blue",
        _ => "violet"
    };
    string CardsSummary => Session.Chat.StoryCards.Items.Count == 1 ? "1 card" : $"{Session.Chat.StoryCards.Items.Count} cards";

    protected override void OnInitialized()
    {
        LoadDraft();
        Session.Chat.ChatDirection.Changed += OnStoreChanged;
    }

    Task OnStoreChanged()
    {
        if (DirectionForm?.HasChanges != true)
            LoadDraft();

        return InvokeAsync(StateHasChanged);
    }

    void LoadDraft()
    {
        Saved = SessionCloner.Clone(Session.Chat.ChatDirection.State);
        Draft = SessionCloner.Clone(Saved);
        SavedTitle = Session.Chats.Active?.Title ?? "";
        DraftTitle = SavedTitle;
    }

    void SetActiveTab(string? id) => ActiveTab = id ?? ActiveTab;

    async Task Save()
    {
        ErrorMessage = "";
        try
        {
            Session.Chat.ChatDirection.SetTitle(DraftTitle);
            CopyInto(Session.Chat.ChatDirection.State, Draft);
            await Session.Chat.ChatDirection.MarkChangedAsync();
            await Session.Chats.RefreshAsync();
            LoadDraft();
            await Close();
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Saving story direction failed.",
                "Saving story direction failed for chat {ChatId}.",
                Session.Chats.Active?.ChatId);
        }
    }

    Task Close() => OnClose.InvokeAsync();

    void SetDirectionForm(StatefulFormContext<ChatDirectionState> form)
    {
        DirectionForm = form;
    }

    bool IsWorldDirty() =>
        DraftTitle != SavedTitle ||
        Draft.Setting != Saved.Setting ||
        Draft.Premise != Saved.Premise ||
        Draft.CustomGuidance != Saved.CustomGuidance;

    void SetDraftTitle(string value) => DraftTitle = value;

    static Task ToggleLimited(List<string> values, string value, int max)
    {
        if (!values.Remove(value) && values.Count < max)
            values.Add(value);

        return Task.CompletedTask;
    }

    static bool HasText(string value) => !string.IsNullOrWhiteSpace(value);

    static string CountSummary(int count) => count == 1 ? "1 choice" : $"{count} choices";

    static string CountSummary(params bool[] values)
    {
        var count = values.Count(value => value);
        return count == 1 ? "1 field" : $"{count} fields";
    }

    static void CopyInto(ChatDirectionState target, ChatDirectionState source)
    {
        var normalized = ChatDirectionService.NormalizeState(source);
        target.SchemaVersion = normalized.SchemaVersion;
        target.Genres = normalized.Genres;
        target.Tones = normalized.Tones;
        target.Themes = normalized.Themes;
        target.Pacing = normalized.Pacing;
        target.StoryFocus = normalized.StoryFocus;
        target.Boundaries = normalized.Boundaries;
        target.ExplicitContent = normalized.ExplicitContent;
        target.ViolentContent = normalized.ViolentContent;
        target.Setting = normalized.Setting;
        target.Premise = normalized.Premise;
        target.CustomGuidance = normalized.CustomGuidance;
    }

    public void Dispose()
    {
        Session.Chat.ChatDirection.Changed -= OnStoreChanged;
    }
}
