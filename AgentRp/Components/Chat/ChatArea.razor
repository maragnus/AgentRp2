@implements IDisposable
@inject IServiceProvider Services
@inject ILogger<ChatArea> Logger
@inject DialogHelper Dialogs
@inject NavigationManager Navigation

<main class="chat claude-chat">
    @if (HasActiveStory)
    {
    <header class="claude-chat-head">
        <div>
            <h1>@Chat.Title</h1>
            <div class="claude-chat-meta">
                @if (!string.IsNullOrWhiteSpace(Chat.Location))
                {
                    <FaIcon Name="map-pin" />
                    <span>@Chat.Location</span>
                    <span>&middot;</span>
                }
                <span>@Chat.Messages messages</span>
            </div>
        </div>
        <AnchoredPopover Placement="OverlayPlacement.BottomEnd" Class="menu-popover" CloseOnContentClick="false">
            <Trigger Context="menu">
                <AppButton Icon="more-h" TooltipText="Story menu" Active="@menu.IsOpen" OnClick="@(_ => menu.Toggle())" />
            </Trigger>
            <Content>
                    <div class="popover-label">Audio Tags</div>
                    <SelectableButton Class="toggle-row" OnClick="@(_ => ToggleInjectAudioTags())">
                        <FaIcon Name="sparkle" />
                        <span>Inject Tags</span>
                        <span class="toggle-pill @(Options.InjectAudioTags ? "is-on" : "")"><span></span></span>
                    </SelectableButton>
                    <SelectableButton Class="toggle-row" OnClick="@(_ => ToggleHideAudioTags())">
                        <FaIcon Name="eye-off" />
                        <span>Hide Tags</span>
                        <span class="toggle-pill @(Options.HideAudioTags ? "is-on" : "")"><span></span></span>
                    </SelectableButton>
                    <div class="divider"></div>
                    <div class="popover-label">Speech</div>
                    <SelectableButton Class="toggle-row" OnClick="@(_ => ToggleAutoSpeakNewMessages())">
                        <FaIcon Name="volume" />
                        <span>Auto Speak</span>
                        <span class="toggle-pill @(Options.AutoSpeakNewMessages ? "is-on" : "")"><span></span></span>
                    </SelectableButton>
                    @if (CanSpeakActionsInNarratorVoice)
                    {
                        <SelectableButton Class="toggle-row" OnClick="@(_ => ToggleSpeakActionsInNarratorVoice())">
                            <FaIcon Name="users" />
                            <span>Narrator Actions</span>
                            <span class="toggle-pill @(Options.SpeakActionsInNarratorVoice ? "is-on" : "")"><span></span></span>
                        </SelectableButton>
                    }
                    <div class="divider"></div>
                    <div class="popover-label">Visible Blocks</div>
                    <SelectableButton Class="toggle-row" OnClick="@(_ => ToggleShowAppearanceBlocks())">
                        <FaIcon Name="eye" />
                        <span>Scene Continuity</span>
                        <span class="toggle-pill @(Options.ShowAppearanceBlocks ? "is-on" : "")"><span></span></span>
                    </SelectableButton>
                    <SelectableButton Class="toggle-row" OnClick="@(_ => ToggleShowProcessTraces())">
                        <FaIcon Name="zap" />
                        <span>Process Traces</span>
                        <span class="toggle-pill @(Options.ShowProcessTraces ? "is-on" : "")"><span></span></span>
                    </SelectableButton>
                    <div class="divider"></div>
                    <div class="popover-label">Theme</div>
                    <div class="popover-pad"><ThemeToggle /></div>
            </Content>
        </AnchoredPopover>
    </header>

    <InlineFooterScrollRegion Class="@TranscriptScrollClass"
                              ContentClass="chat-message-stack"
                              FooterClass="claude-footer"
                              ScrollVersion="@TranscriptScrollVersion">
        <ChildContent>
            @if (Session.Chat.Transcript.LastBackgroundError is not null)
            {
                <StatusRow Icon="warning" Tone="danger" Class="appearance-row chat-error-row">@Session.Chat.Transcript.LastBackgroundError.Message</StatusRow>
            }
            @foreach (var item in DisplayItems)
            {
                @if (item.Snapshot is not null)
                {
                    <SnapshotTranscriptRow @key="item.Snapshot.Id"
                                           Snapshot="item.Snapshot"
                                           ShowProcess="Options.ShowProcessTraces"
                                           TranscriptBusy="TranscriptBusy"
                                           OnOpenEntities="OnOpenEntities" />
                }
                else if (item.Message is not null)
                {
                    @if (item.Transition is not null && item.Transition.HasChanges)
                    {
                        <SceneTransitionEntry @key="@($"transition:{item.Message.Id}")"
                                              Delta="item.Transition"
                                              OnOpenEntities="OnOpenEntities" />
                    }
                    <ChatMessage @key="item.Message.Id"
                                 Message="item.Message"
                                 Characters="Characters"
                                 ShowAppearance="Options.ShowAppearanceBlocks"
                                 ShowProcess="Options.ShowProcessTraces"
                                 TranscriptBusy="TranscriptBusy"
                                 SubsequentCount="item.SubsequentCount"
                                 OnOpenEntities="OnOpenEntities"
                                 OnCreateSnapshot="OpenSnapshotDraft" />
                }
            }
            @if (ActiveDraftTurn is not null)
            {
                <ChatMessage @key="ActiveDraftTurn.Id"
                             Message="ActiveDraftTurn"
                             Characters="Characters"
                             ShowAppearance="false"
                             ShowProcess="false"
                             TranscriptBusy="true"
                             SubsequentCount="0" />
            }
            @if (ActiveTrace is not null)
            {
                <ProcessTrace @key="ActiveTrace.StartedUtc" Trace="ActiveTrace" IsLive="true" AutoExpand="Options.ShowProcessTraces" />
            }
        </ChildContent>
        <FooterContent>
            @if (BuildSnapshotSuggestion() is { } snapshotSuggestion)
            {
                <SnapshotSuggestionBanner CoveredMessageCount="@snapshotSuggestion.CoveredMessageCount"
                                          RetainedMessageCount="@SnapshotSuggestionRetainedMessageCount"
                                          Disabled="@TranscriptBusy"
                                          OnCreateSnapshot="OpenSuggestedSnapshotDraft" />
            }
            <div class="claude-composer @(TranscriptBusy ? "is-locked" : "")">
                <textarea rows="3" @bind="Draft" @bind:event="oninput" @onkeydown="HandleKeyDown" disabled="@TranscriptBusy" placeholder="Guide the next turn, or leave blank to let AI continue the scene…"></textarea>
                <div class="claude-composer-actions">
                    <AnchoredPopover Placement="OverlayPlacement.TopStart" Class="composer-popover">
                        <Trigger Context="speaker">
                            <AppButton Variant="secondary" Size="xs" Class="composer-action-button" Active="@speaker.IsOpen" Disabled="@TranscriptBusy" OnClick="@(_ => speaker.Toggle())">
                                @if (Session.SpeakingAs is null)
                                {
                                    <span class="mini-narrator"><FaIcon Name="book-open" /></span>
                                }
                                else
                                {
                                    <EntityImage EntityType="character" EntityId="@CurrentSpeaker?.Id" Name="@SpeakerName" Image="@ImageFor(CurrentSpeaker?.ImageId ?? "")" Size="14" />
                                }
                                <span>@SpeakerName</span>
                                <FaIcon Name="chevron-down" />
                            </AppButton>
                        </Trigger>
                        <Content>
                            <SelectableButton Class="select-row" Disabled="@TranscriptBusy" OnClick="@(_ => PickSpeaker(null))"><span class="mini-narrator large"><FaIcon Name="book-open" /></span><span>Narrator</span></SelectableButton>
                            @foreach (var character in Characters)
                            {
                                <SelectableButton @key="character.Id" Class="select-row" Disabled="@TranscriptBusy" OnClick="@(_ => PickSpeaker(character))"><EntityImage EntityType="character" EntityId="@character.Id" Name="@character.Name" Image="@ImageFor(character.ImageId)" Size="20" /><span>@character.Name</span></SelectableButton>
                            }
                        </Content>
                    </AnchoredPopover>

                    <div class="toolbar-spacer"></div>

                    <TurnShapePicker SelectedShape="@TurnShape" Disabled="@TranscriptBusy" ShapeSelected="PickShape" />
                    <AppButton Icon="@TurnShapeLockIcon"
                               Variant="secondary"
                               Size="xs"
                               Class="composer-lock-button"
                               Active="@Options.TurnShapeLocked"
                               Disabled="@TranscriptBusy"
                               TooltipText="@TurnShapeLockTitle"
                               OnClick="@(_ => ToggleTurnShapeLocked())" />

                    <span class="v-divider"></span>

                    @if (TranscriptBusy)
                    {
                        <span class="composer-busy-status"><span class="spinner" aria-hidden="true"></span>@TranscriptBusyMessage</span>
                    }
                    <span class="shortcut">Ctrl+↵</span>
                    <AppButton Variant="primary" Size="xs" Class="composer-action-button" Disabled="@(!CanGenerate)" TooltipText="@GenerateTitle" OnClick="@GenerateTurn">
                        <FaIcon Name="sparkle" /> Generate
                    </AppButton>
                    <AppButton Icon="paper-plane-top" Variant="secondary" Class="composer-manual-button" Disabled="@(TranscriptBusy || Draft.Trim().Length == 0)" TooltipText="Post manual turn" OnClick="@(_ => PostManual())" />
                </div>
            </div>
        </FooterContent>
    </InlineFooterScrollRegion>
    }
    else
    {
        <section class="claude-chat-scroll no-story-onboarding">
            <div class="story-resume-board">
                <div class="story-resume-head">
                    <span class="story-resume-head-icon"><FaIcon Name="book-open" /></span>
                    <div>
                        <h1>Choose a story</h1>
                        <p>Continue where you left off or start a new thread.</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(SelectionError))
                {
                    <StatusRow Icon="warning" Tone="danger" Class="story-resume-error">@SelectionError</StatusRow>
                }
                <div class="story-resume-grid">
                    @foreach (var story in ResumeStories)
                    {
                        <StoryResumeCard @key="story.ChatId"
                                         Story="story"
                                         OnClick="@(() => SelectStory(story))" />
                    }
                    <button class="story-resume-card story-resume-new-card"
                            title="Start a new story"
                            @onclick="@(() => OnNewStory.InvokeAsync())">
                        <span class="story-resume-new-icon"><FaIcon Name="plus" /></span>
                        <span class="story-resume-copy">
                            <strong>New Story</strong>
                            <small>Start from a blank setup.</small>
                        </span>
                        <span class="story-resume-trailing"><FaIcon Name="chevron-right" /></span>
                    </button>
                </div>
            </div>
        </section>
    }
</main>

@if (SnapshotModalOpen)
{
    <SnapshotDraftModal Draft="SnapshotDraft"
                        Preview="SnapshotDraftPreview"
                        IsLoading="SnapshotDraftLoading"
                        IsSaving="SnapshotSaving"
                        CloseDisabled="@(SnapshotDraftLoading || SnapshotSaving)"
                        ErrorMessage="@SnapshotError"
                        OnClose="CloseSnapshotDraft"
                        OnSave="SaveSnapshotDraft" />
}

@code {
    string Draft = "";
    string ActiveChatId = "";
    string PendingAutoSpeakTurnId = "";
    string LastTranscriptScrollSignature = "";
    string StorySelectionError = "";
    long TranscriptScrollVersion;
    bool SnapshotModalOpen;
    bool SnapshotDraftLoading;
    bool SnapshotSaving;
    string SnapshotError = "";
    RpTranscriptSnapshotDraft? SnapshotDraft;
    RpTranscriptSnapshotDraftPreview? SnapshotDraftPreview;
    HashSet<string> KnownMessageIds = [];
    readonly SceneTransitionService SceneTransitions = new();
    const int SnapshotSuggestionThreshold = 25;
    const int SnapshotSuggestionRetainedMessageCount = 5;

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public string RouteSelectionError { get; set; } = "";
    [Parameter] public EventCallback<(string Type, string? Id)> OnOpenEntities { get; set; }
    [Parameter] public EventCallback OnNewStory { get; set; }

    IMessageSpeechService? MessageSpeechService => Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions.GetService<IMessageSpeechService>(Services);
    ITtsAudioPlaybackService? Playback => Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions.GetService<ITtsAudioPlaybackService>(Services);
    RpChat Chat => Session.ActiveChat.Current!.Chat;
    RpTranscriptOptionsState Options => Session.Chat.Transcript.Options;
    string TurnShape => string.IsNullOrWhiteSpace(Options.TurnShape)
        ? TurnShapePickerOptions.Auto
        : TurnShapePickerOptions.Normalize(Options.TurnShape);
    string TurnShapeLockIcon => Options.TurnShapeLocked ? "lock" : "lock-open";
    string TurnShapeLockTitle => Options.TurnShapeLocked ? "Keep Turn Shape" : "Reset Turn Shape after generation";
    List<RpTranscriptTurn> Messages => Session.Chat.Transcript.Items;
    List<RpCharacter> Characters => Session.Chat.Characters.Items;
    RpGenerationTrace? ActiveTrace => Session.Chat.Transcript.ActiveTrace;
    RpTranscriptTurn? ActiveDraftTurn => Session.Chat.Transcript.ActiveDraftTurn;
    IReadOnlyList<TranscriptDisplayItem> DisplayItems => BuildDisplayItems();
    IReadOnlyList<StoryPreview> ResumeStories => Session.Chats.Items.Take(3).ToList();
    string SelectionError => string.IsNullOrWhiteSpace(RouteSelectionError) ? StorySelectionError : RouteSelectionError;

    bool IsGuided => Draft.Trim().Length > 0;
    bool HasActiveStory => Session.ActiveChat.Current is not null && Session.Chats.Active is not null;
    RpCharacter? CurrentSpeaker => Session.SpeakingAs is null
        ? null
        : Characters.FirstOrDefault(character => character.Id == Session.SpeakingAs.Id) ?? Session.SpeakingAs;
    string SpeakerName => CurrentSpeaker?.Name ?? "Narrator";
    string GenerateTitle => TranscriptBusy ? TranscriptBusyMessage : "Generate next turn (Ctrl+Enter)";
    bool TranscriptBusy => Session.Chat.Transcript.IsBusy;
    string TranscriptBusyMessage => string.IsNullOrWhiteSpace(Session.Chat.Transcript.BusyMessage) ? "Working..." : Session.Chat.Transcript.BusyMessage;
    bool CanGenerate => !TranscriptBusy;
    bool CanSpeakActionsInNarratorVoice => string.Equals(Session.ModelSelection.Resolve(AiModelRole.Voice)?.Provider.Type, "elevenlabs", StringComparison.OrdinalIgnoreCase);
    string TranscriptScrollClass => string.Join(" ", new[]
    {
        "claude-chat-scroll",
        Options.HideAudioTags ? "hide-audio-tags" : null
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    IReadOnlyList<TranscriptDisplayItem> BuildDisplayItems()
    {
        var messages = Messages;
        var document = Session.ActiveChat.Current;
        var indexById = messages
            .Select((message, index) => (message.Id, index))
            .ToDictionary(pair => pair.Id, pair => pair.index, StringComparer.Ordinal);
        var snapshots = Session.Chat.Transcript.SnapshotsForActivePath()
            .Where(snapshot => indexById.ContainsKey(snapshot.TurnId))
            .OrderBy(snapshot => indexById[snapshot.TurnId])
            .ToList();
        var items = new List<TranscriptDisplayItem>();
        var nextIndex = 0;
        RpSceneFrame? previousScene = null;
        foreach (var snapshot in snapshots)
        {
            var snapshotIndex = indexById[snapshot.TurnId];
            if (snapshotIndex < nextIndex)
                continue;

            items.Add(new($"snapshot:{snapshot.Id}", null, snapshot, null, messages.Count - snapshotIndex - 1));
            nextIndex = snapshotIndex + 1;
            previousScene = snapshot.Scene;
        }

        for (var index = nextIndex; index < messages.Count; index++)
        {
            var message = messages[index];
            var transition = document is not null && previousScene is not null
                ? SceneTransitions.BuildDelta(document, previousScene, message.Scene)
                : null;
            items.Add(new($"turn:{message.Id}", message, null, transition, messages.Count - index - 1));
            previousScene = message.Scene;
        }

        return items;
    }

    SnapshotSuggestionTarget? BuildSnapshotSuggestion()
    {
        var messages = Messages;
        var latestSnapshot = Session.Chat.Transcript.SnapshotsForActivePath().LastOrDefault();
        var latestSnapshotIndex = latestSnapshot is null
            ? -1
            : messages.FindIndex(message => string.Equals(message.Id, latestSnapshot.TurnId, StringComparison.Ordinal));
        var unsnapshottedMessageCount = messages.Count - latestSnapshotIndex - 1;
        var targetIndex = messages.Count - SnapshotSuggestionRetainedMessageCount - 1;
        if (unsnapshottedMessageCount < SnapshotSuggestionThreshold
            || targetIndex <= latestSnapshotIndex
            || targetIndex < 0
            || targetIndex >= messages.Count)
            return null;

        return new(messages[targetIndex], targetIndex - latestSnapshotIndex);
    }

    GalleryImage? ImageFor(string imageId) => Session.Chat.Images.Items.FirstOrDefault(image => image.Id == imageId);

    protected override void OnInitialized()
    {
        ActiveChatId = Session.Chats.Active?.ChatId ?? "";
        KnownMessageIds = Messages.Select(message => message.Id).ToHashSet(StringComparer.Ordinal);
        LastTranscriptScrollSignature = BuildTranscriptScrollSignature();
        Session.Changed += OnSessionChanged;
        Session.Chats.Changed += OnSessionChanged;
        Session.Providers.Changed += OnSessionChanged;
        Session.Chat.Transcript.Changed += OnSessionChanged;
        Session.ModelSelection.Changed += OnSessionChanged;
        Session.Chat.Characters.Changed += OnSessionChanged;
        Session.Chat.Locations.Changed += OnSessionChanged;
    }

    async Task OnSessionChanged()
    {
        var chatId = Session.Chats.Active?.ChatId ?? "";
        if (!string.Equals(ActiveChatId, chatId, StringComparison.Ordinal))
        {
            ActiveChatId = chatId;
            KnownMessageIds = Messages.Select(message => message.Id).ToHashSet(StringComparer.Ordinal);
            PendingAutoSpeakTurnId = "";
            LastTranscriptScrollSignature = BuildTranscriptScrollSignature();
            TranscriptScrollVersion++;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var newMessages = Messages
            .Where(message => !KnownMessageIds.Contains(message.Id))
            .ToList();
        foreach (var message in newMessages)
            KnownMessageIds.Add(message.Id);

        if (Options.AutoSpeakNewMessages && newMessages.Count > 0)
            PendingAutoSpeakTurnId = newMessages.Last().Id;

        if (Options.AutoSpeakNewMessages && !TranscriptBusy && !string.IsNullOrWhiteSpace(PendingAutoSpeakTurnId))
        {
            var turnId = PendingAutoSpeakTurnId;
            PendingAutoSpeakTurnId = "";
            await AutoSpeak(turnId);
        }

        UpdateTranscriptScrollVersion();
        await InvokeAsync(StateHasChanged);
    }

    async Task PickSpeaker(RpCharacter? character)
    {
        await Session.SetSpeakingAsAsync(character);
    }

    async Task SelectStory(StoryPreview story)
    {
        StorySelectionError = "";
        Navigation.NavigateTo(ChatUrl(story.ChatId));
        await Task.CompletedTask;
    }

    static string ChatUrl(string chatId) => $"/{Uri.EscapeDataString(chatId)}";

    async Task PickShape(string shape) =>
        await Session.Chat.Transcript.SetTurnShapeAsync(shape);

    async Task ToggleTurnShapeLocked() =>
        await Session.Chat.Transcript.SetTurnShapeLockedAsync(!Options.TurnShapeLocked);

    async Task ToggleInjectAudioTags() =>
        await Session.Chat.Transcript.SetInjectAudioTagsAsync(!Options.InjectAudioTags);

    async Task ToggleHideAudioTags() =>
        await Session.Chat.Transcript.SetHideAudioTagsAsync(!Options.HideAudioTags);

    async Task ToggleShowAppearanceBlocks() =>
        await Session.Chat.Transcript.SetShowSceneContinuityBlocksAsync(!Options.ShowSceneContinuityBlocks);

    async Task ToggleShowProcessTraces() =>
        await Session.Chat.Transcript.SetShowProcessTracesAsync(!Options.ShowProcessTraces);

    async Task ToggleAutoSpeakNewMessages() =>
        await Session.Chat.Transcript.SetAutoSpeakNewMessagesAsync(!Options.AutoSpeakNewMessages);

    async Task ToggleSpeakActionsInNarratorVoice() =>
        await Session.Chat.Transcript.SetSpeakActionsInNarratorVoiceAsync(!Options.SpeakActionsInNarratorVoice);

    async Task OpenSnapshotDraft(string turnId)
    {
        SnapshotModalOpen = true;
        SnapshotDraftLoading = true;
        SnapshotSaving = false;
        SnapshotDraft = null;
        SnapshotDraftPreview = Session.Chat.Transcript.PreviewSnapshotDraft(turnId);
        SnapshotError = "";
        await InvokeAsync(StateHasChanged);
        try
        {
            SnapshotDraft = await Session.Chat.Transcript.CreateSnapshotDraftAsync(turnId);
        }
        catch (Exception exception)
        {
            SnapshotError = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Creating the snapshot draft failed.",
                "Creating snapshot draft failed for chat {ChatId}.",
                Chat.Id);
        }
        finally
        {
            SnapshotDraftLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task OpenSuggestedSnapshotDraft()
    {
        var suggestion = BuildSnapshotSuggestion();
        if (suggestion is null)
            return;

        await OpenSnapshotDraft(suggestion.TargetTurn.Id);
    }

    Task CloseSnapshotDraft()
    {
        if (SnapshotDraftLoading || SnapshotSaving)
            return Task.CompletedTask;

        SnapshotModalOpen = false;
        SnapshotDraft = null;
        SnapshotDraftPreview = null;
        SnapshotError = "";
        return Task.CompletedTask;
    }

    async Task SaveSnapshotDraft(RpTranscriptSnapshotDraft draft)
    {
        SnapshotSaving = true;
        SnapshotError = "";
        try
        {
            await Session.Chat.Transcript.CommitSnapshotDraftAsync(draft);
            SnapshotModalOpen = false;
            SnapshotDraft = null;
            SnapshotDraftPreview = null;
        }
        catch (Exception exception)
        {
            SnapshotError = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                "Saving the snapshot failed.",
                "Saving snapshot failed for chat {ChatId}.",
                Chat.Id);
        }
        finally
        {
            SnapshotSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task AutoSpeak(string turnId)
    {
        var document = Session.ActiveChat.Current;
        var turn = Messages.FirstOrDefault(message => message.Id == turnId);
        if (document is null || turn is null)
            return;

        if (MessageSpeechService is null)
            return;

        var availability = MessageSpeechService.ResolveAvailability(document, Session.Providers.Items, Session.ModelSelection.State, turn);
        if (!availability.CanDisplay)
            return;
        if (!availability.CanGenerate)
        {
            await MessageSpeechDialogHelper.ShowMissingVoiceAsync(Dialogs, availability, OnOpenEntities);
            return;
        }

        try
        {
            var playback = await Session.Chat.Transcript.GetOrGenerateSpeechAsync(turn.Id, false);
            if (playback is not null && Playback is not null)
                await Playback.PlayUrlAsync(playback.Key, playback.Url);
        }
        catch (MessageSpeechMissingVoiceException exception)
        {
            Logger.LogWarning(exception, "Automatically reading message {TurnId} aloud needs a selected voice.", turn.Id);
            await MessageSpeechDialogHelper.ShowMissingVoiceAsync(Dialogs, exception.Availability, OnOpenEntities);
        }
        catch (Exception exception)
        {
            var error = UserFacingErrorReporter.CaptureWithDetails(
                Logger,
                exception,
                "Automatically reading the new message aloud failed.",
                "Automatically reading message {TurnId} aloud failed.",
                turn.Id);
            await Dialogs.DisplayErrorAsync(
                "Reading aloud failed",
                error.Message,
                error.Details);
        }
    }

    async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (!TranscriptBusy && args.Key == "Enter" && args.CtrlKey)
            await GenerateTurn();
    }

    async Task GenerateTurn()
    {
        if (!CanGenerate)
            return;

        var text = Draft.Trim();
        var isGuided = text.Length > 0;
        var speaker = Session.SpeakingAs;
        var turnShape = TurnShape;
        Draft = "";
        await Session.Chat.Transcript.GenerateAsync(text, speaker, speaker is null, isGuided ? "guided" : "automatic", turnShape);
        if (!Options.TurnShapeLocked)
            await Session.Chat.Transcript.SetTurnShapeAsync(TurnShapePickerOptions.Auto);
    }

    async Task PostManual()
    {
        if (TranscriptBusy)
            return;

        var text = Draft.Trim();
        if (text.Length == 0)
            return;

        Draft = "";
        await Session.Chat.Transcript.PostManualAsync(text, Session.SpeakingAs);
    }

    void UpdateTranscriptScrollVersion()
    {
        var signature = BuildTranscriptScrollSignature();
        if (string.Equals(LastTranscriptScrollSignature, signature, StringComparison.Ordinal))
            return;

        LastTranscriptScrollSignature = signature;
        TranscriptScrollVersion++;
    }

    string BuildTranscriptScrollSignature()
    {
        var lastMessage = Messages.LastOrDefault();
        return string.Join("|",
            ActiveChatId,
            Messages.Count,
            lastMessage?.Id,
            lastMessage?.UpdatedUtc.Ticks,
            lastMessage?.Body.Length,
            ActiveDraftTurn?.Id,
            ActiveDraftTurn?.UpdatedUtc.Ticks,
            ActiveDraftTurn?.Body.Length,
            ActiveTrace?.StartedUtc.Ticks,
            ActiveTrace?.Status,
            ActiveTrace?.Steps.Count);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.Chats.Changed -= OnSessionChanged;
        Session.Providers.Changed -= OnSessionChanged;
        Session.Chat.Transcript.Changed -= OnSessionChanged;
        Session.ModelSelection.Changed -= OnSessionChanged;
        Session.Chat.Characters.Changed -= OnSessionChanged;
        Session.Chat.Locations.Changed -= OnSessionChanged;
    }

    sealed record TranscriptDisplayItem(
        string Key,
        RpTranscriptTurn? Message,
        RpTranscriptSnapshot? Snapshot,
        SceneTransitionDelta? Transition,
        int SubsequentCount);

    sealed record SnapshotSuggestionTarget(RpTranscriptTurn TargetTurn, int CoveredMessageCount);
}
