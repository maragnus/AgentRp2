@implements IDisposable
@inject IModelCapabilityCatalog CapabilityCatalog

<main class="chat claude-chat">
    <header class="claude-chat-head">
        <div>
            <h1>@Chat.Title</h1>
            <div class="claude-chat-meta">
                <FaIcon Name="map-pin" />
                <span>@Chat.Location</span>
                <span>·</span>
                <span>@Chat.Messages messages</span>
            </div>
        </div>
        <AnchoredPopover Placement="OverlayPlacement.BottomEnd" Class="menu-popover" CloseOnContentClick="false">
            <Trigger Context="menu">
                <IconButton Icon="more-h" Title="Chat menu" Active="@menu.IsOpen" OnClick="@(_ => menu.Toggle())" />
            </Trigger>
            <Content>
                    <div class="popover-label">Visible Blocks</div>
                    <SelectableButton Class="toggle-row" OnClick="@(_ => ShowAppearance = !ShowAppearance)">
                        <FaIcon Name="eye" />
                        <span>Appearance Blocks</span>
                        <span class="toggle-pill @(ShowAppearance ? "is-on" : "")"><span></span></span>
                    </SelectableButton>
                    <SelectableButton Class="toggle-row" OnClick="@(_ => ShowProcess = !ShowProcess)">
                        <FaIcon Name="zap" />
                        <span>Process Traces</span>
                        <span class="toggle-pill @(ShowProcess ? "is-on" : "")"><span></span></span>
                    </SelectableButton>
                    <div class="divider"></div>
                    <div class="popover-label">Appearance</div>
                    <div class="popover-pad"><ThemeToggle /></div>
            </Content>
        </AnchoredPopover>
    </header>

    <section class="claude-chat-scroll">
        <div class="chat-message-stack">
            @if (Session.Chat.Transcript.LastBackgroundError is not null)
            {
                <StatusRow Icon="warning" Tone="danger" Class="appearance-row chat-error-row">@Session.Chat.Transcript.LastBackgroundError.Message</StatusRow>
            }
            @for (var i = 0; i < Messages.Count; i++)
            {
                var message = Messages[i];
                var subsequentCount = Messages.Count - i - 1;
                <ChatMessage @key="message.Id"
                             Message="message"
                             Characters="Characters"
                             ShowAppearance="ShowAppearance"
                             ShowProcess="ShowProcess"
                             TranscriptBusy="TranscriptBusy"
                             SubsequentCount="subsequentCount" />
            }
        </div>
        <div class="claude-footer">
            <div class="claude-composer @(TranscriptBusy ? "is-locked" : "")">
                <textarea @bind="Draft" @bind:event="oninput" @onkeydown="HandleKeyDown" disabled="@TranscriptBusy" placeholder="Guide the next turn, or leave blank to let AI continue the scene…"></textarea>
                <div class="claude-composer-actions">
                    <AnchoredPopover Placement="OverlayPlacement.TopStart" Class="composer-popover">
                        <Trigger Context="speaker">
                            <AppButton Variant="secondary" Size="xs" Class="composer-action-button" Active="@speaker.IsOpen" Disabled="@TranscriptBusy" OnClick="@(_ => speaker.Toggle())">
                                @if (Session.SpeakingAs is null)
                                {
                                    <span class="mini-narrator"><FaIcon Name="book-open" /></span>
                                }
                                else
                                {
                                    <Avatar Name="@Session.SpeakingAs.Name" Size="14" />
                                }
                                <span>@SpeakerName</span>
                                <FaIcon Name="chevron-down" />
                            </AppButton>
                        </Trigger>
                        <Content>
                            <SelectableButton Class="select-row" Disabled="@TranscriptBusy" OnClick="@(_ => PickSpeaker(null))"><span class="mini-narrator large"><FaIcon Name="book-open" /></span><span>Narrator</span></SelectableButton>
                            @foreach (var character in Characters)
                            {
                                <SelectableButton @key="character.Id" Class="select-row" Disabled="@TranscriptBusy" OnClick="@(_ => PickSpeaker(character))"><Avatar Name="@character.Name" Size="20" /><span>@character.Name</span></SelectableButton>
                            }
                        </Content>
                    </AnchoredPopover>

                    <div class="toolbar-spacer"></div>

                    <AnchoredPopover Placement="OverlayPlacement.TopEnd" Class="composer-popover">
                        <Trigger Context="respond">
                            <AppButton Size="xs" Class="composer-action-button" Active="@respond.IsOpen" Disabled="@TranscriptBusy" OnClick="@(_ => respond.Toggle())">
                                <FaIcon Name="user" /> Respond As <FaIcon Name="chevron-down" />
                            </AppButton>
                        </Trigger>
                        <Content>
                            <div class="popover-label">Respond As</div>
                            @if (CanAutoSelectResponder)
                            {
                                <SelectableButton Class="@($"select-row {(RespondAs is null ? "is-active" : "")}")" Disabled="@TranscriptBusy" OnClick="@(_ => PickRespondAs(null))"><span class="mini-narrator large"><FaIcon Name="book-open" /></span><span>Auto-select</span>@if (RespondAs is null) { <FaIcon Name="check" /> }</SelectableButton>
                            }
                            @foreach (var character in Characters)
                            {
                                <SelectableButton @key="character.Id" Class="@($"select-row {(RespondAs?.Id == character.Id ? "is-active" : "")}")" Disabled="@TranscriptBusy" OnClick="@(_ => PickRespondAs(character))"><Avatar Name="@character.Name" Size="20" /><span>@character.Name</span>@if (RespondAs?.Id == character.Id) { <FaIcon Name="check" /> }</SelectableButton>
                            }
                        </Content>
                    </AnchoredPopover>

                    <span class="v-divider"></span>

                    <div class="send-combo">
                        <SelectableButton Class="send-mode" Title="@ModeTitle" Disabled="@(!CanGenerate)" OnClick="@(_ => GenerateTurn())">
                            <FaIcon Name="@ModeIcon" /> @ModeLabel
                        </SelectableButton>
                        <AnchoredPopover Placement="OverlayPlacement.TopEnd" Class="composer-popover">
                            <Trigger Context="shape">
                                <SelectableButton Class="send-shape" Title="Select Turn Shape" Active="@shape.IsOpen" Disabled="@TranscriptBusy" OnClick="@(_ => shape.Toggle())">
                                    <FaIcon Name="chevron-down" />
                                </SelectableButton>
                            </Trigger>
                            <Content>
                                <div class="popover-label">Turn Shape</div>
                                @foreach (var shape in TurnShapes)
                                {
                                    <SelectableButton @key="shape" Class="@($"select-row {(TurnShape == shape ? "is-active" : "")}")" Disabled="@TranscriptBusy" OnClick="@(_ => PickShape(shape))"><span>@shape</span>@if (TurnShape == shape) { <FaIcon Name="check" /> }</SelectableButton>
                                }
                            </Content>
                        </AnchoredPopover>
                    </div>

                    <span class="v-divider"></span>

                    <AppButton Variant="secondary" Size="xs" Class="composer-action-button" Disabled="@(TranscriptBusy || Draft.Trim().Length == 0)" Title="Post the text directly as a manual turn" OnClick="@PostManual">
                        <FaIcon Name="book-open" /> Manual
                    </AppButton>
                    <AppButton Variant="primary" Size="xs" Class="composer-action-button" Disabled="@(!CanGenerate)" Title="@GenerateTitle" OnClick="@GenerateTurn">
                        <FaIcon Name="sparkle" /> Generate
                    </AppButton>
                    @if (TranscriptBusy)
                    {
                        <span class="composer-busy-status"><span class="spinner" aria-hidden="true"></span>@TranscriptBusyMessage</span>
                    }
                    <span class="shortcut">Ctrl+↵</span>
                </div>
            </div>
        </div>
    </section>
</main>

@code {
    bool ShowProcess = true;
    bool ShowAppearance = true;
    string Draft = "";
    string TurnShape = "Brief";
    RpCharacter? RespondAs;
    readonly string[] TurnShapes = ["Compact", "Brief", "Extended", "Monologue", "Silent", "Silent Extended"];

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;

    RpChat Chat => Session.Chats.Active ?? new() { Title = "Loading", Location = "" };
    List<RpTranscriptTurn> Messages => Session.Chat.Transcript.Items;
    List<RpCharacter> Characters => Session.Chat.Characters.Items;

    bool IsGuided => Draft.Trim().Length > 0;
    string SpeakerName => Session.SpeakingAs?.Name ?? "Narrator";
    string ModeLabel => IsGuided ? "Guided" : "Auto";
    string ModeIcon => IsGuided ? "layers" : "zap";
    string ModeTitle => CanGenerate ? IsGuided ? "Generate guided turn (Ctrl+Enter)" : "Auto-continue scene (Ctrl+Enter)" : GenerateTitle;
    string GenerateTitle => TranscriptBusy ? TranscriptBusyMessage : RequiresRespondAs ? "Choose Respond As to generate with this model" : "Generate next turn (Ctrl+Enter)";
    bool CanAutoSelectResponder => ActiveTextModel?.Capabilities.CanGenerateStructuredText != false;
    bool RequiresRespondAs => !CanAutoSelectResponder && RespondAs is null;
    bool TranscriptBusy => Session.Chat.Transcript.IsBusy;
    string TranscriptBusyMessage => string.IsNullOrWhiteSpace(Session.Chat.Transcript.BusyMessage) ? "Working..." : Session.Chat.Transcript.BusyMessage;
    bool CanGenerate => !TranscriptBusy && !RequiresRespondAs;
    ActiveTextModel? ActiveTextModel => ResolveActiveTextModel();

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.Chats.Changed += OnSessionChanged;
        Session.Chat.Transcript.Changed += OnSessionChanged;
        Session.Chat.Characters.Changed += OnSessionChanged;
        Session.Chat.Locations.Changed += OnSessionChanged;
    }

    Task OnSessionChanged() => InvokeAsync(StateHasChanged);

    async Task PickSpeaker(RpCharacter? character)
    {
        await Session.SetSpeakingAsAsync(character);
    }

    void PickRespondAs(RpCharacter? character)
    {
        RespondAs = character;
    }

    void PickShape(string shape)
    {
        TurnShape = shape;
    }

    async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (!TranscriptBusy && args.Key == "Enter" && args.CtrlKey)
            await GenerateTurn();
    }

    async Task GenerateTurn()
    {
        if (!CanGenerate)
            return;

        var text = Draft.Trim();
        Draft = "";
        await Session.Chat.Transcript.GenerateAsync(text, RespondAs, IsGuided ? "guided" : "automatic", TurnShape);
    }

    async Task PostManual()
    {
        if (TranscriptBusy)
            return;

        var text = Draft.Trim();
        if (text.Length == 0)
            return;

        Draft = "";
        await Session.Chat.Transcript.PostManualAsync(text, Session.SpeakingAs);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.Chats.Changed -= OnSessionChanged;
        Session.Chat.Transcript.Changed -= OnSessionChanged;
        Session.Chat.Characters.Changed -= OnSessionChanged;
        Session.Chat.Locations.Changed -= OnSessionChanged;
    }

    ActiveTextModel? ResolveActiveTextModel()
    {
        foreach (var provider in Session.Providers.Items)
            CapabilityCatalog.ApplyResolvedCapabilities(provider);

        return TextModelTuningCatalog.TryResolveActiveTextModel(Session.Providers.Items);
    }
}
