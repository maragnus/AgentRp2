@using AgentRp.Models
@using AgentRp.Services

<ModalShell Title="Snapshot Draft" Icon="flag" MaxWidth="900px" BodyClass="is-flush" CloseDisabled="@CloseDisabled" OnClose="RequestClose">
    @if (IsLoading || Draft is null)
    {
        <ModalStackLayout BodyClass="modal-form-stack snapshot-loading-pane">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="modal-error">@ErrorMessage</div>
                }
                @if (IsLoading)
                {
                    <LoadingState Title="Your snapshot is generating"
                                  Message="AgentRp is summarizing the new transcript range, preserving private intents and scene continuity blocks, drafting timeline items, and checking relationship canon for review before anything is saved."
                                  Class="snapshot-generation-state">
                        <div class="loading-state-stat-grid">
                            <Badge Tone="blue">@CoveredTurnPreview</Badge>
                            <Badge Tone="violet">Continuity preserved</Badge>
                            <Badge Tone="amber">Timeline draft</Badge>
                            <Badge Tone="blue">Relationships evolved</Badge>
                        </div>
                        <p class="loading-state-note">@SnapshotBenefitText</p>
                    </LoadingState>
                }
                else
                {
                    <div class="providers-empty-state is-compact">
                        <FaIcon Name="flag" />
                        <strong>No snapshot draft</strong>
                        <span>Choose a transcript turn to create one.</span>
                    </div>
                }
            </ChildContent>
            <Footer>
                <span class="modal-action-spacer"></span>
                <AppButton Variant="secondary" Disabled="@CloseDisabled" OnClick="@(_ => Close())">Discard</AppButton>
            </Footer>
        </ModalStackLayout>
    }
    else
    {
        <StatefulForm Model="@Editor"
                      Baseline="@Baseline"
                      CanSave="@(() => CanSave)"
                      OnSave="Save"
                      OnClose="Close"
                      ContextChanged="SetSnapshotForm">
            <ChildContent Context="form">
        <ModalTabGroup ActiveId="@ActiveTab" ActiveIdChanged="SetActiveTab" Height="600px" RailWidth="164px" Class="snapshot-draft-tabs">
            <ChildContent>
                <ModalTab Id="summary" Title="Summary" Summary="Required" DirtyPath="@nameof(Editor.Summary)">
                    <LeadingContent><FaIcon Name="align-left" /></LeadingContent>
                </ModalTab>
                <ModalTab Id="timeline" Title="Timeline" Summary="@TimelineSummary" DirtyPath="@nameof(Editor.TimelineEntries)">
                    <LeadingContent><FaIcon Name="clock" /></LeadingContent>
                    <TrailingContent><Badge Tone="amber">@Editor.TimelineEntries.Count</Badge></TrailingContent>
                </ModalTab>
                <ModalTab Id="continuity" Title="Continuity" Summary="@ContinuitySummary">
                    <LeadingContent><FaIcon Name="eye" /></LeadingContent>
                    <TrailingContent><Badge Tone="violet">@ContinuityCount</Badge></TrailingContent>
                </ModalTab>
                <ModalTab Id="relationships" Title="Relationships" Summary="@RelationshipSummary" DirtyPath="@nameof(Editor.RelationshipUpdates)">
                    <LeadingContent><FaIcon Name="users" /></LeadingContent>
                    <TrailingContent><Badge Tone="blue">@RelationshipUpdates.Count</Badge></TrailingContent>
                </ModalTab>
                <ModalTab Id="turns" Title="Covered Turns" Summary="@CoveredTurnsSummary">
                    <LeadingContent><FaIcon Name="message-sq" /></LeadingContent>
                    <TrailingContent><Badge Tone="blue">@Draft.IncludedTurns.Count</Badge></TrailingContent>
                </ModalTab>
                @if (Draft.Trace is not null && CanInspectProcess)
                {
                    <ModalTab Id="process" Title="Process" Summary="@ProcessSummary">
                        <LeadingContent><FaIcon Name="zap" /></LeadingContent>
                    </ModalTab>
                }
            </ChildContent>
            <RailFooter>
                <div class="prompt-rail-note">
                    <p>Saving collapses the covered turns into one snapshot row.</p>
                </div>
            </RailFooter>
            <MainContent>
                <ModalStackLayout Class="modal-editor-main snapshot-draft-main" BodyClass="modal-form-stack snapshot-tab-body">
                    <Header>
                        <ModalPaneToolbar Class="tuning-toolbar">
                            <strong>@ActiveTabTitle</strong>
                            <span class="toolbar-spacer"></span>
                            @if (ActiveTab == "summary")
                            {
                                <Badge Tone="amber">Required</Badge>
                            }
                            else if (ActiveTab == "timeline")
                            {
                                <Badge Tone="amber">@TimelineSummary</Badge>
                                <AppButton Icon="plus" TooltipText="Add timeline item" OnClick="@(_ => AddTimelineEntry())" />
                            }
                            else if (ActiveTab == "continuity")
                            {
                                <Badge Tone="violet">@ContinuitySummary</Badge>
                            }
                            else if (ActiveTab == "relationships")
                            {
                                <Badge Tone="blue">@RelationshipSummary</Badge>
                            }
                            else if (ActiveTab == "process" && Draft.Trace is not null && CanInspectProcess)
                            {
                                <Badge Tone="blue">@ProcessSummary</Badge>
                            }
                            else
                            {
                                <Badge Tone="blue">@CoveredTurnsSummary</Badge>
                            }
                        </ModalPaneToolbar>
                    </Header>
                    <ChildContent>
                        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                        {
                            <div class="modal-error">@ErrorMessage</div>
                        }
                        @if (ActiveTab == "summary")
                        {
                            <SnapshotSummaryEditor Draft="@Draft" Summary="@Editor.Summary" SummaryChanged="SetSummary" />
                        }
                        else if (ActiveTab == "timeline")
                        {
                            <SnapshotTimelineEditor Entries="@Editor.TimelineEntries" OnChanged="Refresh" />
                        }
                        else if (ActiveTab == "continuity")
                        {
                            <SnapshotContinuityReview Draft="@Draft" Characters="@Session.Chat.Characters.Items" />
                        }
                        else if (ActiveTab == "relationships")
                        {
                            <SnapshotRelationshipsEditor Updates="Editor.RelationshipUpdates"
                                                         Characters="Session.Chat.Characters.Items"
                                                         Library="Session.Chat.CharacterTraitLibrary.State"
                                                         OnChanged="Refresh" />
                        }
                        else if (ActiveTab == "process" && Draft.Trace is not null && CanInspectProcess)
                        {
                            <ProcessTrace Trace="Draft.Trace" AutoExpand="true" />
                        }
                        else
                        {
                            <SnapshotCoveredTurns Turns="@Draft.IncludedTurns" />
                        }
                    </ChildContent>
                    <Footer>
                        <span class="modal-action-spacer"></span>
                        <span class="modal-action-group">
                            <AppButton Variant="secondary" Disabled="@CloseDisabled" OnClick="@(_ => form.RequestCloseAsync())">Discard</AppButton>
                            <BusyButton Variant="primary" Disabled="@(!CanSave)" OnClick="Save">Save Snapshot</BusyButton>
                        </span>
                    </Footer>
                </ModalStackLayout>
            </MainContent>
        </ModalTabGroup>
            </ChildContent>
        </StatefulForm>
    }
</ModalShell>

@code {
    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public RpTranscriptSnapshotDraft? Draft { get; set; }
    [Parameter] public RpTranscriptSnapshotDraftPreview? Preview { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public bool CloseDisabled { get; set; }
    [Parameter] public string ErrorMessage { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RpTranscriptSnapshotDraft> OnSave { get; set; }

    RpTranscriptSnapshotDraft? LoadedDraft;
    SnapshotDraftEditorState Editor = new();
    SnapshotDraftEditorState Baseline = new();
    StatefulFormContext<SnapshotDraftEditorState>? SnapshotForm;
    string ActiveTab = "summary";

    bool CanSave => !IsLoading && !IsSaving && Draft is not null && !string.IsNullOrWhiteSpace(Editor.Summary);
    int ContinuityCount => Draft is null ? 0 : Draft.PrivateIntentByCharacterId.Keys.Concat(Draft.CharacterAppearances.Keys).Distinct(StringComparer.Ordinal).Count();
    List<RpTranscriptSnapshotRelationshipUpdate> RelationshipUpdates => Editor.RelationshipUpdates;
    string TimelineSummary => $"{Editor.TimelineEntries.Count} item{(Editor.TimelineEntries.Count == 1 ? "" : "s")}";
    string ContinuitySummary => $"{ContinuityCount} character{(ContinuityCount == 1 ? "" : "s")}";
    string RelationshipSummary => RelationshipUpdates.Count == 0
        ? "No changes"
        : $"{RelationshipUpdates.Count(update => update.ApplyChange)} of {RelationshipUpdates.Count} applied";
    string CoveredTurnsSummary => Draft is null ? "0 turns" : $"{Draft.IncludedTurns.Count} turn{(Draft.IncludedTurns.Count == 1 ? "" : "s")}";
    string ProcessSummary => Draft?.Trace is null ? "No trace" : $"{Draft.Trace.Steps.Count} step{(Draft.Trace.Steps.Count == 1 ? "" : "s")}";
    bool CanInspectProcess => Session.CurrentUser.CanInspectGenerationProcess;
    string CoveredTurnPreview => Preview is null || Preview.CoveredTurnCount == 0
        ? "Transcript range"
        : $"{Preview.CoveredTurnCount} turn{(Preview.CoveredTurnCount == 1 ? "" : "s")} compacted";
    string SnapshotBenefitText => Preview is null || Preview.CoveredTurnCount == 0
        ? "A snapshot lets later generations use a compact continuity record instead of rereading the full covered transcript."
        : $"This will collapse the range from {FormatPreviewEndpoint(Preview.FirstSpeakerName, Preview.FirstTurnNumber)} through {FormatPreviewEndpoint(Preview.LastSpeakerName, Preview.LastTurnNumber)} into one reviewable snapshot row.";
    string ActiveTabTitle => ActiveTab switch
    {
        "timeline" => "Timeline Items",
        "continuity" => "Continuity",
        "relationships" => "Relationships",
        "turns" => "Covered Turns",
        "process" => "Process",
        _ => "Summary"
    };

    protected override void OnParametersSet()
    {
        if (Draft is null)
        {
            LoadedDraft = null;
            Editor = new();
            Baseline = new();
            return;
        }

        if (ReferenceEquals(LoadedDraft, Draft))
            return;

        LoadedDraft = Draft;
        ActiveTab = "summary";
        Editor = SnapshotDraftEditorState.From(Draft);
        Baseline = SnapshotDraftEditorState.From(Draft);
    }

    void SetSnapshotForm(StatefulFormContext<SnapshotDraftEditorState> form) => SnapshotForm = form;

    Task RequestClose() => SnapshotForm?.RequestCloseAsync() ?? Close();

    async Task Close()
    {
        if (CloseDisabled)
            return;

        await OnClose.InvokeAsync();
    }

    async Task Save()
    {
        if (!CanSave || Draft is null)
            return;

        var saved = new RpTranscriptSnapshotDraft
        {
            TurnId = Draft.TurnId,
            CreatedUtc = Draft.CreatedUtc,
            Summary = Editor.Summary,
            CoveredTurnIds = [.. Draft.CoveredTurnIds],
            IncludedTurns = [.. Draft.IncludedTurns],
            PrivateIntentByCharacterId = Draft.PrivateIntentByCharacterId.ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal),
            CharacterAppearances = Draft.CharacterAppearances.ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal),
            TimelineEntries = Editor.TimelineEntries.Select(entry => entry.ToModel()).ToList(),
            RelationshipUpdates = Editor.RelationshipUpdates.Select(SnapshotDraftEditorState.CloneRelationshipUpdate).ToList(),
            Scene = SessionCloner.Clone(Draft.Scene),
            Trace = Draft.Trace is null ? null : SessionCloner.Clone(Draft.Trace)
        };
        await OnSave.InvokeAsync(saved);
    }

    Task SetActiveTab(string? id)
    {
        ActiveTab = string.IsNullOrWhiteSpace(id) ? ActiveTab : id;
        return Task.CompletedTask;
    }

    Task SetSummary(string value)
    {
        Editor.Summary = value;
        SnapshotForm?.NotifyChanged();
        return Task.CompletedTask;
    }

    Task Refresh()
    {
        SnapshotForm?.NotifyChanged();
        return InvokeAsync(StateHasChanged);
    }

    void AddTimelineEntry()
    {
        Editor.TimelineEntries.Add(new());
        SnapshotForm?.NotifyChanged();
    }

    static string FormatPreviewEndpoint(string speakerName, int turnNumber) =>
        $"{speakerName} ({TranscriptTurnNumbering.Format(turnNumber)})";

}
