@if (Updates.Count == 0)
{
    <div class="providers-empty-state is-compact">
        <FaIcon Name="users" />
        <strong>No relationship updates</strong>
        <span>This draft did not find relationship canon changes to review.</span>
    </div>
}
else
{
    <div class="snapshot-relationship-list">
        @foreach (var update in Updates)
        {
            var sourceName = CharacterName(update.SourceCharacterId);
            var targetName = CharacterName(update.TargetCharacterId);
            <article @key="update.RelationshipId" class="snapshot-relationship-update @(update.ApplyChange ? "is-applied" : "is-skipped") @(UpdateDirty(update) ? "is-dirty" : "")">
                <header class="snapshot-relationship-update-head">
                    <label class="snapshot-relationship-apply">
                        <ToggleSwitch Value="@update.ApplyChange"
                                      ValueChanged="value => SetApply(update, value)"
                                      Dirty="@ApplyDirty(update)"
                                      TooltipText="Toggle relationship update" />
                        <span>Apply</span>
                    </label>
                    <div class="snapshot-relationship-title">
                        <strong>@sourceName / @targetName</strong>
                        @if (!string.IsNullOrWhiteSpace(update.Reason))
                        {
                            <small>@update.Reason</small>
                        }
                    </div>
                    @if (update.EvidenceTurnNumbers.Count > 0)
                    {
                        <Badge Tone="blue">@EvidenceText(update)</Badge>
                    }
                    @if (!update.ApplyChange)
                    {
                        <Badge Tone="amber">Skipped</Badge>
                    }
                </header>
                <CharacterRelationshipFieldsEditor SourceName="@sourceName"
                                                   TargetName="@targetName"
                                                   RelationshipTypes="update.RelationshipTypes"
                                                   PrivateTensions="update.PrivateTensions"
                                                   BondTypes="Library.BondTypes"
                                                   Dynamics="Library.Dynamics"
                                                   HowSourceSeesTarget="@update.HowSourceSeesTarget"
                                                   HowSourceSeesTargetChanged="value => update.HowSourceSeesTarget = value"
                                                   HowTargetSeesSource="@update.HowTargetSeesSource"
                                                   HowTargetSeesSourceChanged="value => update.HowTargetSeesSource = value"
                                                   PublicDynamic="@update.PublicDynamic"
                                                   PublicDynamicChanged="value => update.PublicDynamic = value"
                                                   RelationshipTypesDirty="@RelationshipTypesDirty(update)"
                                                   PrivateTensionsDirty="@PrivateTensionsDirty(update)"
                                                   HowSourceSeesTargetDirty="@HowSourceSeesTargetDirty(update)"
                                                   HowTargetSeesSourceDirty="@HowTargetSeesSourceDirty(update)"
                                                   PublicDynamicDirty="@PublicDynamicDirty(update)"
                                                   OnChanged="OnChanged"
                                                   Class="snapshot-relationship-fields" />
            </article>
        }
    </div>
}

@code {
    [Parameter] public List<RpTranscriptSnapshotRelationshipUpdate> Updates { get; set; } = [];
    [Parameter] public IReadOnlyList<RpTranscriptSnapshotRelationshipUpdate> BaselineUpdates { get; set; } = [];
    [Parameter] public List<RpCharacter> Characters { get; set; } = [];
    [Parameter] public CharacterTraitLibraryState Library { get; set; } = CharacterTraitLibraryState.CreateDefault();
    [Parameter] public EventCallback OnChanged { get; set; }

    async Task SetApply(RpTranscriptSnapshotRelationshipUpdate update, bool value)
    {
        update.ApplyChange = value;
        await OnChanged.InvokeAsync();
    }

    string CharacterName(string characterId) =>
        Characters.FirstOrDefault(character => character.Id == characterId)?.Name ?? characterId;

    static string EvidenceText(RpTranscriptSnapshotRelationshipUpdate update) =>
        update.EvidenceTurnNumbers.Count == 1
            ? $"Turn {update.EvidenceTurnNumbers[0]}"
            : $"Turns {string.Join(", ", update.EvidenceTurnNumbers)}";

    RpTranscriptSnapshotRelationshipUpdate? BaselineFor(RpTranscriptSnapshotRelationshipUpdate update) =>
        BaselineUpdates.FirstOrDefault(item => string.Equals(item.RelationshipId, update.RelationshipId, StringComparison.Ordinal));

    bool UpdateDirty(RpTranscriptSnapshotRelationshipUpdate update) =>
        StatefulFormCollectionDirty.ItemDirty(Updates, BaselineUpdates, update.RelationshipId, item => item.RelationshipId);

    bool ApplyDirty(RpTranscriptSnapshotRelationshipUpdate update) =>
        BaselineFor(update) is not { } baseline || update.ApplyChange != baseline.ApplyChange;

    bool RelationshipTypesDirty(RpTranscriptSnapshotRelationshipUpdate update) =>
        BaselineFor(update) is not { } baseline || StatefulFormCollectionDirty.ValueDirty(update.RelationshipTypes, baseline.RelationshipTypes);

    bool PrivateTensionsDirty(RpTranscriptSnapshotRelationshipUpdate update) =>
        BaselineFor(update) is not { } baseline || StatefulFormCollectionDirty.ValueDirty(update.PrivateTensions, baseline.PrivateTensions);

    bool HowSourceSeesTargetDirty(RpTranscriptSnapshotRelationshipUpdate update) =>
        BaselineFor(update) is not { } baseline || update.HowSourceSeesTarget != baseline.HowSourceSeesTarget;

    bool HowTargetSeesSourceDirty(RpTranscriptSnapshotRelationshipUpdate update) =>
        BaselineFor(update) is not { } baseline || update.HowTargetSeesSource != baseline.HowTargetSeesSource;

    bool PublicDynamicDirty(RpTranscriptSnapshotRelationshipUpdate update) =>
        BaselineFor(update) is not { } baseline || update.PublicDynamic != baseline.PublicDynamic;
}
