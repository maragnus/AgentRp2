@inject NavigationManager Navigation

<SidebarActivePicker Label="Stories"
                     Title="@ActiveStoryTitle"
                     Subtitle="@ActiveStorySubtitle"
                     Tooltip="Switch current story"
                     PopoverClass="sidebar-picker-popover sidebar-story-popover"
                     DebugName="Sidebar active story picker"
                     ErrorMessage="@ErrorMessage"
                     Empty="false">
    <LeadingContent>
        <StoryPreviewAvatarStack Characters="@(ActiveStory?.SceneCharacters ?? [])"
                                 Max="1"
                                 Class="sidebar-story-trigger-avatars"
                                 AvatarClass="sidebar-chat-avatar"
                                 EmptyClass="sidebar-row-icon"
                                 EmptyIcon="book-open" />
    </LeadingContent>
    <EmptyContent>No stories are available.</EmptyContent>
    <ChildContent Context="picker">
        <PickerOptionButton Class="sidebar-story-new-option"
                            Title="New Story"
                            TooltipText="New Story"
                            AriaLabel="New Story"
                            OnClick="@(() => OpenNewStory(picker))">
            <LeadingContent>
                <span class="sidebar-row-icon"><FaIcon Name="plus" /></span>
            </LeadingContent>
        </PickerOptionButton>
        <div class="divider"></div>
        @if (Stories.Count == 0)
        {
            <div class="sidebar-picker-empty">No stories are available.</div>
        }
        else
        {
            @foreach (var story in Stories)
            {
                <SidebarStoryRow @key="story.ChatId"
                                 Story="story"
                                 Active="@(ActiveStory?.ChatId == story.ChatId)"
                                 OnClick="@(() => SelectStory(picker, story))" />
            }
        }
    </ChildContent>
</SidebarActivePicker>

@code {
    string? ErrorMessage;

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnNewStory { get; set; }

    IReadOnlyList<StoryPreview> Stories => Session.Chats.Items;
    StoryPreview? ActiveStory => Session.Chats.Active;
    string ActiveStoryTitle => ActiveStory?.Title ?? (Stories.Count == 0 ? "Add Story" : "Choose Story");
    string ActiveStorySubtitle => ActiveStory is null
        ? (Stories.Count == 0 ? "No stories yet" : "No story loaded")
        : string.Join(" / ", new[] { ActiveStory.ActiveLocation?.Name, ActiveStory.Updated }.Where(value => !string.IsNullOrWhiteSpace(value)));

    async Task OpenNewStory(AnchoredPopoverContext picker)
    {
        ErrorMessage = null;
        await picker.Close();
        await OnNewStory.InvokeAsync();
    }

    async Task SelectStory(AnchoredPopoverContext picker, StoryPreview story)
    {
        ErrorMessage = null;
        Navigation.NavigateTo(ChatUrl(story.ChatId));
        await picker.Close();
    }

    static string ChatUrl(string chatId) => $"/{Uri.EscapeDataString(chatId)}";
}
