@implements IDisposable
@inject ILogger<ActiveLocationPicker> Logger

<SidebarActivePicker Label="Locations"
                     Title="@ActiveLocationName"
                     Tooltip="Switch current location"
                     PopoverClass="sidebar-picker-popover sidebar-location-popover"
                     DebugName="Sidebar active location picker"
                     ErrorMessage="@ErrorMessage"
                     Empty="@(Locations.Count == 0)">
    <LeadingContent>
        @if (ActiveLocation is null)
        {
            <span class="sidebar-row-icon"><FaIcon Name="map-pin" /></span>
        }
        else
        {
            <EntityImage Name="@ActiveLocation.Name" Image="@ImageFor(ActiveLocation.ImageId)" EntityType="location" EntityId="@ActiveLocation.Id" Size="24" />
        }
    </LeadingContent>
    <EmptyContent>No locations are available.</EmptyContent>
    <ChildContent Context="picker">
        @foreach (var location in Locations)
        {
            var selected = location.IsActive;
            <PickerOptionButton @key="location.Id"
                                Title="@location.Name"
                                Subtitle="@location.Summary"
                                Selected="@selected"
                                Disabled="@selected"
                                TooltipText="@($"Use {location.Name}")"
                                AriaLabel="@($"Use {location.Name}")"
                                OnClick="@(() => SelectLocation(picker, location))">
                <LeadingContent>
                    <EntityImage Name="@location.Name" Image="@ImageFor(location.ImageId)" EntityType="location" EntityId="@location.Id" Size="24" />
                </LeadingContent>
            </PickerOptionButton>
        }
    </ChildContent>
</SidebarActivePicker>

@code {
    string? ErrorMessage;

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;

    IReadOnlyList<RpLocation> Locations => Session.Chat.Locations.Items;
    IReadOnlyList<GalleryImage> Images => Session.ImageLibrary.Items;
    RpLocation? ActiveLocation => Session.Chat.Locations.Active ?? Locations.FirstOrDefault();
    string ActiveLocationName => ActiveLocation?.Name ?? "No location";

    GalleryImage? ImageFor(string imageId) => Images.FirstOrDefault(image => image.Id == imageId);

    protected override void OnInitialized()
    {
        Session.Chat.Locations.Changed += OnStoreChanged;
        Session.ImageLibrary.Changed += OnStoreChanged;
    }

    Task OnStoreChanged()
    {
        ErrorMessage = null;
        return InvokeAsync(StateHasChanged);
    }

    async Task SelectLocation(AnchoredPopoverContext picker, RpLocation location)
    {
        ErrorMessage = null;
        try
        {
            await Session.Chat.Locations.SetActiveAsync(location.Id);
            await picker.Close();
        }
        catch (Exception exception)
        {
            ErrorMessage = UserFacingErrorReporter.Capture(
                Logger,
                exception,
                $"Selecting {location.Name} as the current location failed.",
                "Selecting location {LocationId} as current failed.",
                location.Id);
        }
    }

    public void Dispose()
    {
        Session.Chat.Locations.Changed -= OnStoreChanged;
        Session.ImageLibrary.Changed -= OnStoreChanged;
    }
}
