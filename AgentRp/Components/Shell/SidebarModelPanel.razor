<div class="sidebar-model-panel">
    @foreach (var role in Roles)
    {
        <ActiveModelPicker @key="role" Role="@role" DebugName="@($"Sidebar model picker {role}")" OnOpenProviders="OnOpenProviders">
            <TriggerContent Context="picker">
                <SidebarRow Title="@RoleLabel(role)"
                            Subtitle="@ModelSummary(picker.ActiveModel, role)"
                            Tooltip="@($"Switch active {RoleLabel(role).ToLowerInvariant()} model")"
                            Open="@picker.IsOpen"
                            OnClick="@(_ => picker.Toggle())">
                    <LeadingContent>
                        @if (picker.ActiveModel is null)
                        {
                            <span class="sidebar-row-icon"><FaIcon Name="@RoleIcon(role)" /></span>
                        }
                        else
                        {
                            <ProviderBadge Type="@picker.ActiveModel.Provider.Type" Size="28" />
                        }
                    </LeadingContent>
                    <TrailingContent>
                        <FaIcon Name="@(picker.IsOpen ? "chevron-up" : "chevron-down")" />
                    </TrailingContent>
                </SidebarRow>
            </TriggerContent>
        </ActiveModelPicker>
    }

    @if (ActiveChatModel is not null && ActiveChatModel.Provider.Type == "huggingface")
    {
        <div class="sidebar-provider-widget">
            <HuggingFaceEndpointWidget Provider="@ActiveChatModel.Provider" Model="@ActiveChatModel.Model" ShowModelName="false" />
        </div>
    }
</div>

@code {
    static readonly AiModelRole[] Roles = [AiModelRole.Chat, AiModelRole.Image, AiModelRole.Voice];

    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback OnOpenProviders { get; set; }

    ActiveModelSelection? ActiveChatModel => Session.Chat.ModelSelection.Resolve(AiModelRole.Chat);

    static string RoleLabel(AiModelRole role) => AiProviderModelSelectionRules.Label(role);

    static string RoleIcon(AiModelRole role) => role switch
    {
        AiModelRole.Chat => "message-sq",
        AiModelRole.Image => "image",
        AiModelRole.Voice => "waveform-lines",
        _ => "circle-question"
    };

    static string ModelSummary(ActiveModelSelection? selection, AiModelRole role) =>
        selection is null ? $"No {RoleLabel(role).ToLowerInvariant()} model selected" : DisplayName(selection.Model);

    static string DisplayName(AiProviderModel model) =>
        string.IsNullOrWhiteSpace(model.DisplayName) ? model.Id : model.DisplayName;
}
