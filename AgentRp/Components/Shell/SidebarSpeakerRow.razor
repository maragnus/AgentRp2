<SidebarRow Title="@Name" Active="@Active">
    <LeadingContent>
        <span class="avatar-wrap">
            @if (AvatarContent is not null)
            {
                @AvatarContent
            }
            else
            {
                <Avatar Name="@Name" Size="24" />
            }
            @if (InScene)
            {
                <span class="scene-dot"></span>
            }
        </span>
    </LeadingContent>
    <Actions>
        <IconButton Icon="message-sq" Title="@SpeakTitle" OnClick="@OnSpeak" />
        @Actions
    </Actions>
</SidebarRow>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool InScene { get; set; }
    [Parameter] public string SpeakTitle { get; set; } = "Speak as";
    [Parameter] public RenderFragment? AvatarContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnSpeak { get; set; }
}
