@implements IDisposable

<aside class="sidebar">
    <div class="sidebar-head">
        <div class="brand">
            <span class="brand-mark"><FaIcon Name="book-open" /></span>
            <span>AgentRp</span>
        </div>
        <div>
            <IconButton Icon="image" Title="Image gallery" OnClick="@(_ => OnOpenModal.InvokeAsync("gallery"))" />
            <IconButton Icon="feather" Title="Prompt library" OnClick="@(_ => OnOpenModal.InvokeAsync("promptLibrary"))" />
        </div>
    </div>

    <div class="sidebar-action-row">
        <AppButton Variant="primary" Size="md" Class="sidebar-new-chat" OnClick="@(_ => AddChat())">New Chat <FaIcon Name="plus" /></AppButton>
        <IconButton Icon="download" Title="Import" Class="sidebar-import-button" OnClick="@(_ => OnOpenModal.InvokeAsync("export"))" />
    </div>

    <div class="sidebar-scroll">
        <Section Title="AI Model" Compact="true">
            <RightContent>
                <IconButton Icon="wrench" Title="Model tuning" OnClick="@(_ => OnOpenModal.InvokeAsync("modelTuning"))" />
                <IconButton Icon="settings" Title="AI Providers" OnClick="@(_ => OnOpenModal.InvokeAsync("aiProviders"))" />
            </RightContent>
        </Section>
        <SidebarModelPanel OnOpenProviders="@(() => OnOpenModal.InvokeAsync("aiProviders"))" />

        <div class="divider"></div>

        <Section Title="Location" Compact="true">
            <RightContent>
            <IconButton Icon="edit" Title="Edit locations" OnClick="@(_ => OnOpenEntities.InvokeAsync(("locations", null)))" />
            </RightContent>
        </Section>
        <ActiveLocationPicker />

        <div class="divider"></div>

        <Section Title="Characters" Compact="true">
            <RightContent>
            <IconButton Icon="edit" Title="Edit characters" OnClick="@(_ => OnOpenEntities.InvokeAsync(("characters", null)))" />
            </RightContent>
        </Section>
        <SidebarSpeakerRow Name="Narrator" Active="@(Session.SpeakingAs is null)" SpeakTitle="Speak as Narrator" OnSpeak="@(_ => SetSpeakingAs(null))">
            <Actions>
                <IconButton Icon="edit" Title="Edit narrator" OnClick="@(_ => OnOpenEntities.InvokeAsync(("characters", "__narrator")))" />
            </Actions>
        </SidebarSpeakerRow>
        @foreach (var character in Characters)
        {
            <SidebarSpeakerRow @key="character.Id"
                               Name="@character.Name"
                               Active="@(Session.SpeakingAs?.Id == character.Id)"
                               InScene="@character.InScene"
                               OnSpeak="@(_ => SetSpeakingAs(character))">
                <Actions>
                <IconButton Icon="eye" Title="Toggle in scene" Active="@character.InScene" OnClick="@(_ => Session.Chat.Characters.ToggleInSceneAsync(character.Id))" />
                <IconButton Icon="edit" Title="Edit character" OnClick="@(_ => OnOpenEntities.InvokeAsync(("characters", character.Id)))" />
                </Actions>
            </SidebarSpeakerRow>
        }

        <div class="divider"></div>

        <Section Title="Items" Compact="true">
            <RightContent>
            <IconButton Icon="edit" Title="Edit items" OnClick="@(_ => OnOpenEntities.InvokeAsync(("items", null)))" />
            </RightContent>
        </Section>
        @foreach (var item in Items)
        {
            <div @key="item.Id" class="row" @onclick="@(() => OnOpenEntities.InvokeAsync(("items", item.Id)))">
                <FaIcon Name="box" />
                <span class="row-title">@item.Name</span>
            </div>
        }

        <div class="divider"></div>

        <Section Title="Chats" Compact="true">
            <RightContent><span class="section-header-note">Starred first</span></RightContent>
        </Section>
        @foreach (var chat in Chats)
        {
            <SidebarChatRow @key="chat.Id" Chat="chat" Active="@(ActiveChat?.Id == chat.Id)" OnClick="@(_ => Session.Chats.SelectAsync(chat.Id))" />
        }
    </div>
</aside>

@code {
    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback<string> OnOpenModal { get; set; }
    [Parameter] public EventCallback<(string Type, string? Id)> OnOpenEntities { get; set; }

    List<RpCharacter> Characters => Session.Chat.Characters.Items;
    List<RpLocation> Locations => Session.Chat.Locations.Items;
    List<RpItem> Items => Session.Chat.Items.Items;
    IReadOnlyList<RpChat> Chats => Session.Chats.Items;
    RpChat? ActiveChat => Session.Chats.Active;
    RpLocation ActiveLocation => Locations.FirstOrDefault(location => location.IsActive) ?? Locations.FirstOrDefault() ?? new() { Name = "No location" };

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.Chats.Changed += OnSessionChanged;
        Session.Providers.Changed += OnSessionChanged;
        Session.Chat.Characters.Changed += OnSessionChanged;
        Session.Chat.Locations.Changed += OnSessionChanged;
        Session.Chat.Images.Changed += OnSessionChanged;
        Session.Chat.Items.Changed += OnSessionChanged;
    }

    Task OnSessionChanged() => InvokeAsync(StateHasChanged);

    Task SetSpeakingAs(RpCharacter? character) => Session.SetSpeakingAsAsync(character);

    async Task AddChat()
    {
        await Session.Chats.AddAsync(ActiveLocation.Name);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.Chats.Changed -= OnSessionChanged;
        Session.Providers.Changed -= OnSessionChanged;
        Session.Chat.Characters.Changed -= OnSessionChanged;
        Session.Chat.Locations.Changed -= OnSessionChanged;
        Session.Chat.Images.Changed -= OnSessionChanged;
        Session.Chat.Items.Changed -= OnSessionChanged;
    }
}
