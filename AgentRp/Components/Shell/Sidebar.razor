@implements IDisposable

<aside class="sidebar">
    <div class="sidebar-head">
        <div class="brand">
            <span class="brand-mark"><FaIcon Name="book-open" /></span>
            <span>AgentRp</span>
        </div>
    </div>

    <div class="sidebar-scroll">
        <Section Title="AI Model" Compact="true">
            <RightContent>
                @if (Session.CurrentUser.IsAdmin)
                {
                    <AppButton Icon="wrench" TooltipText="Model tuning" OnClick="@(_ => OnOpenModal.InvokeAsync("modelTuning"))" />
                    <AppButton Icon="settings" TooltipText="AI Providers" OnClick="@(_ => OnOpenModal.InvokeAsync("aiProviders"))" />
                }
            </RightContent>
        </Section>
        <SidebarModelPanel @key="@($"models:{ActiveStoryKey}")" OnOpenProviders="@(() => OnOpenModal.InvokeAsync("aiProviders"))" />

        <div class="divider"></div>

        <SidebarStudioSection OnOpenModal="OnOpenModal" />

        <div class="divider"></div>

        <Section Title="Story" Compact="true">
            <RightContent>
                @if (HasActiveStory)
                {
                    <AppButton Icon="book-open" TooltipText="Story direction" OnClick="@(_ => OnOpenModal.InvokeAsync("chatDirection"))" />
                    <AppButton Icon="download" TooltipText="Export story" OnClick="@(_ => OnOpenModal.InvokeAsync("export"))" />
                }
            </RightContent>
        </Section>
        <ActiveStoryPicker @key="@($"story:{ActiveStoryKey}")" OnNewStory="@(() => OnOpenModal.InvokeAsync("newStory"))" />

        @if (HasActiveStory)
        {
            <Section Title="Location" Compact="true">
                <RightContent>
                <AppButton Icon="edit" TooltipText="Edit locations" OnClick="@(_ => OnOpenEntities.InvokeAsync(("locations", null)))" />
                </RightContent>
            </Section>
            <ActiveLocationPicker @key="@($"location:{ActiveStoryKey}")" />

            <div class="divider"></div>

            <Section Title="Characters" Compact="true">
                <RightContent>
                <AppButton Icon="edit" TooltipText="Edit characters" OnClick="@(_ => OnOpenEntities.InvokeAsync(("characters", null)))" />
                </RightContent>
            </Section>
            <SidebarSpeakerRow Name="Narrator" Active="@(Session.SpeakingAs is null)" OnSelect="@(_ => SetSpeakingAs(null))">
                <Actions>
                    <AppButton Icon="edit" TooltipText="Edit narrator" OnClick="@(_ => OnOpenEntities.InvokeAsync(("characters", EntityIds.Narrator)))" />
                </Actions>
            </SidebarSpeakerRow>
            @foreach (var character in Characters)
            {
                <SidebarSpeakerRow @key="character.Id"
                                   Name="@character.Name"
                                   Active="@(Session.SpeakingAs?.Id == character.Id)"
                                   InScene="@character.InScene"
                                   OnSelect="@(_ => SetSpeakingAs(character))">
                    <AvatarContent>
                        <EntityImage EntityType="character" EntityId="@character.Id" Name="@character.Name" Image="@ImageFor(character.ImageId)" Size="24" />
                    </AvatarContent>
                    <Actions>
                    <AppButton Icon="eye" TooltipText="Toggle in scene" Active="@character.InScene" OnClick="@(_ => Session.Chat.Characters.ToggleInSceneAsync(character.Id))" />
                    <AppButton Icon="edit" TooltipText="Edit character" OnClick="@(_ => OnOpenEntities.InvokeAsync(("characters", character.Id)))" />
                    </Actions>
                </SidebarSpeakerRow>
            }

            <div class="divider"></div>

            <Section Title="Items" Compact="true">
                <RightContent>
                <AppButton Icon="edit" TooltipText="Edit items" OnClick="@(_ => OnOpenEntities.InvokeAsync(("items", null)))" />
                </RightContent>
            </Section>
            @foreach (var item in Items)
            {
                <div @key="item.Id" class="row" @onclick="@(() => OnOpenEntities.InvokeAsync(("items", item.Id)))">
                    <FaIcon Name="box" />
                    <span class="row-title">@item.Name</span>
                </div>
            }
        }
    </div>
</aside>

@code {
    [CascadingParameter] public RoleplaySession Session { get; set; } = default!;
    [Parameter] public EventCallback<string> OnOpenModal { get; set; }
    [Parameter] public EventCallback<(string Type, string? Id)> OnOpenEntities { get; set; }

    List<RpCharacter> Characters => Session.Chat.Characters.Items;
    List<RpItem> Items => Session.Chat.Items.Items;
    string ActiveStoryKey => Session.Chats.Active?.ChatId ?? "";
    bool HasActiveStory => Session.ActiveChat.Current is not null && Session.Chats.Active is not null;

    GalleryImage? ImageFor(string imageId) => Session.ImageLibrary.Items.FirstOrDefault(image => image.Id == imageId);

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.ActiveChat.Changed += OnActiveChatChanged;
        Session.Chats.Changed += OnSessionChanged;
        Session.Providers.Changed += OnSessionChanged;
        Session.Chat.Characters.Changed += OnSessionChanged;
        Session.Chat.Locations.Changed += OnSessionChanged;
        Session.ImageLibrary.Changed += OnSessionChanged;
        Session.Chat.Items.Changed += OnSessionChanged;
    }

    Task OnSessionChanged() => InvokeAsync(StateHasChanged);

    Task OnActiveChatChanged(ActiveChatChange change) =>
        change.Area is null ? InvokeAsync(StateHasChanged) : Task.CompletedTask;

    Task SetSpeakingAs(RpCharacter? character) => Session.SetSpeakingAsAsync(character);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.ActiveChat.Changed -= OnActiveChatChanged;
        Session.Chats.Changed -= OnSessionChanged;
        Session.Providers.Changed -= OnSessionChanged;
        Session.Chat.Characters.Changed -= OnSessionChanged;
        Session.Chat.Locations.Changed -= OnSessionChanged;
        Session.ImageLibrary.Changed -= OnSessionChanged;
        Session.Chat.Items.Changed -= OnSessionChanged;
    }
}
