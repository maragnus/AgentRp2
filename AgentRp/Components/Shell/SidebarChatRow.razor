<SelectableButton Class="@CssClass" TooltipText="@Title" OnClick="@OnClick">
    <span class="sidebar-chat-avatars" aria-label="@AvatarSummary">
        @foreach (var character in VisibleSceneCharacters)
        {
            <EntityImage @key="character.Id" Name="@character.Name" Image="@character.Image" Size="22" Class="sidebar-chat-avatar" />
        }
    </span>
    <span class="sidebar-chat-copy">
        <span class="sidebar-chat-title-line">
            @if (Chat.Starred)
            {
                <FaIcon Name="star" />
            }
            <span class="row-title">@Chat.Title</span>
        </span>
        <span class="sidebar-chat-date">@Chat.Updated</span>
    </span>
</SelectableButton>

@code {
    [Parameter] public RpChat Chat { get; set; } = new();
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    IEnumerable<RpChatSceneCharacter> VisibleSceneCharacters => Chat.SceneCharacters.Take(3);
    string CssClass => $"row sidebar-chat-row {(Active ? "is-active" : "")}".Trim();
    string Title => string.IsNullOrWhiteSpace(Chat.Updated) ? Chat.Title : $"{Chat.Title} · {Chat.Updated}";
    string AvatarSummary => Chat.SceneCharacters.Count == 0
        ? "No characters in scene"
        : $"In scene: {string.Join(", ", Chat.SceneCharacters.Take(3).Select(character => character.Name))}";
}
