<PickerOptionButton Class="sidebar-story-option"
                    Title="@Story.Title"
                    Subtitle="@Subtitle"
                    Selected="@Active"
                    Disabled="@Active"
                    TooltipText="@Title"
                    AriaLabel="@Title"
                    OnClick="@OnClick">
    <LeadingContent>
        <span class="sidebar-story-avatars" aria-label="@AvatarSummary">
            @foreach (var character in VisibleSceneCharacters)
            {
                <EntityImage @key="character.Id" Name="@character.Name" Image="@character.Image" EntityType="character" EntityId="@character.Id" ChatId="@Story.Id" Size="22" Class="sidebar-chat-avatar" />
            }
            @if (!VisibleSceneCharacters.Any())
            {
                <span class="sidebar-row-icon"><FaIcon Name="book-open" /></span>
            }
        </span>
    </LeadingContent>
    <TitleContent>
        <span class="sidebar-chat-title-line">
            @if (Story.Starred)
            {
                <FaIcon Name="star" />
            }
            <strong>@Story.Title</strong>
        </span>
    </TitleContent>
</PickerOptionButton>

@code {
    [Parameter] public RpChat Story { get; set; } = new();
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    IReadOnlyList<RpChatSceneCharacter> VisibleSceneCharacters => Story.SceneCharacters.Take(3).ToList();
    string Subtitle => string.Join(" · ", new[] { Story.Location, Story.Updated }.Where(value => !string.IsNullOrWhiteSpace(value)));
    string Title => string.IsNullOrWhiteSpace(Story.Updated) ? Story.Title : $"{Story.Title} · {Story.Updated}";
    string AvatarSummary => Story.SceneCharacters.Count == 0
        ? "No characters in scene"
        : $"In scene: {string.Join(", ", Story.SceneCharacters.Take(3).Select(character => character.Name))}";
}
