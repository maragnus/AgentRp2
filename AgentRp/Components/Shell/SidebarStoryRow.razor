<PickerOptionButton Class="sidebar-story-option"
                    Title="@Story.Title"
                    Subtitle="@Subtitle"
                    Selected="@Active"
                    Disabled="@Active"
                    TooltipText="@Title"
                    AriaLabel="@Title"
                    OnClick="@OnClick">
    <LeadingContent>
        <StoryPreviewAvatarStack Characters="Story.SceneCharacters"
                                 Class="sidebar-story-avatars"
                                 AvatarClass="sidebar-chat-avatar"
                                 EmptyClass="sidebar-row-icon"
                                 EmptyIcon="book-open" />
    </LeadingContent>
    <TitleContent>
        <span class="sidebar-chat-title-line">
            @if (Story.Starred)
            {
                <FaIcon Name="star" />
            }
            <strong>@Story.Title</strong>
        </span>
    </TitleContent>
</PickerOptionButton>

@code {
    [Parameter] public StoryPreview Story { get; set; } = new();
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    string Subtitle => string.Join(" / ", new[] { Story.ActiveLocation?.Name, Story.Updated }.Where(value => !string.IsNullOrWhiteSpace(value)));
    string Title => string.IsNullOrWhiteSpace(Story.Updated) ? Story.Title : $"{Story.Title} / {Story.Updated}";
}
