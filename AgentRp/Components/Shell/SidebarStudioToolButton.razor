<button type="button"
        class="sidebar-studio-tool"
        title="@TooltipText"
        aria-label="@Label"
        disabled="@Disabled"
        @onclick="OnClick">
    <span class="sidebar-studio-tool-icon"><FaIcon Name="@Icon" /></span>
</button>

@code {
    [Parameter] public string Icon { get; set; } = "circle";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? TooltipText { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
