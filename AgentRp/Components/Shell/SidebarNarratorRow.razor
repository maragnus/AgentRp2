<SelectableButton Class="@CssClass" OnClick="@OnClick">
    <span class="narrator-row-mark"><FaIcon Name="book-open" /></span>
    <span class="row-title narrator-row-title">Narrator</span>
    <FaIcon Name="message-sq" />
</SelectableButton>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    string CssClass => $"row {(Active ? "is-active" : "")}".Trim();
}
