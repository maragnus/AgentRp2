<SelectableButton Class="@CssClass"
                  Disabled="@Disabled"
                  TooltipText="@EffectiveTooltip"
                  OnClick="@OnClick">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <span class="decision-option-icon"><FaIcon Name="@Icon" /></span>
    }
    <span class="decision-option-main">
        <span class="decision-option-title">
            <strong>@Title</strong>
            @if (!string.IsNullOrWhiteSpace(BadgeText))
            {
                <Badge Tone="@BadgeTone">@BadgeText</Badge>
            }
        </span>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <small>@Description</small>
        }
        @if (!string.IsNullOrWhiteSpace(Guidance))
        {
            <span class="decision-option-guidance">@Guidance</span>
        }
        @if (Disabled && !string.IsNullOrWhiteSpace(DisabledReason))
        {
            <span class="decision-option-disabled"><FaIcon Name="lock" />@DisabledReason</span>
        }
    </span>
    <span class="decision-option-check" aria-hidden="true">
        @if (Active)
        {
            <FaIcon Name="check" />
        }
    </span>
</SelectableButton>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Guidance { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string BadgeText { get; set; } = "";
    [Parameter] public string BadgeTone { get; set; } = "muted";
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string DisabledReason { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    string CssClass => string.Join(" ", new[]
    {
        "decision-option-card",
        Active ? "is-active" : null,
        Disabled ? "is-disabled" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    string? EffectiveTooltip => Disabled && !string.IsNullOrWhiteSpace(DisabledReason) ? DisabledReason : null;
}
