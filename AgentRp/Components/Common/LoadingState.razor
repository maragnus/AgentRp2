<div class="@CssClass" role="status" aria-live="polite">
    <span class="loading-state-spinner spinner" aria-hidden="true"></span>
    <div class="loading-state-copy">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <strong>@Title</strong>
        }
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p>@Message</p>
        }
    </div>
    @if (ChildContent is not null)
    {
        <div class="loading-state-detail">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Loading";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string CssClass => string.Join(" ", new[] { "loading-state", Compact ? "is-compact" : null, Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
