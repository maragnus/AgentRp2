<SelectableButton Class="@CssClass" Title="@Title" Disabled="@Disabled" OnClick="@OnClick">
    @ChildContent
</SelectableButton>

@code {
    [Parameter] public string Class { get; set; } = "chip-button";
    [Parameter] public string Color { get; set; } = "amber";
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string CssClass => $"{Class} color-{Color} {(Active ? "is-selected" : "")}";
}
