<div class="@CssClass">
    @ChildContent
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string CssClass => string.Join(" ", new[] { "panel-stack", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
