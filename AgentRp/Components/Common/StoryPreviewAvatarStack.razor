<CharacterAvatarStack Characters="AvatarItems"
                      Max="@Max"
                      Class="@Class"
                      AvatarClass="@AvatarClass"
                      EmptyClass="@EmptyClass"
                      EmptyIcon="@EmptyIcon"
                      SummaryPrefix="In scene"
                      EmptySummary="No characters in scene" />

@code {
    [Parameter] public IReadOnlyList<StoryPreviewCharacter> Characters { get; set; } = [];
    [Parameter] public int Max { get; set; } = 3;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string AvatarClass { get; set; } = "";
    [Parameter] public string EmptyClass { get; set; } = "";
    [Parameter] public string EmptyIcon { get; set; } = "";

    IReadOnlyList<CharacterAvatarItem> AvatarItems => Characters
        .Select(character => new CharacterAvatarItem(character.CharacterId, character.Name, character.Avatar?.Url, CropFor(character.Avatar)))
        .ToList();

    static ImageAvatarCropView CropFor(StoryPreviewAvatar? avatar) =>
        avatar is null
            ? ImageAvatarCropView.Default
            : new(avatar.FocusXPercent, avatar.FocusYPercent, avatar.ZoomPercent);
}
