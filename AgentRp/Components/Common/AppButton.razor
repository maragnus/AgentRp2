<button type="@Type"
        @attributes="AdditionalAttributes"
        @ref="Element"
        class="@CssClass"
        title="@TooltipText"
        disabled="@Disabled"
        aria-label="@EffectiveAriaLabel"
        @onclick="OnClick"
        @onclick:stopPropagation="StopPropagation">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <FaIcon Name="@Icon" />
        }
        @if (!string.IsNullOrWhiteSpace(Text))
        {
            <span>@Text</span>
        }
        @if (!string.IsNullOrWhiteSpace(TrailingIcon))
        {
            <FaIcon Name="@TrailingIcon" />
        }
    }
</button>

@code {
    public ElementReference Element { get; private set; }

    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Variant { get; set; } = "ghost";
    [Parameter] public string Size { get; set; } = "sm";
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Bare { get; set; }
    [Parameter] public bool StopPropagation { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TooltipText { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? TrailingIcon { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    string? EffectiveAriaLabel => AriaLabel
        ?? (string.IsNullOrWhiteSpace(Text) ? TooltipText : null);

    bool IsIconOnly => ChildContent is null
        && !string.IsNullOrWhiteSpace(Icon)
        && string.IsNullOrWhiteSpace(Text)
        && string.IsNullOrWhiteSpace(TrailingIcon);

    bool IsPlusIcon => string.Equals(Icon, "plus", StringComparison.OrdinalIgnoreCase);

    string CssClass => Bare
        ? string.Join(" ", new[] { Class, Active ? "is-active" : null }.Where(value => !string.IsNullOrWhiteSpace(value)))
        : string.Join(" ", new[] { "btn", $"btn-{Variant}", $"btn-{Size}", IsIconOnly ? "btn-icon-only" : null, IsPlusIcon ? "btn-plus-action" : null, Active ? "is-active" : null, Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
