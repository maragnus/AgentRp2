<button type="@Type"
        class="@CssClass"
        style="@Style"
        title="@Title"
        disabled="@Disabled"
        aria-label="@AriaLabel"
        @onclick="OnClick"
        @onclick:stopPropagation="StopPropagation">
    @ChildContent
</button>

@code {
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Variant { get; set; } = "ghost";
    [Parameter] public string Size { get; set; } = "sm";
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Bare { get; set; }
    [Parameter] public bool StopPropagation { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string CssClass => Bare
        ? string.Join(" ", new[] { Class, Active ? "is-active" : null }.Where(value => !string.IsNullOrWhiteSpace(value)))
        : string.Join(" ", new[] { "btn", $"btn-{Variant}", $"btn-{Size}", Active ? "is-active" : null, Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
