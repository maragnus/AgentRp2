<CascadingValue Name="OverlayLayer" Value="ModalOverlayLayer" IsFixed="true">
    <ModalEscapeBoundary OnClose="OnCancel">
        <div class="modal-backdrop confirm-backdrop" @onclick="BackdropClick">
            <section class="confirm-dialog" @onclick:stopPropagation="true">
                <div class="confirm-head">
                    <span class="danger-mark @IconClass"><FaIcon Name="@Icon" /></span>
                    <strong>@Title</strong>
                </div>
                <p>@Body</p>
                <div class="confirm-actions">
                    @if (Actions is not null)
                    {
                        @Actions
                    }
                    else
                    {
                        <AppButton Variant="secondary" OnClick="@Cancel">Cancel</AppButton>
                        <AppButton Variant="@ConfirmVariant" OnClick="@Confirm"><FaIcon Name="@Icon" /> @ConfirmText</AppButton>
                    }
                </div>
            </section>
        </div>
    </ModalEscapeBoundary>
</CascadingValue>

@code {
    [Parameter] public string Title { get; set; } = "Delete item?";
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "trash";
    [Parameter] public string ConfirmText { get; set; } = "Delete";
    [Parameter] public string ConfirmVariant { get; set; } = "rose";
    [Parameter] public bool CloseOnBackdropClick { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    string IconClass => Icon == "trash" ? "" : "is-neutral";
    OverlayLayer ModalOverlayLayer => OverlayLayer.Modal;

    Task BackdropClick(MouseEventArgs args) => CloseOnBackdropClick ? OnCancel.InvokeAsync() : Task.CompletedTask;
    Task Cancel(MouseEventArgs args) => OnCancel.InvokeAsync();
    Task Confirm(MouseEventArgs args) => OnConfirm.InvokeAsync();
}
