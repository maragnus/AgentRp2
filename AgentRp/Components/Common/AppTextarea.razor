@inherits AppTextInputBase<AppTextarea>

<textarea @attributes="AdditionalAttributes"
          class="field @Class"
          @ref="InputElement"
          rows="@Rows"
          style="@TextareaStyle"
          value="@Value"
          placeholder="@Placeholder"
          disabled="@Disabled"
          @onchange="HandleNativeChange"></textarea>

@code {
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public bool Disabled { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    string TextareaStyle => string.IsNullOrWhiteSpace(Style)
        ? $"--textarea-lines: {Rows}lh;"
        : $"--textarea-lines: {Rows}lh; {Style}";

}
