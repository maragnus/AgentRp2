<div class="@BackdropCssClass" @onclick="BackdropClick">
    <section class="@ModalCssClass" style="@Style" @onclick:stopPropagation="true">
        <header class="modal-header">
            <div class="modal-title">
                @if (!string.IsNullOrWhiteSpace(Icon))
                {
                    <FaIcon Name="@Icon" />
                }
                <span>@Title</span>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <small>@Subtitle</small>
                }
            </div>
            <div class="modal-window-actions">
                @if (ShowExpandButton)
                {
                    <IconButton Icon="@ExpandIcon" Title="@ExpandTitle" OnClick="@ToggleExpanded" />
                }
                <IconButton Icon="x" Title="Close" OnClick="@CloseClick" />
            </div>
        </header>
        <div class="modal-body @BodyClass">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <footer class="modal-footer">@Footer</footer>
        }
    </section>
</div>

@code {
    bool IsExpanded;

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string MaxWidth { get; set; } = "960px";
    [Parameter] public string? Height { get; set; } = "max(680px, 60vh)";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? BodyClass { get; set; }
    [Parameter] public bool CloseOnBackdropClick { get; set; }
    [Parameter] public bool ShowExpandButton { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    string BackdropCssClass => IsExpanded ? "modal-backdrop is-expanded" : "modal-backdrop";
    string ModalCssClass => string.Join(" ", new[] { "modal", IsExpanded ? "is-expanded" : null, Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    string ExpandIcon => IsExpanded ? "restore" : "maximize";
    string ExpandTitle => IsExpanded ? "Restore" : "Maximize";
    string Style => string.IsNullOrWhiteSpace(Height)
        ? $"--modal-max-width:{MaxWidth};"
        : $"--modal-max-width:{MaxWidth};--modal-height:{Height};";

    Task BackdropClick(MouseEventArgs args) => CloseOnBackdropClick ? OnClose.InvokeAsync() : Task.CompletedTask;
    Task ToggleExpanded(MouseEventArgs args)
    {
        IsExpanded = !IsExpanded;
        return Task.CompletedTask;
    }

    Task CloseClick(MouseEventArgs args) => OnClose.InvokeAsync();
}
