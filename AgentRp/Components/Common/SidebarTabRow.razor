<SelectableButton Class="@CssClass" TooltipText="@Title" Disabled="@Disabled" OnClick="@OnClick">
    @if (LeadingContent is not null)
    {
        @LeadingContent
    }
    else if (IndexContent is not null)
    {
        <span class="@IndexCssClass">@IndexContent</span>
    }
    else
    {
        <span class="sidebar-tab-bar"></span>
    }
    <span class="sidebar-tab-copy">
        <strong>@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Summary))
        {
            <small>@Summary</small>
        }
    </span>
    @if (Dirty)
    {
        <i class="sidebar-tab-dirty"></i>
    }
    @if (TrailingContent is not null)
    {
        <span class="sidebar-tab-trailing">@TrailingContent</span>
    }
</SelectableButton>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Summary { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool Done { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Locked { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? LeadingContent { get; set; }
    [Parameter] public RenderFragment? IndexContent { get; set; }
    [Parameter] public RenderFragment? TrailingContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    string CssClass => $"sidebar-tab-row {(Active ? "is-active" : "")} {(Locked ? "is-locked" : "")} {Class}".Trim();
    string IndexCssClass => $"sidebar-tab-index {(Done && !Active ? "is-done" : "")}".Trim();
}
