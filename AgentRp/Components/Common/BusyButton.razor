<AppButton Variant="@Variant" Size="@Size" Class="@Class" Disabled="@(Busy || Disabled)" Bare="@Bare" OnClick="@HandleClick" TooltipText="@TooltipText" AriaLabel="@AriaLabel" StopPropagation="@StopPropagation">
    @if (Busy)
    {
        <span class="spinner" aria-hidden="true"></span>
    }
    @ChildContent
</AppButton>

@code {
    bool Busy;

    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public string Size { get; set; } = "sm";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Bare { get; set; }
    [Parameter] public string? TooltipText { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool StopPropagation { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    async Task HandleClick()
    {
        if (Busy)
            return;

        Busy = true;
        try
        {
            await OnClick.InvokeAsync();
        }
        finally
        {
            Busy = false;
        }
    }
}
