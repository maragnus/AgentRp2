@inject ITtsPreviewService PreviewService
@inject ITtsAudioPlaybackService Playback

<AudioPlaybackButton AudioKey="@Key"
                     ResolveUrlAsync="ResolveUrl"
                     Variant="@Variant"
                     Size="@Size"
                     Class="@CssClass"
                     Disabled="@Disabled"
                     IconOnly="@IconOnly"
                     PlayTooltip="@PlayTooltip"
                     StopTooltip="@StopTooltip"
                     LoadingTooltip="@LoadingTooltip"
                     ErrorFallback="@($"Playing {DisplayVoice} failed.")" />

@code {
    [Parameter] public AiProvider Provider { get; set; } = new();
    [Parameter] public AiProviderModel Model { get; set; } = new();
    [Parameter] public AiProviderVoice Voice { get; set; } = new();
    [Parameter] public string PreviewUrl { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Variant { get; set; } = "secondary";
    [Parameter] public string Size { get; set; } = "sm";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool IconOnly { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    string Key => $"{Provider.Id}::{Model.Id}::{Voice.Id}::{SampleText}";
    string SampleText => string.IsNullOrWhiteSpace(Text)
        ? $"This is {DisplayVoice}, a sample voice for AgentRp."
        : Text.Trim();
    string DisplayVoice => string.IsNullOrWhiteSpace(Voice.DisplayName) ? Voice.Id : Voice.DisplayName;
    bool HasPreviewUrl => PreviewUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
        || PreviewUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase);
    string PlayTooltip
    {
        get
        {
            if (HasPreviewUrl)
                return $"Play {DisplayVoice} preview.";
            if (Playback.TryGetCachedUrl(Key, out _))
                return $"Play {DisplayVoice} sample. Shift-click to replace it.";

            return $"Generate and play {DisplayVoice} sample.";
        }
    }
    string StopTooltip => $"Stop {DisplayVoice} sample.";
    string LoadingTooltip => $"Generating {DisplayVoice} sample.";
    string CssClass => string.Join(" ", new[]
    {
        "tts-sample-button",
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    async Task<string> ResolveUrl(MouseEventArgs args)
    {
        if (HasPreviewUrl)
            return PreviewUrl;

        if (!Playback.TryGetCachedUrl(Key, out var url) || args.ShiftKey)
        {
            var audio = await PreviewService.GenerateSampleAsync(Provider, Model, Voice, SampleText);
            await Playback.ReplaceCachedAudioAsync(Key, audio.Bytes, audio.ContentType);
            Playback.TryGetCachedUrl(Key, out url);
        }

        return url;
    }
}
