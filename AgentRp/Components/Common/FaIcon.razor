<i class="@CssClass" aria-hidden="true"></i>

@code {
    [Parameter] public string Name { get; set; } = "circle";

    string CssClass => Name switch
    {
        "story-assistant" or "fairy" => "fa-duotone fa-solid fa-person-fairy",
        _ => $"fa-regular {RegularClass}"
    };

    string RegularClass => Name switch
    {
        "plus" => "fa-plus",
        "minus" => "fa-minus",
        "x" => "fa-xmark",
        "xmark" => "fa-xmark",
        "chevron-down" => "fa-chevron-down",
        "chevron-up" => "fa-chevron-up",
        "chevron-left" => "fa-chevron-left",
        "chevron-right" => "fa-chevron-right",
        "settings" => "fa-gear",
        "sliders" => "fa-sliders",
        "edit" => "fa-pen-to-square",
        "trash" => "fa-trash",
        "image" => "fa-image",
        "user" => "fa-user",
        "map-pin" => "fa-location-dot",
        "box" => "fa-box",
        "clock" => "fa-clock",
        "timer" => "fa-timer",
        "coin" => "fa-coin",
        "refresh" => "fa-rotate",
        "copy" => "fa-copy",
        "star" => "fa-star",
        "eye" => "fa-eye",
        "eye-off" => "fa-eye-slash",
        "send" => "fa-paper-plane",
        "paper-plane-top" => "fa-paper-plane-top",
        "sparkle" => "fa-sparkles",
        "check" => "fa-check",
        "save" => "fa-floppy-disk",
        "download" => "fa-download",
        "upload" => "fa-upload",
        "message-sq" => "fa-message",
        "branch" or "git-branch" => "fa-code-branch",
        "more-h" => "fa-ellipsis",
        "zap" => "fa-bolt",
        "layers" => "fa-layer-group",
        "lock" => "fa-lock",
        "lock-open" => "fa-lock-open",
        "align-left" => "fa-align-left",
        "camera" => "fa-camera",
        "filter" => "fa-filter",
        "search" => "fa-magnifying-glass",
        "book-open" => "fa-book-open",
        "cards" => "fa-cards",
        "flag" => "fa-flag",
        "scissors" => "fa-scissors",
        "users" => "fa-users",
        "pin" => "fa-thumbtack",
        "shuffle" => "fa-shuffle",
        "route" => "fa-route",
        "clapperboard" => "fa-clapperboard",
        "forward" => "fa-forward",
        "swap" => "fa-arrow-right-arrow-left",
        "feather" => "fa-feather",
        "wrench" => "fa-wrench",
        "chart-line" => "fa-chart-line",
        "waveform-lines" => "fa-waveform-lines",
        "microphone" => "fa-microphone",
        "masks-theater" => "fa-masks-theater",
        "play" => "fa-play",
        "pause" => "fa-pause",
        "power-off" => "fa-power-off",
        "circle-play" => "fa-circle-play",
        "circle-pause" => "fa-circle-pause",
        "circle-stop" => "fa-circle-stop",
        "volume" => "fa-volume",
        "volume-high" => "fa-volume-high",
        "circle-exclamation" => "fa-circle-exclamation",
        "circle-question" => "fa-circle-question",
        "warning" => "fa-triangle-exclamation",
        "question" => "fa-circle-question",
        "circle-info" => "fa-circle-info",
        "spinner" => "fa-spinner",
        "sun" => "fa-sun",
        "moon" => "fa-moon",
        "monitor" => "fa-display",
        "maximize" => "fa-window-maximize",
        "restore" => "fa-window-restore",
        _ => "fa-circle"
    };
}
