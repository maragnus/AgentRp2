@inject IJSRuntime JS
@inject OverlayService Overlays
@inject ILogger<OverlaySurface> Logger
@implements IAsyncDisposable

<div @ref="Element"
     class="@CssClass"
     data-overlay-id="@Entry.Id"
     @onclick="ContentClick"
     @onclick:stopPropagation="true">
    @Entry.Content
</div>

@code {
    ElementReference Element;
    DotNetObjectReference<OverlaySurface>? DotNetReference;

    [Parameter] public OverlayEntry Entry { get; set; } = default!;

    string CssClass => string.Join(" ", new[]
    {
        "overlay-popover",
        "popover",
        Entry.Class,
        Entry.Layer == OverlayLayer.Modal ? "is-layer-modal" : "is-layer-page"
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        DotNetReference ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("agentRp.overlay.track", Entry.Id.ToString(), Entry.Anchor, Element, Entry.Placement.ToString(), DotNetReference);
        }
        catch (InvalidOperationException exception) when (IsDetachedElementReference(exception))
        {
            Logger.LogWarning(
                exception,
                "OverlaySurface track failed because an ElementReference was detached. Id={OverlayId} Owner={Owner} Class={Class}",
                Entry.Id,
                Entry.OwnerDebugName,
                Entry.Class);
            await Overlays.CloseAsync(Entry.Id);
        }
        catch (JSDisconnectedException)
        {
            Logger.LogDebug("OverlaySurface track skipped because JS disconnected. Id={OverlayId} Owner={Owner}", Entry.Id, Entry.OwnerDebugName);
        }
    }

    async Task ContentClick(MouseEventArgs args)
    {
        if (Entry.CloseOnContentClick)
        {
            await Overlays.CloseAsync(Entry.Id);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task CloseFromBrowser() => Overlays.CloseAsync(Entry.Id);

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("agentRp.overlay.untrack", Entry.Id.ToString());
        }
        catch (InvalidOperationException exception) when (IsDetachedElementReference(exception))
        {
            Logger.LogWarning(
                exception,
                "OverlaySurface untrack ignored because an ElementReference was detached. Id={OverlayId} Owner={Owner}",
                Entry.Id,
                Entry.OwnerDebugName);
        }
        catch (JSDisconnectedException)
        {
            Logger.LogDebug("OverlaySurface untrack skipped because JS disconnected. Id={OverlayId} Owner={Owner}", Entry.Id, Entry.OwnerDebugName);
        }

        DotNetReference?.Dispose();
    }

    static bool IsDetachedElementReference(InvalidOperationException exception) =>
        exception.Message.Contains("No element is currently associated", StringComparison.OrdinalIgnoreCase);
}
