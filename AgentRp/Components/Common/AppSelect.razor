<select class="@CssClass" value="@Value" @onchange="HandleChange">
    @ChildContent
</select>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Size { get; set; } = "field";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string CssClass => string.Join(" ", new[] { "select", $"select-{Size}", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));

    Task HandleChange(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");
}
