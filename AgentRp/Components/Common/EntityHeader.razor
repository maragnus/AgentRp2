<div class="entity-header">
    @if (LeadingContent is not null)
    {
        @LeadingContent
    }
    else
    {
        <EntityImage Name="@Name"
                     Image="Image"
                     EntityType="@EntityType"
                     EntityId="@EntityId"
                     Size="@ImageSize"
                     Editable="@Editable"
                     OnClick="OnImagePickerRequested" />
    }
    <div class="entity-header-copy">
        <strong>@Name</strong>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <div>@Subtitle</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="entity-header-actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public GalleryImage? Image { get; set; }
    [Parameter] public string? EntityType { get; set; }
    [Parameter] public string? EntityId { get; set; }
    [Parameter] public int ImageSize { get; set; } = 44;
    [Parameter] public bool Editable { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnImagePickerRequested { get; set; }
    [Parameter] public RenderFragment? LeadingContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
