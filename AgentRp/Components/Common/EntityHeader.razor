<div class="entity-form-head">
    <EntityImage Name="@Name" Image="Image" Size="@ImageSize" Editable="@Editable" OnClick="OnImagePickerRequested" />
    <div class="entity-header-copy">
        <strong>@Name</strong>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <div>@Subtitle</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="entity-header-actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public GalleryImage? Image { get; set; }
    [Parameter] public int ImageSize { get; set; } = 44;
    [Parameter] public bool Editable { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnImagePickerRequested { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
