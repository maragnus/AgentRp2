<div class="@CssClass" title="@Title">
    <AppButton Bare
               Class="@CheckClass"
               Disabled="@Disabled"
               TooltipText="@SelectionTooltipText"
               AriaLabel="@SelectionTooltipText"
               OnClick="@OnToggle">
        @if (Selected)
        {
            <FaIcon Name="check" />
        }
    </AppButton>
    <div class="selectable-row-main">
        @ChildContent
    </div>
    @if (Actions is not null)
    {
        <div class="selectable-row-actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Limited { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? SelectionTooltipText { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnToggle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    string CssClass => string.Join(" ", new[]
    {
        "selectable-row",
        Selected ? "is-selected" : null,
        Disabled ? "is-disabled" : null,
        Limited ? "is-limited" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    string CheckClass => $"selectable-row-check {(Selected ? "is-on" : "")}";
}
