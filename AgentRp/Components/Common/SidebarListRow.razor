<SelectableButton Class="@CssClass" TooltipText="@Title" Disabled="@Disabled" OnClick="@OnClick">
    @if (LeadingContent is not null)
    {
        <span class="sidebar-list-leading">@LeadingContent</span>
    }
    <span class="sidebar-list-copy">
        <strong>@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Summary))
        {
            <small>@Summary</small>
        }
    </span>
    @if (!string.IsNullOrWhiteSpace(Count))
    {
        <span class="sidebar-list-count">@Count</span>
    }
    @if (TrailingContent is not null)
    {
        <span class="sidebar-list-trailing">@TrailingContent</span>
    }
</SelectableButton>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Summary { get; set; }
    [Parameter] public string? Count { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? LeadingContent { get; set; }
    [Parameter] public RenderFragment? TrailingContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    string CssClass => $"sidebar-list-row {(Active ? "is-active" : "")} {Class}".Trim();
}
