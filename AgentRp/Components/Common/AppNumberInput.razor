@inherits AppTextInputBase<AppNumberInput>

<InputGroup Class="@CssClass">
    @if (!string.IsNullOrWhiteSpace(PrefixText) || PrefixContent is not null)
    {
        <InputGroupAddon>
            @if (PrefixContent is not null)
            {
                @PrefixContent
            }
            else
            {
                @PrefixText
            }
        </InputGroupAddon>
    }
    <input @attributes="AdditionalAttributes"
           class="@BuildFieldCssClass(InputCssClass)"
           type="number"
           @ref="InputElement"
           value="@Value"
           min="@Min"
           max="@Max"
           step="@Step"
           placeholder="@Placeholder"
           disabled="@Disabled"
           aria-label="@AriaLabel"
           @onchange="HandleNativeChange" />
    <AppButton Icon="minus"
               Size="@ButtonSize"
               Disabled="@Disabled"
               TooltipText="@DecrementTooltipText"
               AriaLabel="@DecrementAriaLabel"
               OnClick="@(_ => StepValue(-1))" />
    <AppButton Icon="plus"
               Size="@ButtonSize"
               Disabled="@Disabled"
               TooltipText="@IncrementTooltipText"
               AriaLabel="@IncrementAriaLabel"
               OnClick="@(_ => StepValue(1))" />
</InputGroup>

@code {
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public string? Step { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? InputClass { get; set; }
    [Parameter] public string? PrefixText { get; set; }
    [Parameter] public RenderFragment? PrefixContent { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string ButtonSize { get; set; } = "sm";
    [Parameter] public string DecrementTooltipText { get; set; } = "Decrease";
    [Parameter] public string IncrementTooltipText { get; set; } = "Increase";
    [Parameter] public string? DecrementAriaLabel { get; set; }
    [Parameter] public string? IncrementAriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    string CssClass => string.Join(" ", new[] { "app-number-input", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));
    string InputCssClass => string.Join(" ", new[] { "app-number-input-field", InputClass }.Where(value => !string.IsNullOrWhiteSpace(value)));

    async Task StepValue(int direction)
    {
        if (Disabled)
            return;

        await JS.InvokeVoidAsync("agentRp.numberInputs.step", InputElement, direction);
    }
}
